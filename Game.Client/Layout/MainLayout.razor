@using Game.Client.Services
@using Game.Shared.Dtos.Auth
@using Game.Shared.Dtos.Characters
@inject ApiService ApiService
@inject ActiveCharacterState ActiveCharacters
@inject CharacterContextCoordinator CharacterContext
@inject NavigationManager Navigation
@inherits LayoutComponentBase
@implements IDisposable

<div class="page @(IsBattlePage ? "page--battle" : null) @(IsLobbyPage ? "page--lobby" : null) @(IsWeaponsPage ? "page--weapons" : null) @(IsTalentPage ? "page--talents" : null) @(IsSuppliesPage ? "page--supplies" : null) @(IsInventoryPage ? "page--inventory" : null) @(IsFormationsPage ? "page--formations" : null) @(IsEntryPage ? "page--auth" : null)">
    @if (!IsEntryPage)
    {
        <NavMenu />
    }
    <main>
        @if (!IsEntryPage)
        {
        <div class="top-row">
            <button type="button" class="top-row__brand" @onclick="OpenBattleAsync" disabled="@_isOpeningBattle"
                    title="返回当前角色的战斗，空闲时打开副本大厅"
                    aria-label="返回当前角色的战斗，空闲时打开副本大厅"
                    aria-busy="@(_isOpeningBattle ? "true" : "false")">⚔</button>
            @if (!_isLoadingUser && _currentUser is not null)
            {
                <button type="button"
                        class="top-row__character"
                        @ref="_switchTrigger"
                        @onclick="OpenSwitcher"
                        aria-haspopup="dialog"
                        aria-expanded="@(_isSwitcherOpen ? "true" : "false")"
                        aria-label="@(ActiveCharacters.Current is { } active ? $"当前角色 {active.Name}，等级 {active.Level}，{GetExperienceText(active)}，点击切换角色" : "选择当前操作角色")">
                    @if (ActiveCharacters.Current is { } character)
                    {
                        <span class="top-row__character-line">
                            <strong>@character.Name</strong>
                            <span class="top-row__character-level">Lv @character.Level</span>
                            <span class="top-row__experience" title="@GetExperienceText(character)">
                                <progress value="@(character.ExperienceToNextLevel is > 0 ? Math.Clamp(character.Experience, 0, character.ExperienceToNextLevel.Value) : 1)"
                                          max="@(character.ExperienceToNextLevel is > 0 ? character.ExperienceToNextLevel.Value : 1)"
                                          aria-label="@character.Name @GetExperienceText(character)"></progress>
                                <span class="top-row__experience-value" aria-hidden="true">@(character.ExperienceToNextLevel is int required ? $"{character.Experience}/{required}" : "MAX")</span>
                            </span>
                        </span>
                        <span class="top-row__character-detail">@character.ProfessionName · HP @character.Hp / @character.MaxHp</span>
                    }
                    else
                    {
                        <strong>选择角色</strong>
                    }
                    <span class="top-row__character-arrow" aria-hidden="true">⌄</span>
                </button>
            }
        </div>
        }

        <article class="content @(IsEntryPage ? "content--auth" : null)">
            @if (!_canRenderBody)
            {
                <GameStateCard Compact="true" Title="正在准备冒险" Detail="确认账号与角色信息…" />
            }
            else
            {
                @Body
            }
        </article>
    </main>

    @if (_currentUser is not null)
    {
        <ShellDialog IsOpen="_isSwitcherOpen" OnClose="CloseSwitcher" Class="character-switcher" LabelledBy="character-switcher-title">
                <header class="character-switcher__header">
                    <div>
                        <h2 id="character-switcher-title">我的角色</h2>
                        <p>@_currentUser.UserName</p>
                    </div>
                    <button type="button" class="character-switcher__close" @onclick="CloseSwitcher" aria-label="关闭角色窗口">×</button>
                </header>
                @if (_isSwitcherOpen)
                {
                <CurrentCharacterPanel OnSelected="CloseSwitcher" />
                }
                <footer class="character-switcher__account">
                    @if (_logoutError is not null) { <span class="top-row__error" role="alert">@_logoutError</span> }
                    <button type="button" class="button button--quiet" @onclick="LogoutAsync" disabled="@_isLoggingOut">@(_isLoggingOut ? "正在退出…" : "退出登录")</button>
                </footer>
        </ShellDialog>
    }
</div>

@code {
    private CurrentUserResponse? _currentUser => CharacterContext.CurrentUser;
    private long _userLoadRequest;
    private long _layoutSessionRevision;
    private bool _isLoadingUser = true;
    private bool _canRenderBody;
    private bool _isLoggingOut;
    private bool _isOpeningBattle;
    private string? _logoutError;
    private bool _isSwitcherOpen;
    private bool _restoreSwitcherFocus;
    private ElementReference _switchTrigger;
    private readonly CancellationTokenSource _refreshCancellation = new();
    private bool IsBattlePage => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("battle/", StringComparison.OrdinalIgnoreCase);
    private bool IsLobbyPage => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/') is "" or "rooms";
    private bool IsWeaponsPage => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("weapons", StringComparison.OrdinalIgnoreCase);
    private bool IsTalentPage => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("talents", StringComparison.OrdinalIgnoreCase);
    private bool IsSuppliesPage => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("supplies", StringComparison.OrdinalIgnoreCase);
    private bool IsFormationsPage => string.Equals(Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/'), "formations", StringComparison.OrdinalIgnoreCase);
    private bool IsInventoryPage => string.Equals(Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/'), "inventory", StringComparison.OrdinalIgnoreCase);
    private bool IsCharacterCreationPage => string.Equals(
        Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/'), "characters/create", StringComparison.OrdinalIgnoreCase);
    private bool IsEntryPage => IsAuthPage || IsCharacterCreationPage;
    private bool IsAuthPage
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri);
            return path.StartsWith("login", StringComparison.OrdinalIgnoreCase)
                || path.StartsWith("register", StringComparison.OrdinalIgnoreCase);
        }
    }
    private string CurrentPageTitle
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri);
            if (path.StartsWith("battle/", StringComparison.OrdinalIgnoreCase)) return "战斗房间";
            if (path.StartsWith("talents", StringComparison.OrdinalIgnoreCase)) return "职业与技能";
            if (path.StartsWith("weapons", StringComparison.OrdinalIgnoreCase)) return "武器编成";
            if (path.StartsWith("inventory", StringComparison.OrdinalIgnoreCase)) return "角色仓库";
            if (path.StartsWith("shop", StringComparison.OrdinalIgnoreCase)) return "商店";
            if (path.StartsWith("supplies", StringComparison.OrdinalIgnoreCase)) return "战斗补给";
            if (path.StartsWith("gathering", StringComparison.OrdinalIgnoreCase) || path.StartsWith("planting", StringComparison.OrdinalIgnoreCase)) return "药田种植";
            if (path.StartsWith("production", StringComparison.OrdinalIgnoreCase)) return "炼金生产";
            if (path.StartsWith("login", StringComparison.OrdinalIgnoreCase)) return "登录";
            if (path.StartsWith("register", StringComparison.OrdinalIgnoreCase)) return "注册";
            return "副本大厅";
        }
    }

    private static string GetExperienceText(CurrentCharacterResponse character) =>
        character.ExperienceToNextLevel is int required ? $"经验 {character.Experience} / {required}" : "等级已满";

    protected override void OnInitialized()
    {
        ActiveCharacters.Changed += OnActiveCharacterChanged;
        CharacterContext.Changed += OnCharacterContextChanged;
        ApiService.ContextChanged += OnContextChanged;
        Navigation.LocationChanged += OnLocationChanged;
        _ = RefreshCharacterLoopAsync(_refreshCancellation.Token);
    }

    // Query-only warehouse navigation must not remove @Body while refreshing the header.
    protected override Task OnParametersSetAsync() => LoadPageContextAsync(
        preserveBody: IsInventoryPage && _canRenderBody && _layoutSessionRevision == ApiService.SessionRevision);

    private async Task LoadPageContextAsync(bool preserveBody = false)
    {
        var request = ++_userLoadRequest;
        _isLoadingUser = true;
        if (!preserveBody) _canRenderBody = IsAuthPage;
        await ApiService.EnsureContextAsync();
        var revision = ApiService.DataRevision;
        await CharacterContext.EnsureLoadedAsync();
        if (_refreshCancellation.IsCancellationRequested || request != _userLoadRequest) return;
        if (revision != ApiService.DataRevision) return;
        _layoutSessionRevision = ApiService.SessionRevision;
        if (_currentUser is null)
        {
            _isSwitcherOpen = false;
            ActiveCharacters.Clear();
            _canRenderBody = true;
        }
        else if (_currentUser.CharacterCount == 0)
        {
            ActiveCharacters.Clear();
            _isSwitcherOpen = false;
            _canRenderBody = IsEntryPage;
            if (!IsEntryPage)
                Navigation.NavigateTo("/characters/create", replace: true);
        }
        else
        {
            _canRenderBody = true;
        }
        _isLoadingUser = false;
    }

    private void OpenSwitcher()
    {
        _isSwitcherOpen = true;
    }

    private void CloseSwitcher()
    {
        _restoreSwitcherFocus |= _isSwitcherOpen;
        _isSwitcherOpen = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_restoreSwitcherFocus && !_isSwitcherOpen && !_isLoadingUser && _currentUser is not null)
        {
            _restoreSwitcherFocus = false;
            await _switchTrigger.FocusAsync(preventScroll: true);
        }
    }

    private void OnActiveCharacterChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(() =>
    {
        _isSwitcherOpen = false;
        _restoreSwitcherFocus = false;
        StateHasChanged();
    });

    private void OnContextChanged()
    {
        _restoreSwitcherFocus |= _isSwitcherOpen && !_isLoggingOut;
        _isSwitcherOpen = false;
        _ = InvokeAsync(async () =>
        {
            if (_refreshCancellation.IsCancellationRequested) return;
            await LoadPageContextAsync(preserveBody: _layoutSessionRevision == ApiService.SessionRevision);
            if (!_refreshCancellation.IsCancellationRequested) StateHasChanged();
        });
    }

    private void OnCharacterContextChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task OpenBattleAsync()
    {
        if (_isOpeningBattle || _isLoggingOut) return;
        _isOpeningBattle = true;
        var sourceUri = Navigation.Uri;
        int? roomId = null;
        try
        {
            await ActiveCharacters.RefreshAsync();
            roomId = ActiveCharacters.Current?.ActiveBattleRoomId;
        }
        catch { /* The lobby remains available if the current battle cannot be read. */ }
        finally
        {
            _isOpeningBattle = false;
        }

        if (_refreshCancellation.IsCancellationRequested || _isLoggingOut || Navigation.Uri != sourceUri) return;
        Navigation.NavigateTo(roomId is int activeRoomId ? $"/battle/{activeRoomId}" : "/rooms");
    }

    private async Task LogoutAsync()
    {
        if (_isLoggingOut) return;
        _isLoggingOut = true;
        _logoutError = null;
        try
        {
            if (!await ApiService.LogoutAsync())
            {
                _logoutError = "退出失败，请重试。";
                return;
            }

            _isSwitcherOpen = false;
            ActiveCharacters.Clear();
            Navigation.NavigateTo("/login", replace: true);
        }
        catch
        {
            _logoutError = "退出失败，请重试。";
        }
        finally
        {
            _isLoggingOut = false;
        }
    }

    private async Task RefreshCharacterLoopAsync(CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(10), cancellationToken);
                if (_currentUser is not null)
                {
                    await CharacterContext.RefreshAsync();
                    if (!cancellationToken.IsCancellationRequested) await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException) { break; }
            catch { /* Keep the header available during a transient connection failure. */ }
        }
    }

    public void Dispose()
    {
        ActiveCharacters.Changed -= OnActiveCharacterChanged;
        CharacterContext.Changed -= OnCharacterContextChanged;
        ApiService.ContextChanged -= OnContextChanged;
        Navigation.LocationChanged -= OnLocationChanged;
        _refreshCancellation.Cancel();
        _refreshCancellation.Dispose();
    }
}
