@using Game.Client.Services
@using Game.Shared.Dtos.Auth
@using Game.Shared.Dtos.Characters
@inject ApiService ApiService
@inject ActiveCharacterState ActiveCharacters
@inject AccountBalanceState AccountBalance
@inject NavigationManager Navigation
@inherits LayoutComponentBase
@implements IDisposable

<div class="page @(IsBattlePage ? "page--battle" : null) @(IsWeaponsPage ? "page--weapons" : null) @(IsTalentPage ? "page--talents" : null) @(IsSuppliesPage ? "page--supplies" : null) @(IsAuthPage ? "page--auth" : null)">
    @if (!IsAuthPage)
    {
        <NavMenu />
    }
    <main>
        @if (!IsAuthPage)
        {
        <div class="top-row">
            <a class="top-row__brand" href="/rooms" aria-label="返回副本大厅">⚔</a>
            @if (!_isLoadingUser && _currentUser is not null)
            {
                <button type="button"
                        class="top-row__character"
                        @ref="_switchTrigger"
                        @onclick="OpenSwitcher"
                        aria-haspopup="dialog"
                        aria-expanded="@(_isSwitcherOpen ? "true" : "false")"
                        aria-label="@(ActiveCharacters.Current is { } active ? $"当前角色 {active.Name}，等级 {active.Level}，{GetExperienceText(active)}，点击切换角色" : "选择当前操作角色")">
                    <span class="top-row__character-label">当前操作角色</span>
                    @if (ActiveCharacters.Current is { } character)
                    {
                        <span class="top-row__character-line">
                            <strong>@character.Name</strong>
                            <span class="top-row__character-level">Lv @character.Level</span>
                            <span class="top-row__experience" title="@GetExperienceText(character)">
                                <progress value="@(character.ExperienceToNextLevel is > 0 ? Math.Clamp(character.Experience, 0, character.ExperienceToNextLevel.Value) : 1)"
                                          max="@(character.ExperienceToNextLevel is > 0 ? character.ExperienceToNextLevel.Value : 1)"
                                          aria-label="@character.Name @GetExperienceText(character)"></progress>
                                <span class="top-row__experience-value" aria-hidden="true">@(character.ExperienceToNextLevel is int required ? $"{character.Experience}/{required}" : "MAX")</span>
                            </span>
                        </span>
                        <span class="top-row__character-detail">HP @character.Hp / @character.MaxHp · 天赋点 @character.TalentPoints</span>
                    }
                    else
                    {
                        <strong>选择角色</strong>
                    }
                    <span class="top-row__character-arrow" aria-hidden="true">⌄</span>
                </button>
            }
            <strong class="top-row__title">@CurrentPageTitle</strong>
            @if (!_isLoadingUser && _currentUser is not null)
            {
                <div class="top-row__account">
                    <span class="top-row__gold" title="当前角色金币"><span aria-hidden="true">◆</span> @_currentUser.Gold</span>
                    <span class="top-row__username" title="@_currentUser.UserName">@_currentUser.UserName</span>
                    <button type="button" class="top-row__logout" @onclick="LogoutAsync" disabled="@_isLoggingOut" title="退出登录" aria-label="@(_isLoggingOut ? "正在退出登录" : "退出登录")">@(_isLoggingOut ? "…" : "↪")</button>
                </div>
            }
            @if (_logoutError is not null)
            {
                <span class="top-row__error" role="alert">@_logoutError</span>
            }
        </div>
        }

        <article class="content @(IsAuthPage ? "content--auth" : null)">
            @Body
        </article>
    </main>

    @if (_isSwitcherOpen && _currentUser is not null)
    {
        <div class="character-switcher__overlay" @onclick="CloseSwitcher">
            <section class="character-switcher__dialog" role="dialog" aria-modal="true" aria-labelledby="character-switcher-title" @onclick:stopPropagation="true" @onkeydown="HandleSwitcherKeyDown">
                <header class="character-switcher__header">
                    <div>
                        <span>YOUR CHARACTERS</span>
                        <h2 id="character-switcher-title">选择操作角色</h2>
                        <p>切换当前角色，或创建、管理你的角色。</p>
                    </div>
                    <button type="button" class="character-switcher__close" @ref="_switchCloseButton" @onclick="CloseSwitcher" aria-label="关闭角色窗口">×</button>
                </header>
                <CurrentCharacterPanel OnSelected="CloseSwitcher" />
            </section>
        </div>
    }
</div>

@code {
    private CurrentUserResponse? _currentUser;
    private bool _isLoadingUser = true;
    private bool _isLoggingOut;
    private string? _logoutError;
    private bool _isSwitcherOpen;
    private bool _focusSwitcherClose;
    private bool _focusSwitcherTrigger;
    private ElementReference _switchTrigger;
    private ElementReference _switchCloseButton;
    private readonly CancellationTokenSource _refreshCancellation = new();
    private bool IsBattlePage => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("battle/", StringComparison.OrdinalIgnoreCase);
    private bool IsWeaponsPage => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("weapons", StringComparison.OrdinalIgnoreCase);
    private bool IsTalentPage => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("talents", StringComparison.OrdinalIgnoreCase);
    private bool IsSuppliesPage => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("supplies", StringComparison.OrdinalIgnoreCase);
    private bool IsAuthPage
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri);
            return path.StartsWith("login", StringComparison.OrdinalIgnoreCase)
                || path.StartsWith("register", StringComparison.OrdinalIgnoreCase);
        }
    }
    private string CurrentPageTitle
    {
        get
        {
            var path = Navigation.ToBaseRelativePath(Navigation.Uri);
            if (path.StartsWith("battle/", StringComparison.OrdinalIgnoreCase)) return "战斗房间";
            if (path.StartsWith("talents", StringComparison.OrdinalIgnoreCase)) return "职业天赋";
            if (path.StartsWith("weapons", StringComparison.OrdinalIgnoreCase)) return "武器编成";
            if (path.StartsWith("shop", StringComparison.OrdinalIgnoreCase)) return "商店";
            if (path.StartsWith("supplies", StringComparison.OrdinalIgnoreCase)) return "战斗补给";
            if (path.StartsWith("gathering", StringComparison.OrdinalIgnoreCase)) return "采集";
            if (path.StartsWith("production", StringComparison.OrdinalIgnoreCase)) return "炼金生产";
            if (path.StartsWith("login", StringComparison.OrdinalIgnoreCase)) return "登录";
            if (path.StartsWith("register", StringComparison.OrdinalIgnoreCase)) return "注册";
            return "副本大厅";
        }
    }

    private static string GetExperienceText(CurrentCharacterResponse character) =>
        character.ExperienceToNextLevel is int required ? $"经验 {character.Experience} / {required}" : "等级已满";

    protected override void OnInitialized()
    {
        ActiveCharacters.Changed += OnActiveCharacterChanged;
        AccountBalance.Changed += OnAccountBalanceChanged;
        _ = RefreshCharacterLoopAsync(_refreshCancellation.Token);
    }

    protected override async Task OnParametersSetAsync()
    {
        _isLoadingUser = true;
        _currentUser = await ApiService.GetCurrentUserAsync();
        if (_currentUser is null)
        {
            _isSwitcherOpen = false;
            _focusSwitcherClose = false;
            _focusSwitcherTrigger = false;
            ActiveCharacters.Clear();
        }
        else
        {
            await ActiveCharacters.RefreshAsync();
        }
        _isLoadingUser = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusSwitcherClose)
        {
            _focusSwitcherClose = false;
            await _switchCloseButton.FocusAsync();
        }
        else if (_focusSwitcherTrigger && _currentUser is not null)
        {
            _focusSwitcherTrigger = false;
            await _switchTrigger.FocusAsync();
        }
    }

    private void OpenSwitcher()
    {
        _isSwitcherOpen = true;
        _focusSwitcherClose = true;
    }

    private void CloseSwitcher()
    {
        _isSwitcherOpen = false;
        _focusSwitcherTrigger = true;
    }

    private void HandleSwitcherKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseSwitcher();
    }

    private void OnActiveCharacterChanged() => _ = InvokeAsync(async () =>
    {
        try
        {
            if (_currentUser is not null)
            {
                var refreshed = await ApiService.GetCurrentUserAsync();
                if (refreshed is not null) _currentUser = refreshed;
            }
        }
        catch { /* The regular header refresh will retry after a transient connection failure. */ }
        StateHasChanged();
    });

    private void OnAccountBalanceChanged() => _ = InvokeAsync(async () =>
    {
        try
        {
            var refreshed = await ApiService.GetCurrentUserAsync();
            if (refreshed is not null) _currentUser = refreshed;
        }
        catch { /* The regular header refresh will retry after a transient connection failure. */ }
        StateHasChanged();
    });

    private async Task LogoutAsync()
    {
        if (_isLoggingOut) return;
        _isLoggingOut = true;
        _logoutError = null;
        try
        {
            if (!await ApiService.LogoutAsync())
            {
                _logoutError = "退出失败，请重试。";
                return;
            }

            _isSwitcherOpen = false;
            ActiveCharacters.Clear();
            Navigation.NavigateTo("/login", replace: true);
        }
        catch
        {
            _logoutError = "退出失败，请重试。";
        }
        finally
        {
            _isLoggingOut = false;
        }
    }

    private async Task RefreshCharacterLoopAsync(CancellationToken cancellationToken)
    {
        while (!cancellationToken.IsCancellationRequested)
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(10), cancellationToken);
                if (_currentUser is not null)
                {
                    await ActiveCharacters.RefreshAsync();
                    var refreshed = await ApiService.GetCurrentUserAsync();
                    if (refreshed is not null)
                    {
                        _currentUser = refreshed;
                        await InvokeAsync(StateHasChanged);
                    }
                }
            }
            catch (OperationCanceledException) { break; }
            catch { /* Keep the header available during a transient connection failure. */ }
        }
    }

    public void Dispose()
    {
        ActiveCharacters.Changed -= OnActiveCharacterChanged;
        AccountBalance.Changed -= OnAccountBalanceChanged;
        _refreshCancellation.Cancel();
        _refreshCancellation.Dispose();
    }
}
