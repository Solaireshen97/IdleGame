@inject NavigationManager Navigation
@implements IDisposable

<nav class="mobile-dock" aria-label="主要导航">
    @foreach (var item in NavigationItems)
    {
        var isActive = IsActive(item);
        <a class="mobile-dock__link @(isActive ? "active" : null)"
           href="@item.Href"
           aria-current="@(isActive ? "page" : null)">
            <span class="mobile-dock__icon" aria-hidden="true">@item.Icon</span>
            <span>@item.MobileLabel</span>
        </a>
    }
</nav>

@code {
    private static readonly NavItem[] NavigationItems =
    [
        new("rooms", "大厅", "☷"),
        new("talents", "天赋", "✦"),
        new("weapons", "武器", "⚔"),
        new("supplies", "补给", "✚"),
        new("gathering", "采集", "♣"),
        new("production", "炼金", "⚗"),
        new("shop", "商店", "◆")
    ];

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private bool IsActive(NavItem item)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri)
            .Split('?', '#')[0]
            .Trim('/');

        if (item.Href == "rooms")
        {
            return string.IsNullOrEmpty(path)
                || path.Equals("rooms", StringComparison.OrdinalIgnoreCase)
                || path.StartsWith("battle/", StringComparison.OrdinalIgnoreCase);
        }

        return path.Equals(item.Href, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith($"{item.Href}/", StringComparison.OrdinalIgnoreCase);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private sealed record NavItem(string Href, string MobileLabel, string Icon);
}
