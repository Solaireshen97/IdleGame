@inject NavigationManager Navigation
@implements IDisposable

<nav class="mobile-dock" aria-label="主要导航">
    @foreach (var item in PrimaryItems)
    {
        var isActive = IsActive(item);
        <a class="mobile-dock__link @(isActive ? "active" : null)"
           href="@item.Href"
           aria-current="@(isActive ? "page" : null)">
            <span class="mobile-dock__icon" aria-hidden="true">@item.Icon</span>
            <span>@item.MobileLabel</span>
        </a>
    }
    <button type="button" class="mobile-dock__link @(IsMoreActive ? "active" : null)"
            @onclick="() => _isMoreOpen = true" aria-haspopup="dialog" aria-expanded="@_isMoreOpen">
        <span class="mobile-dock__icon" aria-hidden="true">•••</span><span>更多</span>
    </button>
</nav>

<ShellDialog IsOpen="_isMoreOpen" OnClose="CloseMore" Class="navigation-sheet" LabelledBy="navigation-sheet-title">
    <header class="navigation-sheet__header">
        <h2 id="navigation-sheet-title">冒险与营地</h2>
        <button type="button" @onclick="CloseMore" aria-label="关闭更多导航">×</button>
    </header>
    <nav class="navigation-sheet__grid" aria-label="更多导航">
        @foreach (var item in MoreItems)
        {
            <a href="@item.Href" class="navigation-sheet__link @(IsActive(item) ? "active" : null)"
               @onclick="CloseMore" aria-current="@(IsActive(item) ? "page" : null)">
                <span aria-hidden="true">@item.Icon</span><strong>@item.MobileLabel</strong><span aria-hidden="true">›</span>
            </a>
        }
    </nav>
</ShellDialog>

@code {
    private bool _isMoreOpen;
    private static readonly NavItem[] PrimaryItems =
    [
        new("rooms", "大厅", "☷"),
        new("formations", "编队", "▦"),
        new("inventory", "仓库", "▣")
    ];
    private static readonly NavItem[] MoreItems =
    [
        new("story", "冒险日志", "✧"),
        new("gathering", "药田", "♣"),
        new("production", "炼金", "⚗"),
        new("shop", "商店", "◆")
    ];
    private bool IsMoreActive => MoreItems.Any(IsActive);
    private void CloseMore() => _isMoreOpen = false;

    protected override void OnInitialized() => Navigation.LocationChanged += OnLocationChanged;

    private bool IsActive(NavItem item)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri)
            .Split('?', '#')[0]
            .Trim('/');

        if (item.Href == "rooms")
        {
            return string.IsNullOrEmpty(path)
                || path.Equals("rooms", StringComparison.OrdinalIgnoreCase)
                || path.StartsWith("battle/", StringComparison.OrdinalIgnoreCase);
        }

        return (item.Href == "gathering" && path.Equals("planting", StringComparison.OrdinalIgnoreCase))
            || path.Equals(item.Href, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith($"{item.Href}/", StringComparison.OrdinalIgnoreCase);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(() =>
    {
        _isMoreOpen = false;
        StateHasChanged();
    });

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;

    private sealed record NavItem(string Href, string MobileLabel, string Icon);
}
