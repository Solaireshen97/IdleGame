@using Game.Shared

<div class="skill-auto-picker">
    <label class="skill-auto-picker__condition">
        <span>自动释放条件</span>
        <select value="@_condition" disabled="@Disabled" @onchange="ChangeConditionAsync">
            <option value="">@DefaultLabel</option>
            @foreach (var condition in SkillAutoRules.Conditions)
            {
                <option value="@condition">@SkillAutoRules.Label(condition)</option>
            }
        </select>
    </label>
    @if (SkillAutoRules.UsesHpThreshold(ConditionOverride ?? DefaultCondition))
    {
        <label class="skill-auto-picker__threshold">
            <span>生命值 ≤</span>
            <input type="number" min="1" max="100" value="@_threshold" disabled="@Disabled" @onchange="ChangeThresholdAsync" />
            <span>%</span>
        </label>
    }
    <p class="skill-auto-picker__hint">仅限制自动触发，不改变目标；仍需技能就绪和有效目标。</p>
</div>

@code {
    [Parameter] public string? ConditionOverride { get; set; }
    [Parameter] public string DefaultCondition { get; set; } = "Always";
    [Parameter] public string DefaultLabel { get; set; } = "技能默认";
    [Parameter] public int Threshold { get; set; } = SkillRules.DefaultAutoHpThresholdPercent;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<string?> OnConditionChanged { get; set; }
    [Parameter] public EventCallback<int> OnThresholdChanged { get; set; }
    private string _condition = string.Empty;
    private int _threshold;

    protected override void OnParametersSet()
    {
        _condition = ConditionOverride ?? string.Empty;
        _threshold = Threshold;
    }

    private async Task ChangeConditionAsync(ChangeEventArgs args)
    {
        _condition = args.Value?.ToString() ?? string.Empty;
        await OnConditionChanged.InvokeAsync(SkillAutoRules.Normalize(_condition));
        _condition = ConditionOverride ?? string.Empty;
    }

    private async Task ChangeThresholdAsync(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var threshold))
        {
            _threshold = threshold;
            await OnThresholdChanged.InvokeAsync(threshold);
        }
        _threshold = Threshold;
    }
}
