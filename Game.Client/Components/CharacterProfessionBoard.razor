@using Game.Client.Services
@using Game.Shared.Dtos.Characters
@inject ApiService ApiService

<section class="profession-board" aria-labelledby="profession-board-title">
    <details class="profession-board__rules">
        <summary><h2 id="profession-board-title">职业成长</h2><span>成长规则 ⌄</span></summary>
        <p>各职业独立成长，当前职业获得战斗经验。活动外可免费切换；职业满 30 级后，为该角色解锁一个共享技能。</p>
    </details>

    @if (_loading)
    {
        <GameStateCard Compact="true" Title="正在载入职业" Detail="读取各职业等级与经验…" />
    }
    else if (_progress is null)
    {
        <GameStateCard Compact="true" Tone="error" Icon="!" Title="职业读取失败" Detail="@(_error ?? "请稍后重试。")">
            <Actions><button type="button" @onclick="LoadAsync">重试</button></Actions>
        </GameStateCard>
    }
    else
    {
        @if (!_progress.CanSwitch) { <p class="profession-board__busy">活动结束后可切换职业</p> }
        <div class="profession-board__list">
            @foreach (var profession in _progress.Professions)
            {
                <article class="profession-board__item @(profession.IsActive ? "profession-board__item--active" : null)" @key="profession.Code">
                    <img src="@ProfessionArt.ForCode(profession.Code)" alt="" width="52" height="52" loading="lazy" />
                    <details class="profession-board__content">
                        <summary aria-label="@($"{profession.Name}，展开职业介绍")">
                            <span class="profession-board__title"><strong>@profession.Name</strong>@if (profession.IsActive) { <span>当前</span> }<i aria-hidden="true">⌄</i></span>
                            <span class="profession-board__level"><strong>Lv @profession.Level</strong><span>@(profession.ExperienceToNextLevel is int required ? $"{profession.Experience} / {required}" : "等级已满")</span></span>
                            <progress value="@(profession.ExperienceToNextLevel is null ? 1 : profession.Experience)" max="@(profession.ExperienceToNextLevel ?? 1)" aria-label="@profession.Name 经验值"></progress>
                            @if (profession.IsSharedSkillUnlocked) { <small class="profession-board__shared">共享技能已解锁</small> }
                        </summary>
                        <p>@profession.Description</p>
                    </details>
                    @if (!profession.IsActive)
                    {
                        <button type="button" disabled="@(_saving || !_progress.CanSwitch)" title="@(_progress.CanSwitch ? null : "请先结束当前活动")" @onclick="() => SwitchAsync(profession.Code)">切换</button>
                    }
                </article>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(_error)) { <p class="profession-board__error" role="alert">@FriendlyError(_error)</p> }
    }
</section>

@code {
    [Parameter, EditorRequired] public int CharacterId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private CharacterCombatProfessionsResponse? _progress;
    private bool _loading = true;
    private bool _saving;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var (progress, error) = await ApiService.GetCharacterProfessionsAsync(CharacterId);
            _progress = progress;
            _error = error;
        }
        catch { _error = "连接失败，请稍后重试。"; }
        finally { _loading = false; }
    }

    private async Task SwitchAsync(string professionCode)
    {
        if (_saving || _progress?.CanSwitch != true) return;
        _saving = true;
        _error = null;
        try
        {
            var (progress, error) = await ApiService.SwitchCharacterProfessionAsync(CharacterId, professionCode);
            if (progress is null) { _error = error; return; }
            _progress = progress;
            await OnChanged.InvokeAsync();
        }
        catch { _error = "连接失败，请稍后重试。"; }
        finally { _saving = false; }
    }

    private static string FriendlyError(string error) => error.Trim().Trim('"') switch
    {
        "CharacterBusy" => "请先结束战斗或当前活动。",
        "InvalidProfession" => "职业已不可用，请刷新后重试。",
        "CharacterNotFound" => "角色不存在，请重新选择角色。",
        "NotOwner" => "无法操作该角色。",
        "ConcurrencyConflict" => "角色状态已变化，请重试。",
        _ => error
    };
}
