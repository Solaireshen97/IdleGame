@using Game.Client.Services
@using Game.Shared.Dtos.Characters
@using Microsoft.AspNetCore.Components.Web
@inject ApiService ApiService
@inject IJSRuntime Js
@implements IAsyncDisposable

<section class="talent-board" aria-label="职业天赋">
    @if (_isLoading)
    {
        <GameStateCard Compact="true" Title="正在载入天赋" Detail="同步职业路线与可用点数…" />
    }
    else if (_skills is null)
    {
        <GameStateCard Compact="true" Tone="error" Icon="!" Title="天赋读取失败" Detail="@(_error ?? "暂时无法加载天赋。")">
            <Actions><button type="button" @onclick="LoadAsync">重试</button></Actions>
        </GameStateCard>
    }
    else
    {
        <header class="talent-board__header">
            <div><h2>@_skills.ProfessionName 天赋</h2><small>Lv.@_skills.Level · 已投入 @_skills.TalentNodes.Sum(node => node.Rank) 点</small></div>
            <strong class="talent-board__points">@_skills.TalentPoints <small>可用</small></strong>
            <button id="talent-manage" type="button" @onclick='() => OpenModal("manage")'>@(_skills.CanPromote ? "可转职" : "管理")</button>
        </header>
        <div class="talent-board__guide"><span>点选节点，查看它的前置路线</span><button type="button" disabled="@(!_skills.TalentNodes.Any(node => node.CanUnlock))" @onclick="SelectAvailable">定位可加点</button></div>
        <div class="talent-tree-legend"><span><i class="learned"></i>已学习</span><span><i class="available"></i>可加点</span><span><i class="required"></i>必需</span><span><i class="optional"></i>任选其一</span></div>
        <div class="talent-tree-map" @ref="_mapElement" style="--tree-tiers:@VisibleTierCount" aria-label="@($"{_skills.ProfessionName}天赋，第 {StartTier} 至 {EndTier} 层")">
            <div class="talent-tree-map__canvas">
                <svg class="talent-tree-map__links" viewBox="0 0 300 @(VisibleTierCount * 100)" preserveAspectRatio="none" aria-hidden="true">
                    @if (SelectedNode is { } target && IsVisible(target))
                    {
                        @foreach (var parent in Parents(target).Where(IsVisible))
                        {
                            <path class="@(target.AnyPrerequisites.Contains(parent.Code) ? "optional" : "required")" d="@ConnectionPath(parent, target)" />
                        }
                    }
                </svg>
                <div class="talent-tree-map__grid">
                    @foreach (var node in _skills.TalentNodes.Where(IsVisible).OrderBy(node => node.Tier).ThenBy(node => node.Column))
                    {
                        <button type="button" id="@NodeId(node.Code)" @key="node.Code"
                                class="talent-tree-map__node @NodeClass(node) @RelationClass(node) @(_selectedNodeCode == node.Code ? "selected" : null)"
                                style="grid-row:@(node.Tier - StartTier + 1);grid-column:@node.Column" @onclick="() => SelectNode(node.Code)"
                                aria-pressed="@(_selectedNodeCode == node.Code ? "true" : "false")" aria-label="@node.Name，@BranchName(node.BranchCode)，@node.Rank / @node.MaxRank 级，@Requirement(node)">
                            <span class="talent-tree-map__relation">@RelationLabel(node)</span>
                            <span class="talent-tree-map__icon"><span aria-hidden="true">@if (SkillArt.ForCode(node.SkillCode) is { } art) { <img src="@art" alt="" /> } else { @NodeGlyph(node) }</span><b>@node.Rank/@node.MaxRank</b></span>
                            <strong>@node.Name</strong>
                        </button>
                    }
                </div>
            </div>
            <div class="talent-tree-map__levels" aria-hidden="true">
                @for (var tier = StartTier; tier <= EndTier; tier++)
                {
                    var level = _skills.TalentNodes.Where(node => node.Tier == tier).Select(node => node.RequiredLevel).DefaultIfEmpty(1).Min();
                    <span><b>@tier</b><small>Lv.@level</small></span>
                }
            </div>
        </div>
        <nav class="talent-board__pages" aria-label="天赋层级">
            <button type="button" disabled="@(_tierPage == 0)" @onclick="() => ChangePage(-1)" aria-label="上一组天赋">←</button>
            <span>@(StartTier == EndTier ? $"第 {StartTier} 层" : $"第 {StartTier}–{EndTier} 层") <small>/ 共 @TreeTierCount 层</small></span>
            <button type="button" disabled="@(EndTier >= TreeTierCount)" @onclick="() => ChangePage(1)" aria-label="下一组天赋">→</button>
        </nav>
        @if (SelectedNode is { } selected)
        {
            <div class="talent-selection" aria-live="polite">
                <div class="talent-selection__copy"><strong>@selected.Name <small>@BranchName(selected.BranchCode)</small></strong><span>@Requirement(selected)</span></div>
                <button id="talent-details" type="button" @onclick='() => OpenModal("detail")'>
                    详情
                    @if (HiddenParentCount > 0) { <small>前置跨层</small> }
                </button>
                <button class="talent-spend" type="button" disabled="@(_isSubmitting || !selected.CanUnlock)" @onclick="() => AllocateAsync(selected.Code)">@(_isSubmitting ? "保存中" : selected.IsMaxRank ? "已满级" : "加 1 点")</button>
            </div>
        }
        @if (_error is not null && _modal is null) { <p class="talent-board__error" role="alert">@_error</p> }
        @if (_modal is not null)
        {
            <div class="talent-modal-shade" @onclick="CloseModal"></div>
            <section class="talent-dialog" role="dialog" aria-modal="true" aria-labelledby="talent-dialog-title" tabindex="-1" @ref="_detailElement" @onkeydown="HandleDialogKeyDown" @onkeydown:stopPropagation>
                <header class="talent-dialog__header"><div><small>@(_modal == "detail" ? "天赋详情与前置" : "职业成长")</small><h3 id="talent-dialog-title">@(_modal == "detail" ? SelectedNode?.Name : _skills.AdvancedProfessionName ?? _skills.ProfessionName)</h3></div><button type="button" @onclick="CloseModal" aria-label="关闭天赋面板">×</button></header>
                <div class="talent-dialog__body">
                    @if (_modal == "detail" && SelectedNode is { } detail)
                    {
                        <p>@detail.Description</p>
                        @if (!string.IsNullOrWhiteSpace(detail.SkillName)) { <div class="talent-reward"><strong>解锁技能 · @detail.SkillName</strong><p>@detail.SkillDescription</p></div> }
                        <div class="talent-requirements"><span>等级 <b>Lv.@(detail.RequiredLevel + (detail.IsMaxRank ? 0 : detail.Rank))</b></span><span>基础树投入 <b>@_skills.TalentNodes.Sum(node => node.Rank) / @detail.RequiredTreePoints</b></span><span>节点等级 <b>@detail.Rank / @detail.MaxRank</b></span></div>
                        @if (detail.Prerequisites.Count > 0)
                        {
                            <div class="talent-prerequisites"><h4>必需前置 · 以下全部满级</h4>@foreach (var parent in Parents(detail).Where(node => detail.Prerequisites.Contains(node.Code))) { <button type="button" class="@(parent.IsMaxRank ? "met" : null)" @onclick="() => JumpToParent(parent.Code)"><span>@(parent.IsMaxRank ? "✓" : "○") @parent.Name</span><small>@parent.Rank/@parent.MaxRank · 第 @parent.Tier 层 →</small></button> }</div>
                        }
                        @if (detail.AnyPrerequisites.Count > 0)
                        {
                            <div class="talent-prerequisites optional"><h4>任选前置 · 以下任意一个满级</h4>@foreach (var parent in Parents(detail).Where(node => detail.AnyPrerequisites.Contains(node.Code))) { <button type="button" class="@(parent.IsMaxRank ? "met" : null)" @onclick="() => JumpToParent(parent.Code)"><span>@(parent.IsMaxRank ? "✓" : "○") @parent.Name</span><small>@parent.Rank/@parent.MaxRank · 第 @parent.Tier 层 →</small></button> }</div>
                        }
                        @if (detail.Prerequisites.Count + detail.AnyPrerequisites.Count == 0) { <p class="talent-muted">起始节点，无前置天赋。</p> }
                        @if (detail.ExclusiveGroup is not null) { <p class="talent-exclusive">互斥选择：@PrerequisiteNames(_skills.TalentNodes.Where(node => node.Code != detail.Code && node.ExclusiveGroup == detail.ExclusiveGroup).Select(node => node.Code))。选择后将锁定另一分支。</p> }
                    }
                    else
                    {
                        <p>每次升级获得 1 点天赋点，基础与进阶职业共用。</p>
                        @if (_skills.CanPromote)
                        {
                            <h4>选择进阶职业</h4><p class="talent-muted">转职不消耗天赋点，立即获得进阶基础技能。</p>
                            <div class="promotion-options">@foreach (var option in _skills.PromotionOptions) { <button type="button" disabled="@_isSubmitting" @onclick="() => PromoteAsync(option.Code)"><img src="@ProfessionArt.ForCode(option.Code)" alt="" /><strong>@option.Name</strong><span>@option.Description</span><small>获得：@option.GrantedSkillName</small></button> }</div>
                        }
                        else { <p class="talent-muted">@(_skills.AdvancedProfessionName is null ? "达到 10 级可进行第一次转职。" : "已完成转职。进阶天赋将在等级上限开放到 11 级后加入，当前可继续投入基础天赋。")</p> }
                        <div class="talent-reset"><h4>重置基础天赋</h4><p>返还基础树的全部点数，并卸下由天赋解锁的技能。</p><button type="button" disabled="@(_isSubmitting || !_skills.TalentNodes.Any(node => node.Rank > 0))" @onclick="ResetAsync">重置并返还 @_skills.TalentNodes.Sum(node => node.Rank) 点</button></div>
                    }
                </div>
                <footer class="talent-dialog__footer">
                    @if (_error is not null) { <p class="talent-board__error" role="alert">@_error</p> }
                    @if (_modal == "detail" && SelectedNode is { } current) { <span>@Requirement(current)</span><button class="talent-spend" type="button" disabled="@(_isSubmitting || !current.CanUnlock)" @onclick="() => AllocateAsync(current.Code)">@(_isSubmitting ? "保存中…" : current.IsMaxRank ? "已满级" : $"投入 {current.Cost} 点")</button> }
                    else { <button type="button" @onclick="CloseModal">返回天赋树</button> }
                </footer>
            </section>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public int CharacterId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private CharacterSkillsResponse? _skills;
    private string? _error, _selectedNodeCode, _modal, _returnFocus;
    private bool _isLoading = true, _isSubmitting, _focusDetail, _disposed;
    private ElementReference _mapElement, _detailElement;
    private DotNetObjectReference<CharacterTalentBoard>? _reference;
    private int _tierCapacity = 3, _tierPage;
    private int TreeTierCount => _skills?.TalentNodes.Count > 0 ? _skills.TalentNodes.Max(node => node.Tier) : 1;
    private int StartTier => _tierPage * _tierCapacity + 1;
    private int EndTier => Math.Min(TreeTierCount, StartTier + _tierCapacity - 1);
    private int VisibleTierCount => EndTier - StartTier + 1;
    private SkillTalentNodeResponse? SelectedNode => _skills?.TalentNodes.FirstOrDefault(node => node.Code == _selectedNodeCode);
    private IEnumerable<SkillTalentNodeResponse> Parents(SkillTalentNodeResponse node) => _skills!.TalentNodes.Where(parent => node.Prerequisites.Contains(parent.Code) || node.AnyPrerequisites.Contains(parent.Code));
    private int HiddenParentCount => SelectedNode is { } node ? Parents(node).Count(parent => !IsVisible(parent)) : 0;
    private bool IsVisible(SkillTalentNodeResponse node) => node.Tier >= StartTier && node.Tier <= EndTier;
    private string NodeId(string code) => $"talent-{CharacterId}-{code}";
    protected override Task OnInitializedAsync() => LoadAsync();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (_skills is not null && !_isLoading)
        {
            _reference ??= DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("talentUi.observe", _mapElement, _reference);
        }
        if (_focusDetail) { _focusDetail = false; await Js.InvokeVoidAsync("talentUi.openDialog", _detailElement); }
        if (_returnFocus is { } id) { _returnFocus = null; await Js.InvokeVoidAsync("talentUi.focus", id); }
    }
    [JSInvokable] public Task UpdateTierCapacity(int capacity)
    {
        if (_disposed) return Task.CompletedTask;
        _tierCapacity = Math.Clamp(capacity, 1, TreeTierCount);
        _tierPage = ((SelectedNode?.Tier ?? 1) - 1) / _tierCapacity;
        return InvokeAsync(StateHasChanged);
    }
    private void SelectNode(string code) { _selectedNodeCode = code; }
    private void SelectAvailable()
    {
        var available = _skills!.TalentNodes.Where(node => node.CanUnlock).OrderBy(node => node.Tier).ThenBy(node => node.Column).ToList();
        if (available.Count == 0) return;
        var index = available.FindIndex(node => node.Code == _selectedNodeCode);
        JumpToParent(available[(index + 1) % available.Count].Code);
    }
    private void ChangePage(int delta)
    {
        _tierPage = Math.Clamp(_tierPage + delta, 0, (TreeTierCount - 1) / _tierCapacity);
        _selectedNodeCode = _skills!.TalentNodes.Where(IsVisible).OrderBy(node => node.Tier).ThenBy(node => node.Column).FirstOrDefault()?.Code;
    }
    private void OpenModal(string modal) { _modal = modal; _focusDetail = true; }
    private void CloseModal() { _returnFocus = _modal == "detail" ? "talent-details" : "talent-manage"; _modal = null; _focusDetail = false; }
    private void JumpToParent(string code)
    {
        var parent = _skills!.TalentNodes.First(node => node.Code == code);
        _selectedNodeCode = code; _tierPage = (parent.Tier - 1) / _tierCapacity;
        _modal = null; _focusDetail = false; _returnFocus = NodeId(code);
    }
    private void HandleDialogKeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") CloseModal(); }
    private string RelationLabel(SkillTalentNodeResponse node) => SelectedNode?.Prerequisites.Contains(node.Code) == true ? "必需" : SelectedNode?.AnyPrerequisites.Contains(node.Code) == true ? "任选" : "";
    private string RelationClass(SkillTalentNodeResponse node) => RelationLabel(node) switch { "必需" => "prerequisite required", "任选" => "prerequisite optional", _ => "" };
    private static string NodeClass(SkillTalentNodeResponse node) => node.IsMaxRank ? "complete" : node.CanUnlock ? "available" : node.Rank > 0 ? "learned" : "locked";
    private string PrerequisiteNames(IEnumerable<string> codes) => string.Join("、", codes.Select(code => _skills?.TalentNodes.FirstOrDefault(node => node.Code == code)?.Name ?? code));
    // Route cross-tier links through column gutters so they never run through intermediate nodes.
    private string ConnectionPath(SkillTalentNodeResponse parent, SkillTalentNodeResponse child)
    {
        var alternate = child.AnyPrerequisites.Contains(parent.Code);
        var x1 = (parent.Column - 1) * 100 + 50;
        var x2 = (child.Column - 1) * 100 + (alternate ? 54 : 46);
        var y1 = (parent.Tier - StartTier) * 100 + 83;
        var y2 = (child.Tier - StartTier) * 100 + 12;
        if (child.Tier == parent.Tier + 1) return $"M {x1} {y1} V {y1 + 10} H {x2} V {y2}";
        var gutter = parent.Column == 3 ? (alternate ? 297 : 293) : parent.Column * 100 + (alternate ? 3 : -3);
        return $"M {x1} {y1} V {y1 + 8} H {gutter} V {y2 - (alternate ? 5 : 9)} H {x2} V {y2}";
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try { await Js.InvokeVoidAsync("talentUi.disconnect", _mapElement); } catch (JSDisconnectedException) { }
        _reference?.Dispose();
    }
    private async Task LoadAsync()
    {
        _isLoading = true; _error = null;
        try
        {
            var (skills, error) = await ApiService.GetCharacterSkillsAsync(CharacterId);
            _skills = skills;
            _error = GetError(error);
            _selectedNodeCode = skills?.TalentNodes.FirstOrDefault(node => node.CanUnlock)?.Code ?? skills?.TalentNodes.FirstOrDefault()?.Code;
        }
        catch { _skills = null; _error = "连接失败，请稍后重试。"; }
        finally { _isLoading = false; }
    }
    private Task AllocateAsync(string code) => ChangeAsync(() => ApiService.UnlockSkillTalentAsync(CharacterId, code));
    private Task ResetAsync() => ChangeAsync(() => ApiService.ResetSkillTalentsAsync(CharacterId));
    private Task PromoteAsync(string code) => ChangeAsync(() => ApiService.PromoteCharacterAsync(CharacterId, code));
    private async Task ChangeAsync(Func<Task<(CharacterSkillsResponse? Response, string? ErrorMessage)>> action)
    {
        if (_isSubmitting) return;
        _isSubmitting = true; _error = null;
        try
        {
            var (response, error) = await action();
            if (error is not null) { _error = GetError(error); return; }
            if (response is null) { _error = "未能读取更新后的天赋，请稍后重试。"; return; }
            _skills = response;
            if (_skills is not null && !_skills.TalentNodes.Any(node => node.Code == _selectedNodeCode))
                _selectedNodeCode = _skills.TalentNodes.FirstOrDefault(node => node.CanUnlock)?.Code ?? _skills.TalentNodes.FirstOrDefault()?.Code;
            if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
        }
        catch { _error = "连接失败，请稍后重试。"; }
        finally { _isSubmitting = false; }
    }
    private static string NodeGlyph(SkillTalentNodeResponse node) => node.BranchCode switch
    {
        "assault" => "⚔", "guard" => "⬡", "tempo" => "↯",
        "judgment" => "✥", "mercy" => "✚",
        "arcane" => "✦", "control" => "◇", "frost" => "❄",
        "precision" => "◎", "survival" => "➶", "endurance" => "♧",
        "assassination" => "✢", "subtlety" => "◈", "evasion" => "◌", _ => "✦"
    };
    private string Requirement(SkillTalentNodeResponse node)
    {
        if (node.IsMaxRank) return "已完成";
        if (_skills!.Level < node.RequiredLevel + node.Rank) return $"需要 Lv {node.RequiredLevel + node.Rank}";
        if (_skills.TalentNodes.Sum(talent => talent.Rank) < node.RequiredTreePoints)
            return $"需要在基础树已投入 {node.RequiredTreePoints} 点";
        if (!node.ArePrerequisitesMet) return node.Prerequisites.Count == 0 ? "任选前置需有一个满级" : node.AnyPrerequisites.Count > 0 ? "必需前置满级，且任选一个前置满级" : "必需前置需全部满级";
        if (node.ExclusiveGroup is not null && _skills.TalentNodes.Any(other =>
                other.Code != node.Code && other.ExclusiveGroup == node.ExclusiveGroup && other.Rank > 0))
            return "与已选择的天赋互斥";
        if (_skills.TalentPoints < node.Cost) return "天赋点不足";
        return node.ExclusiveGroup is null ? "可以投入" : "选择后锁定另一分支";
    }
    private static string BranchName(string code) => code switch
    {
        "shared" => "基础", "assault" => "猛攻", "guard" => "稳守", "tempo" => "战术",
        "judgment" => "惩戒", "mercy" => "慈悲",
        "arcane" => "奥术", "control" => "控场", "frost" => "寒霜",
        "precision" => "狙猎", "survival" => "游猎", "endurance" => "生存",
        "assassination" => "刺杀", "subtlety" => "诡道", "evasion" => "脱身", _ => code
    };
    private static string? GetError(string? error) => error?.Trim().Trim('"') switch
    {
        null or "" => null,
        "InsufficientTalentPoints" => "天赋点不足。",
        "SkillTalentPrerequisiteRequired" => "请先完成必需前置，并满足任一可选前置节点。",
        "SkillTalentTreePointsRequired" => "基础树已投入的天赋点不足。",
        "SkillTalentLevelRequired" => "角色等级尚未达到要求。",
        "SkillTalentBranchLocked" => "已经选择了互斥的另一条路线。",
        "SkillTalentMaxRank" => "该节点已满级。",
        "PromotionLevelRequired" => "达到 10 级后才能转职。",
        "AlreadyPromoted" => "该角色已经完成转职。",
        "InvalidPromotion" => "该转职路线不可用。",
        "LoadoutLocked" => "战斗进行时不能修改职业天赋或转职。",
        "ConcurrencyConflict" => "角色数据已变化，请刷新后重试。",
        _ => "职业操作失败，请稍后重试。"
    };
}
