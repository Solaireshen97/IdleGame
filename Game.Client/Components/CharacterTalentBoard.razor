@using Game.Client.Services
@using Game.Shared.Dtos.Characters
@using Microsoft.AspNetCore.Components.Web
@inject ApiService ApiService

<section class="talent-board" aria-labelledby="talent-title">
    <header class="talent-board__header">
        <div>
            <span class="talent-board__eyebrow">CLASS TALENTS</span>
            <h2 id="talent-title">@(_skills is null ? "职业天赋" : $"{_skills.ProfessionName} · 职业天赋")</h2>
            <p>关键天赋决定战斗方式，成长节点负责补强路线。</p>
        </div>
    </header>

    @if (_isLoading)
    {
        <GameStateCard Compact="true" Title="正在载入天赋" Detail="同步职业路线与可用点数…" />
    }
    else if (_skills is null)
    {
        <GameStateCard Compact="true" Tone="error" Icon="!" Title="天赋读取失败" Detail="@(_error ?? "暂时无法加载天赋。")">
            <Actions><button class="talent-board__retry" type="button" @onclick="LoadAsync">重试</button></Actions>
        </GameStateCard>
    }
    else
    {
        <div class="talent-board__summary">
            <div class="talent-board__points"><span>Lv @_skills.Level</span><strong>@_skills.TalentPoints</strong><small>可用天赋点</small></div>
            <span class="talent-board__portrait" aria-hidden="true"><img src="@ProfessionArt.ForCode(_skills.AdvancedProfessionCode ?? _skills.ProfessionCode)" alt="" /></span>
            <div class="talent-board__identity">
                <small>当前职业</small><strong>@(_skills.AdvancedProfessionName ?? _skills.ProfessionName)</strong>
                <span>每次升级获得 1 点，基础与进阶职业共用。</span>
            </div>
        </div>

        <nav class="talent-board__tree-tabs" aria-label="职业天赋树">
            <button type="button" class="@BaseTabClass" @onclick="ShowBaseTree">@_skills.ProfessionName 天赋</button>
            @if (_skills.AdvancedProfessionName is not null)
            {
                <button type="button" class="@AdvancedTabClass" @onclick="ShowAdvancedTree">@_skills.AdvancedProfessionName 天赋</button>
            }
        </nav>

        @if (_activeTree == "advanced" && _skills.AdvancedProfessionName is not null)
        {
            <div class="talent-board__future">
                <strong>@_skills.AdvancedProfessionName 天赋树</strong>
                <p>转职基础技能已解锁。进阶天赋将在等级上限开放到 11 级后加入；后续获得的点数仍可用于 @_skills.ProfessionName 天赋。</p>
            </div>
        }
        else
        {
            <div class="talent-tree-legend" aria-label="节点与路线说明"><span><i class="talent-tree-legend__available"></i> 可加点</span><span><i class="talent-tree-legend__learned"></i> 已学习</span><span><i class="talent-tree-legend__locked"></i> 未解锁</span><span><i class="talent-tree-legend__route"></i> 必需路线</span><span><i class="talent-tree-legend__alternate"></i> 任选路线</span></div>
            <div class="talent-tree-layout">
                <div class="talent-tree-map" aria-label="@_skills.ProfessionName 天赋树，点击节点查看详情" style="--tree-tiers:@TreeTierCount">
                    <svg class="talent-tree-map__links" viewBox="0 0 300 @(TreeTierCount * 100)" preserveAspectRatio="none" aria-hidden="true">
                        @foreach (var node in _skills.TalentNodes)
                        {
                            @foreach (var prerequisite in node.Prerequisites)
                            {
                                var parent = _skills.TalentNodes.FirstOrDefault(candidate => candidate.Code == prerequisite);
                                if (parent is not null)
                                {
                                    <path class="@ConnectionClass(parent, false)" d="@ConnectionPath(parent, node)" />
                                }
                            }
                            @foreach (var prerequisite in node.AnyPrerequisites)
                            {
                                var parent = _skills.TalentNodes.FirstOrDefault(candidate => candidate.Code == prerequisite);
                                if (parent is not null)
                                {
                                    <path class="@ConnectionClass(parent, true)" d="@ConnectionPath(parent, node)" />
                                }
                            }
                        }
                    </svg>
                    <div class="talent-tree-map__grid">
                        @foreach (var tier in _skills.TalentNodes.GroupBy(node => node.Tier).OrderBy(group => group.Key))
                        {
                            <span class="talent-tree-map__level" style="grid-row:@tier.Key">Lv @tier.Min(node => node.RequiredLevel)</span>
                        }
                        @foreach (var node in _skills.TalentNodes.OrderBy(node => node.Tier).ThenBy(node => node.Column))
                        {
                            <button type="button" class="talent-tree-map__node @NodeClass(node) @(_selectedNodeCode == node.Code ? "talent-tree-map__node--selected" : null)"
                                    style="grid-row:@node.Tier;grid-column:@node.Column" @key="node.Code" @onclick="() => SelectNode(node.Code)"
                                    aria-pressed="@(_selectedNodeCode == node.Code)" aria-label="@node.Name，@BranchName(node.BranchCode)，@node.Rank / @node.MaxRank 级，@Requirement(node)">
                                <span class="talent-tree-map__icon"><span aria-hidden="true">@if (SkillArt.ForCode(node.SkillCode) is { } skillArt) { <img src="@skillArt" alt="" loading="lazy" /> } else { @NodeGlyph(node) }</span><b>@node.Rank/@node.MaxRank</b></span>
                                <strong>@node.Name</strong>
                            </button>
                        }
                    </div>
                </div>
                @if (SelectedNode is { } selected)
                {
                    <div class="talent-tree-detail-shade @(_detailOpen ? "talent-tree-detail-shade--open" : null)" @onclick="CloseNodeDetails"></div>
                    <section class="talent-tree-detail @(_detailOpen ? "talent-tree-detail--open" : null)" role="@(_detailOpen ? "dialog" : "region")" aria-modal="@(_detailOpen ? "true" : null)" aria-label="@selected.Name 详情"
                             tabindex="-1" @ref="_detailElement" @onkeydown="HandleDetailKeyDown" @onkeydown:stopPropagation>
                        <header class="talent-tree-detail__header">
                            <span class="talent-tree-detail__icon" aria-hidden="true">@if (SkillArt.ForCode(selected.SkillCode) is { } selectedSkillArt) { <img src="@selectedSkillArt" alt="" /> } else { @NodeGlyph(selected) }</span>
                            <div><small>@BranchName(selected.BranchCode) · 第 @selected.Tier 层</small><h3>@selected.Name</h3><span>等级 @selected.Rank / @selected.MaxRank</span></div>
                            <button type="button" class="talent-tree-detail__close" @onclick="CloseNodeDetails" aria-label="关闭天赋详情">×</button>
                        </header>
                        <div class="talent-tree-detail__body">
                            <p>@selected.Description</p>
                            @if (!string.IsNullOrWhiteSpace(selected.SkillName))
                            {
                                <div class="talent-skill__reward"><strong>解锁技能 · @selected.SkillName</strong><small>@selected.SkillDescription</small></div>
                            }
                            <div class="talent-tree-detail__pips" aria-label="已投入 @selected.Rank / @selected.MaxRank 点">
                                @for (var index = 0; index < selected.MaxRank; index++)
                                {
                                    <span class="@(index < selected.Rank ? "talent-tree-detail__pip--active" : null)"></span>
                                }
                            </div>
                            @if (selected.Prerequisites.Count > 0)
                            {
                                <small class="talent-tree-detail__prerequisite">必需前置：@PrerequisiteNames(selected.Prerequisites)</small>
                            }
                            @if (selected.AnyPrerequisites.Count > 0)
                            {
                                <small class="talent-tree-detail__prerequisite talent-tree-detail__prerequisite--alternate">任选前置：@PrerequisiteNames(selected.AnyPrerequisites)</small>
                            }
                            @if (selected.RequiredTreePoints > 0)
                            {
                                <small class="talent-tree-detail__prerequisite">基础树需投入 @selected.RequiredTreePoints 点</small>
                            }
                            <small class="talent-tree-detail__requirement">@Requirement(selected)</small>
                        </div>
                        <button type="button" class="talent-tree-detail__spend" disabled="@(_isSubmitting || !selected.CanUnlock)" @onclick="() => AllocateAsync(selected.Code)">
                            @(selected.IsMaxRank ? "已满级" : selected.CanUnlock ? "投入 1 点" : "暂不可加点")
                        </button>
                    </section>
                }
            </div>
        }

        @if (_skills.CanPromote)
        {
            <section class="promotion-panel">
                <div><span>LEVEL 10 · CLASS CHANGE</span><h3>选择进阶职业</h3><p>转职不消耗天赋点，并立即授予进阶职业基础技能。</p></div>
                <div class="promotion-panel__options">
                    @foreach (var option in _skills.PromotionOptions)
                    {
                        <button type="button" disabled="@_isSubmitting" @onclick="() => PromoteAsync(option.Code)">
                            <img class="promotion-panel__portrait" src="@ProfessionArt.ForCode(option.Code)" alt="" />
                            <strong>@option.Name</strong><span>@option.Description</span><small>获得技能：@option.GrantedSkillName</small>
                        </button>
                    }
                </div>
            </section>
        }
        else if (_skills.Level < 10)
        {
            <p class="promotion-hint">达到 10 级后可进行第一次转职。</p>
        }

        @if (!string.IsNullOrEmpty(_error)) { <p class="talent-board__error" role="alert">@_error</p> }
        @if (_skills.TalentNodes.Any(node => node.Rank > 0))
        {
            <footer class="talent-board__footer">
                <span>重置会返还基础职业树中投入的全部点数，并卸下由天赋解锁的技能。</span>
                <button type="button" disabled="@_isSubmitting" @onclick="ResetAsync">重置基础天赋</button>
            </footer>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public int CharacterId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    private CharacterSkillsResponse? _skills;
    private string? _error;
    private bool _isLoading = true;
    private bool _isSubmitting;
    private string _activeTree = "base";
    private string? _selectedNodeCode;
    private bool _detailOpen;
    private bool _focusDetail;
    private ElementReference _detailElement;
    private int TreeTierCount => _skills?.TalentNodes.Count > 0 ? _skills.TalentNodes.Max(node => node.Tier) : 1;
    private SkillTalentNodeResponse? SelectedNode => _skills?.TalentNodes.FirstOrDefault(node => node.Code == _selectedNodeCode);
    private string? BaseTabClass => _activeTree == "base" ? "active" : null;
    private string? AdvancedTabClass => _activeTree == "advanced" ? "active" : null;
    private void ShowBaseTree() => _activeTree = "base";
    private void ShowAdvancedTree() => _activeTree = "advanced";

    protected override Task OnInitializedAsync() => LoadAsync();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusDetail)
        {
            _focusDetail = false;
            await _detailElement.FocusAsync();
        }
    }
    private async Task LoadAsync()
    {
        _isLoading = true; _error = null;
        try
        {
            var (skills, error) = await ApiService.GetCharacterSkillsAsync(CharacterId);
            _skills = skills;
            _error = GetError(error);
            _selectedNodeCode = skills?.TalentNodes.FirstOrDefault(node => node.CanUnlock)?.Code ?? skills?.TalentNodes.FirstOrDefault()?.Code;
        }
        catch { _skills = null; _error = "连接失败，请稍后重试。"; }
        finally { _isLoading = false; }
    }
    private Task AllocateAsync(string code) => ChangeAsync(() => ApiService.UnlockSkillTalentAsync(CharacterId, code));
    private Task ResetAsync() => ChangeAsync(() => ApiService.ResetSkillTalentsAsync(CharacterId));
    private Task PromoteAsync(string code) => ChangeAsync(() => ApiService.PromoteCharacterAsync(CharacterId, code));
    private async Task ChangeAsync(Func<Task<(CharacterSkillsResponse? Response, string? ErrorMessage)>> action)
    {
        if (_isSubmitting) return;
        _isSubmitting = true; _error = null;
        try
        {
            var (response, error) = await action();
            if (error is not null) { _error = GetError(error); return; }
            _skills = response;
            if (_skills is not null && !_skills.TalentNodes.Any(node => node.Code == _selectedNodeCode))
                _selectedNodeCode = _skills.TalentNodes.FirstOrDefault(node => node.CanUnlock)?.Code ?? _skills.TalentNodes.FirstOrDefault()?.Code;
            if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
        }
        catch { _error = "连接失败，请稍后重试。"; }
        finally { _isSubmitting = false; }
    }
    private static string NodeClass(SkillTalentNodeResponse node) => node.IsMaxRank ? "talent-node--complete" : node.CanUnlock ? "talent-node--available" : node.Rank > 0 ? "talent-node--active" : "talent-node--locked";
    private void SelectNode(string code) { _selectedNodeCode = code; _detailOpen = true; _focusDetail = true; }
    private void CloseNodeDetails() { _detailOpen = false; _focusDetail = false; }
    private void HandleDetailKeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") CloseNodeDetails(); }
    private string PrerequisiteNames(IEnumerable<string> codes) => string.Join("、", codes.Select(code => _skills?.TalentNodes.FirstOrDefault(candidate => candidate.Code == code)?.Name ?? code));
    private static string NodeGlyph(SkillTalentNodeResponse node) => node.BranchCode switch
    {
        "assault" => "⚔", "guard" => "⬡", "tempo" => "↯",
        "judgment" => "✥", "mercy" => "✚",
        "arcane" => "✦", "control" => "◇", "frost" => "❄",
        "precision" => "◎", "survival" => "➶", "endurance" => "♧",
        "assassination" => "✢", "subtlety" => "◈", "evasion" => "◌", _ => "✦"
    };
    private static string ConnectionClass(SkillTalentNodeResponse parent, bool alternate) =>
        $"{(alternate ? "talent-tree-map__link--alternate" : "talent-tree-map__link--primary")} {(parent.IsMaxRank ? "talent-tree-map__link--active" : null)}";
    private static string ConnectionPath(SkillTalentNodeResponse parent, SkillTalentNodeResponse child)
    {
        var fromX = (parent.Column - 1) * 100 + 50;
        var toX = (child.Column - 1) * 100 + 50;
        var fromY = (parent.Tier - 1) * 100 + 73;
        var toY = (child.Tier - 1) * 100 + 27;
        var middleY = (fromY + toY) / 2;
        return $"M {fromX} {fromY} V {middleY} H {toX} V {toY}";
    }
    private string Requirement(SkillTalentNodeResponse node)
    {
        if (node.IsMaxRank) return "已完成";
        if (_skills!.Level < node.RequiredLevel + node.Rank) return $"需要 Lv {node.RequiredLevel + node.Rank}";
        if (_skills.TalentNodes.Sum(talent => talent.Rank) < node.RequiredTreePoints)
            return $"需要在基础树已投入 {node.RequiredTreePoints} 点";
        if (!node.ArePrerequisitesMet) return node.AnyPrerequisites.Count > 0 ? "需要完成必需前置，并满足任一可选前置" : "需要完成必需前置";
        if (node.ExclusiveGroup is not null && _skills.TalentNodes.Any(other =>
                other.Code != node.Code && other.ExclusiveGroup == node.ExclusiveGroup && other.Rank > 0))
            return "与已选择的天赋互斥";
        if (_skills.TalentPoints < node.Cost) return "天赋点不足";
        return node.ExclusiveGroup is null ? "可以投入" : "选择后锁定另一分支";
    }
    private static string BranchName(string code) => code switch
    {
        "shared" => "基础", "assault" => "猛攻", "guard" => "稳守", "tempo" => "战术",
        "judgment" => "惩戒", "mercy" => "慈悲",
        "arcane" => "奥术", "control" => "控场", "frost" => "寒霜",
        "precision" => "狙猎", "survival" => "游猎", "endurance" => "生存",
        "assassination" => "刺杀", "subtlety" => "诡道", "evasion" => "脱身", _ => code
    };
    private static string? GetError(string? error) => error?.Trim().Trim('"') switch
    {
        null or "" => null,
        "InsufficientTalentPoints" => "天赋点不足。",
        "SkillTalentPrerequisiteRequired" => "请先完成必需前置，并满足任一可选前置节点。",
        "SkillTalentTreePointsRequired" => "基础树已投入的天赋点不足。",
        "SkillTalentLevelRequired" => "角色等级尚未达到要求。",
        "SkillTalentBranchLocked" => "已经选择了互斥的另一条路线。",
        "SkillTalentMaxRank" => "该节点已满级。",
        "PromotionLevelRequired" => "达到 10 级后才能转职。",
        "AlreadyPromoted" => "该角色已经完成转职。",
        "InvalidPromotion" => "该转职路线不可用。",
        "LoadoutLocked" => "战斗进行时不能修改职业天赋或转职。",
        "ConcurrencyConflict" => "角色数据已变化，请刷新后重试。",
        _ => "职业操作失败，请稍后重试。"
    };
}
