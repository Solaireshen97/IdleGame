@using Game.Client.Services
@using Game.Shared.Dtos.Characters
@using Game.Shared.Enums
@inject ApiService ApiService

<section class="talent-board" aria-labelledby="talent-title">
    <header class="talent-board__header">
        <div>
            <span class="talent-board__eyebrow">CLASS TALENTS</span>
            <h2 id="talent-title">@(_talents is null ? "职业天赋" : $"{_talents.Name} · 职业天赋")</h2>
            <p>从攻击、防御、生命出发，提升属性并沿路线学习职业技能。</p>
        </div>
    </header>

    @if (_isLoading)
    {
        <p class="talent-board__loading">天赋加载中...</p>
    }
    else if (_talents is null || _skills is null)
    {
        <p class="talent-board__error" role="alert">@(_error ?? "暂时无法加载天赋。")</p>
        <button class="talent-board__retry" type="button" @onclick="LoadAsync">重试</button>
    }
    else
    {
        <div class="talent-board__summary">
            <div class="talent-board__points"><span>Lv @_talents.Level</span><strong>@_talents.TalentPoints</strong><small>可用天赋点</small></div>
            <dl class="talent-board__stats">
                <div><dt>攻击</dt><dd>@_talents.Attack</dd></div>
                <div><dt>防御</dt><dd>@_talents.Defense</dd></div>
                <div><dt>生命</dt><dd>@_talents.Hp / @_talents.MaxHp</dd></div>
            </dl>
        </div>

        <div class="talent-board__branches" aria-label="职业天赋树">
            @foreach (var node in _talents.Talents)
            {
                <section class="talent-branch" aria-label="@GetName(node.Type)路线" @key="node.Type">
                    <div class="talent-branch__heading"><span class="talent-node__icon" aria-hidden="true">@GetIcon(node.Type)</span><strong>@GetName(node.Type)路线</strong></div>
                    <article class="talent-node">
                        <div class="talent-node__top"><span>基础属性</span><span class="talent-node__rank">@node.Rank / @node.MaxRank</span></div>
                        <h3>@GetName(node.Type)</h3>
                        <p>@GetDescription(node)</p>
                        <div class="talent-node__pips" aria-label="已点 @node.Rank 级，共 @node.MaxRank 级">
                            @for (var i = 0; i < node.MaxRank; i++)
                            {
                                <span class="@(i < node.Rank ? "talent-node__pip--active" : string.Empty)"></span>
                            }
                        </div>
                        <div class="talent-node__bottom">
                            <span>@(node.NextRankCost is null ? "已满级" : $"下一级 · {node.NextRankCost} 点")</span>
                            <button type="button" disabled="@(_isSubmitting || node.NextRankCost is null || _talents.TalentPoints < node.NextRankCost)"
                                    @onclick="() => AllocateAsync(node.Type)">@(node.NextRankCost is null ? "已满级" : "加点 +")</button>
                        </div>
                    </article>
                    @foreach (var skill in _skills.TalentNodes.Where(skill => skill.RequiredTalentType == node.Type).OrderBy(skill => skill.Tier))
                    {
                        <div class="talent-branch__link @(skill.ArePrerequisitesMet || skill.IsUnlocked ? "talent-branch__link--active" : string.Empty)" aria-hidden="true"></div>
                        <article class="talent-skill @(skill.IsUnlocked ? "talent-skill--unlocked" : skill.CanUnlock ? "talent-skill--available" : "talent-skill--locked")" @key="skill.Code">
                            <div class="talent-skill__top"><span>职业技能 · @skill.Cost 点</span><strong>@(skill.IsUnlocked ? "已学会" : skill.CanUnlock ? "可点亮" : "未解锁")</strong></div>
                            <h3>@skill.Name</h3>
                            <p>@skill.Description</p>
                            <div class="talent-skill__reward"><strong>@skill.SkillName</strong><small>@skill.SkillDescription</small></div>
                            <small class="talent-skill__requirement">前置：@GetRequirement(skill)</small>
                            <button type="button" disabled="@(_isSubmitting || !skill.CanUnlock)" @onclick="() => UnlockAsync(skill.Code)">
                                @(skill.IsUnlocked ? "已学会" : !skill.ArePrerequisitesMet ? "需要前置" : _talents.TalentPoints < skill.Cost ? "点数不足" : "点亮技能")
                            </button>
                        </article>
                    }
                </section>
            }
        </div>

        @if (!string.IsNullOrEmpty(_error)) { <p class="talent-board__error" role="alert">@_error</p> }
        <footer class="talent-board__footer">
            <span>重置会返还这张树的全部点数，并卸下通过天赋学会的技能。生命加点不会立即恢复当前 HP。</span>
            <button type="button" disabled="@(_isSubmitting || !_talents.Talents.Any(node => node.Rank > 0) && !_skills.TalentNodes.Any(node => node.IsUnlocked))"
                    @onclick="ResetAsync">重置职业天赋</button>
        </footer>
    }
</section>

@code {
    [Parameter, EditorRequired] public int CharacterId { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private CharacterTalentsResponse? _talents;
    private CharacterSkillsResponse? _skills;
    private string? _error;
    private bool _isLoading = true;
    private bool _isSubmitting;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            var talentsTask = ApiService.GetCharacterTalentsAsync(CharacterId);
            var skillsTask = ApiService.GetCharacterSkillsAsync(CharacterId);
            await Task.WhenAll(talentsTask, skillsTask);
            var (talents, talentError) = await talentsTask;
            var (skills, skillError) = await skillsTask;
            _talents = talents;
            _skills = skills;
            _error = GetError(talentError ?? skillError);
        }
        catch
        {
            _talents = null;
            _skills = null;
            _error = "连接失败，请稍后重试。";
        }
        finally { _isLoading = false; }
    }

    private Task AllocateAsync(TalentType type) => ChangeAsync(async () =>
    {
        var (_, error) = await ApiService.AllocateTalentAsync(CharacterId, type);
        return error;
    });

    private Task UnlockAsync(string code) => ChangeAsync(async () =>
    {
        var (_, error) = await ApiService.UnlockSkillTalentAsync(CharacterId, code);
        return error;
    });

    private Task ResetAsync() => ChangeAsync(async () =>
    {
        var (_, error) = await ApiService.ResetTalentsAsync(CharacterId);
        return error;
    });

    private async Task ChangeAsync(Func<Task<string?>> action)
    {
        if (_isSubmitting || _talents is null || _skills is null) return;
        _isSubmitting = true;
        _error = null;
        try
        {
            var error = await action();
            if (error is not null) { _error = GetError(error); return; }
            if (OnChanged.HasDelegate) await OnChanged.InvokeAsync();
            else await LoadAsync();
        }
        catch { _error = "连接失败，请稍后重试。"; }
        finally { _isSubmitting = false; }
    }

    private string GetRequirement(SkillTalentNodeResponse skill)
    {
        var requirements = new List<string> { $"{GetName(skill.RequiredTalentType)} {skill.RequiredTalentRank} 级" };
        requirements.AddRange(skill.Prerequisites.Select(code => _skills?.TalentNodes.FirstOrDefault(node => node.Code == code)?.Name ?? code));
        return string.Join("、", requirements);
    }

    private static string GetName(TalentType type) => type switch
    {
        TalentType.Attack => "攻击", TalentType.Defense => "防御", TalentType.Health => "生命", _ => "未知"
    };
    private static string GetIcon(TalentType type) => type switch
    {
        TalentType.Attack => "⚔", TalentType.Defense => "◈", TalentType.Health => "✚", _ => "•"
    };
    private static string GetDescription(TalentNodeResponse node) => node.Type switch
    {
        TalentType.Attack => $"每级攻击 +{node.BonusPerRank}",
        TalentType.Defense => $"每级防御 +{node.BonusPerRank}",
        TalentType.Health => $"每级最大 HP +{node.BonusPerRank}",
        _ => string.Empty
    };
    private static string? GetError(string? error) => error?.Trim().Trim('"') switch
    {
        null or "" => null,
        "Not enough talent points." or "InsufficientTalentPoints" => "天赋点不足。",
        "Talent is already at maximum rank." => "该属性天赋已满级。",
        "SkillTalentPrerequisiteRequired" => "请先点亮所需的属性等级和前置技能。",
        "SkillTalentAlreadyUnlocked" => "该技能已学会，请刷新页面。",
        "LoadoutLocked" => "战斗进行时不能修改职业天赋。",
        "Character changed. Please refresh and try again." or "ConcurrencyConflict" => "角色数据已变化，请刷新页面后重试。",
        "Character not found." or "CharacterNotFound" => "角色不存在。",
        "Character does not belong to current user." or "NotOwner" => "该角色不属于当前用户。",
        _ => "天赋操作失败，请稍后重试。"
    };
}
