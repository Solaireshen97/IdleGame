@using Game.Client.Services
@using Game.Shared
@using Game.Shared.Dtos.Characters
@inject ApiService ApiService
@implements IDisposable

<section class="soul-board" aria-label="魂印配置">
    <header class="soul-board__header"><h2>魂印配装</h2><a href="/inventory?characterId=@CharacterId&amp;category=souls">魂印仓库 ↗</a></header>
    @if (_loading && _response is null)
    {
        <GameStateCard Compact="true" Title="正在读取魂印" Detail="准备角色的魂印配装…" />
    }
    else if (_response is null)
    {
        <GameStateCard Compact="true" Tone="error" Icon="!" Title="魂印读取失败" Detail="@(_notice ?? "请稍后重试。")"><Actions><button type="button" @onclick="RefreshAsync">重新读取</button></Actions></GameStateCard>
    }
    else
    {
        var equipped = _response.SoulImprints.FirstOrDefault(item => item.IsEquipped);
        <div class="soul-board__slot @(equipped is null ? "soul-board__slot--empty" : null)">
            <span class="soul-board__sigil" aria-hidden="true">@if (equipped is not null && ItemArt.ForCode(equipped.Code) is { } art) { <img src="@art" alt="" /> } else { <text>◇</text> }</span>
            <details class="soul-board__effect">
                <summary><small>当前装备 · 效果 ⌄</small><strong>@(equipped?.Name ?? "未装备魂印")</strong></summary>
                <p>@(equipped?.Description ?? "选择魂印后，其能力会出现在战斗操作区。")</p>
                @if (equipped is not null) { <p>初始冷却 @equipped.InitialCooldownRounds 回合 · 使用冷却 @equipped.CooldownRounds 回合</p> }
            </details>
            @if (equipped is not null) { <button type="button" disabled="@_busy" @onclick="() => SetEquippedAsync(null)">卸下</button> }
        </div>
        <InventoryItemPicker @ref="_picker" Options="@SoulOptions" Value="@(equipped?.Id.ToString())" OnPick="PickAsync" Title="选择并装备魂印" Hint="选择后立即更新当前角色魂印；角色入场时无法更换。" EmptyLabel="不装备魂印" Disabled="@_busy" WarehouseRoute="@($"/inventory?characterId={CharacterId}&category=souls")" />
        @if (equipped is not null)
        {
            <details class="soul-board__strategy">
                <summary>自动释放 <span>@(equipped.AutoUseEnabled ? "已开启" : "已关闭") ⌄</span></summary>
                <label><input type="checkbox" checked="@equipped.AutoUseEnabled" disabled="@_busy" @onchange="args => SaveAutoAsync(equipped, args.Value is true, equipped.AutoConditionOverride, equipped.AutoHpThresholdPercent)" /> 自动使用魂印</label>
                <SkillAutoConditionPicker ConditionOverride="@equipped.AutoConditionOverride" DefaultCondition="@equipped.DefaultAutoCondition" DefaultLabel="魂印默认" Threshold="@equipped.AutoHpThresholdPercent" Disabled="@_busy" OnConditionChanged="condition => SaveAutoAsync(equipped, equipped.AutoUseEnabled, condition, equipped.AutoHpThresholdPercent)" OnThresholdChanged="threshold => SaveAutoAsync(equipped, equipped.AutoUseEnabled, equipped.AutoConditionOverride, threshold)" />
            </details>
        }
    }
    @if (_notice is not null) { <p class="soul-board__notice" role="status">@_notice</p> }
</section>

@code {
    [Parameter, EditorRequired] public int CharacterId { get; set; }
    [Parameter] public int? InitialSoulId { get; set; }
    private CharacterSoulImprintsResponse? _response;
    private bool _loading = true, _busy, _disposed;
    private long _generation;
    private string? _notice;
    private InventoryItemPicker? _picker;
    private bool _initialLocated;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_initialLocated && InitialSoulId is int id && _picker is not null && _response?.SoulImprints.FirstOrDefault(item => item.Id == id) is { } soul) { _initialLocated = true; await _picker.ShowAsync(soul.Name); }
    }
    private IReadOnlyList<InventoryItemPicker.Option> SoulOptions => (_response?.SoulImprints ?? []).Select(item => new InventoryItemPicker.Option(item.Id.ToString(), item.Name, $"T{item.Tier} · {WeaponRules.ElementName(item.Element)} · #{item.Id}", ItemArt.ForCode(item.Code))).ToList();
    protected override async Task OnInitializedAsync() { ApiService.InventoryChanged += InventoryChanged; await LoadAsync(); }
    private void InventoryChanged(int id) { if (id == CharacterId && !_busy && !_disposed) _ = InvokeAsync(RefreshAsync); }
    private Task LoadAsync() => ReadAsync(false);
    private Task RefreshAsync() => ReadAsync(true);
    private async Task ReadAsync(bool forceRefresh)
    {
        var generation = ++_generation; var characterId = CharacterId; _loading = true;
        try { var (response, error) = await ApiService.GetCharacterSoulImprintsAsync(characterId, forceRefresh); if (_disposed || generation != _generation || CharacterId != characterId) return; if (response is not null) _response = response; else _notice = error ?? "魂印读取失败，请重试。"; } catch { if (!_disposed && generation == _generation) _notice = "连接中断，请重新读取。"; } finally { if (generation == _generation) _loading = false; }
    }
    private Task PickAsync(string id) => SetEquippedAsync(int.TryParse(id, out var value) ? value : null);
    private Task SetEquippedAsync(int? id) => ChangeAsync(() => ApiService.SetEquippedSoulImprintAsync(CharacterId, id), id is null ? "魂印已卸下。" : "魂印已装备。");
    private Task SaveAutoAsync(CharacterSoulImprintResponse item, bool enabled, string? condition, int threshold) => ChangeAsync(() => ApiService.SetSoulImprintAutoAsync(CharacterId, item.Id, enabled, condition, threshold), "自动释放设置已保存。");
    private async Task ChangeAsync(Func<Task<(CharacterSoulImprintsResponse? Response, string? ErrorMessage)>> action, string notice)
    {
        if (_busy) return; _busy = true; _notice = null; var generation = _generation;
        try { var (response, error) = await action(); if (_disposed || generation != _generation) return; if (response is not null) { _response = response; _notice = notice; } else { _notice = error ?? "魂印操作失败。"; await LoadAsync(); } } catch { if (!_disposed) _notice = "连接中断，请重新读取并核对魂印状态。"; } finally { _busy = false; }
    }
    public void Dispose() { _disposed = true; _generation++; ApiService.InventoryChanged -= InventoryChanged; }
}
