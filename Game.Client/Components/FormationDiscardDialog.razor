@inject IJSRuntime Js
<div class="discard-backdrop" @onclick="() => Decide(false)">
    <section class="discard-dialog" role="alertdialog" aria-modal="true" aria-labelledby="discard-formation-title" aria-describedby="discard-formation-copy" tabindex="-1" @ref="_dialog" @onclick:stopPropagation="true" @onkeydown="KeyDown" @onkeydown:stopPropagation="true">
        <span class="discard-emblem" aria-hidden="true">✧</span>
        <h2 id="discard-formation-title">保留这次调整？</h2>
        <p id="discard-formation-copy">编队尚未保存，离开会放弃本次修改。</p>
        <button type="button" class="keep-editing" @onclick="() => Decide(false)">继续编辑</button>
        <button type="button" class="discard-changes" @onclick="() => Decide(true)">放弃修改</button>
    </section>
</div>
@code {
    [Parameter] public EventCallback<bool> OnDecision { get; set; }
    private ElementReference _dialog;
    private Task Decide(bool discard) => OnDecision.InvokeAsync(discard);
    private Task KeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? Decide(false) : Task.CompletedTask;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Js.InvokeVoidAsync("inventoryUi.focusDialog", _dialog, true);
    }
}
