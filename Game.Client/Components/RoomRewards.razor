@using Game.Shared.Dtos
@using Game.Client.Services

<div class="room-loot">
    <div class="room-loot__totals" aria-label="我的房间累计收益">
        <div><small>累计金币</small><strong>+@Rewards.Gold.ToString("N0")</strong></div>
        <div><small>累计经验</small><strong>+@Rewards.Experience.ToString("N0")</strong></div>
    </div>
    @if (Rewards.MasteryGold > 0) { <p class="room-loot__hint">金币中包含精通加成 +@Rewards.MasteryGold.ToString("N0")。</p> }
    <p class="room-loot__hint">仅统计我的角色在当前房间的收益，同类物品已合并。</p>
    @if (Rewards.HasPendingRewards)
    {
        <p class="room-loot__pending">包含本轮待结算奖励；经验以结算时为准。</p>
    }
    @if (Rewards.Characters.Count > 0)
    {
        <div class="room-loot__characters" role="group" aria-label="选择查看奖励的角色">
            @foreach (var character in Rewards.Characters)
            {
                <button @key="character.CharacterId" type="button"
                        class="room-loot__character @(character.CharacterId == _selectedCharacterId ? "room-loot__character--selected" : null)"
                        aria-pressed="@(character.CharacterId == _selectedCharacterId ? "true" : "false")"
                        @onclick="() => _selectedCharacterId = character.CharacterId">
                    <strong>@character.CharacterName</strong>
                    <small>@character.Items.Count 种物品</small>
                </button>
            }
        </div>
        @if (Rewards.Characters.FirstOrDefault(character => character.CharacterId == _selectedCharacterId) is { } selected)
        {
            <section @key="selected.CharacterId" class="room-loot__detail" aria-label="@($"{selected.CharacterName}的累计奖励")">
                <div class="room-loot__identity"><h3>@selected.CharacterName</h3><span>累计收益</span></div>
                <div class="room-loot__character-totals">
                    <div><small>金币</small><strong>+@selected.Gold.ToString("N0")</strong>
                        @if (selected.PendingGold > 0) { <small class="room-loot__pending">其中 @selected.PendingGold.ToString("N0") 待结算</small> }
                    </div>
                    <div><small>经验</small><strong>+@selected.Experience.ToString("N0")</strong>
                        @if (selected.PendingExperience > 0) { <small class="room-loot__pending">其中 @selected.PendingExperience.ToString("N0") 待结算</small> }
                    </div>
                </div>
                @if (selected.Items.Count > 0)
                {
                    @foreach (var group in selected.Items.GroupBy(item => RewardGroup(item.Source)))
                    {
                        <section @key="group.Key" class="room-loot__source" aria-label="@group.Key">
                            <h4>@group.Key</h4>
                            <div class="room-loot__items">
                            @foreach (var item in group)
                            {
                                <button @key="(item.Kind, item.Code, item.Name, item.Source)" type="button"
                                        id="@($"{_itemTitleId}-{selected.CharacterId}-{item.Kind}-{item.Code}-{Uri.EscapeDataString(item.Source)}")"
                                        class="room-loot__item room-loot__item--@item.Kind.ToLowerInvariant()"
                                        aria-label="@ItemLabel(item)" aria-haspopup="dialog" title="@ItemLabel(item)"
                                        @onclick="() => OpenItem(selected, item)">
                                    @if (GetArt(item) is { } art)
                                    {
                                        <img src="@art" alt="" @onerror="() => _failedArt.Add(art)" />
                                    }
                                    else { <span class="room-loot__fallback" aria-hidden="true">@KindSymbol(item.Kind)</span> }
                                    @if (item.PendingQuantity > 0) { <span class="room-loot__pending-dot" aria-hidden="true"></span> }
                                    <b class="room-loot__quantity" aria-hidden="true">×@CompactQuantity(item.Quantity)</b>
                                </button>
                            }
                            </div>
                        </section>
                    }
                }
                else
                {
                    <p class="room-loot__empty">该角色在当前房间暂无物品奖励。</p>
                }
            </section>
        }
    }
    else
    {
        <p class="room-loot__empty">当前房间暂无我的角色奖励。</p>
    }
    <ShellDialog IsOpen="@(_inspectedItem is not null)" Class="room-loot-dialog" LabelledBy="@_itemTitleId" OnClose="CloseItem">
        @if (_inspectedItem is { } inspected)
        {
            <div class="room-loot__inspection" @onkeydown:stopPropagation @onclick:stopPropagation>
                <header class="room-loot__inspection-header">
                    <span class="room-loot__inspection-art room-loot__item--@inspected.Kind.ToLowerInvariant()" aria-hidden="true">
                        @if (GetArt(inspected) is { } art)
                        {
                            <img src="@art" alt="" @onerror="() => _failedArt.Add(art)" />
                        }
                        else { <span class="room-loot__fallback">@KindSymbol(inspected.Kind)</span> }
                    </span>
                    <div><small>@GetKindName(inspected.Kind)</small><h3 id="@_itemTitleId">@inspected.Name</h3></div>
                    <button type="button" class="room-loot__close" aria-label="关闭物品详情" @onclick="CloseItem">×</button>
                </header>
                <dl class="room-loot__facts">
                    <div><dt>累计获得</dt><dd class="room-loot__received">×@inspected.Quantity.ToString("N0")</dd></div>
                    @if (inspected.PendingQuantity > 0)
                    {
                        <div><dt>其中待结算</dt><dd class="room-loot__pending">×@inspected.PendingQuantity.ToString("N0")</dd></div>
                    }
                    <div><dt>奖励来源</dt><dd>@RewardGroup(inspected.Source)</dd></div>
                    <div><dt>获得角色</dt><dd>@_inspectedCharacterName</dd></div>
                </dl>
                <p class="room-loot__hint">当前房间累计掉落，非仓库现有数量。</p>
            </div>
        }
    </ShellDialog>
</div>

@code {
    [Parameter, EditorRequired] public RoomCumulativeRewardsResponse Rewards { get; set; } = new();
    private int? _selectedCharacterId;
    private readonly string _itemTitleId = "loot-item-" + Guid.NewGuid().ToString("N");
    private readonly HashSet<string> _failedArt = [];
    private RoomRewardItemResponse? _inspectedItem;
    private int _inspectedCharacterId;
    private string _inspectedCharacterName = string.Empty;

    protected override void OnParametersSet()
    {
        if (!Rewards.Characters.Any(character => character.CharacterId == _selectedCharacterId))
            _selectedCharacterId = Rewards.Characters.FirstOrDefault()?.CharacterId;

        // Preserve the open dialog and its DOM across polling, reorderings and transient omissions.
        // Resolve by owner and reward identity, never by list index or the refreshed DTO reference.
        if (_inspectedItem is { } inspected && Rewards.Characters
            .FirstOrDefault(character => character.CharacterId == _inspectedCharacterId)?.Items
            .FirstOrDefault(item => item.Kind == inspected.Kind && item.Code == inspected.Code && item.Source == inspected.Source) is { } latest)
            _inspectedItem = latest;
    }

    private void OpenItem(RoomCharacterRewardsResponse character, RoomRewardItemResponse item)
    {
        _inspectedCharacterId = character.CharacterId;
        _inspectedCharacterName = character.CharacterName;
        _inspectedItem = item;
    }

    private void CloseItem() => _inspectedItem = null;

    private string? GetArt(RoomRewardItemResponse item)
    {
        var path = item.Kind == "Weapon" && !string.IsNullOrWhiteSpace(item.Code)
            ? WeaponArt.ForCode(item.Code) : ItemArt.ForCode(item.Code);
        return path is not null && !_failedArt.Contains(path) ? path : null;
    }

    private static string ItemLabel(RoomRewardItemResponse item) => $"{item.Name}，累计 {item.Quantity:N0} 件"
        + (item.PendingQuantity > 0 ? $"，其中 {item.PendingQuantity:N0} 件待结算" : "") + "，查看详情";
    private static string CompactQuantity(int quantity) => quantity >= 10000 ? $"{quantity / 10000d:0.#}万" : quantity.ToString("N0");
    private static string KindSymbol(string kind) => kind switch
    {
        "Weapon" => "⚔", "SoulImprint" => "✧", "Consumable" => "✚", _ => "◈"
    };

    private static string GetKindName(string kind) => kind switch
    {
        "Consumable" => "消耗品",
        "Material" => "材料",
        "Weapon" => "武器",
        "SoulImprint" => "魂印",
        _ => "物品"
    };

    private static string RewardGroup(string source) => source switch
    {
        "精通追加" => "精通追加",
        "挑战奖励" or "挑战额外奖励" => "挑战额外奖励",
        _ => "基础战利品"
    };
}
