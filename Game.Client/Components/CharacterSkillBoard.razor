@using Game.Client.Services
@using Game.Shared
@using Game.Shared.Dtos.Characters
@inject ApiService ApiService
@inject IJSRuntime Js

<section class="skill-board" aria-labelledby="skill-board-title">
    <header class="skill-board__header">
        <div><h2 id="skill-board-title">职业技能</h2></div>
        @if (_skills is not null) { <span>@_skills.ProfessionName · @_skills.Slots.Count(slot => slot.SkillCode is not null) / @SkillRules.SlotCount</span> }
    </header>

    @if (_isLoading)
    {
        <GameStateCard Compact="true" Title="正在载入技能" Detail="同步技能栏与 Auto 优先级…" />
    }
    else if (_skills is null)
    {
        <GameStateCard Compact="true" Tone="error" Icon="!" Title="技能读取失败" Detail="@(_error ?? "暂时无法读取技能。")">
            <Actions><button type="button" @onclick="LoadAsync">重试</button></Actions>
        </GameStateCard>
    }
    else
    {
        var selectedSlot = _skills.Slots.FirstOrDefault(slot => slot.SlotIndex == _selectedSlotIndex) ?? _skills.Slots.OrderBy(slot => slot.SlotIndex).First();
        var selectedSkill = FindSkill(selectedSlot.SkillCode);

        <div class="skill-board__slot-strip" role="group" aria-label="技能槽位">
            @foreach (var slot in _skills.Slots.OrderBy(slot => slot.SlotIndex))
            {
                var activeSkill = FindSkill(slot.SkillCode);
                <button type="button"
                        class="skill-board__slot-card @(activeSkill is null ? "skill-board__slot-card--empty" : null) @(slot.SlotIndex == _selectedSlotIndex ? "active" : null)"
                        aria-pressed="@(slot.SlotIndex == _selectedSlotIndex ? "true" : "false")"
                        aria-label="@($"选择 {slot.SlotIndex} 号槽位：{activeSkill?.Name ?? "空槽位"}")"
                        disabled="@_isSaving"
                        @onclick="() => SelectSlot(slot.SlotIndex)" @key="slot.SlotIndex">
                    <span class="skill-board__slot-index">@slot.SlotIndex.ToString("00")</span>
                    <span class="skill-board__icon skill-board__icon--@GetEffectTone(activeSkill)" aria-hidden="true">@if (activeSkill is null) { <text>+</text> } else { <img src="@SkillArt.ForCode(activeSkill.Code)" alt="" /> }</span>
                    <strong>@(activeSkill?.Name ?? "空槽")</strong>
                    @if (activeSkill is not null)
                    {
                        <small class="@(slot.AutoUseEnabled ? "skill-board__auto-badge" : null)">@(slot.AutoUseEnabled ? "AUTO" : "手动")</small>
                    }
                </button>
            }
        </div>

        <details class="skill-board__settings">
            <summary>槽位 @_selectedSlotIndex 设置 · @(selectedSkill?.Name ?? "空槽位")</summary>
            <div class="skill-board__settings-content">
                <p class="skill-board__empty-hint">从左到右决定自动使用优先级；技能随职业等级自动提升。</p>
                <div class="skill-board__settings-tools">
                    <div class="skill-board__reorder" aria-label="调整技能优先级">
                        <button type="button" title="优先级上移" aria-label="@_selectedSlotIndex 号位上移" disabled="@(_isSaving || _selectedSlotIndex == 1)" @onclick="() => MoveAsync(_selectedSlotIndex, _selectedSlotIndex - 1)">←</button>
                        <button type="button" title="优先级下移" aria-label="@_selectedSlotIndex 号位下移" disabled="@(_isSaving || _selectedSlotIndex == SkillRules.SlotCount)" @onclick="() => MoveAsync(_selectedSlotIndex, _selectedSlotIndex + 1)">→</button>
                    </div>
                    <button type="button" class="button button--quiet" disabled="@(_isSaving || selectedSkill is null)" @onclick="() => SaveSlotAsync(selectedSlot, null, false, selectedSlot.AutoHpThresholdPercent)">卸下技能</button>
                </div>
                @if (selectedSkill is null)
                {
                    <p class="skill-board__empty-hint">点击下方已学技能图标，装备到当前槽位。</p>
                }
                else
                {
                    <p class="skill-board__selected-description">@selectedSkill.Description <span>Lv @selectedSkill.Level · 初始冷却 @selectedSkill.InitialCooldownRounds 回合 · 常规冷却 @selectedSkill.CooldownRounds 回合</span></p>
                    <div class="skill-board__automation">
                        <label class="skill-board__auto">
                            <input type="checkbox" checked="@selectedSlot.AutoUseEnabled" disabled="@_isSaving" @onchange="e => SaveAutoAsync(selectedSlot, (bool)e.Value!, selectedSlot.AutoHpThresholdPercent, selectedSlot.AutoConditionOverride)" />
                            <span><strong>自动使用</strong><small>@SkillAutoRules.Describe(selectedSlot.AutoCondition, selectedSlot.AutoHpThresholdPercent)</small></span>
                        </label>
                    </div>
                    <SkillAutoConditionPicker @key="selectedSlot.SlotIndex" ConditionOverride="@selectedSlot.AutoConditionOverride"
                        DefaultCondition="@selectedSlot.AutoCondition" Threshold="@selectedSlot.AutoHpThresholdPercent" Disabled="@_isSaving"
                        OnConditionChanged="condition => SaveAutoAsync(selectedSlot, selectedSlot.AutoUseEnabled, selectedSlot.AutoHpThresholdPercent, condition)"
                        OnThresholdChanged="threshold => SaveAutoAsync(selectedSlot, selectedSlot.AutoUseEnabled, threshold, selectedSlot.AutoConditionOverride)" />
                }
                <small class="skill-board__save-status" role="status">@(_isSaving ? "正在保存…" : "修改后自动保存")</small>
            </div>
        </details>

        <section class="skill-board__library" aria-labelledby="learned-skills-title">
            <header><div><h3 id="learned-skills-title">已学技能</h3></div><small>点选装备至 @_selectedSlotIndex 号位</small></header>
            <div class="skill-board__learned">
                @foreach (var skill in _skills.LearnedSkills)
                {
                    var equippedSlot = _skills.Slots.FirstOrDefault(slot => string.Equals(slot.SkillCode, skill.Code, StringComparison.OrdinalIgnoreCase));
                    <article class="skill-board__learned-item @(equippedSlot is not null ? "equipped" : null)" @key="skill.Code">
                        <button type="button" class="skill-board__learned-equip" aria-label="@($"将{skill.Name}装备至槽位 {_selectedSlotIndex}")"
                                disabled="@_isSaving" @onclick="() => ChooseSkillAsync(skill.Code)">
                            <span class="skill-board__icon skill-board__icon--@GetEffectTone(skill)" aria-hidden="true"><img src="@SkillArt.ForCode(skill.Code)" alt="" loading="lazy" /></span>
                            <span class="skill-board__learned-copy"><strong>@skill.Name · Lv @skill.Level</strong><small>@skill.Description</small></span>
                        </button>
                        <div class="skill-board__learned-footer">
                            <span class="skill-board__learned-meta">初始 @skill.InitialCooldownRounds · 常规 @skill.CooldownRounds 回合 · @(equippedSlot is null ? "点击装备" : equippedSlot.SlotIndex == _selectedSlotIndex ? "当前槽位" : $"槽位 {equippedSlot.SlotIndex} · 点击交换")</span>
                            <button type="button" id="@GetDetailButtonId(skill.Code)" class="skill-board__detail-button"
                                    aria-label="@($"查看{skill.Name}的完整详情")" aria-haspopup="dialog" aria-controls="skill-detail-dialog"
                                    @onclick="() => OpenSkillDetails(skill.Code)">详情 ›</button>
                        </div>
                    </article>
                }
            </div>
        </section>

        @if (_skills.SharedSkills.Count > 0)
        {
            <section class="skill-board__library" aria-labelledby="shared-skills-title">
                <header><div><h3 id="shared-skills-title">共享技能</h3></div><small>职业 10 级解锁 · 最多一格</small></header>
                <div class="skill-board__learned">
                    @foreach (var skill in _skills.SharedSkills)
                    {
                        var equippedSlot = _skills.Slots.FirstOrDefault(slot => string.Equals(slot.SkillCode, skill.Code, StringComparison.OrdinalIgnoreCase));
                        var occupiedByOtherShared = _skills.Slots.Any(slot => slot.SlotIndex != _selectedSlotIndex && _skills.SharedSkills.Any(shared => string.Equals(shared.Code, slot.SkillCode, StringComparison.OrdinalIgnoreCase)));
                        <article class="skill-board__learned-item @(equippedSlot is not null ? "equipped" : null)" @key="skill.Code">
                            <button type="button" class="skill-board__learned-equip" aria-label="@($"将共享技能 {skill.Name} 装备至槽位 {_selectedSlotIndex}")"
                                    disabled="@(_isSaving || !skill.CanEquip || (occupiedByOtherShared && equippedSlot is null))" @onclick="() => ChooseSkillAsync(skill.Code)">
                                <span class="skill-board__icon skill-board__icon--@GetEffectTone(skill)" aria-hidden="true"><img src="@SkillArt.ForCode(skill.Code)" alt="" loading="lazy" /></span>
                                <span class="skill-board__learned-copy"><strong>@skill.Name · 固定效果</strong><small>@skill.Description</small></span>
                            </button>
                            <div class="skill-board__learned-footer">
                                <span class="skill-board__learned-meta">初始 @skill.InitialCooldownRounds · 常规 @skill.CooldownRounds 回合 · @(!skill.CanEquip ? "当前职业需达到 10 级" : occupiedByOtherShared && equippedSlot is null ? "先卸下其他共享技能" : equippedSlot is null ? "点击装备" : $"槽位 {equippedSlot.SlotIndex}")</span>
                                <button type="button" id="@GetDetailButtonId(skill.Code)" class="skill-board__detail-button" aria-label="@($"查看{skill.Name}的完整详情")" aria-haspopup="dialog" aria-controls="skill-detail-dialog" @onclick="() => OpenSkillDetails(skill.Code)">详情 ›</button>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }

        @if (FindSkill(_detailSkillCode) is { } detailSkill)
        {
            var detailSlot = _skills.Slots.FirstOrDefault(slot => string.Equals(slot.SkillCode, detailSkill.Code, StringComparison.OrdinalIgnoreCase));
            <div class="skill-board__detail-backdrop" @onclick="CloseSkillDetailsAsync" @onkeydown="HandleDetailKeyDownAsync" @onkeydown:stopPropagation>
                <section id="skill-detail-dialog" class="skill-board__detail-dialog" role="dialog" aria-modal="true"
                         aria-labelledby="skill-detail-title" aria-describedby="skill-detail-description"
                         tabindex="-1" @ref="_detailDialog" @onclick:stopPropagation>
                    <header class="skill-board__detail-header">
                        <span class="skill-board__icon skill-board__icon--@GetEffectTone(detailSkill)" aria-hidden="true"><img src="@SkillArt.ForCode(detailSkill.Code)" alt="" /></span>
                        <div><span class="skill-board__eyebrow">技能详情</span><h3 id="skill-detail-title">@detailSkill.Name</h3></div>
                        <button type="button" class="skill-board__detail-close" @onclick="CloseSkillDetailsAsync" aria-label="关闭技能详情">×</button>
                    </header>
                    <div class="skill-board__detail-body">
                        <p id="skill-detail-description" class="skill-board__detail-description">@detailSkill.Description</p>
                        <dl class="skill-board__detail-facts">
                            <div><dt>技能效果</dt><dd>
                                @foreach (var effect in detailSkill.Effects)
                                {
                                    <p class="skill-board__effect">@effect.Summary</p>
                                }
                            </dd></div>
                            <div><dt>@(detailSkill.IsShared ? "共享版本" : "技能等级")</dt><dd>@(detailSkill.IsShared ? "固定效果" : $"Lv {detailSkill.Level}")</dd></div>
                            <div><dt>初始冷却</dt><dd>@detailSkill.InitialCooldownRounds 回合</dd></div>
                            <div><dt>常规冷却</dt><dd>@detailSkill.CooldownRounds 回合</dd></div>
                            <div><dt>技能来源</dt><dd>@(detailSkill.IsShared ? "其他职业共享" : "当前职业")</dd></div>
                            <div><dt>自动使用条件</dt><dd>@SkillAutoRules.Describe(detailSlot?.AutoCondition ?? detailSkill.AutoCondition, detailSlot?.AutoHpThresholdPercent ?? SkillRules.DefaultAutoHpThresholdPercent)</dd></div>
                            <div><dt>装备状态</dt><dd>@(detailSlot is null ? "尚未装备" : $"已装备至槽位 {detailSlot.SlotIndex} · {(detailSlot.AutoUseEnabled ? "自动使用" : "手动使用")}")</dd></div>
                        </dl>
                    </div>
                    <footer class="skill-board__detail-footer"><button type="button" class="button button--quiet" @onclick="CloseSkillDetailsAsync">返回</button></footer>
                </section>
            </div>
        }

        @if (_error is not null) { <p class="skill-board__error" role="alert">@GetError(_error)</p> }
    }
</section>

@code {
    [Parameter, EditorRequired] public int CharacterId { get; set; }
    private CharacterSkillsResponse? _skills;
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _error;
    private int _selectedSlotIndex = 1;
    private string? _detailSkillCode;
    private bool _focusDetail;
    private ElementReference _detailDialog;

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusDetail) return;
        _focusDetail = false;
        await Js.InvokeVoidAsync("talentUi.openDialog", _detailDialog);
    }

    private string GetDetailButtonId(string code) => $"skill-details-{CharacterId}-{code}";

    private LearnedSkillResponse? FindSkill(string? code) => _skills?.LearnedSkills.FirstOrDefault(skill => string.Equals(skill.Code, code, StringComparison.OrdinalIgnoreCase))
        ?? _skills?.SharedSkills.FirstOrDefault(skill => string.Equals(skill.Code, code, StringComparison.OrdinalIgnoreCase));

    private void OpenSkillDetails(string code)
    {
        _detailSkillCode = code;
        _focusDetail = true;
    }

    private async Task CloseSkillDetailsAsync()
    {
        var code = _detailSkillCode;
        _detailSkillCode = null;
        _focusDetail = false;
        if (code is not null) await Js.InvokeVoidAsync("talentUi.focus", GetDetailButtonId(code));
    }

    private Task HandleDetailKeyDownAsync(KeyboardEventArgs args) =>
        args.Key == "Escape" ? CloseSkillDetailsAsync() : Task.CompletedTask;

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            var (response, error) = await ApiService.GetCharacterSkillsAsync(CharacterId);
            _skills = response;
            _error = error;
        }
        catch { _error = "连接失败，请稍后重试。"; }
        finally { _isLoading = false; }
    }

    private void SelectSlot(int slotIndex)
    {
        if (_isSaving) return;
        _selectedSlotIndex = slotIndex;
        _error = null;
    }

    private async Task SaveSlotAsync(EquippedSkillResponse slot, string? code, bool auto, int threshold)
    {
        if (_isSaving) return;
        _isSaving = true;
        _error = null;
        try
        {
            var (response, error) = await ApiService.SetSkillSlotAsync(CharacterId, slot.SlotIndex,
                new SetSkillSlotRequest
                {
                    SkillCode = string.IsNullOrWhiteSpace(code) ? null : code,
                    AutoUseEnabled = auto, AutoHpThresholdPercent = threshold,
                    AutoConditionOverride = string.Equals(slot.SkillCode, code, StringComparison.OrdinalIgnoreCase) ? slot.AutoConditionOverride : null
                });
            if (response is not null) _skills = response;
            else _error = error;
        }
        catch { _error = "连接失败，请稍后重试。"; }
        finally { _isSaving = false; }
    }

    private async Task SaveAutoAsync(EquippedSkillResponse slot, bool auto, int threshold, string? condition)
    {
        if (_isSaving) return;
        _isSaving = true;
        _error = null;
        try
        {
            var (response, error) = await ApiService.SetSkillAutoAsync(CharacterId, slot.SlotIndex,
                new SetSkillAutoRequest { AutoUseEnabled = auto, AutoHpThresholdPercent = threshold, AutoConditionOverride = condition });
            if (response is not null) _skills = response;
            else _error = error;
        }
        catch { _error = "连接失败，请稍后重试。"; }
        finally { _isSaving = false; }
    }

    private async Task ChooseSkillAsync(string code)
    {
        if (_skills is null || _isSaving) return;
        var target = _skills.Slots.FirstOrDefault(slot => slot.SlotIndex == _selectedSlotIndex);
        if (target is null) return;
        var equippedSlot = _skills.Slots.FirstOrDefault(slot => string.Equals(slot.SkillCode, code, StringComparison.OrdinalIgnoreCase));
        if (equippedSlot is not null)
        {
            if (equippedSlot.SlotIndex != target.SlotIndex)
                await MoveAsync(equippedSlot.SlotIndex, target.SlotIndex);
            return;
        }
        await SaveSlotAsync(target, code, target.AutoUseEnabled, target.AutoHpThresholdPercent);
    }

    private async Task MoveAsync(int from, int to)
    {
        if (_isSaving) return;
        _isSaving = true;
        _error = null;
        try
        {
            var (response, error) = await ApiService.SwapSkillSlotsAsync(CharacterId, from, to);
            if (response is not null)
            {
                _skills = response;
                if (_selectedSlotIndex == from) _selectedSlotIndex = to;
            }
            else _error = error;
        }
        catch { _error = "连接失败，请稍后重试。"; }
        finally { _isSaving = false; }
    }

    private static string GetError(string error) => error.Trim().Trim('"') switch
    {
        "LoadoutLocked" => "角色已入场，请先离场或移出角色后再调整技能栏。",
        "SkillAlreadyEquipped" => "该技能已装备在其他槽位，可用箭头调整顺序。",
        "SkillNotLearned" => "该角色尚未学会这个技能。",
        "SharedSkillLimitReached" => "共享技能最多装备一格。请先卸下其他共享技能。",
        "SharedSkillLocked" => "当前职业达到 10 级后才能装备共享技能。",
        "InvalidHpThreshold" => "自动使用阈值应为 1～100%。",
        "InvalidAutoCondition" => "请选择一个有效的 Auto 释放条件。",
        "ConcurrencyConflict" => "技能栏状态已变化，请重试。",
        _ => error
    };

    private static string GetEffectTone(LearnedSkillResponse? skill) => skill?.EffectType switch
    {
        "Damage" => "damage", "Heal" => "heal", "Guard" => "guard", "Cleanse" => "cleanse",
        "Dispel" => "dispel", "Interrupt" => "interrupt", "ApplyStatus" => "status", _ => "empty"
    };
}
