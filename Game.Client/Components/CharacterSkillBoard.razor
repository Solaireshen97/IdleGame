@using Game.Client.Services
@using Game.Shared
@using Game.Shared.Dtos.Characters
@inject ApiService ApiService

<section class="skill-board" aria-labelledby="skill-board-title">
    <header class="skill-board__header">
        <div><span class="skill-board__eyebrow">CLASS SKILLS</span><h2 id="skill-board-title">职业技能</h2></div>
        @if (_skills is not null) { <span>@_skills.ProfessionName · 最多 @SkillRules.SlotCount 个技能</span> }
    </header>

    @if (_isLoading)
    {
        <GameStateCard Compact="true" Title="正在载入技能" Detail="同步技能栏与 Auto 优先级…" />
    }
    else if (_skills is null)
    {
        <GameStateCard Compact="true" Tone="error" Icon="!" Title="技能读取失败" Detail="@(_error ?? "暂时无法读取技能。")">
            <Actions><button type="button" @onclick="LoadAsync">重试</button></Actions>
        </GameStateCard>
    }
    else
    {
        var selectedSlot = _skills.Slots.FirstOrDefault(slot => slot.SlotIndex == _selectedSlotIndex) ?? _skills.Slots.OrderBy(slot => slot.SlotIndex).First();
        var selectedSkill = _skills.LearnedSkills.FirstOrDefault(skill => skill.Code == selectedSlot.SkillCode);
        var equippedCount = _skills.Slots.Count(slot => slot.SkillCode is not null);

        <div class="skill-board__loadout-heading">
            <div><span class="skill-board__eyebrow">SKILL LOADOUT</span><h3>技能编成</h3></div>
            <p><strong>@equippedCount / @SkillRules.SlotCount</strong> 已装备 · 从左到右决定 Auto 优先级</p>
        </div>

        <div class="skill-board__slot-strip" role="group" aria-label="技能槽位">
            @foreach (var slot in _skills.Slots.OrderBy(slot => slot.SlotIndex))
            {
                var activeSkill = _skills.LearnedSkills.FirstOrDefault(skill => skill.Code == slot.SkillCode);
                <button type="button"
                        class="skill-board__slot-card @(activeSkill is null ? "skill-board__slot-card--empty" : null) @(slot.SlotIndex == _selectedSlotIndex ? "active" : null)"
                        aria-haspopup="dialog"
                        aria-expanded="@(_isEditorOpen && slot.SlotIndex == _selectedSlotIndex ? "true" : "false")"
                        aria-label="@($"{slot.SlotIndex} 号槽位：{activeSkill?.Name ?? "空槽位"}")"
                        @onclick="() => OpenEditor(slot.SlotIndex)" @key="slot.SlotIndex">
                    <span class="skill-board__slot-index">@slot.SlotIndex.ToString("00")</span>
                    <span class="skill-board__icon skill-board__icon--@GetEffectTone(activeSkill)" aria-hidden="true">@GetSkillIcon(activeSkill)</span>
                    <strong>@(activeSkill?.Name ?? "空槽")</strong>
                    @if (activeSkill is not null)
                    {
                        <small class="@(slot.AutoUseEnabled ? "skill-board__auto-badge" : null)">@(slot.AutoUseEnabled ? "AUTO" : "手动")</small>
                    }
                </button>
            }
        </div>

        <section class="skill-board__library" aria-labelledby="learned-skills-title">
            <header><div><span class="skill-board__eyebrow">LEARNED SKILLS</span><h3 id="learned-skills-title">已学技能</h3></div><small>点按后装备至槽位 @_selectedSlotIndex</small></header>
            <div class="skill-board__learned">
                @foreach (var skill in _skills.LearnedSkills)
                {
                    var equippedSlot = _skills.Slots.FirstOrDefault(slot => string.Equals(slot.SkillCode, skill.Code, StringComparison.OrdinalIgnoreCase));
                    <button type="button" class="skill-board__learned-item @(equippedSlot is not null ? "equipped" : null)"
                            disabled="@_isSaving" @onclick="() => ChooseSkillAsync(skill.Code)">
                        <span class="skill-board__icon skill-board__icon--@GetEffectTone(skill)" aria-hidden="true">@GetSkillIcon(skill)</span>
                        <span class="skill-board__learned-copy"><strong>@skill.Name</strong><small>@skill.Description</small></span>
                        <span class="skill-board__learned-meta">CD @skill.CooldownRounds · @(equippedSlot is null ? "点击装备" : $"槽位 {equippedSlot.SlotIndex}")</span>
                    </button>
                }
            </div>
        </section>

        @if (_isEditorOpen)
        {
            <div class="skill-board__editor-backdrop" @onclick="CloseEditor">
                <section class="skill-board__editor" role="dialog" aria-modal="true" aria-labelledby="skill-editor-title"
                         tabindex="-1" @ref="_editorDialog" @onclick:stopPropagation="true" @onkeydown="HandleEditorKeyDown">
                    <header class="skill-board__editor-header">
                        <div><span>编辑槽位 @_selectedSlotIndex.ToString("00")</span><strong id="skill-editor-title">@(selectedSkill?.Name ?? "未装备技能")</strong></div>
                        <div class="skill-board__editor-tools">
                            <div class="skill-board__reorder" aria-label="调整技能优先级">
                                <button type="button" title="优先级上移" aria-label="@_selectedSlotIndex 号位上移" disabled="@(_isSaving || _selectedSlotIndex == 1)" @onclick="() => MoveAsync(_selectedSlotIndex, _selectedSlotIndex - 1)">←</button>
                                <button type="button" title="优先级下移" aria-label="@_selectedSlotIndex 号位下移" disabled="@(_isSaving || _selectedSlotIndex == SkillRules.SlotCount)" @onclick="() => MoveAsync(_selectedSlotIndex, _selectedSlotIndex + 1)">→</button>
                            </div>
                            <button type="button" class="skill-board__editor-close" @onclick="CloseEditor" aria-label="关闭技能设置">×</button>
                        </div>
                    </header>
                    <label class="skill-board__selector">
                        <span>装备技能</span>
                        <select value="@selectedSlot.SkillCode" disabled="@_isSaving" @onchange="e => ChangeSkillAsync(selectedSlot, e.Value?.ToString())">
                            <option value="">空槽位</option>
                            @foreach (var skill in _skills.LearnedSkills)
                            {
                                <option value="@skill.Code">@skill.Name</option>
                            }
                        </select>
                    </label>
                    @if (selectedSkill is null)
                    {
                        <p class="skill-board__empty-hint">选择已学技能，装备到当前槽位。</p>
                    }
                    else
                    {
                        <p class="skill-board__selected-description">@selectedSkill.Description <span>冷却 @selectedSkill.CooldownRounds 回合</span></p>
                        <div class="skill-board__automation">
                            <label class="skill-board__auto">
                                <input type="checkbox" checked="@selectedSlot.AutoUseEnabled" disabled="@_isSaving" @onchange="e => SaveSlotAsync(selectedSlot, selectedSlot.SkillCode, (bool)e.Value!, selectedSlot.AutoHpThresholdPercent)" />
                                <span><strong>自动使用</strong><small>@GetAutoConditionText(selectedSkill.AutoCondition)</small></span>
                            </label>
                            @if (selectedSkill.AutoCondition == "LowestHpBelowThreshold")
                            {
                                <label class="skill-board__threshold"><span>HP ≤</span><input type="number" min="1" max="100" value="@selectedSlot.AutoHpThresholdPercent" disabled="@_isSaving" @onchange="e => ChangeThresholdAsync(selectedSlot, e.Value?.ToString())" /><span>%</span></label>
                            }
                        </div>
                    }
                    <footer class="skill-board__editor-footer">
                        <small>@(_isSaving ? "正在保存…" : "修改后自动保存 · 战斗中无法调整")</small>
                        <button type="button" class="button button--quiet" @onclick="CloseEditor">完成</button>
                    </footer>
                </section>
            </div>
        }
        @if (_error is not null) { <p class="skill-board__error" role="alert">@GetError(_error)</p> }
    }
</section>

@code {
    [Parameter, EditorRequired] public int CharacterId { get; set; }
    private CharacterSkillsResponse? _skills;
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isEditorOpen;
    private bool _focusEditor;
    private string? _error;
    private int _selectedSlotIndex = 1;
    private ElementReference _editorDialog;

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusEditor) return;
        _focusEditor = false;
        await _editorDialog.FocusAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            var (response, error) = await ApiService.GetCharacterSkillsAsync(CharacterId);
            _skills = response;
            _error = error;
            _isEditorOpen = false;
        }
        catch { _error = "连接失败，请稍后重试。"; }
        finally { _isLoading = false; }
    }

    private void OpenEditor(int slotIndex)
    {
        _selectedSlotIndex = slotIndex;
        _isEditorOpen = true;
        _focusEditor = true;
        _error = null;
    }

    private void CloseEditor() => _isEditorOpen = false;

    private void HandleEditorKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseEditor();
    }

    private async Task SaveSlotAsync(EquippedSkillResponse slot, string? code, bool auto, int threshold)
    {
        if (_isSaving) return;
        _isSaving = true;
        _error = null;
        try
        {
            var (response, error) = await ApiService.SetSkillSlotAsync(CharacterId, slot.SlotIndex,
                new SetSkillSlotRequest { SkillCode = string.IsNullOrWhiteSpace(code) ? null : code, AutoUseEnabled = auto, AutoHpThresholdPercent = threshold });
            if (response is not null) _skills = response;
            else _error = error;
        }
        catch { _error = "连接失败，请稍后重试。"; }
        finally { _isSaving = false; }
    }

    private Task ChangeThresholdAsync(EquippedSkillResponse slot, string? raw)
    {
        if (!int.TryParse(raw, out var threshold)) threshold = slot.AutoHpThresholdPercent;
        return SaveSlotAsync(slot, slot.SkillCode, slot.AutoUseEnabled, threshold);
    }

    private Task ChangeSkillAsync(EquippedSkillResponse slot, string? code) =>
        SaveSlotAsync(slot, code, !string.IsNullOrWhiteSpace(code) && slot.AutoUseEnabled, slot.AutoHpThresholdPercent);

    private async Task ChooseSkillAsync(string code)
    {
        if (_skills is null) return;
        var equippedSlot = _skills.Slots.FirstOrDefault(slot => string.Equals(slot.SkillCode, code, StringComparison.OrdinalIgnoreCase));
        if (equippedSlot is not null)
        {
            OpenEditor(equippedSlot.SlotIndex);
            return;
        }
        var target = _skills.Slots.FirstOrDefault(slot => slot.SlotIndex == _selectedSlotIndex);
        if (target is null) return;
        await SaveSlotAsync(target, code, target.AutoUseEnabled, target.AutoHpThresholdPercent);
        if (_skills is not null) OpenEditor(target.SlotIndex);
    }

    private async Task MoveAsync(int from, int to)
    {
        if (_isSaving) return;
        _isSaving = true;
        _error = null;
        try
        {
            var (response, error) = await ApiService.SwapSkillSlotsAsync(CharacterId, from, to);
            if (response is not null)
            {
                _skills = response;
                if (_selectedSlotIndex == from) _selectedSlotIndex = to;
            }
            else _error = error;
        }
        catch { _error = "连接失败，请稍后重试。"; }
        finally { _isSaving = false; }
    }

    private static string GetError(string error) => error.Trim().Trim('"') switch
    {
        "LoadoutLocked" => "战斗进行时不能调整技能栏。",
        "SkillAlreadyEquipped" => "该技能已装备在其他槽位，可用箭头调整顺序。",
        "SkillNotLearned" => "该角色尚未学会这个技能。",
        "InvalidHpThreshold" => "自动使用阈值应为 1～100%。",
        "ConcurrencyConflict" => "技能栏状态已变化，请重试。",
        _ => error
    };

    private static string GetAutoConditionText(string condition) => condition switch
    {
        "LowestHpBelowThreshold" => "目标生命低于阈值时",
        "AllyHasDebuff" => "队友存在可净化状态时",
        "MonsterHasBuff" => "怪物存在可驱散增益时",
        "InterruptibleIntent" => "怪物预告可打断技能时",
        _ => "冷却结束后"
    };

    private static string GetSkillIcon(LearnedSkillResponse? skill) => skill?.EffectType switch
    {
        "Damage" => "✦", "Heal" => "+", "Guard" => "◆", "Cleanse" => "◇",
        "Dispel" => "✧", "Interrupt" => "⚡", "ApplyStatus" => "◉", _ => "+"
    };

    private static string GetEffectTone(LearnedSkillResponse? skill) => skill?.EffectType switch
    {
        "Damage" => "damage", "Heal" => "heal", "Guard" => "guard", "Cleanse" => "cleanse",
        "Dispel" => "dispel", "Interrupt" => "interrupt", "ApplyStatus" => "status", _ => "empty"
    };
}
