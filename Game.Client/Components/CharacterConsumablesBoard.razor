@using Game.Client.Services
@using Game.Shared.Dtos.Characters
@inject ApiService ApiService

<section class="consumables-board" aria-labelledby="consumables-title">
    <header class="consumables-board__header">
        <div>
            <h2 id="consumables-title">战斗补给</h2>
        </div>
        <div class="consumables-board__header-tools">
            @if (_data is not null)
            {
                <span class="consumables-board__summary">已配置 <strong>@_data.Slots.Count(slot => slot.ItemCode is not null) / @_data.Slots.Count</strong></span>
            }
            <button type="button" class="button button--quiet" @onclick="RefreshAsync" disabled="@(_isLoading || _isSaving)" aria-label="刷新补给数据">刷新</button>
        </div>
    </header>

    @if (_isLoading)
    {
        <GameStateCard Compact="true" Title="正在读取背包" Detail="同步库存与战斗补给槽…" />
    }
    else if (_data is null)
    {
        <GameStateCard Compact="true" Tone="error" Icon="!" Title="背包读取失败" Detail="@(_error ?? "暂时无法读取背包。")">
            <Actions><button type="button" class="button button--secondary" @onclick="RefreshAsync">重试</button></Actions>
        </GameStateCard>
    }
    else
    {
        var selectedSlot = _drafts.FirstOrDefault(slot => slot.SlotIndex == _selectedSlotIndex) ?? _drafts.OrderBy(slot => slot.SlotIndex).First();
        var selectedItem = _data.Items.FirstOrDefault(item => item.Code == selectedSlot.ItemCode);

        <div class="consumables-board__loadout" role="group" aria-label="战斗补给配置">
            @foreach (var slot in _drafts.OrderBy(slot => slot.SlotIndex))
            {
                var item = _data.Items.FirstOrDefault(item => item.Code == slot.ItemCode);
                <button type="button"
                        class="supply-loadout supply-loadout--@SlotTone(slot.SlotIndex) @(item is null ? "is-empty" : null) @(IsDirty(slot) ? "is-dirty" : null)"
                        disabled="@_isSaving" aria-haspopup="dialog"
                        aria-expanded="@(_isEditorOpen && slot.SlotIndex == _selectedSlotIndex ? "true" : "false")"
                        aria-label="@($"配置{Game.Shared.ConsumableRules.SlotName(slot.SlotIndex)}：{item?.Name ?? "未装备"}")"
                        @onclick="() => OpenEditor(slot.SlotIndex)" @key="slot.SlotIndex">
                    <span class="supply-loadout__heading">
                        <span class="supply-loadout__category"><span aria-hidden="true"></span>@Game.Shared.ConsumableRules.SlotName(slot.SlotIndex)</span>
                        <span class="supply-loadout__rule">@SlotRule(slot.SlotIndex)</span>
                    </span>
                    <span class="supply-loadout__main">
                        <span class="supply-loadout__art" aria-hidden="true">
                            @if (item is null) { <span>+</span> } else { <img src="@ItemArt.ForCode(item.Code)" alt="" /> }
                        </span>
                        <span class="supply-loadout__body">
                            <strong>@(item?.Name ?? "选择一瓶药剂")</strong>
                            <span class="supply-loadout__meta">
                                @if (item is null) { <span>空槽位 · 点击配置</span> }
                                else
                                {
                                    <span class="@(item.Quantity == 0 ? "is-depleted" : null)">库存 <b>@item.Quantity</b></span>
                                    <span>@SlotMode(slot, item)</span>
                                }
                            </span>
                        </span>
                        <span class="supply-loadout__action">@if (IsDirty(slot)) { <span>未保存</span> }<span aria-hidden="true">›</span></span>
                    </span>
                </button>
            }
        </div>
        <div class="consumables-board__tools">
            <details class="consumables-board__rules">
                <summary>使用规则 ⌄</summary>
                <p>点击出战槽选择药剂和自动使用条件；治疗与强化可同回合使用。战斗进行时无法更换补给。</p>
                <p>每名角色独立拥有库存。库存耗尽后保留配置，不会自动换药或购买。药剂与材料保存在角色仓库。</p>
            </details>
            <a href="/inventory?characterId=@CharacterId&amp;category=supplies">药剂仓库 ↗</a>
        </div>
        @if (_isEditorOpen)
        {
            <div class="consumables-board__editor-backdrop" @onclick="CloseEditor">
                <section class="consumables-board__editor" role="dialog" aria-modal="true" aria-labelledby="consumables-editor-title"
                         tabindex="-1" @ref="_editorDialog" @onclick:stopPropagation="true" @onkeydown="HandleEditorKeyDown">
                    <header>
                        <div><span>@($"编辑{Game.Shared.ConsumableRules.SlotName(_selectedSlotIndex)}槽")</span><strong id="consumables-editor-title">@(selectedItem?.Name ?? "未装备道具")</strong></div>
                        <div class="consumables-board__editor-status">
                            <small class="@(IsDirty(selectedSlot) ? "dirty" : null)">@(IsDirty(selectedSlot) ? "有未保存修改" : "设置已保存")</small>
                            <button type="button" class="consumables-board__editor-close" @onclick="CloseEditor" aria-label="关闭补给设置">×</button>
                        </div>
                    </header>
                    <label class="consumable-slot__field">
                        装备道具
                        <InventoryItemPicker Options="@SupplyOptions(selectedSlot)" Value="@selectedSlot.ItemCode" OnPick="code => UpdateItem(selectedSlot, code)" Title="@($"选择{Game.Shared.ConsumableRules.SlotName(selectedSlot.SlotIndex)}")" Hint="选择只修改草稿，点击保存后生效。" Disabled="@_isSaving" WarehouseRoute="@($"/inventory?characterId={CharacterId}&category=supplies")" />
                    </label>
                    @if (selectedItem is null)
                    {
                        <p class="consumables-board__empty-hint">选择背包中的道具，装备到当前槽位。</p>
                    }
                    else
                    {
                        @if (selectedItem.Kind == "OperationPotion")
                        {
                            <p class="consumables-board__item-description">@selectedItem.Description</p>
                            <p class="consumables-board__empty-hint">本轮副本首次参战时自动消耗 1 瓶，效果持续整轮。</p>
                        }
                        else
                        {
                        <p class="consumables-board__item-description">@selectedItem.Description</p>
                        <div class="consumables-board__automation">
                            <label class="consumable-slot__toggle">
                                <input type="checkbox" checked="@selectedSlot.AutoUseEnabled" @onchange="e => UpdateAuto(selectedSlot, e.Value is true)" disabled="@_isSaving" />
                                <span><strong>自动使用</strong><small>条件满足、次数和冷却允许时使用</small></span>
                            </label>
                            <SkillAutoConditionPicker ConditionOverride="@selectedSlot.AutoConditionOverride"
                                DefaultCondition="@selectedItem.DefaultAutoCondition" DefaultLabel="药剂默认"
                                Threshold="@selectedSlot.AutoHpThresholdPercent" Disabled="@_isSaving"
                                OnConditionChanged="condition => selectedSlot.AutoConditionOverride = condition"
                                OnThresholdChanged="threshold => selectedSlot.AutoHpThresholdPercent = threshold" />
                            <small>条件决定使用时机，药效只作用于自己。</small>
                        </div>
                        }
                    }
                    @if (selectedSlot.AutoHpThresholdPercent is < 1 or > 100) { <small class="consumable-slot__invalid">请输入 1%～100% 的阈值。</small> }
                    @if (_error is not null) { <p class="consumables-board__error" role="alert">@_error</p> }
                    <footer>
                        <small>战斗进行时无法修改编成</small>
                        <div>
                            <button type="button" class="button button--quiet" @onclick="CloseEditor">关闭</button>
                            <button type="button" class="button button--primary" @onclick="() => SaveAsync(selectedSlot)" disabled="@(_isSaving || !IsDirty(selectedSlot) || selectedSlot.AutoHpThresholdPercent is < 1 or > 100)">@(_isSaving ? "保存中…" : "保存设置")</button>
                        </div>
                    </footer>
                </section>
            </div>
        }

        @if (_error is not null && !_isEditorOpen) { <p class="consumables-board__error" role="alert">@_error</p> }
        @if (_notice is not null) { <p class="consumables-board__success" role="status">@_notice</p> }
    }
</section>

@code {
    [Parameter, EditorRequired]
    public int CharacterId { get; set; }
    [Parameter] public string? InitialItemCode { get; set; }
    private bool _initialItemApplied;
    private IReadOnlyList<InventoryItemPicker.Option> SupplyOptions(SlotDraft slot) => (_data?.Items ?? []).Where(item => Game.Shared.ConsumableRules.CanEquip(slot.SlotIndex, item.Kind) && (item.Quantity > 0 || _drafts.Any(draft => draft.ItemCode == item.Code))).Select(item => new InventoryItemPicker.Option(item.Code, item.Name, $"库存 {item.Quantity} · {item.Description}", ItemArt.ForCode(item.Code), IsUsedInOtherSlot(item.Code, slot.SlotIndex))).ToList();

    private static string SlotTone(int index) => index switch { 1 => "healing", 2 => "buff", _ => "flask" };
    private string SlotRule(int index) => index switch
    {
        1 => $"每轮副本 {_data?.HealingPotionUsesLimit} 次",
        2 => $"每轮副本 {_data?.BuffPotionUsesLimit} 次 · 短时增益",
        _ => "首次参战使用 · 整轮生效"
    };
    private static string SlotMode(SlotDraft slot, ConsumableItemResponse item) => item.Kind == "OperationPotion"
        ? "首次参战自动使用" : !slot.AutoUseEnabled ? "手动使用"
        : $"自动 · {Game.Shared.SkillAutoRules.Describe(slot.AutoConditionOverride ?? item.DefaultAutoCondition, slot.AutoHpThresholdPercent)}";
    private CharacterConsumablesResponse? _data;
    private readonly List<SlotDraft> _drafts = [];
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isEditorOpen;
    private bool _focusEditor;
    private int _selectedSlotIndex = 1;
    private string? _error;
    private string? _notice;
    private ElementReference _editorDialog;

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusEditor) return;
        _focusEditor = false;
        await _editorDialog.FocusAsync();
    }

    private Task LoadAsync() => ReadAsync(false);
    private Task RefreshAsync() => ReadAsync(true);
    private async Task ReadAsync(bool forceRefresh)
    {
        _isLoading = true;
        _error = null;
        _notice = null;
        try
        {
            var (response, error) = await ApiService.GetCharacterConsumablesAsync(CharacterId, forceRefresh);
            _data = response;
            _error = GetError(error);
            if (response is not null)
            {
                SetDrafts(response);
                _isEditorOpen = false;
                if (!_initialItemApplied && InitialItemCode is not null) { _initialItemApplied = true; ChooseItem(InitialItemCode); }
            }
        }
        catch
        {
            _data = null;
            _error = "连接失败，请稍后重试。";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SetDrafts(CharacterConsumablesResponse response)
    {
        _drafts.Clear();
        _drafts.AddRange(response.Slots.Select(slot => new SlotDraft
        {
            SlotIndex = slot.SlotIndex,
            ItemCode = slot.ItemCode,
            AutoUseEnabled = slot.AutoUseEnabled,
            AutoConditionOverride = slot.AutoConditionOverride,
            AutoHpThresholdPercent = slot.AutoHpThresholdPercent
        }));
        if (_drafts.All(slot => slot.SlotIndex != _selectedSlotIndex))
        {
            _selectedSlotIndex = _drafts.OrderBy(slot => slot.SlotIndex).FirstOrDefault()?.SlotIndex ?? 1;
        }
    }

    private void OpenEditor(int slotIndex)
    {
        _selectedSlotIndex = slotIndex;
        _isEditorOpen = true;
        _focusEditor = true;
        _error = null;
        _notice = null;
    }

    private void CloseEditor() => _isEditorOpen = false;

    private void HandleEditorKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseEditor();
    }

    private void UpdateItem(SlotDraft slot, string? code)
    {
        if (slot.ItemCode != code)
        {
            var item = _data?.Items.FirstOrDefault(item => item.Code == code);
            slot.AutoConditionOverride = null;
            slot.AutoHpThresholdPercent = item?.DefaultAutoHpThresholdPercent ?? Game.Shared.ConsumableRules.DefaultAutoHpThresholdPercent;
        }
        slot.ItemCode = string.IsNullOrEmpty(code) ? null : code;
        if (slot.ItemCode is null)
        {
            slot.AutoUseEnabled = false;
            if (slot.AutoHpThresholdPercent is < 1 or > 100) slot.AutoHpThresholdPercent = Game.Shared.ConsumableRules.DefaultAutoHpThresholdPercent;
        }
        _error = null;
        _notice = null;
    }

    private void UpdateThreshold(SlotDraft slot, string? value)
    {
        slot.AutoHpThresholdPercent = int.TryParse(value, out var threshold) ? threshold : 0;
        _error = null;
        _notice = null;
    }

    private void UpdateAuto(SlotDraft slot, bool enabled)
    {
        slot.AutoUseEnabled = enabled;
        _error = null;
        _notice = null;
    }

    private void ChooseItem(string itemCode)
    {
        var item = _data?.Items.FirstOrDefault(entry => entry.Code == itemCode);
        if (item is null) return;
        var equippedSlot = _drafts.FirstOrDefault(slot => slot.ItemCode == itemCode);
        if (equippedSlot is not null)
        {
            OpenEditor(equippedSlot.SlotIndex);
            return;
        }
        _selectedSlotIndex = item.Kind switch
        {
            "Healing" => Game.Shared.ConsumableRules.HealingPotionSlotIndex,
            "CombatBuff" => Game.Shared.ConsumableRules.BuffPotionSlotIndex,
            "OperationPotion" => Game.Shared.ConsumableRules.OperationPotionSlotIndex,
            _ => _selectedSlotIndex
        };
        var target = _drafts.FirstOrDefault(slot => slot.SlotIndex == _selectedSlotIndex);
        if (target is not null)
        {
            UpdateItem(target, itemCode);
            _isEditorOpen = true;
            _focusEditor = true;
        }
    }

    private bool IsUsedInOtherSlot(string itemCode, int slotIndex) =>
        _drafts.Any(slot => slot.SlotIndex != slotIndex && slot.ItemCode == itemCode);

    private bool IsDirty(SlotDraft draft)
    {
        var saved = _data?.Slots.FirstOrDefault(slot => slot.SlotIndex == draft.SlotIndex);
        return saved is not null && (saved.ItemCode != draft.ItemCode ||
            saved.AutoUseEnabled != draft.AutoUseEnabled ||
            saved.AutoConditionOverride != draft.AutoConditionOverride ||
            saved.AutoHpThresholdPercent != draft.AutoHpThresholdPercent);
    }

    private async Task SaveAsync(SlotDraft slot)
    {
        if (_isSaving || !IsDirty(slot)) return;
        _isSaving = true;
        _error = null;
        _notice = null;
        try
        {
            var (response, error) = await ApiService.SetConsumableSlotAsync(CharacterId, slot.SlotIndex,
                new SetConsumableSlotRequest
                {
                    ItemCode = slot.ItemCode,
                    AutoUseEnabled = slot.AutoUseEnabled,
                    AutoConditionOverride = slot.AutoConditionOverride,
                    AutoHpThresholdPercent = slot.AutoHpThresholdPercent
                });
            if (response is null)
            {
                _error = GetError(error) ?? "保存失败，请稍后重试。";
                return;
            }
            _data = response;
            var saved = response.Slots.Single(item => item.SlotIndex == slot.SlotIndex);
            slot.ItemCode = saved.ItemCode;
            slot.AutoUseEnabled = saved.AutoUseEnabled;
            slot.AutoConditionOverride = saved.AutoConditionOverride;
            slot.AutoHpThresholdPercent = saved.AutoHpThresholdPercent;
            _notice = $"{Game.Shared.ConsumableRules.SlotName(slot.SlotIndex)}槽已保存。";
            _isEditorOpen = false;
        }
        catch
        {
            _error = "连接失败，请稍后重试。";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static string? GetError(string? error) => error?.Trim().Trim('"') switch
    {
        null or "" => null,
        "LoadoutLocked" => "角色已入场，请先离场或移出角色后再调整补给槽。",
        "ConsumableAlreadyEquipped" => "该道具已装备在另一个补给槽。",
        "InvalidHpThreshold" => "HP 阈值必须在 1%～100% 之间。",
        "InvalidAutoCondition" => "请选择有效的自动使用条件。",
        "UnknownConsumable" => "道具不存在，请刷新背包。",
        "WrongConsumableSlot" => "治疗药水、强化药水与合剂必须装备到各自的固定槽位。",
        "ConcurrencyConflict" => "角色或房间状态已变化，请刷新后重试。",
        "NotOwner" => "只能调整自己的角色。",
        _ => "补给操作失败，请稍后重试。"
    };

    private sealed class SlotDraft
    {
        public int SlotIndex { get; init; }
        public string? ItemCode { get; set; }
        public bool AutoUseEnabled { get; set; }
        public string? AutoConditionOverride { get; set; }
        public int AutoHpThresholdPercent { get; set; }
    }
}
