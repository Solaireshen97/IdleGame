@using Game.Client.Services
@using Game.Shared.Dtos.Characters
@inject ApiService ApiService

<section class="consumables-board" aria-labelledby="consumables-title">
    <header class="consumables-board__header">
        <div>
            <span class="consumables-board__eyebrow">CHARACTER INVENTORY</span>
            <h2 id="consumables-title">背包与补给槽</h2>
            <p>每名角色有自己的道具库存，战斗中可从已装备的补给槽使用道具。</p>
        </div>
        <div class="consumables-board__header-tools">
            @if (_data is not null)
            {
                <span class="consumables-board__summary"><strong>@_data.Slots.Count(slot => slot.ItemCode is not null) / @_data.Slots.Count</strong> 已配置 · <strong>@_data.Items.Sum(item => item.Quantity)</strong> 库存</span>
            }
            <button type="button" class="button button--quiet" @onclick="LoadAsync" disabled="@(_isLoading || _isSaving)" aria-label="刷新补给数据">刷新</button>
        </div>
    </header>

    @if (_isLoading)
    {
        <GameStateCard Compact="true" Title="正在读取背包" Detail="同步库存与战斗补给槽…" />
    }
    else if (_data is null)
    {
        <GameStateCard Compact="true" Tone="error" Icon="!" Title="背包读取失败" Detail="@(_error ?? "暂时无法读取背包。")">
            <Actions><button type="button" class="button button--secondary" @onclick="LoadAsync">重试</button></Actions>
        </GameStateCard>
    }
    else
    {
        var selectedSlot = _drafts.FirstOrDefault(slot => slot.SlotIndex == _selectedSlotIndex) ?? _drafts.OrderBy(slot => slot.SlotIndex).First();
        var selectedItem = _data.Items.FirstOrDefault(item => item.Code == selectedSlot.ItemCode);

        <div class="consumables-board__section-heading">
            <div><span class="consumables-board__eyebrow">BATTLE LOADOUT</span><h3>补给编成</h3></div>
            <small>两格普通消耗品，可手动使用或设置 Auto</small>
        </div>

        <div class="consumables-board__slot-strip" role="group" aria-label="战斗补给槽位">
            @foreach (var slot in _drafts.Where(slot => slot.SlotIndex <= Game.Shared.ConsumableRules.SlotCount).OrderBy(slot => slot.SlotIndex))
            {
                var equippedItem = _data.Items.FirstOrDefault(item => item.Code == slot.ItemCode);
                <button type="button"
                        class="consumables-board__slot-card @(equippedItem is null ? "consumables-board__slot-card--empty" : null) @(IsDirty(slot) ? "consumables-board__slot-card--dirty" : null) @(slot.SlotIndex == _selectedSlotIndex ? "active" : null)"
                        aria-haspopup="dialog"
                        aria-expanded="@(_isEditorOpen && slot.SlotIndex == _selectedSlotIndex ? "true" : "false")"
                        aria-label="@($"{slot.SlotIndex} 号补给槽：{equippedItem?.Name ?? "空槽位"}")"
                        @onclick="() => OpenEditor(slot.SlotIndex)" @key="slot.SlotIndex">
                    <span class="consumables-board__slot-index">@slot.SlotIndex.ToString("00")</span>
                    <span class="inventory-item__icon" aria-hidden="true">@(equippedItem is null ? "+" : "✚")</span>
                    <span><strong>@(equippedItem?.Name ?? "空槽位")</strong><small>@(equippedItem is null ? "点击配置" : !slot.AutoUseEnabled ? "手动使用" : equippedItem.Kind == "Healing" ? $"AUTO · HP ≤ {slot.AutoHpThresholdPercent}%" : "AUTO · 条件满足时使用")</small></span>
                    @if (IsDirty(slot)) { <b>未保存</b> }
                </button>
            }
        </div>

        @if (_drafts.FirstOrDefault(slot => slot.SlotIndex == Game.Shared.ConsumableRules.OperationPotionSlotIndex) is { } potionSlot)
        {
            var potionItem = _data.Items.FirstOrDefault(item => item.Code == potionSlot.ItemCode);
            <div class="consumables-board__section-heading consumables-board__operation-heading">
                <div><span class="consumables-board__eyebrow">OPERATION POTION</span><h3>作战药剂</h3></div>
                <small>本场首次结算使用 1 瓶，效果持续整场</small>
            </div>
            <button type="button" class="consumables-board__slot-card consumables-board__slot-card--operation @(potionItem is null ? "consumables-board__slot-card--empty" : null) @(IsDirty(potionSlot) ? "consumables-board__slot-card--dirty" : null) @(potionSlot.SlotIndex == _selectedSlotIndex ? "active" : null)"
                    aria-haspopup="dialog" aria-expanded="@(_isEditorOpen && potionSlot.SlotIndex == _selectedSlotIndex ? "true" : "false")"
                    aria-label="@($"作战药剂槽：{potionItem?.Name ?? "空槽位"}")" @onclick="() => OpenEditor(potionSlot.SlotIndex)">
                <span class="consumables-board__slot-index">作战药剂</span>
                <span class="inventory-item__icon" aria-hidden="true">✦</span>
                <span><strong>@(potionItem?.Name ?? "未装备作战药剂")</strong><small>@(potionItem is null ? "点击配置" : $"{potionItem.Description} · 库存 {potionItem.Quantity}")</small></span>
                @if (IsDirty(potionSlot)) { <b>未保存</b> }
            </button>
        }

        <section class="consumables-board__inventory-section" aria-labelledby="inventory-title">
            <header class="consumables-board__section-heading">
                <div><span class="consumables-board__eyebrow">INVENTORY</span><h3 id="inventory-title">角色背包</h3></div>
                <small>点按道具后可装备到对应槽位 · 共 @_data.Items.Sum(item => item.Quantity) 件</small>
            </header>
            <div class="consumables-board__inventory">
                @if (!_data.Items.Any(item => item.Quantity > 0 || _drafts.Any(slot => slot.ItemCode == item.Code)))
                {
                    <p class="consumables-board__inventory-empty">背包里还没有可用道具，可前往商店补充。</p>
                }
                @foreach (var item in _data.Items.Where(item => item.Quantity > 0 || _drafts.Any(slot => slot.ItemCode == item.Code)))
                {
                    var equippedSlot = _drafts.FirstOrDefault(slot => slot.ItemCode == item.Code);
                    <button type="button" class="inventory-item @(equippedSlot is not null ? "inventory-item--equipped" : null)"
                            disabled="@_isSaving" @onclick="() => ChooseItem(item.Code)">
                        <span class="inventory-item__icon" aria-hidden="true">✚</span>
                        <span><strong>@item.Name</strong><small>@item.Description</small></span>
                        <span class="inventory-item__meta"><b>×@item.Quantity</b><small>@(equippedSlot is null ? "点击装备" : $"槽位 {equippedSlot.SlotIndex}")</small></span>
                    </button>
                }
            </div>
        </section>

        @if (_isEditorOpen)
        {
            <div class="consumables-board__editor-backdrop" @onclick="CloseEditor">
                <section class="consumables-board__editor" role="dialog" aria-modal="true" aria-labelledby="consumables-editor-title"
                         tabindex="-1" @ref="_editorDialog" @onclick:stopPropagation="true" @onkeydown="HandleEditorKeyDown">
                    <header>
                        <div><span>@(_selectedSlotIndex == Game.Shared.ConsumableRules.OperationPotionSlotIndex ? "编辑作战药剂" : $"编辑槽位 {_selectedSlotIndex:00}")</span><strong id="consumables-editor-title">@(selectedItem?.Name ?? "未装备道具")</strong></div>
                        <div class="consumables-board__editor-status">
                            <small class="@(IsDirty(selectedSlot) ? "dirty" : null)">@(IsDirty(selectedSlot) ? "有未保存修改" : "设置已保存")</small>
                            <button type="button" class="consumables-board__editor-close" @onclick="CloseEditor" aria-label="关闭补给设置">×</button>
                        </div>
                    </header>
                    <label class="consumable-slot__field">
                        装备道具
                        <select value="@(selectedSlot.ItemCode ?? string.Empty)" @onchange="e => UpdateItem(selectedSlot, e.Value?.ToString())" disabled="@_isSaving">
                            <option value="">不装备</option>
                            @foreach (var item in _data.Items.Where(item =>
                                (selectedSlot.SlotIndex == Game.Shared.ConsumableRules.OperationPotionSlotIndex) == (item.Kind == "OperationPotion") &&
                                (item.Quantity > 0 || _drafts.Any(slot => slot.ItemCode == item.Code))))
                            {
                                <option value="@item.Code" disabled="@IsUsedInOtherSlot(item.Code, selectedSlot.SlotIndex)">@item.Name（库存 @item.Quantity）</option>
                            }
                        </select>
                    </label>
                    @if (selectedItem is null)
                    {
                        <p class="consumables-board__empty-hint">选择背包中的道具，装备到当前槽位。</p>
                    }
                    else
                    {
                        @if (selectedItem.Kind == "OperationPotion")
                        {
                            <p class="consumables-board__item-description">本场首次参与回合结算时消耗 1 瓶，<span>@selectedItem.Description</span>，整场生效。无需开启 Auto。</p>
                        }
                        else
                        {
                        <p class="consumables-board__item-description">@selectedItem.Description</p>
                        <div class="consumables-board__automation">
                            <label class="consumable-slot__toggle">
                                <input type="checkbox" checked="@selectedSlot.AutoUseEnabled" @onchange="e => UpdateAuto(selectedSlot, e.Value is true)" disabled="@_isSaving" />
                                <span><strong>自动使用</strong><small>@(selectedItem.Kind == "Healing" ? "生命低于设定阈值时" : selectedItem.WeaponSkillCode == "weapon-enmity" ? "生命不高于 50%、效果结束且冷却就绪时" : "效果结束且冷却就绪时")</small></span>
                            </label>
                            @if (selectedItem.Kind == "Healing")
                            {
                                <label class="consumable-slot__threshold">
                                    <span>HP ≤</span>
                                    <input type="number" min="1" max="100" value="@selectedSlot.AutoHpThresholdPercent" @onchange="e => UpdateThreshold(selectedSlot, e.Value?.ToString())" disabled="@_isSaving" />
                                    <span>%</span>
                                </label>
                            }
                        </div>
                        }
                    }
                    @if (selectedSlot.AutoHpThresholdPercent is < 1 or > 100) { <small class="consumable-slot__invalid">请输入 1%～100% 的阈值。</small> }
                    <footer>
                        <small>战斗进行时无法修改编成</small>
                        <div>
                            <button type="button" class="button button--quiet" @onclick="CloseEditor">关闭</button>
                            <button type="button" class="button button--primary" @onclick="() => SaveAsync(selectedSlot)" disabled="@(_isSaving || !IsDirty(selectedSlot) || selectedSlot.AutoHpThresholdPercent is < 1 or > 100)">@(_isSaving ? "保存中…" : "保存设置")</button>
                        </div>
                    </footer>
                </section>
            </div>
        }

        @if (_error is not null) { <p class="consumables-board__error" role="alert">@_error</p> }
        @if (_notice is not null) { <p class="consumables-board__success" role="status">@_notice</p> }
        <p class="consumables-board__footnote">普通消耗品可手动排队到下一次结算；作战药剂独立使用，缺货时跳过本场。战斗进行时补给槽无法调整。</p>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public int CharacterId { get; set; }

    private CharacterConsumablesResponse? _data;
    private readonly List<SlotDraft> _drafts = [];
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isEditorOpen;
    private bool _focusEditor;
    private int _selectedSlotIndex = 1;
    private string? _error;
    private string? _notice;
    private ElementReference _editorDialog;

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusEditor) return;
        _focusEditor = false;
        await _editorDialog.FocusAsync();
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        _notice = null;
        try
        {
            var (response, error) = await ApiService.GetCharacterConsumablesAsync(CharacterId);
            _data = response;
            _error = GetError(error);
            if (response is not null)
            {
                SetDrafts(response);
                _isEditorOpen = false;
            }
        }
        catch
        {
            _data = null;
            _error = "连接失败，请稍后重试。";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SetDrafts(CharacterConsumablesResponse response)
    {
        _drafts.Clear();
        _drafts.AddRange(response.Slots.Select(slot => new SlotDraft
        {
            SlotIndex = slot.SlotIndex,
            ItemCode = slot.ItemCode,
            AutoUseEnabled = slot.AutoUseEnabled,
            AutoHpThresholdPercent = slot.AutoHpThresholdPercent
        }));
        if (_drafts.All(slot => slot.SlotIndex != _selectedSlotIndex))
        {
            _selectedSlotIndex = _drafts.OrderBy(slot => slot.SlotIndex).FirstOrDefault()?.SlotIndex ?? 1;
        }
    }

    private void OpenEditor(int slotIndex)
    {
        _selectedSlotIndex = slotIndex;
        _isEditorOpen = true;
        _focusEditor = true;
        _error = null;
        _notice = null;
    }

    private void CloseEditor() => _isEditorOpen = false;

    private void HandleEditorKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseEditor();
    }

    private void UpdateItem(SlotDraft slot, string? code)
    {
        slot.ItemCode = string.IsNullOrEmpty(code) ? null : code;
        if (slot.ItemCode is null)
        {
            slot.AutoUseEnabled = false;
            if (slot.AutoHpThresholdPercent is < 1 or > 100) slot.AutoHpThresholdPercent = 50;
        }
        _error = null;
        _notice = null;
    }

    private void UpdateThreshold(SlotDraft slot, string? value)
    {
        slot.AutoHpThresholdPercent = int.TryParse(value, out var threshold) ? threshold : 0;
        _error = null;
        _notice = null;
    }

    private void UpdateAuto(SlotDraft slot, bool enabled)
    {
        slot.AutoUseEnabled = enabled;
        _error = null;
        _notice = null;
    }

    private void ChooseItem(string itemCode)
    {
        var item = _data?.Items.FirstOrDefault(entry => entry.Code == itemCode);
        if (item is null) return;
        var equippedSlot = _drafts.FirstOrDefault(slot => slot.ItemCode == itemCode);
        if (equippedSlot is not null)
        {
            OpenEditor(equippedSlot.SlotIndex);
            return;
        }
        if (item.Kind == "OperationPotion") _selectedSlotIndex = Game.Shared.ConsumableRules.OperationPotionSlotIndex;
        else if (_selectedSlotIndex == Game.Shared.ConsumableRules.OperationPotionSlotIndex) _selectedSlotIndex = 1;
        var target = _drafts.FirstOrDefault(slot => slot.SlotIndex == _selectedSlotIndex);
        if (target is not null)
        {
            UpdateItem(target, itemCode);
            _isEditorOpen = true;
            _focusEditor = true;
        }
    }

    private bool IsUsedInOtherSlot(string itemCode, int slotIndex) =>
        _drafts.Any(slot => slot.SlotIndex != slotIndex && slot.ItemCode == itemCode);

    private bool IsDirty(SlotDraft draft)
    {
        var saved = _data?.Slots.FirstOrDefault(slot => slot.SlotIndex == draft.SlotIndex);
        return saved is not null && (saved.ItemCode != draft.ItemCode ||
            saved.AutoUseEnabled != draft.AutoUseEnabled ||
            saved.AutoHpThresholdPercent != draft.AutoHpThresholdPercent);
    }

    private async Task SaveAsync(SlotDraft slot)
    {
        if (_isSaving || !IsDirty(slot)) return;
        _isSaving = true;
        _error = null;
        _notice = null;
        try
        {
            var (response, error) = await ApiService.SetConsumableSlotAsync(CharacterId, slot.SlotIndex,
                new SetConsumableSlotRequest
                {
                    ItemCode = slot.ItemCode,
                    AutoUseEnabled = slot.AutoUseEnabled,
                    AutoHpThresholdPercent = slot.AutoHpThresholdPercent
                });
            if (response is null)
            {
                _error = GetError(error) ?? "保存失败，请稍后重试。";
                return;
            }
            _data = response;
            var saved = response.Slots.Single(item => item.SlotIndex == slot.SlotIndex);
            slot.ItemCode = saved.ItemCode;
            slot.AutoUseEnabled = saved.AutoUseEnabled;
            slot.AutoHpThresholdPercent = saved.AutoHpThresholdPercent;
            _notice = $"补给槽 {slot.SlotIndex} 已保存。";
            _isEditorOpen = false;
        }
        catch
        {
            _error = "连接失败，请稍后重试。";
        }
        finally
        {
            _isSaving = false;
        }
    }

    private static string? GetError(string? error) => error?.Trim().Trim('"') switch
    {
        null or "" => null,
        "LoadoutLocked" => "战斗正在进行，请在战斗结束后调整补给槽。",
        "ConsumableAlreadyEquipped" => "该道具已装备在另一个补给槽。",
        "InvalidHpThreshold" => "HP 阈值必须在 1%～100% 之间。",
        "UnknownConsumable" => "道具不存在，请刷新背包。",
        "WrongConsumableSlot" => "普通消耗品与作战药剂必须装备到各自的槽位。",
        "ConcurrencyConflict" => "角色或房间状态已变化，请刷新后重试。",
        "NotOwner" => "只能调整自己的角色。",
        _ => "补给操作失败，请稍后重试。"
    };

    private sealed class SlotDraft
    {
        public int SlotIndex { get; init; }
        public string? ItemCode { get; set; }
        public bool AutoUseEnabled { get; set; }
        public int AutoHpThresholdPercent { get; set; }
    }
}
