@using Game.Shared
@using Game.Shared.Dtos
@using Microsoft.AspNetCore.Components.Web

<div class="monster-detail-overlay" @onclick="CloseAsync" @onkeydown="HandleKeyDown" @onkeydown:stopPropagation>
    <section class="monster-detail-dialog @(!ShowDrops && SelectedMonster is { } activeMonster ? $"monster-detail-dialog--{activeMonster.Element.ToString().ToLowerInvariant()}" : "")"
             role="dialog" aria-modal="true" aria-labelledby="monster-detail-title" @onclick:stopPropagation>
        <header class="monster-detail-header">
            <div>
                <span class="monster-detail-kicker">@Dungeon.Name · @(ShowDrops ? "REWARD PREVIEW" : "ENEMY PROFILE")</span>
                <h2 id="monster-detail-title">@(ShowDrops ? "掉落预览" : "怪物信息")</h2>
                <p>@(ShowDrops ? "按怪物查看可能掉落与通关奖励" : $"共 {Dungeon.Monsters.Count} 名敌人 · {Dungeon.WaveCount} 波")</p>
            </div>
            <button type="button" class="monster-detail-close" @onclick="CloseAsync" @ref="_monsterCloseButton" aria-label="关闭详情">×</button>
        </header>

        <div class="monster-detail-body">
            @if (ShowDrops)
            {
                @foreach (var monster in Dungeon.Monsters.OrderBy(item => item.WaveNumber).ThenBy(item => item.Position))
                {
                    <section class="monster-detail-drops" aria-label="@monster.Name 的掉落">
                        <div class="monster-detail-section-heading">
                            <h3><span class="monster-detail-element monster-detail-element--@monster.Element.ToString().ToLowerInvariant()">@WeaponRules.ElementName(monster.Element)属性</span> @monster.Name</h3>
                            <small>第 @monster.WaveNumber 波 · @(monster.IsBoss ? "首领" : "普通敌人")</small>
                        </div>
                        @if (monster.Drops.Count == 0)
                        {
                            <p class="monster-detail-empty">没有额外物品掉落</p>
                        }
                        else
                        {
                            <ul>
                                @foreach (var drop in monster.Drops)
                                {
                                    <li>
                                        @if (drop.Weapon is not null)
                                        {
                                            <button type="button" class="monster-drop monster-drop--weapon" @onclick="() => OpenWeapon(drop)" aria-haspopup="dialog" aria-label="查看武器 @drop.Name 的属性">
                                                <span class="monster-drop-icon" aria-hidden="true">⚔</span>
                                                <span class="monster-drop-copy"><strong>@drop.Name <small>× @drop.Quantity</small></strong><small>武器 · 点击查看属性</small></span>
                                                <span class="monster-drop-rate">@drop.ChancePercent.ToString("0.##")% <span aria-hidden="true">›</span></span>
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="monster-drop">
                                                <span class="monster-drop-icon" aria-hidden="true">✦</span>
                                                <span class="monster-drop-copy"><strong>@drop.Name <small>× @drop.Quantity</small></strong><small>@DropKindName(drop.Kind)</small></span>
                                                <span class="monster-drop-rate">@drop.ChancePercent.ToString("0.##")%</span>
                                            </div>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                }

                var completionRewards = Dungeon.RewardPreview.Where(reward => reward.Source is "通关奖励" or "首次通关").ToList();
                @if (completionRewards.Count > 0)
                {
                    <section class="monster-detail-drops" aria-label="通关奖励">
                        <div class="monster-detail-section-heading"><h3>通关奖励</h3><small>完成副本时判定</small></div>
                        <ul>
                            @foreach (var drop in completionRewards)
                            {
                                <li>
                                    @if (drop.Weapon is not null)
                                    {
                                        <button type="button" class="monster-drop monster-drop--weapon" @onclick="() => OpenWeapon(drop)" aria-haspopup="dialog" aria-label="查看武器 @drop.Name 的属性">
                                            <span class="monster-drop-icon" aria-hidden="true">⚔</span>
                                            <span class="monster-drop-copy"><strong>@drop.Name <small>× @drop.Quantity</small></strong><small>@drop.Source · 点击查看属性</small></span>
                                            <span class="monster-drop-rate">@drop.ChancePercent.ToString("0.##")% <span aria-hidden="true">›</span></span>
                                        </button>
                                    }
                                    else
                                    {
                                        <div class="monster-drop">
                                            <span class="monster-drop-icon" aria-hidden="true">✦</span>
                                            <span class="monster-drop-copy"><strong>@drop.Name <small>× @drop.Quantity</small></strong><small>@drop.Source · @DropKindName(drop.Kind)</small></span>
                                            <span class="monster-drop-rate">@drop.ChancePercent.ToString("0.##")%</span>
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    </section>
                }
                <p class="monster-weapon-note">掉率为每次对应击败或通关时的判定概率。</p>
            }
            else if (SelectedMonster is { } monster)
            {
                <div class="monster-selector" aria-label="选择怪物">
                    @for (var index = 0; index < Dungeon.Monsters.Count; index++)
                    {
                        var option = Dungeon.Monsters[index];
                        var optionIndex = index;
                        <button type="button" class="monster-selector__item @(index == _selectedMonsterIndex ? "monster-selector__item--active" : "")"
                                aria-pressed="@(index == _selectedMonsterIndex)" @onclick="() => SelectMonster(optionIndex)">
                            <small>第 @option.WaveNumber 波</small><strong>@option.Name</strong>
                        </button>
                    }
                </div>
                <div class="monster-detail-identity">
                    <span class="monster-detail-element">@WeaponRules.ElementName(monster.Element)属性</span>
                    <div><strong>@monster.Name</strong><small>@(monster.IsBoss ? "首领" : "普通敌人") · 第 @monster.WaveNumber 波 / 第 @monster.Position 位</small></div>
                </div>
                <div class="monster-detail-stats" aria-label="怪物属性">
                    <div><span>生命</span><strong>@monster.MaxHp</strong></div>
                    <div><span>攻击</span><strong>@monster.Attack</strong></div>
                    <div><span>防御</span><strong>@monster.Defense</strong></div>
                </div>
                <p class="monster-weapon-note">掉落物请点击创建栏的“掉落预览”查看。</p>
            }
            else
            {
                <p class="monster-detail-empty">此副本暂无怪物资料。</p>
            }
        </div>
    </section>

    @if (_selectedWeapon is { Weapon: { } weapon } selectedDrop)
    {
        <div class="monster-weapon-overlay" @onclick="CloseWeapon" @onclick:stopPropagation @onkeydown="HandleKeyDown" @onkeydown:stopPropagation>
            <section class="monster-weapon-dialog monster-weapon-dialog--@weapon.Element.ToString().ToLowerInvariant()"
                     role="dialog" aria-modal="true" aria-labelledby="monster-weapon-title" @onclick:stopPropagation>
                <header class="monster-detail-header">
                    <div>
                        <span class="monster-detail-kicker">WEAPON PREVIEW · @WeaponRules.ElementName(weapon.Element)属性</span>
                        <h2 id="monster-weapon-title">@selectedDrop.Name</h2>
                        <p>基础模板 · Lv.@weapon.ItemLevel</p>
                    </div>
                    <button type="button" class="monster-detail-close" @onclick="CloseWeapon" @ref="_weaponCloseButton" aria-label="返回掉落预览">×</button>
                </header>
                <div class="monster-detail-body">
                    <div class="monster-detail-stats" aria-label="武器基础属性">
                        <div><span>属性</span><strong>@WeaponRules.ElementName(weapon.Element)</strong></div>
                        <div><span>攻击</span><strong>+@weapon.Attack</strong></div>
                        <div><span>生命</span><strong>+@weapon.MaxHp</strong></div>
                    </div>
                    <section class="monster-detail-drops" aria-labelledby="monster-weapon-skills-title">
                        <div class="monster-detail-section-heading"><h3 id="monster-weapon-skills-title">武器技能</h3></div>
                        @if (weapon.Skills.Count == 0)
                        {
                            <p class="monster-detail-empty">这把武器没有附带技能。</p>
                        }
                        else
                        {
                            <ul class="monster-weapon-skills">
                                @foreach (var skill in weapon.Skills)
                                {
                                    <li><strong>@skill.Name <small>Lv.@skill.Level</small></strong><span>@skill.Description</span></li>
                                }
                            </ul>
                        }
                    </section>
                    <p class="monster-weapon-note">显示的是基础属性；实际掉落品质可能提高技能等级。</p>
                    <button type="button" class="monster-weapon-back" @onclick="CloseWeapon">← 返回掉落预览</button>
                </div>
            </section>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public DungeonSummaryResponse Dungeon { get; set; } = null!;
    [Parameter] public bool ShowDrops { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private DungeonRewardPreviewResponse? _selectedWeapon;
    private ElementReference _monsterCloseButton;
    private ElementReference _weaponCloseButton;
    private bool _focusMonster = true;
    private bool _focusWeapon;
    private int _selectedMonsterIndex;
    private MonsterPreviewResponse? SelectedMonster => Dungeon.Monsters.ElementAtOrDefault(_selectedMonsterIndex);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusWeapon)
        {
            _focusWeapon = false;
            await _weaponCloseButton.FocusAsync();
        }
        else if (_focusMonster)
        {
            _focusMonster = false;
            await _monsterCloseButton.FocusAsync();
        }
    }

    private void SelectMonster(int index) => _selectedMonsterIndex = index;
    private void OpenWeapon(DungeonRewardPreviewResponse drop) { _selectedWeapon = drop; _focusWeapon = true; }
    private void CloseWeapon() { _selectedWeapon = null; _focusMonster = true; }

    private async Task CloseAsync()
    {
        if (_selectedWeapon is not null) CloseWeapon();
        else await OnClose.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Escape") return;
        if (_selectedWeapon is not null) CloseWeapon();
        else await OnClose.InvokeAsync();
    }

    private static string DropKindName(string kind) => kind switch
    {
        "Consumable" => "消耗品",
        "Material" => "材料",
        _ => "掉落物"
    };
}
