@using Game.Shared
@using Game.Client.Services
@using Game.Shared.Dtos
@using Game.Shared.Dtos.Characters
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime Js

<div class="monster-detail-overlay" @onclick="CloseAsync" @onkeydown="HandleKeyDown" @onkeydown:stopPropagation>
    <section class="monster-detail-dialog @(!_showDrops && SelectedMonster is { } activeMonster ? $"monster-detail-dialog--{activeMonster.Element.ToString().ToLowerInvariant()}" : "")"
             role="dialog" aria-modal="true" aria-labelledby="monster-detail-title" @onclick:stopPropagation @ref="_dialog">
        <header class="monster-detail-header">
            <div>
                <span class="monster-detail-kicker">@Dungeon.RegionName · @Dungeon.Name</span>
                <h2 id="monster-detail-title">创建战斗</h2>
                <p>@Dungeon.WaveCount 波 · @Dungeon.MonsterCount 名敌人 · 推荐 Lv.@Dungeon.RecommendedLevel</p>
            </div>
            <button type="button" class="monster-detail-close" @onclick="CloseAsync" @ref="_monsterCloseButton" aria-label="关闭详情">×</button>
        </header>

        <div class="monster-detail-tabs" role="tablist" aria-label="副本资料">
            <button type="button" role="tab" aria-selected="@(!_showDrops ? "true" : "false")" class="@(!_showDrops ? "monster-detail-tabs__active" : null)" @onclick="() => _showDrops = false">怪物信息</button>
            <button type="button" role="tab" aria-selected="@(_showDrops ? "true" : "false")" class="@(_showDrops ? "monster-detail-tabs__active" : null)" @onclick="() => _showDrops = true">掉落预览</button>
        </div>

        <div class="monster-detail-body" @key="_showDrops">
            @if (_showDrops)
            {
                @foreach (var monster in Dungeon.Monsters.OrderBy(item => item.WaveNumber).ThenBy(item => item.Position))
                {
                    <section class="monster-detail-drops" aria-label="@monster.Name 的掉落">
                        <div class="monster-detail-section-heading">
                            <h3><img class="monster-detail-heading-art" src="@MonsterArt.ForName(monster.Name)" alt="" loading="lazy" /><span class="monster-detail-element monster-detail-element--@monster.Element.ToString().ToLowerInvariant()">@WeaponRules.ElementName(monster.Element)属性</span> @monster.Name</h3>
                            <small>第 @monster.WaveNumber 波 · @(monster.IsBoss ? "首领" : "普通敌人")</small>
                        </div>
                        @if (monster.Drops.Count == 0)
                        {
                            <p class="monster-detail-empty">没有额外物品掉落</p>
                        }
                        else
                        {
                            <ul>
                                @foreach (var drop in monster.Drops)
                                {
                                    <li>
                                        @if (drop.Weapon is not null)
                                        {
                                            <button type="button" class="monster-drop monster-drop--weapon" @onclick="() => OpenWeapon(drop)" aria-haspopup="dialog" aria-label="查看武器 @drop.Name 的属性">
                                                <span class="monster-drop-icon" aria-hidden="true"><img src="@WeaponArt.ForName(drop.Name)" alt="" loading="lazy" /></span>
                                                <span class="monster-drop-copy"><strong>@drop.Name <small>× @drop.Quantity</small></strong><small>武器 · 点击查看属性</small></span>
                                                <span class="monster-drop-rate">@drop.ChancePercent.ToString("0.##")% <span aria-hidden="true">›</span></span>
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="monster-drop">
                                                <span class="monster-drop-icon" aria-hidden="true">@if (ItemArt.ForCode(drop.Code) is { } dropArt) { <img src="@dropArt" alt="" loading="lazy" /> } else { <text>✦</text> }</span>
                                                <span class="monster-drop-copy"><strong>@drop.Name <small>× @drop.Quantity</small></strong><small>@DropKindName(drop.Kind)</small></span>
                                                <span class="monster-drop-rate">@drop.ChancePercent.ToString("0.##")%</span>
                                            </div>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                }

                var completionRewards = Dungeon.RewardPreview.Where(reward => reward.Source is "通关奖励" or "首次通关").ToList();
                @if (completionRewards.Count > 0)
                {
                    <section class="monster-detail-drops" aria-label="通关奖励">
                        <div class="monster-detail-section-heading"><h3>通关奖励</h3><small>完成副本时判定</small></div>
                        <ul>
                            @foreach (var drop in completionRewards)
                            {
                                <li>
                                    @if (drop.Weapon is not null)
                                    {
                                        <button type="button" class="monster-drop monster-drop--weapon" @onclick="() => OpenWeapon(drop)" aria-haspopup="dialog" aria-label="查看武器 @drop.Name 的属性">
                                            <span class="monster-drop-icon" aria-hidden="true"><img src="@WeaponArt.ForName(drop.Name)" alt="" loading="lazy" /></span>
                                            <span class="monster-drop-copy"><strong>@drop.Name <small>× @drop.Quantity</small></strong><small>@drop.Source · 点击查看属性</small></span>
                                            <span class="monster-drop-rate">@drop.ChancePercent.ToString("0.##")% <span aria-hidden="true">›</span></span>
                                        </button>
                                    }
                                    else
                                    {
                                        <div class="monster-drop">
                                            <span class="monster-drop-icon" aria-hidden="true">@if (ItemArt.ForCode(drop.Code) is { } dropArt) { <img src="@dropArt" alt="" loading="lazy" /> } else { <text>✦</text> }</span>
                                            <span class="monster-drop-copy"><strong>@drop.Name <small>× @drop.Quantity</small></strong><small>@drop.Source · @DropKindName(drop.Kind)</small></span>
                                            <span class="monster-drop-rate">@drop.ChancePercent.ToString("0.##")%</span>
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    </section>
                }
                <p class="monster-weapon-note">掉率为每次对应击败或通关时的判定概率。</p>
            }
            else if (SelectedMonster is { } monster)
            {
                <div class="monster-selector" aria-label="选择怪物">
                    @for (var index = 0; index < Dungeon.Monsters.Count; index++)
                    {
                        var option = Dungeon.Monsters[index];
                        var optionIndex = index;
                        <button type="button" class="monster-selector__item @(index == _selectedMonsterIndex ? "monster-selector__item--active" : "")"
                                aria-pressed="@(index == _selectedMonsterIndex ? "true" : "false")" @onclick="() => SelectMonster(optionIndex)">
                            <img src="@MonsterArt.ForName(option.Name)" alt="" loading="lazy" /><span><small>第 @option.WaveNumber 波</small><strong>@option.Name</strong></span>
                        </button>
                    }
                </div>
                <div class="monster-detail-identity">
                    <img class="monster-detail-identity-art" src="@MonsterArt.ForName(monster.Name)" alt="" />
                    <span class="monster-detail-element">@WeaponRules.ElementName(monster.Element)属性</span>
                    <div><strong>@monster.Name</strong><small>@(monster.IsBoss ? "首领" : "普通敌人") · 第 @monster.WaveNumber 波 / 第 @monster.Position 位</small></div>
                </div>
                <div class="monster-detail-stats" aria-label="怪物属性">
                    <div><span>生命</span><strong>@monster.MaxHp</strong></div>
                    <div><span>攻击</span><strong>@monster.Attack</strong></div>
                    <div><span>防御</span><strong>@monster.Defense</strong></div>
                </div>
                <p class="monster-weapon-note">切换到“掉落预览”可查看每只怪物的掉落及武器属性。</p>
            }
            else
            {
                <p class="monster-detail-empty">此副本暂无怪物资料。</p>
            }
        </div>
        <footer class="monster-create-panel" aria-label="创建房间设置">
            @if (Character is { } character)
            {
                <div class="monster-create-character"><span>当前角色</span><strong>@character.Name · @character.ProfessionName · Lv.@character.Level</strong><small>生命 @character.Hp / @character.MaxHp · 攻击 @character.Attack · 本副本经验 @Dungeon.ExperiencePercent%</small></div>
            }
            else
            {
                <div class="monster-create-character"><strong>请先选择角色</strong></div>
            }
            <div class="monster-create-settings">
                <label><input type="checkbox" @bind="_isRepeatBattle" /><span><strong>自动循环</strong><small>胜利后自动重开</small></span></label>
                <label><input type="checkbox" @bind="_isPreparationTimeoutEnabled" /><span><strong>准备超时</strong><small>到时自动开战</small></span></label>
                <label><input type="checkbox" @bind="_isPublic" /><span><strong>开放房间</strong><small>允许其他玩家加入</small></span></label>
            </div>
            @if (!Dungeon.CanEnter)
            {
                <p class="monster-create-message">@Dungeon.LockReason</p>
            }
            else if (!string.IsNullOrWhiteSpace(CreateError))
            {
                <p class="monster-create-message" role="alert">@CreateError</p>
            }
            <button type="button" class="button button--primary monster-create-button" disabled="@(IsCreating || !Dungeon.CanEnter || Character is null)" @onclick="CreateAsync">@(IsCreating ? "创建中…" : "创建战斗")</button>
        </footer>
    </section>

    @if (_selectedWeapon is { Weapon: { } weapon } selectedDrop)
    {
        <WeaponDetailDialog Name="@selectedDrop.Name" Element="@weapon.Element" ItemLevel="@weapon.ItemLevel"
                            Attack="@weapon.Attack" MaxHp="@weapon.MaxHp" Skills="@weapon.Skills"
                            Category="WEAPON PREVIEW" Subtitle="@($"基础模板 · 装等 {weapon.ItemLevel}")"
                            Note="显示的是基础属性；掉落品质只提高每条技能的强化上限。"
                            CloseLabel="← 返回掉落预览" OnClose="CloseWeapon" />
    }
</div>

@code {
    [Parameter, EditorRequired] public DungeonSummaryResponse Dungeon { get; set; } = null!;
    [Parameter] public CurrentCharacterResponse? Character { get; set; }
    [Parameter] public EventCallback<CreateRoomRequest> OnCreate { get; set; }
    [Parameter] public bool IsCreating { get; set; }
    [Parameter] public string? CreateError { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private DungeonRewardPreviewResponse? _selectedWeapon;
    private ElementReference _monsterCloseButton;
    private ElementReference _dialog;
    private bool _focusMonster = true;
    private int _selectedMonsterIndex;
    private bool _showDrops;
    private bool _isRepeatBattle = true;
    private bool _isPreparationTimeoutEnabled = true;
    private bool _isPublic;
    private MonsterPreviewResponse? SelectedMonster => Dungeon.Monsters.ElementAtOrDefault(_selectedMonsterIndex);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusMonster)
        {
            _focusMonster = false;
            await _monsterCloseButton.FocusAsync(preventScroll: true);
            await Js.InvokeVoidAsync("lobbyUi.trapFocus", _dialog);
        }
    }

    private void SelectMonster(int index) => _selectedMonsterIndex = index;
    private Task CreateAsync() => OnCreate.InvokeAsync(new CreateRoomRequest
    {
        DungeonId = Dungeon.DungeonId,
        IsRepeatBattle = _isRepeatBattle,
        IsPreparationTimeoutEnabled = _isPreparationTimeoutEnabled,
        IsPublic = _isPublic
    });
    private void OpenWeapon(DungeonRewardPreviewResponse drop) { _selectedWeapon = drop; }
    private void CloseWeapon() { _selectedWeapon = null; _focusMonster = true; }

    private async Task CloseAsync()
    {
        if (_selectedWeapon is not null) CloseWeapon();
        else await OnClose.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Escape") return;
        if (_selectedWeapon is not null) CloseWeapon();
        else await OnClose.InvokeAsync();
    }

    private static string DropKindName(string kind) => kind switch
    {
        "Consumable" => "消耗品",
        "Material" => "材料",
        _ => "掉落物"
    };
}
