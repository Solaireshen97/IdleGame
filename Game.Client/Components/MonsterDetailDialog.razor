@using Game.Shared
@using Game.Shared.Dtos.Formations
@using Game.Client.Services
@using Game.Shared.Dtos
@using Game.Shared.Dtos.Characters
@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime Js
@inject ApiService ApiService

<div class="monster-detail-overlay" @onclick="CloseAsync" @onkeydown="HandleKeyDown" @onkeydown:stopPropagation>
    <section class="monster-detail-dialog @(CurrentDungeon.SupportsDepths ? "monster-detail-dialog--depth" : "") @(CurrentDungeon.Monsters.Count == 1 ? "monster-detail-dialog--single" : "") @(FeaturedMonster is { } activeMonster ? $"monster-detail-dialog--{activeMonster.Element.ToString().ToLowerInvariant()}" : "")"
             role="dialog" aria-modal="true" aria-labelledby="monster-detail-title" @onclick:stopPropagation @ref="_dialog">
        <header class="monster-detail-header">
            <div>
                <span class="monster-detail-kicker">@CurrentDungeon.RegionName <span> / @(CurrentDungeon.SupportsDepths ? $"T{CurrentDungeon.Stage} 深层副本" : "冒险准备")</span></span>
                <h2 id="monster-detail-title">@DungeonTitle</h2>
                <p><span>@CurrentDungeon.WaveCount 波 · @CurrentDungeon.MonsterCount 名敌人</span><span>推荐 Lv.@CurrentDungeon.RecommendedLevel</span></p>
            </div>
            @if (FeaturedMonster is { } featured)
            {
                <div class="monster-detail-banner-art" aria-hidden="true"><img src="@MonsterArt.ForName(featured.Name)" alt="" /></div>
            }
            <button type="button" class="monster-detail-close" @onclick="CloseAsync" @ref="_monsterCloseButton" aria-label="关闭详情">×</button>
        </header>

        <div class="monster-detail-scroll">
        <div class="monster-detail-tabs @(CurrentDungeon.SupportsDepths ? "monster-detail-tabs--three" : "")" role="group" aria-label="副本资料">
            @if (CurrentDungeon.SupportsDepths)
            {
                <button type="button" aria-pressed="@(_view == DetailView.Difficulty ? "true" : "false")" class="@(_view == DetailView.Difficulty ? "monster-detail-tabs__active" : null)" @onclick="() => _view = DetailView.Difficulty">选择难度</button>
            }
            <button type="button" aria-pressed="@(_view == DetailView.Monsters ? "true" : "false")" class="@(_view == DetailView.Monsters ? "monster-detail-tabs__active" : null)" @onclick="() => _view = DetailView.Monsters">敌情</button>
            <button type="button" aria-pressed="@(_view == DetailView.Drops ? "true" : "false")" class="@(_view == DetailView.Drops ? "monster-detail-tabs__active" : null)" @onclick="() => _view = DetailView.Drops">战利品</button>
        </div>

        <div class="monster-detail-body @(_view == DetailView.Difficulty ? "monster-detail-body--difficulty" : "")" @key="_view">
            @if (CurrentDungeon.SupportsDepths && _view != DetailView.Difficulty)
            {
                <button type="button" class="monster-depth-return" @onclick="() => _view = DetailView.Difficulty"><span><b>LV@(CurrentDungeon.DepthLevel)</b> @(SelectedDepth?.IsChallenge == true ? "极限挑战" : "精通之路")</span><span>更换难度 <span aria-hidden="true">↗</span></span></button>
            }
            @if (_view == DetailView.Difficulty)
            {
                <DungeonDepthPicker Dungeon="CurrentDungeon" IsLoading="_isLoadingDepth" IsCreating="IsCreating" OnSelect="SelectDepthAsync" />
            }
            else if (_view == DetailView.Drops)
            {
                @foreach (var monster in CurrentDungeon.Monsters.OrderBy(item => item.WaveNumber).ThenBy(item => item.Position))
                {
                    <section class="monster-detail-drops" aria-label="@monster.Name 的掉落">
                        <div class="monster-detail-section-heading">
                            <h3><img class="monster-detail-heading-art" src="@MonsterArt.ForName(monster.Name)" alt="" loading="lazy" /><span class="monster-detail-element monster-detail-element--@monster.Element.ToString().ToLowerInvariant()">@WeaponRules.ElementName(monster.Element)属性</span> @monster.Name</h3>
                            <small>第 @monster.WaveNumber 波 · @(monster.IsBoss ? "首领" : "普通敌人")</small>
                        </div>
                        @if (monster.Drops.Count == 0)
                        {
                            <p class="monster-detail-empty">没有额外物品掉落</p>
                        }
                        else
                        {
                            <ul>
                                @foreach (var drop in monster.Drops)
                                {
                                    <li>
                                        @if (drop.Weapon is not null)
                                        {
                                            <button type="button" class="monster-drop monster-drop--weapon" @onclick="() => OpenWeapon(drop)" aria-haspopup="dialog" aria-label="查看武器 @drop.Name 的属性">
                                                <span class="monster-drop-icon" aria-hidden="true"><img src="@WeaponArt.ForName(drop.Name)" alt="" loading="lazy" /></span>
                                                <span class="monster-drop-copy"><strong>@drop.Name <small>× @drop.Quantity</small></strong><small>武器 · 点击查看属性</small></span>
                                                <span class="monster-drop-rate">@drop.ChancePercent.ToString("0.##")% <span aria-hidden="true">›</span></span>
                                            </button>
                                        }
                                        else
                                        {
                                            <div class="monster-drop">
                                                <span class="monster-drop-icon" aria-hidden="true">@if (ItemArt.ForCode(drop.Code) is { } dropArt) { <img src="@dropArt" alt="" loading="lazy" /> } else { <text>✦</text> }</span>
                                                <span class="monster-drop-copy"><strong>@drop.Name <small>× @drop.Quantity</small></strong><small>@DropKindName(drop.Kind)</small></span>
                                                <span class="monster-drop-rate">@drop.ChancePercent.ToString("0.##")%</span>
                                            </div>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                }

                var completionRewards = CurrentDungeon.RewardPreview.Where(reward => reward.Source is "通关奖励" or "首次通关" or "挑战奖励" or "挑战额外奖励").ToList();
                @if (completionRewards.Count > 0)
                {
                    @foreach (var rewardGroup in completionRewards.GroupBy(reward => reward.Source is "挑战奖励" or "挑战额外奖励" ? "挑战额外奖励" : "基础通关奖励"))
                    {
                    <section class="monster-detail-drops" aria-label="通关奖励">
                        <div class="monster-detail-section-heading"><h3>@rewardGroup.Key</h3><small>@(rewardGroup.Key == "挑战额外奖励" ? "通关时独立判定 · 不享受精通追加" : "完成副本时判定")</small></div>
                        <ul>
                            @foreach (var drop in rewardGroup)
                            {
                                <li>
                                    @if (drop.Weapon is not null)
                                    {
                                        <button type="button" class="monster-drop monster-drop--weapon" @onclick="() => OpenWeapon(drop)" aria-haspopup="dialog" aria-label="查看武器 @drop.Name 的属性">
                                            <span class="monster-drop-icon" aria-hidden="true"><img src="@WeaponArt.ForName(drop.Name)" alt="" loading="lazy" /></span>
                                            <span class="monster-drop-copy"><strong>@drop.Name <small>× @drop.Quantity</small></strong><small>@drop.Source · 点击查看属性</small></span>
                                            <span class="monster-drop-rate">@drop.ChancePercent.ToString("0.##")% <span aria-hidden="true">›</span></span>
                                        </button>
                                    }
                                    else
                                    {
                                        <div class="monster-drop">
                                            <span class="monster-drop-icon" aria-hidden="true">@if (ItemArt.ForCode(drop.Code) is { } dropArt) { <img src="@dropArt" alt="" loading="lazy" /> } else { <text>✦</text> }</span>
                                            <span class="monster-drop-copy"><strong>@drop.Name <small>× @drop.Quantity</small></strong><small>@drop.Source · @DropKindName(drop.Kind)</small></span>
                                            <span class="monster-drop-rate">@drop.ChancePercent.ToString("0.##")%</span>
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    </section>
                    }
                }
                <details class="monster-detail-note"><summary>掉落说明</summary><p class="monster-weapon-note">掉率为每次对应击败或通关时的判定概率；获得的武器固定为普通品质（0 突破），之后可主动突破。</p></details>
            }
            else if (SelectedMonster is { } monster)
            {
                @if (CurrentDungeon.Monsters.Count > 1)
                {
                <div class="monster-selector" aria-label="选择怪物">
                    @for (var index = 0; index < CurrentDungeon.Monsters.Count; index++)
                    {
                        var option = CurrentDungeon.Monsters[index];
                        var optionIndex = index;
                        <button type="button" class="monster-selector__item @(index == _selectedMonsterIndex ? "monster-selector__item--active" : "")"
                                aria-pressed="@(index == _selectedMonsterIndex ? "true" : "false")" @onclick="() => SelectMonster(optionIndex)">
                            <img src="@MonsterArt.ForName(option.Name)" alt="" loading="lazy" /><span><small>第 @option.WaveNumber 波</small><strong>@option.Name</strong></span>
                        </button>
                    }
                </div>
                }
                <div class="monster-detail-identity">
                    <img class="monster-detail-identity-art" src="@MonsterArt.ForName(monster.Name)" alt="" />
                    <span class="monster-detail-element">@WeaponRules.ElementName(monster.Element)属性</span>
                    <div><strong>@monster.Name</strong><small>@(monster.IsBoss ? "首领" : "普通敌人") · 第 @monster.WaveNumber 波 / 第 @monster.Position 位</small></div>
                </div>
                <div class="monster-detail-stats" aria-label="怪物属性">
                    <div><span>@(HasPartyHpScaling ? "单人生命" : "生命")</span><strong>@monster.MaxHp</strong></div>
                    <div><span>攻击</span><strong>@monster.Attack</strong></div>
                    <div><span>防御</span><strong>@monster.Defense</strong></div>
                </div>
                <details class="monster-detail-note"><summary>@(HasPartyHpScaling ? "组队生命规则" : "固定难度规则")</summary>
                @if (HasPartyHpScaling)
                {
                    <p class="monster-weapon-note">生命随上阵角色人数增加；1～5人分别为 @string.Join(" / ", CurrentDungeon.PartyHpPercentages.Select(percent => $"{percent}%"))。中途加入保留剩余血量比例，下一场按队伍人数重新计算。</p>
                }
                else
                {
                    <p class="monster-weapon-note">固定难度，怪物生命不随队伍人数变化。</p>
                }
                </details>
            }
            else
            {
                <p class="monster-detail-empty">此副本暂无怪物资料。</p>
            }
        </div>
        <section class="monster-create-panel" aria-label="创建房间设置">
            @if (Character is { } character)
            {
                <div class="monster-create-character"><span>出战角色</span><strong>@character.Name</strong><small>@(CurrentDungeon.AutoUnlocked ? "Auto 已解锁" : "Auto 待解锁")</small></div>
            }
            else
            {
                <div class="monster-create-character"><strong>请先选择角色</strong></div>
            }
            @if (Character is not null) { <FormationSelector Disabled="IsCreating" CharacterId="Character.CharacterId" CharacterName="@Character.Name" DungeonId="CurrentDungeon.DungeonId" DungeonCode="@CurrentDungeon.Code" DepthLevel="CurrentDungeon.DepthLevel" SelectionChanged="FormationChanged" ValidityChanged="valid => _formationValid = valid" /> }
            <div class="monster-create-controls">
                <label class="monster-repeat-control"><input type="checkbox" @bind="_isRepeatBattle" disabled="@IsCreating" /><span>自动循环</span><small>@(CurrentDungeon.SupportsDepths ? $"固定 LV{CurrentDungeon.DepthLevel}" : "胜利后重开")</small></label>
                <button type="button" class="monster-settings-toggle" aria-expanded="@(_showSettings ? "true" : "false")" aria-controls="monster-room-settings" @onclick="() => _showSettings = !_showSettings">更多设置 <span aria-hidden="true">@(_showSettings ? "−" : "+")</span></button>
            </div>
            @if (_showSettings)
            {
                <div id="monster-room-settings" class="monster-room-settings">
                    <div class="monster-create-settings">
                        <label><input type="checkbox" @bind="_isPreparationTimeoutEnabled" disabled="@IsCreating" /><span><strong>准备超时</strong><small>到时自动开战</small></span></label>
                        <label><input type="checkbox" @bind="_isPublic" disabled="@IsCreating" /><span><strong>开放房间</strong><small>允许其他玩家加入</small></span></label>
                    </div>
                    <p>循环固定所选难度，战败后停止。</p>
                    @if (Character is { } settingsCharacter) { <p>生命 @settingsCharacter.Hp / @settingsCharacter.MaxHp · 攻击 @settingsCharacter.Attack</p> }
                </div>
            }
        </section>
        </div>
        <footer class="monster-create-action" aria-label="开始挑战">
            @if (_depthError is not null)
            {
                <div class="monster-create-message monster-create-message--retry" role="alert"><span>@_depthError</span><button type="button" @onclick="() => SelectDepthAsync(_requestedDepth)" disabled="@_isLoadingDepth">重试</button></div>
            }
            else if (!CurrentDungeon.CanEnter && SelectedDepth?.IsUnlocked != false)
            {
                <p class="monster-create-message">@CurrentDungeon.LockReason</p>
            }
            else if (!string.IsNullOrWhiteSpace(CreateError))
            {
                <p class="monster-create-message" role="alert">@CreateError</p>
            }
            <button type="button" class="button button--primary monster-create-button" disabled="@(IsCreating || !_formationValid || _isLoadingDepth || _depthError is not null || !CurrentDungeon.CanEnter || SelectedDepth?.IsUnlocked == false || Character is null)" @onclick="CreateAsync"><span>@CreateButtonLabel</span><span aria-hidden="true">@(SelectedDepth?.IsUnlocked == false ? "" : "→")</span></button>
        </footer>
    </section>

    @if (_selectedWeapon is { Weapon: { } weapon } selectedDrop)
    {
        <WeaponDetailDialog Name="@selectedDrop.Name" Element="@weapon.Element" ItemLevel="@weapon.ItemLevel"
                            Attack="@weapon.Attack" MaxHp="@weapon.MaxHp" Skills="@weapon.Skills" QualityRank="0"
                            Category="WEAPON PREVIEW" Subtitle="@($"基础模板 · 装等 {weapon.ItemLevel}")"
                            Note="掉落时固定为普通品质、0 突破；之后可用同名武器或通用突破石主动突破，点亮的水晶只提高每条技能的强化上限。"
                            CloseLabel="← 返回掉落预览" OnClose="CloseWeapon" />
    }
</div>

@code {
    [Parameter, EditorRequired] public DungeonSummaryResponse Dungeon { get; set; } = null!;
    [Parameter] public CurrentCharacterResponse? Character { get; set; }
    [Parameter] public int? InitialDepth { get; set; }
    [Parameter] public EventCallback<CreateRoomRequest> OnCreate { get; set; }
    [Parameter] public bool IsCreating { get; set; }
    [Parameter] public string? CreateError { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private DungeonSummaryResponse? _preview;
    private int? _previousDungeonId;
    private int? _previousCharacterId;
    private DungeonSummaryResponse CurrentDungeon => _preview ?? Dungeon;
    private DungeonDepthPreviewResponse? SelectedDepth => CurrentDungeon.Depths.FirstOrDefault(depth => depth.DepthLevel == CurrentDungeon.DepthLevel);
    private bool _isLoadingDepth;
    private string? _depthError;
    private int _depthRequest;
    private int _requestedDepth = 1;
    private enum DetailView { Difficulty, Monsters, Drops }
    private DetailView _view;
    private bool _showSettings;
    private MonsterPreviewResponse? FeaturedMonster => CurrentDungeon.Monsters.FirstOrDefault(item => item.IsBoss) ?? CurrentDungeon.Monsters.FirstOrDefault();
    private string DungeonTitle => CurrentDungeon.SupportsDepths
        ? System.Text.RegularExpressions.Regex.Replace(CurrentDungeon.Name, @"·深层(?:\s*LV\d+)?$", "") : CurrentDungeon.Name;
    private string CreateButtonLabel => IsCreating ? "正在创建…" : _isLoadingDepth ? "正在读取难度…"
        : SelectedDepth?.IsUnlocked == false ? CurrentDungeon.DepthLevel <= 1 ? "先解锁副本" : $"通关 LV{CurrentDungeon.DepthLevel - 1} 后开放"
        : CurrentDungeon.SupportsDepths ? $"开始挑战 · LV{CurrentDungeon.DepthLevel}" : "开始战斗";

    protected override async Task OnParametersSetAsync()
    {
        // Lobby polling creates new DTOs for the same dungeon. Only a different
        // dungeon or character starts a new dialog session, not a data refresh.
        if (_previousDungeonId == Dungeon.DungeonId && _previousCharacterId == Character?.CharacterId) return;
        _previousDungeonId = Dungeon.DungeonId;
        _previousCharacterId = Character?.CharacterId;
        _preview = null;
        _depthRequest++;
        _isLoadingDepth = false;
        _depthError = null;
        _view = Dungeon.SupportsDepths ? DetailView.Difficulty : DetailView.Monsters;
        _selectedMonsterIndex = Math.Max(0, Dungeon.Monsters.FindIndex(item => item.IsBoss));
        _requestedDepth = Dungeon.DepthLevel;
        _showSettings = false;
        if (Dungeon.SupportsDepths && InitialDepth is int depth && depth != Dungeon.DepthLevel && Dungeon.Depths.Any(item => item.DepthLevel == depth))
            await SelectDepthAsync(depth);
    }

    private async Task SelectDepthAsync(int depthLevel)
    {
        var request = ++_depthRequest;
        _requestedDepth = depthLevel;
        _isLoadingDepth = true;
        _depthError = null;
        try
        {
            var preview = await ApiService.GetDungeonAsync(Dungeon.DungeonId, depthLevel);
            if (request != _depthRequest) return;
            if (preview is null) _depthError = "层级资料读取失败，请重试。";
            else { _preview = preview; _selectedMonsterIndex = Math.Max(0, preview.Monsters.FindIndex(item => item.IsBoss)); _selectedWeapon = null; }
        }
        catch { if (request == _depthRequest) _depthError = "层级资料读取失败，请重试。"; }
        finally { if (request == _depthRequest) _isLoadingDepth = false; }
    }

    private DungeonRewardPreviewResponse? _selectedWeapon;
    private ElementReference _monsterCloseButton;
    private ElementReference _dialog;
    private bool _focusMonster = true;
    private int _selectedMonsterIndex;
    private bool _isRepeatBattle = true;
    private bool _isPreparationTimeoutEnabled = true;
    private bool _isPublic;
    private MonsterPreviewResponse? SelectedMonster => CurrentDungeon.Monsters.ElementAtOrDefault(_selectedMonsterIndex);
    private bool HasPartyHpScaling => CurrentDungeon.PartyHpPercentages.Any(percent => percent != 100);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusMonster)
        {
            _focusMonster = false;
            await _monsterCloseButton.FocusAsync(preventScroll: true);
            await Js.InvokeVoidAsync("lobbyUi.trapFocus", _dialog);
        }
    }

    private LoadoutSelection? _loadoutSelection;
    private bool _formationValid;
    private string? _admissionRequestId;
    private void FormationChanged(LoadoutSelection selection) { _loadoutSelection = selection; _admissionRequestId = null; }
    private void SelectMonster(int index) => _selectedMonsterIndex = index;
    private Task CreateAsync() => OnCreate.InvokeAsync(new CreateRoomRequest
    {
        CharacterId = Character?.CharacterId,
        LoadoutSelection = _loadoutSelection,
        RequestId = _admissionRequestId ??= Guid.NewGuid().ToString("N"),
        DungeonId = CurrentDungeon.DungeonId,
        DepthLevel = CurrentDungeon.DepthLevel,
        IsRepeatBattle = _isRepeatBattle,
        IsPreparationTimeoutEnabled = _isPreparationTimeoutEnabled,
        IsPublic = _isPublic
    });
    private void OpenWeapon(DungeonRewardPreviewResponse drop) { _selectedWeapon = drop; }
    private void CloseWeapon() { _selectedWeapon = null; _focusMonster = true; }

    private async Task CloseAsync()
    {
        if (_selectedWeapon is not null) CloseWeapon();
        else await OnClose.InvokeAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Escape") return;
        if (_selectedWeapon is not null) CloseWeapon();
        else await OnClose.InvokeAsync();
    }

    private static string DropKindName(string kind) => kind switch
    {
        "Consumable" => "消耗品",
        "Material" => "材料",
        _ => "掉落物"
    };
}
