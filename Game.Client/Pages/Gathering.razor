@page "/gathering"
@page "/planting"
@using Game.Client.Services
@using Game.Shared.Dtos.Planting
@inject ApiService ApiService
@inject ActiveCharacterState ActiveCharacters
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>药田</PageTitle>

<div class="garden-page">
    <header class="garden-intro">
        <div><span class="garden-eyebrow">HERB GARDEN</span><h1>营地药田</h1><p>播下一粒种子，为下一场冒险积蓄力量。</p></div>
        <a class="garden-shop-link" href="/shop">购买种子 <span aria-hidden="true">↗</span></a>
    </header>
    @if (_notice is not null)
    {
        <div class="garden-notice @(_noticeIsError ? "garden-notice--error" : null)" role="status"><span>@_notice</span><button type="button" @onclick="() => _notice = null" aria-label="关闭提示">×</button></div>
    }
    @if (_overview is null)
    {
        <GameStateCard Compact="true" Tone="@(_loading ? "default" : "error")" Title="@(_loading ? "正在走进药田" : "暂时无法读取药田")" Detail="@(_loading ? "查看草药的生长情况…" : "请检查连接后重试。")" />
        @if (!_loading) { <button type="button" class="garden-button garden-button--secondary garden-retry" @onclick="LoadAsync">重新读取</button> }
    }
    else
    {
        <section class="garden-field" aria-labelledby="garden-field-title">
            <div class="garden-field-heading"><div><span class="garden-eyebrow">YOUR PLOTS</span><h2 id="garden-field-title">@_overview.CharacterName 的药田</h2></div><button type="button" class="garden-refresh" disabled="@IsWorking" @onclick="LoadAsync" aria-label="刷新药田" title="刷新药田">↻</button></div>
            <div class="garden-summary" aria-label="药田状态">
                <span><i class="garden-dot garden-dot--empty"></i>空置 <b>@EmptyPlots.Count()</b></span>
                <span><i class="garden-dot garden-dot--growing"></i>生长中 <b>@GrowingCount</b></span>
                <span><i class="garden-dot garden-dot--ready"></i>可收获 <b>@MaturePlots.Count()</b></span>
            </div>
            <div class="garden-plots">
                @foreach (var plot in _overview.Plots)
                {
                    var empty = plot.PlantCode is null;
                    var mature = !empty && IsMature(plot);
                    var selected = _selected.Contains(plot.PlotIndex);
                    var rare = _overview.Plants.FirstOrDefault(plant => plant.Code == plot.PlantCode)?.IsRare == true;
                    <article @key="plot.PlotIndex" class="garden-plot @(empty ? "garden-plot--empty" : mature ? "garden-plot--ready" : "garden-plot--growing") @(selected ? "garden-plot--selected" : null)">
                        <div class="garden-plot-top"><span class="garden-plot-number">@((plot.PlotIndex + 1).ToString("D2")) <small>号药田</small></span><span class="garden-status">@(empty ? selected ? "已选择" : "待播种" : mature ? "已成熟" : "生长中")</span></div>
                        <div class="garden-plot-scene" aria-hidden="true">
                            <div class="garden-soil"></div>
                            @if (empty)
                            {
                                <svg class="garden-sprout" viewBox="0 0 64 64" fill="none"><path d="M32 49V29m0 7C18 36 13 29 14 19c12-1 19 5 18 17Zm0-6C32 18 40 13 51 14c0 11-7 17-19 16Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M23 51h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                            }
                            else
                            {
                                <img class="garden-crop garden-crop--left" src="@ItemArt.ForCode(plot.MaterialCode)" alt="" />
                                <img class="garden-crop garden-crop--main" src="@ItemArt.ForCode(plot.MaterialCode)" alt="" />
                                <img class="garden-crop garden-crop--right" src="@ItemArt.ForCode(plot.MaterialCode)" alt="" />
                                @if (mature) { <span class="garden-spark garden-spark--one">✦</span><span class="garden-spark garden-spark--two">✧</span> }
                            }
                        </div>
                        <div class="garden-plot-label"><h3>@(empty ? "留一方新绿" : plot.PlantName)</h3><span>@(empty ? "选择地块，再挑选种子" : $"{(rare ? "稀有草药 · " : "")}预计收获 {plot.HarvestQuantity} 株")</span></div>
                        @if (empty)
                        {
                            <button type="button" class="garden-plot-action" disabled="@IsWorking" aria-pressed="@(selected ? "true" : "false")" aria-label="@($"{(selected ? "取消选择" : "选择")} {plot.PlotIndex + 1} 号药田")" @onclick="() => TogglePlot(plot.PlotIndex)"><span aria-hidden="true">@(selected ? "✓" : "+")</span> @(selected ? "已选中这块药田" : "选择这块药田")</button>
                        }
                        else if (mature)
                        {
                            <button type="button" class="garden-plot-action garden-plot-action--harvest" disabled="@IsWorking" @onclick="() => HarvestAsync([plot])">收获 <strong>@plot.HarvestQuantity 株</strong> <span aria-hidden="true">↗</span></button>
                        }
                        else
                        {
                            <div class="garden-growth"><div><span>距离成熟</span><strong>@Remaining(plot)</strong></div><div class="garden-progress" role="progressbar" aria-label="@($"{plot.PlantName} 生长进度")" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Progress(plot)"><span style="width: @(Progress(plot))%"></span></div></div>
                        }
                    </article>
                }
            </div>
            <div class="garden-field-footer">
                <button type="button" class="garden-select-all" disabled="@(IsWorking || !EmptyPlots.Any())" @onclick="ToggleAllPlots">@(_selected.Count > 0 && _selected.Count == EmptyPlots.Count() ? "取消全选" : "选择全部空地")</button>
                <button type="button" class="garden-button garden-button--secondary" disabled="@(IsWorking || !MaturePlots.Any())" @onclick="HarvestAllAsync">一键收获 <span>@MaturePlots.Count()</span></button>
            </div>
            <p class="garden-field-note">离线也会生长 · 成熟后保留，收获后手动补种</p>
        </section>

        <section class="garden-seed-section" aria-labelledby="garden-seed-title">
            <div class="garden-section-heading"><div><span class="garden-eyebrow">SOW &amp; GROW</span><h2 id="garden-seed-title">挑选种子</h2></div><span class="garden-selection-count">已选 <b>@_selected.Count</b> / 4 块地</span></div>
            @if (SelectedSeed is { } seed)
            {
                <div class="garden-sowing @(seed.IsRare ? "garden-sowing--rare" : null)">
                    <div class="garden-sowing-main">
                        <img src="@ItemArt.ForCode(seed.MaterialCode)" alt="" />
                        <div><small>本次种植</small><h3>@seed.Name</h3><p>@(seed.IsRare ? "稀有草药" : "普通草药") · @Hours(seed.GrowthSeconds) 小时成熟</p></div>
                        <button type="button" class="garden-button garden-button--primary" disabled="@(!CanPlant(seed))" @onclick="() => PlantAsync(seed)">@PlantButtonLabel(seed)</button>
                    </div>
                    <div class="garden-sowing-stats"><span>种子 <b>@seed.SeedQuantity</b><small> / 需 @_selected.Count 颗</small></span><span>预计收获 <b>@((long)_selected.Count * seed.HarvestQuantity)</b> 株</span></div>
                    <p class="garden-seed-source">@SeedSource(seed)</p>
                    @if (seed.SeedQuantity < Math.Max(1, _selected.Count) && !seed.IsRare && seed.IsUnlocked)
                    {
                        <a class="garden-replenish" href="/shop">种子不足，前往商店补充 <span aria-hidden="true">↗</span></a>
                    }
                </div>
            }
            <div class="garden-seed-filters" role="group" aria-label="筛选种子">
                @foreach (var filter in SeedFilters)
                {
                    <button type="button" class="@(_filter == filter.Code ? "garden-filter--active" : null)" aria-pressed="@(_filter == filter.Code ? "true" : "false")" @onclick="() => _filter = filter.Code">@filter.Name <small>@FilterCount(filter.Code)</small></button>
                }
            </div>
            <div class="garden-seeds">
                @foreach (var plant in VisibleSeeds)
                {
                    <button @key="plant.Code" type="button" class="garden-seed @(plant.Code == _selectedSeedCode ? "garden-seed--selected" : null) @(plant.IsRare ? "garden-seed--rare" : null) @(!plant.IsUnlocked ? "garden-seed--locked" : null)" aria-pressed="@(plant.Code == _selectedSeedCode ? "true" : "false")" @onclick="() => SelectSeed(plant.Code)">
                        <span class="garden-seed-image"><img src="@ItemArt.ForCode(plant.MaterialCode)" alt="" loading="lazy" /></span>
                        <span class="garden-seed-title"><strong>@plant.Name</strong><small>@Hours(plant.GrowthSeconds) 小时 <span>·</span> @plant.HarvestQuantity 株</small></span>
                        <span class="garden-seed-stock @(plant.SeedQuantity > 0 ? "garden-seed-stock--owned" : null)">×@plant.SeedQuantity</span>
                        <span class="garden-seed-footer"><span>@(plant.IsRare ? "精英掉落" : $"{plant.SeedPrice} 金 / 颗")</span><span>@(!plant.IsUnlocked ? "未解锁" : plant.IsRare ? "稀有" : plant.Code == _selectedSeedCode ? "已选" : "普通")</span></span>
                    </button>
                }
            </div>
            @if (!VisibleSeeds.Any())
            {
                <div class="garden-empty-seeds"><strong>背包里还没有种子</strong><p>普通种子可以在商店购买，稀有种子来自精英掉落。</p><a href="/shop">去商店看看 ↗</a></div>
            }
            <a class="garden-alchemy-link" href="/production"><span>收获的草药，可以继续炼制药剂</span><strong>前往炼金 <span aria-hidden="true">→</span></strong></a>
        </section>
    }
</div>

@code {
    private PlantingOverviewResponse? _overview;
    private readonly HashSet<int> _selected = [];
    private readonly CancellationTokenSource _clockCancellation = new();
    private static readonly (string Code, string Name)[] SeedFilters = [("all", "全部"), ("owned", "持有"), ("ordinary", "普通"), ("rare", "稀有")];
    private string _filter = "all";
    private string? _selectedSeedCode;
    private string? _notice;
    private bool _noticeIsError;
    private bool _busy;
    private bool _loading = true;
    private bool _disposed;
    private int? _viewCharacterId;
    private int _generation;
    private TimeSpan _serverOffset;
    private PlantGardenRequest? _pendingPlant;
    private bool IsWorking => _busy || _loading;
    private DateTime ServerNow => DateTime.UtcNow + _serverOffset;
    private IEnumerable<GardenPlotDto> EmptyPlots => _overview?.Plots.Where(plot => plot.PlantCode is null) ?? [];
    private IEnumerable<GardenPlotDto> MaturePlots => _overview?.Plots.Where(plot => plot.PlantCode is not null && IsMature(plot)) ?? [];
    private int GrowingCount => (_overview?.Plots.Count ?? 0) - EmptyPlots.Count() - MaturePlots.Count();
    private PlantDto? SelectedSeed => _overview?.Plants.FirstOrDefault(plant => plant.Code == _selectedSeedCode);
    private IEnumerable<PlantDto> VisibleSeeds => (_overview?.Plants ?? []).Where(plant => MatchesFilter(plant, _filter))
        .OrderByDescending(plant => plant.SeedQuantity > 0).ThenByDescending(plant => plant.IsUnlocked).ThenBy(plant => plant.IsRare);

    protected override async Task OnInitializedAsync()
    {
        await ActiveCharacters.EnsureLoadedAsync();
        if (_disposed) return;
        _viewCharacterId = ActiveCharacters.Current?.CharacterId;
        if (_viewCharacterId is null) { Navigation.NavigateTo("/login", replace: true); return; }
        ActiveCharacters.Changed += CharacterChanged;
        await LoadAsync();
        if (!_disposed) _ = TickAsync();
    }

    private void CharacterChanged()
    {
        if (_disposed || _viewCharacterId == ActiveCharacters.Current?.CharacterId) return;
        _viewCharacterId = ActiveCharacters.Current?.CharacterId;
        _generation++;
        _ = InvokeAsync(async () =>
        {
            _pendingPlant = null;
            _overview = null;
            _selectedSeedCode = null;
            _notice = null;
            _selected.Clear();
            if (_viewCharacterId is null) { Navigation.NavigateTo("/login", replace: true); return; }
            await LoadAsync();
            if (!_disposed) StateHasChanged();
        });
    }

    private async Task LoadAsync()
    {
        var generation = ++_generation;
        var characterId = _viewCharacterId;
        _loading = true;
        try
        {
            var value = await ApiService.GetPlantingAsync();
            if (!IsCurrent(generation, characterId)) return;
            if (value is null || value.CharacterId != characterId) SetNotice("药田读取失败，请检查登录状态后重试。", true);
            else ApplyOverview(value);
        }
        catch { if (IsCurrent(generation, characterId)) SetNotice("网络中断，请刷新重试。", true); }
        finally { if (IsCurrent(generation, characterId)) _loading = false; }
    }

    private void ApplyOverview(PlantingOverviewResponse value)
    {
        _overview = value;
        _serverOffset = value.ServerTimeUtc - DateTime.UtcNow;
        _selected.IntersectWith(EmptyPlots.Select(plot => plot.PlotIndex));
        if (SelectedSeed is null)
            _selectedSeedCode = value.Plants.OrderByDescending(plant => plant.SeedQuantity > 0 && plant.IsUnlocked)
                .ThenByDescending(plant => plant.IsUnlocked).ThenBy(plant => plant.IsRare).FirstOrDefault()?.Code;
    }

    private async Task TickAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try { while (await timer.WaitForNextTickAsync(_clockCancellation.Token)) await InvokeAsync(() => { if (!_disposed) StateHasChanged(); }); }
        catch (OperationCanceledException) { }
    }

    private bool IsCurrent(int generation, int? characterId) => !_disposed && generation == _generation && characterId == ActiveCharacters.Current?.CharacterId;
    private void SetNotice(string message, bool error = false) { _notice = message; _noticeIsError = error; }
    private void TogglePlot(int index) { if (!_selected.Add(index)) _selected.Remove(index); _pendingPlant = null; }
    private void ToggleAllPlots()
    {
        var empty = EmptyPlots.Select(plot => plot.PlotIndex).ToList();
        if (_selected.SetEquals(empty)) _selected.Clear(); else _selected.UnionWith(empty);
        _pendingPlant = null;
    }
    private void SelectSeed(string code) { if (_selectedSeedCode != code) _pendingPlant = null; _selectedSeedCode = code; }
    private static bool MatchesFilter(PlantDto plant, string filter) => filter switch { "owned" => plant.SeedQuantity > 0, "ordinary" => !plant.IsRare, "rare" => plant.IsRare, _ => true };
    private int FilterCount(string filter) => _overview?.Plants.Count(plant => MatchesFilter(plant, filter)) ?? 0;
    private static string Hours(int seconds) => (seconds / 3600d).ToString("0.#");
    private bool IsMature(GardenPlotDto plot) => plot.MaturesAtUtc is { } maturity && maturity <= ServerNow;
    private int Progress(GardenPlotDto plot) => plot.PlantedAtUtc is { } planted && plot.MaturesAtUtc is { } maturity && maturity > planted
        ? (int)Math.Clamp((ServerNow - planted).TotalSeconds / (maturity - planted).TotalSeconds * 100, 0, 100) : 0;
    private string Remaining(GardenPlotDto plot)
    {
        var minutes = Math.Max(1, (int)Math.Ceiling((plot.MaturesAtUtc!.Value - ServerNow).TotalMinutes));
        return minutes >= 60 ? $"{minutes / 60} 小时 {minutes % 60:00} 分" : $"{minutes} 分钟";
    }
    private string SeedSource(PlantDto seed) => seed.IsRare ? $"种子来源：{seed.UnlockTargetName} · 精英掉落"
        : seed.IsUnlocked ? $"商店售价 {seed.SeedPrice} 金 / 颗 · 每块地消耗 1 颗种子"
        : $"尚未解锁：{seed.UnlockTargetName} · 战斗进度 {seed.Progress}/{seed.RequiredCount}";
    private bool CanPlant(PlantDto seed) => !IsWorking && _selected.Count > 0 && seed.IsUnlocked && seed.SeedQuantity >= _selected.Count;
    private string PlantButtonLabel(PlantDto seed) => _busy ? "处理中…" : !seed.IsUnlocked ? "尚未解锁" : _selected.Count == 0 ? "先选择空地" : seed.SeedQuantity < _selected.Count ? "种子不足" : $"播种 {_selected.Count} 块";

    private async Task PlantAsync(PlantDto plant)
    {
        if (_overview is null || !CanPlant(plant) || _overview.CharacterId != ActiveCharacters.Current?.CharacterId) return;
        _busy = true;
        var generation = _generation;
        var characterId = _overview.CharacterId;
        var count = _selected.Count;
        try
        {
            _pendingPlant ??= new(characterId, Guid.NewGuid().ToString("N"), plant.Code,
                _overview.Plots.Where(plot => _selected.Contains(plot.PlotIndex)).Select(plot => new PlotVersionRequest(plot.PlotIndex, plot.Version)).ToList());
            var (value, error) = await ApiService.PlantAsync(_pendingPlant);
            if (!IsCurrent(generation, characterId)) return;
            if (value is not null && value.CharacterId == characterId)
            {
                ApplyOverview(value);
                _pendingPlant = null;
                _selected.Clear();
                SetNotice($"已在 {count} 块药田种下{plant.Name}，{Hours(plant.GrowthSeconds)} 小时后可收获。");
            }
            else
            {
                SetNotice(error ?? "播种未完成，请刷新后重试。", true);
                if (error is "播种请求无效，请重新选择药田。" or "播种操作标识冲突，请重新选择药田。" or "药田已变化，请刷新后重试。") _pendingPlant = null;
            }
        }
        catch { if (IsCurrent(generation, characterId)) SetNotice("网络中断，可再次点击播种安全重试。", true); }
        finally { _busy = false; }
    }

    private Task HarvestAllAsync() => HarvestAsync(MaturePlots.ToList());
    private async Task HarvestAsync(List<GardenPlotDto> plots)
    {
        if (_overview is null || IsWorking || plots.Count == 0 || _overview.CharacterId != ActiveCharacters.Current?.CharacterId) return;
        _busy = true;
        var generation = _generation;
        var characterId = _overview.CharacterId;
        try
        {
            var (value, error) = await ApiService.HarvestAsync(new(characterId, plots.Select(plot => new PlotVersionRequest(plot.PlotIndex, plot.Version)).ToList()));
            if (!IsCurrent(generation, characterId)) return;
            if (value is not null && value.CharacterId == characterId)
            {
                ApplyOverview(value);
                SetNotice($"收获 {plots.Sum(plot => (long)plot.HarvestQuantity)} 株草药，已存入当前角色背包。");
            }
            else SetNotice(error ?? "收获未完成，请刷新后重试。", true);
        }
        catch { if (IsCurrent(generation, characterId)) SetNotice("网络中断，请刷新药田查看收获结果。", true); }
        finally { _busy = false; }
    }

    public void Dispose()
    {
        _disposed = true;
        ActiveCharacters.Changed -= CharacterChanged;
        _clockCancellation.Cancel();
        _clockCancellation.Dispose();
    }
}
