@page "/formations"
@using Game.Shared
@using Game.Shared.Enums
@using Game.Client.Services
@implements IDisposable

<PageTitle>我的编队</PageTitle>
<NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges" OnBeforeInternalNavigation="BeforeNavigationAsync" />
<div class="formations" style="@ElementStyle(_element)">
    <header class="formations-heading formations-heading--compact">
        <h1>我的编队</h1>
        @if (ReturnToBattlePreparation is { } returnRoute) { <a class="formation-return formation-return--compact" href="@returnRoute" aria-label="返回战斗准备" title="返回战斗准备">‹ 返回准备</a> }
        @if (Selected is not null) { <button type="button" class="round-button" aria-label="编队名称与管理" @onclick='() => OpenEditor("details")'>···</button> }
    </header>
    @if (_message is not null)
    { <div class="formation-notice" role="status"><span>@_message</span><button type="button" aria-label="关闭提示" @onclick="() => _message = null">×</button></div> }
    @if (_loading)
    { <div class="formation-empty"><span class="empty-emblem">◇</span><h2>正在整理编队</h2><p>读取你的职业、装备与保存的配置…</p></div> }
    else if (_overview is null)
    { <div class="formation-empty"><h2>暂时无法读取编队</h2><button class="formation-primary" @onclick="LoadAsync">重新载入</button></div> }
    else
    {
        @if (ChoicesError is { } choiceError) { <div class="formation-choice-error" role="alert"><span>@choiceError</span><button type="button" disabled="@_choicesLoading" @onclick="RefreshChoicesAsync">@(_choicesLoading ? "读取中…" : "重试读取候选")</button></div> }
        <nav class="element-tabs" aria-label="按属性查看编队">
            @foreach (var element in Enum.GetValues<ElementType>())
            {
                <button type="button" style="@ElementStyle(element)" aria-pressed="@(_element == element ? "true" : "false")" @onclick="() => SelectElement(element)">
                    <span class="element-orb" aria-hidden="true"><FormationElementIcon Element="element" /></span><strong>@WeaponRules.ElementName(element)</strong><small>@_overview.Formations.Count(f => f.GroupElement == element)</small>
                </button>
            }
        </nav>
        <div class="group-heading"><h2>@WeaponRules.ElementName(_element)属性编队 <span>@GroupFormations.Count() / @_overview.PositionsPerElement</span></h2><small>点击切换预设</small></div>
        <div class="preset-strip" aria-label="已保存的编队" @ref="_presetStrip" data-drag-scroll>
            @foreach (var formation in GroupFormations)
            {
                <button type="button" class="preset-card @(formation.Id == _selectedId ? "is-selected" : null)" aria-pressed="@(formation.Id == _selectedId ? "true" : "false")" @onclick="() => SelectFormation(formation)">
                    <img src="@ProfessionArt.ForCode(formation.Loadout.ProfessionCode)" alt="" /><span class="preset-index">@formation.Position.ToString("00")</span>
                    <span class="preset-copy"><strong>@formation.Name</strong><small>@formation.Preview.ProfessionName · Lv.@formation.Preview.Level</small><span class="preset-state">@(IsApplied(formation) ? "已应用" : formation.Preview.CanDeploy ? (_overview.DefaultFormationId == formation.Id ? "★ 默认编队" : "可出战") : "待完善")</span></span>
                    @if (formation.Id == _selectedId) { <span class="preset-selected" aria-hidden="true">✓</span> }
                </button>
            }
            @if (FreePosition(_element) > 0)
            { <button type="button" class="preset-add" disabled="@_busy" @onclick="CreateNewAsync"><span>＋</span><strong>新建编队</strong><small>从当前配置开始</small></button> }
        </div>


        @if (Selected is { } selected)
        {
            var mainId = selected.Loadout.Weapons.FirstOrDefault(w => w.SlotIndex == WeaponRules.MainSlotIndex)?.WeaponId;
            var main = _weapons.FirstOrDefault(w => w.Id == mainId);
            var soul = _souls.FirstOrDefault(s => s.Id == selected.Loadout.SoulImprintId);
            <section class="formation-overview formation-overview--summary" aria-label="当前查看的编队">
                <div class="formation-combat-strip">
                    <button type="button" class="profession-shortcut" @onclick='() => OpenEditor("profession")' aria-label="调整此编队职业"><strong>@selected.Preview.ProfessionName</strong><small>Lv.@selected.Preview.Level · 更换 ›</small></button>
                    <span><small>攻击</small><strong>@selected.Preview.Attack.ToString("N0")</strong></span><span><small>生命</small><strong>@selected.Preview.MaxHp.ToString("N0")</strong></span>
                </div>
                <div class="formation-summary-grid" aria-label="编队配置，点按进入编辑">
                    <button type="button" class="formation-summary-card" @onclick='() => OpenEditor("weapons")' aria-label="调整编队武器盘">
                        <span class="summary-card-heading"><strong>武器盘</strong><small>@selected.Loadout.Weapons.Count(w => w.WeaponId.HasValue)/10</small><b>›</b></span>
                        <span class="summary-item"><span class="summary-art">@if (main is not null) { <img src="@WeaponArt.ForCode(main.WeaponCode)" alt="" /> } else { <span>@(mainId.HasValue ? "…" : "＋")</span> }</span><span><strong>@(!_weaponsAvailable && mainId.HasValue ? "武器暂不可用" : main?.Name ?? (mainId.HasValue ? "武器已失效" : "未配置主武器"))</strong><small>@(selected.Preview.MainElement is { } element ? WeaponRules.ElementName(element) + "属性" : "未确定属性")</small></span></span>
                        <small class="summary-note">生效加成 @selected.Preview.WeaponEffects.Count 项</small>
                    </button>
                    <button type="button" class="formation-summary-card" @onclick='() => OpenEditor("skills")' aria-label="调整编队技能">
                        <span class="summary-card-heading"><strong>技能</strong><small>@selected.Loadout.Skills.Count(s => s.SkillCode is not null)/5</small><b>›</b></span>
                        <span class="summary-skill-icons">@for (var i = 1; i <= SkillRules.SlotCount; i++) { var slot = selected.Loadout.Skills.FirstOrDefault(s => s.SlotIndex == i); <span>@if (SkillArt.ForCode(slot?.SkillCode) is { } skillArt) { <img src="@skillArt" alt="@(selected.Preview.AvailableSkills.FirstOrDefault(s => s.Code == slot?.SkillCode)?.Name ?? "技能")" /> } else { <span>＋</span> }</span> }</span>
                        <small class="summary-note">自动 @selected.Loadout.Skills.Count(s => s.SkillCode is not null && s.AutoUseEnabled) / 已装配 @selected.Loadout.Skills.Count(s => s.SkillCode is not null)</small>
                    </button>
                    <button type="button" class="formation-summary-card" @onclick='() => OpenEditor("supplies")' aria-label="调整编队补给">
                        <span class="summary-card-heading"><strong>补给</strong><small>@selected.Loadout.Consumables.Count(c => c.ItemCode is not null)/3</small><b>›</b></span>
                        <span class="summary-supply-icons">@for (var i = 1; i <= ConsumableRules.TotalSlotCount; i++) { var choice = selected.Loadout.Consumables.FirstOrDefault(c => c.SlotIndex == i); var item = _supplies.FirstOrDefault(c => c.Code == choice?.ItemCode); <span>@if (ItemArt.ForCode(item?.Code) is { } supplyArt) { <img src="@supplyArt" alt="@item?.Name" /> } else { <span>@(choice?.ItemCode is not null ? "…" : "＋")</span> }<small>@SupplySlotName(i)</small></span> }</span>
                    </button>
                    <button type="button" class="formation-summary-card" @onclick='() => OpenEditor("soul")' aria-label="调整编队魂印">
                        <span class="summary-card-heading"><strong>魂印</strong><small>@(!_soulsAvailable && selected.Loadout.SoulImprintId.HasValue ? "暂不可用" : soul is null ? "未配置" : selected.Loadout.SoulAutoUseEnabled ? "自动" : "手动")</small><b>›</b></span>
                        <span class="summary-item"><span class="summary-art">@if (ItemArt.ForCode(soul?.Code) is { } soulArt) { <img src="@soulArt" alt="" /> } else { <span>◇</span> }</span><span><strong>@(!_soulsAvailable && selected.Loadout.SoulImprintId.HasValue ? "魂印暂不可用" : soul?.Name ?? (selected.Loadout.SoulImprintId.HasValue ? "魂印已失效" : "选择魂印"))</strong>@if (soul is not null) { <small>@WeaponRules.ElementName(soul.Element) · T@(soul.Tier)</small> }</span></span>
                    </button>
                </div>
                @if (selected.Preview.Issues.Count > 0)
                {
                    <details class="formation-issues"><summary>@(selected.Preview.CanDeploy ? "查看配置提醒" : "配置尚未完整，请检查") · @selected.Preview.Issues.Count 项</summary>
                        @foreach (var issue in selected.Preview.Issues)
                        { <div class="formation-issue-row"><p><strong>@IssueLocation(issue)</strong><span>@issue.Message</span></p><button type="button" aria-label="@($"调整{IssueLocation(issue)}")" @onclick="() => OpenEditor(IssueEditor(issue), issue.SlotIndex ?? 1)">调整 ›</button></div> }
                    </details>
                }
            </section>
        }
        else
        { <div class="formation-empty"><span class="empty-emblem">@ElementSymbol(_element)</span><h2>@($"准备你的第一套{WeaponRules.ElementName(_element)}属性编队")</h2><p>从角色当前配置开始，再分别调整技能与装备。</p><button type="button" class="formation-primary" @onclick="CreateNewAsync">＋ 新建编队</button></div> }
    }
    @if (_editor is not null && _overview is not null)
    {
        <FormationEditor @key="_editor" Draft="_editor" Section="@_section" InitialSlot="_initialSlot" InitialSupplyCode="@(_section == "supplies" ? RequestedSupplyCode : null)" IsNew="@(!_editingId.HasValue)" HasUnsavedChanges="@HasUnsavedChanges" Preview="_editorPreview" PreviewLoading="_previewLoading" Busy="_busy" Error="@_editorError" Notice="@_editorNotice" ManagementOperation="@_managementOperation" ChoicesError="@GetChoicesError(_section)" ChoicesWarning="@ChoicesError" ChoicesLoading="_choicesLoading" OnRetryChoices="RefreshChoicesAsync" Professions="_professions" Weapons="_weapons" Supplies="_supplies" Souls="_souls" Formations="_overview.Formations" EditingId="_editingId" PositionsPerElement="_overview.PositionsPerElement" CharacterId="_characterId" CanApply="@_overview.CanApply" IsApplied="@(Selected is { } applied && IsApplied(applied))" IsDefault="@(_overview.DefaultFormationId == _editingId)" CanDeploy="@(Selected?.Preview.CanDeploy == true)" OnApply="ApplyAsync" OnToggleDefault="ToggleDefaultAsync" OnChanged="RefreshEditorPreviewAsync" OnTouched="StateHasChanged" OnSave="SaveAsync" OnCancel="CloseEditorAsync" OnCopy="CopyAsync" OnDelete="DeleteAsync" />
        @if (_discardDecision is not null) { <FormationDiscardDialog OnDecision="ResolveDiscardAsync" /> }
    }
</div>
