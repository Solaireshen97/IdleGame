    private async Task<bool> RunRoomOperationAsync(Func<Task<(RoomDetailResponse? Detail, string? ErrorMessage)>> action, string fallback)
    {
        if (_isBusy) return false;
        var requestRoomId = RoomId;
        _isBusy = true; _message = null;
        try
        {
            var (detail, error) = await action();
            if (RoomId != requestRoomId || _refreshCancellation.IsCancellationRequested) return false;
            if (detail is null) { _message = GetRoomOperationError(error, fallback); return false; }
            ApplyRoomDetail(detail, allowCombatFeedback: false);
            _message = detail.Operations.FirstOrDefault()?.Message;
            return true;
        }
        catch
        {
            _message = "连接中断，暂未确认操作结果；请查看刷新后的预约列表，避免重复提交。";
            return false;
        }
        finally { _isBusy = false; }
    }

    private async Task CancelRoomOperationAsync(int operationId)
    {
        if (_isBusy) return;
        _isBusy = true;
        try
        {
            var error = await ApiService.CancelRoomOperationAsync(RoomId, operationId);
            _message = error is null ? "已取消预约。" : GetRoomOperationError(error, "取消预约失败。");
            await RefreshRoomDetailAsync();
        }
        catch { _message = "连接中断，暂未确认取消结果，请查看预约状态。"; }
        finally { _isBusy = false; }
    }

    private Task StartPreparationAsync() => SetPreparationAsync(cancel: false);

    private Task CancelPreparationAsync() => SetPreparationAsync(cancel: true);

    private async Task SetPreparationAsync(bool cancel)
    {
        if (_isBusy || _roomDetail is not { } room || room.RoomId != RoomId ||
            (cancel ? !room.CanCancelPreparation : !room.CanPrepare)) return;
        var requestRoomId = room.RoomId;
        var requestRoundNumber = room.RoundNumber;
        var requestRunSequence = room.RunSequence;
        _isBusy = true; _message = null;
        try
        {
            try
            {
                var (result, error) = cancel
                    ? await ApiService.CancelPreparationAsync(requestRoomId, requestRoundNumber, requestRunSequence)
                    : await ApiService.StartPreparationAsync(requestRoomId, requestRoundNumber, requestRunSequence);
                if (RoomId != requestRoomId || _refreshCancellation.IsCancellationRequested) return;
                _message = error ?? (result is null ? "未能确认准备状态，请稍后重试。" : null);
                if (result is not null && error is not null) AppendBattleLogs(result.Logs);
            }
            catch
            {
                if (RoomId != requestRoomId || _refreshCancellation.IsCancellationRequested) return;
                _message = "连接中断，未能确认这次请求；请查看刷新后的准备状态。";
            }

            try
            {
                await RefreshRoomDetailAsync(requestRoomId);
            }
            catch
            {
                _message = "连接失败，暂未同步准备状态，请稍后重试。";
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task JoinRoomAsync(int slotIndex) =>
        await RunRoomOperationAsync(() => ApiService.JoinRoomAsync(RoomId, slotIndex), "加入房间失败。");

    private async Task SetRoomVisibilityAsync(bool isPublic)
    {
        if (_isBusy || !IsOwner || _roomDetail?.ClosedAtUtc is not null) return;
        _isBusy = true;
        _isUpdatingVisibility = true;
        _visibilityError = null;
        try
        {
            var (detail, error) = await ApiService.SetRoomVisibilityAsync(RoomId, isPublic);
            if (detail is null) _visibilityError = GetRoomOperationError(error, "更新房间开放状态失败，请重试。");
            else
            {
                ApplyRoomDetail(detail, allowCombatFeedback: false);
                _serverTimeUtc = detail.ServerTimeUtc;
                _serverTimeReceivedAtUtc = DateTime.UtcNow;
                MergeRoomBattleLogs(detail.BattleLogs);
            }
        }
        catch { _visibilityError = "连接失败，未能确认开放状态，请重试。"; }
        finally { _isUpdatingVisibility = false; _isBusy = false; }
    }

    private async Task LeaveRoomAsync() =>
        await RunRoomOperationAsync(() => ApiService.LeaveRoomAsync(RoomId), "离开房间失败。");

    private async Task SetSlotAutoAsync(int slotIndex, bool isAutoEnabled)
    {
        if (_isBusy || _roomDetail is null || _roomDetail.ClosedAtUtc.HasValue ||
            isAutoEnabled && !_roomDetail.IsCurrentUserAutoUnlocked) return;
        var requestRoomId = RoomId;
        _isBusy = true; _message = null;
        try
        {
            var (response, error) = await ApiService.SetSlotAutoAsync(requestRoomId, slotIndex, isAutoEnabled);
            if (requestRoomId != RoomId || _refreshCancellation.IsCancellationRequested) return;
            if (response is null)
            {
                _message = GetRoomOperationError(error, "更新 Auto 失败，请稍后重试。");
                await RefreshRoomDetailAsync(requestRoomId);
            }
            else
            {
                ApplyRoomDetail(response.Room);
                _serverTimeUtc = response.Room.ServerTimeUtc;
                _serverTimeReceivedAtUtc = DateTime.UtcNow;
                MergeRoomBattleLogs(response.Room.BattleLogs);
            }
        }
        catch
        {
            if (requestRoomId == RoomId && !_refreshCancellation.IsCancellationRequested)
                _message = "连接失败，暂未确认 Auto 状态，请稍后重试。";
        }
        finally
        {
            _isBusy = false;
        }
    }

