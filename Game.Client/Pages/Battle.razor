    private async Task ToggleSoulImprintAsync(RoomSlotResponse character, RoomSoulImprintResponse soulImprint)
    {
        if (_isBusy || character.CharacterId is null || !CanQueueSoulImprint(character, soulImprint)) return;
        _isBusy = true;
        _skillMessage = null;
