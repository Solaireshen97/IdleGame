    private static bool IsConsumableQueued(RoomSlotResponse character, RoomConsumableSlotResponse supply) =>
        (character.PendingConsumableSlotMask & ConsumableRules.SlotMask(supply.SlotIndex)) != 0;

    private bool CanQueueConsumable(RoomSlotResponse character, RoomConsumableSlotResponse supply) =>
        _roomDetail is { ClosedAtUtc: null } &&
        _roomDetail.RoomStatus != Game.Shared.Enums.RoomStatus.BattleOver && character.IsAlive &&
        ConsumableRules.SlotMask(supply.SlotIndex) != 0 &&
        (IsConsumableQueued(character, supply) || supply.UnavailableReason is null);

    private SkillDialogContext? GetSkillDialogContext()
    {
        if (!_isSkillDialogOpen || _roomDetail is null || _selectedSkillCharacterId is null || _selectedSkillSlotIndex is null)
            return null;
        var character = _roomDetail.Slots.FirstOrDefault(slot => slot.CharacterId == _selectedSkillCharacterId);
        var skill = character?.Skills.FirstOrDefault(item => item.SlotIndex == _selectedSkillSlotIndex && item.SkillCode is not null);
        return character is null || skill is null ? null : new SkillDialogContext(character, skill);
    }

    private async Task SetQuickSkillCastAsync(int? characterId, bool isEnabled)
    {
        if (_isQuickSkillCastSaving || characterId is null) return;
        var requestRoomId = RoomId;
        _isQuickSkillCastSaving = true;
        _skillMessage = null;
        try
        {
            var error = await ApiService.SetQuickSkillCastAsync(characterId.Value, isEnabled);
            if (requestRoomId != RoomId || _refreshCancellation.IsCancellationRequested) return;
            if (error is not null)
            {
                _skillMessage = "快速释放设置未能保存，请重试。";
                return;
            }
            if (_roomDetail?.Slots.FirstOrDefault(slot => slot.CharacterId == characterId && slot.IsCurrentUserCharacter) is { } slot)
                slot.IsQuickSkillCastEnabled = isEnabled;
        }
        catch
        {
            if (requestRoomId == RoomId && !_refreshCancellation.IsCancellationRequested)
                _skillMessage = "连接中断，暂未确认快速释放设置，请稍后重试。";
        }
        finally { _isQuickSkillCastSaving = false; }
    }

    private async Task HandleSkillClickAsync(RoomSlotResponse character, RoomSkillSlotResponse skill)
    {
        if (_isBusy) return;
        if (IsSkillQueued(character, skill) || character.IsQuickSkillCastEnabled &&
            !CanChooseSkillTarget(skill) && CanQueueSkill(character, skill))
        {
            await ToggleSkillAsync(character, skill);
            return;
        }

        _selectedSkillCharacterId = character.CharacterId;
        _selectedSkillSlotIndex = skill.SlotIndex;
        _selectedSkillTargetId = null;
        _skillDialogMessage = null;
        _isSkillDialogOpen = true;
        _focusSkillDialogCloseButton = true;
    }

    private void CloseSkillDialog()
    {
        _isSkillDialogOpen = false;
        _selectedSkillCharacterId = null;
        _selectedSkillSlotIndex = null;
        _selectedSkillTargetId = null;
        _skillDialogMessage = null;
    }

    private async Task ConfirmSkillAsync(SkillDialogContext context)
    {
        if (CanChooseSkillTarget(context.Skill) && !IsSkillQueued(context.Character, context.Skill) &&
            (!_selectedSkillTargetId.HasValue || _roomDetail?.Slots.FirstOrDefault(slot => slot.CharacterId == _selectedSkillTargetId) is not { } target ||
             !CanSelectSkillTarget(context.Skill, target))) return;
        if (await ToggleSkillAsync(context.Character, context.Skill, _selectedSkillTargetId)) CloseSkillDialog();
    }

    private async Task SetSkillAutoAsync(SkillDialogContext context, bool enabled, int threshold, string? condition)
    {
        if (_isSkillAutoSaving || context.Character.CharacterId is null) return;
        _isSkillAutoSaving = true;
        _skillDialogMessage = null;
        try
        {
            var (response, error) = await ApiService.SetSkillAutoAsync(context.Character.CharacterId.Value,
                context.Skill.SlotIndex, new SetSkillAutoRequest
                {
                    AutoUseEnabled = enabled,
                    AutoConditionOverride = condition,
                    AutoHpThresholdPercent = threshold
                });
            if (response is null)
                _skillDialogMessage = GetSkillAutoError(error);
            else
                await RefreshRoomDetailAsync();
        }
        catch
        {
            _skillDialogMessage = "连接失败，自动使用设置未保存。";
        }
        finally
        {
            _isSkillAutoSaving = false;
        }
    }

    private static string GetSkillAutoError(string? error) => error?.Trim().Trim('"') switch
    {
        "InvalidHpThreshold" => "生命值阈值需要设置在 1% 到 100% 之间。",
        "InvalidAutoCondition" => "请选择一个有效的 Auto 释放条件。",
        "SkillNotEquipped" or "SkillNotLearned" => "技能配置已变化，请刷新页面。",
        "ConcurrencyConflict" => "技能设置刚刚发生变化，请重试。",
        _ => "自动使用设置保存失败，请稍后重试。"
    };

    private static bool IsSkillQueued(RoomSlotResponse character, RoomSkillSlotResponse skill) =>
        (character.PendingSkillSlotMask & SkillRules.SlotMask(skill.SlotIndex)) != 0;

    private static bool CanChooseSkillTarget(RoomSkillSlotResponse skill) =>
        SkillTargetRules.CanChooseAllyTarget(skill.Effects.Select(effect => (effect.Type, effect.Target)));

    private static bool CanSelectSkillTarget(RoomSkillSlotResponse skill, RoomSlotResponse target) =>
        target.IsAlive && target.CharacterId.HasValue && skill.Effects.Any(effect =>
            SkillTargetRules.UsesChosenTarget(effect.Type, effect.Target) && effect.Type switch
            {
                "Heal" => target.CharacterHp < target.CharacterMaxHp,
                "Cleanse" => target.StatusEffects.Any(status => !status.IsPositive && status.CanDispel),
                "Guard" or "ApplyStatus" => true,
                _ => false
            });

    private string QueuedSkillTargetName(RoomSkillSlotResponse skill) =>
        _roomDetail?.Slots.FirstOrDefault(slot => slot.CharacterId == skill.QueuedTargetCharacterId)?.CharacterName ?? "已离队的目标";

    private bool CanQueueSkill(RoomSlotResponse character, RoomSkillSlotResponse skill) =>
        _roomDetail?.RoomStatus != Game.Shared.Enums.RoomStatus.BattleOver && character.IsAlive && skill.SkillCode is not null &&
        (IsSkillQueued(character, skill) || skill.CooldownRoundsRemaining == 0 && HasApplicableSkillEffect(character, skill));

    private bool CanQueueSoulImprint(RoomSlotResponse character, RoomSoulImprintResponse soulImprint) =>
        _roomDetail?.RoomStatus != Game.Shared.Enums.RoomStatus.BattleOver && character.IsAlive &&
        (character.IsSoulImprintQueued || soulImprint.CooldownRoundsRemaining == 0 && SoulImprintHasTarget(character, soulImprint));

    private bool SoulImprintHasTarget(RoomSlotResponse character, RoomSoulImprintResponse soulImprint) => soulImprint.EffectType switch
    {
        Game.Shared.Enums.SoulImprintEffectType.Interrupt =>
            _roomDetail?.MonsterIntent is { ActionType: "Skill", IsInterruptible: true, IsInterrupted: false },
        Game.Shared.Enums.SoulImprintEffectType.CooldownReduction =>
            character.Skills.Any(skill => skill.SkillCode is not null && skill.CooldownRoundsRemaining > 0),
        Game.Shared.Enums.SoulImprintEffectType.HealCleanse =>
            _roomDetail?.Slots.Any(slot => slot.IsAlive &&
                (slot.CharacterHp < slot.CharacterMaxHp || slot.StatusEffects.Any(effect => !effect.IsPositive))) == true,
        _ => true
    };

    private string GetSoulImprintHint(RoomSlotResponse character, RoomSoulImprintResponse soulImprint)
    {
        if (_roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.BattleOver) return "战斗已结束";
        if (!character.IsAlive) return "角色已阵亡";
        if (character.IsSoulImprintQueued) return "点击取消本回合释放";
        if (soulImprint.CooldownRoundsRemaining > 0) return $"魂印蓄力中，还需 {soulImprint.CooldownRoundsRemaining} 回合";
        if (!CanQueueSoulImprint(character, soulImprint)) return "当前没有有效目标";
        return soulImprint.Description;
    }

    private static string GetSoulImprintStatus(RoomSoulImprintResponse soulImprint, bool selected)
    {
        if (selected) return "已安排本回合释放";
        if (soulImprint.CooldownRoundsRemaining > 0) return $"蓄力 {soulImprint.CooldownRoundsRemaining} 回合";
        return soulImprint.AutoUseEnabled ? "可释放 · AUTO" : "可以释放";
    }

    private string GetSkillHint(RoomSlotResponse character, RoomSkillSlotResponse skill)
    {
        if (_roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.BattleOver) return "战斗已结束";
        if (!character.IsAlive) return "角色已阵亡";
        if (IsSkillQueued(character, skill)) return skill.QueuedTargetCharacterId.HasValue
            ? $"已安排对 {QueuedSkillTargetName(skill)} 施放，点击取消" : "点击取消本回合手动施放";
        if (skill.CooldownRoundsRemaining > 0) return $"冷却中，还需 {skill.CooldownRoundsRemaining} 回合";
        if (!HasApplicableSkillEffect(character, skill)) return GetUnavailableSkillReason(skill);
        return string.IsNullOrWhiteSpace(skill.Description) ? "安排在下一次结算中手动施放" : skill.Description;
    }

    private string GetSkillStatus(RoomSkillSlotResponse skill, bool selected)
    {
        if (selected) return skill.QueuedTargetCharacterId.HasValue ? $"目标 · {QueuedSkillTargetName(skill)}" : "已安排手动施放";
        if (skill.CooldownRoundsRemaining > 0) return $"冷却 {skill.CooldownRoundsRemaining} 回合";
        if (skill.AutoUseEnabled) return $"自动 · {SkillAutoRules.Describe(skill.AutoCondition, skill.AutoHpThresholdPercent)}";
        return "可手动施放";
    }

    private static string GetSkillTone(RoomSkillSlotResponse skill)
    {
        if (skill.Effects.Any(effect => effect.Type is "Heal" or "Cleanse")) return "support";
        if (skill.Effects.Any(effect => effect.Type == "Guard")) return "guard";
        if (skill.Effects.Any(effect => effect.Type is "Interrupt" or "Dispel")) return "utility";
        return "damage";
    }

    private static string GetSkillAutoConditionText(RoomSkillSlotResponse skill) =>
        $"{SkillAutoRules.Describe(skill.AutoCondition, skill.AutoHpThresholdPercent)}时自动使用";

    private static string GetSkillEffectText(SkillEffectResponse effect, bool canChooseTarget = false)
    {
        var target = canChooseTarget && SkillTargetRules.UsesChosenTarget(effect.Type, effect.Target) ? "本次所选队友" : effect.Target switch
        {
            "Self" => "自身",
            "LowestHpAlly" or "LowestHpAllyFixed" => "生命值最低的队友",
            "AllAllies" or "AllAlive" => "全体存活队友",
            "AllOtherAlive" => "其他存活队友",
            "FrontAlly" or "FrontAllyFixed" => "前排队友",
            "Monster" => "敌人",
            _ => "目标"
        };
        return effect.Type switch
        {
            "Damage" => $"对{target}造成 {effect.AttackPowerPercent:0.##}% 攻击伤害{(effect.Power > 0 ? $"，另加 {effect.Power} 点威力" : "")}",
            "Heal" => $"为{target}恢复{(effect.Power > 0 ? $"{effect.Power} 点" : "")}{(effect.Power > 0 && effect.HealMaxHpPercent > 0 ? " + " : "")}{(effect.HealMaxHpPercent > 0 ? $"目标最大生命值的 {effect.HealMaxHpPercent:0.##}%" : "")}生命值",
            "Guard" => $"使{target}在本回合获得 {effect.Power}% 伤害减免",
            "Cleanse" => $"净化{target}的负面状态",
            "Dispel" => $"驱散{target}的增益状态",
            "Interrupt" => "打断敌人当前可打断技能",
            "ApplyStatus" when effect.StatusCode is "rogue-adrenaline-1" or "rogue-adrenaline-2" or "rogue-adrenaline-3" =>
                $"本回合和下一回合，普通攻击二连击概率 +{(effect.StatusCode switch { "rogue-adrenaline-1" => 20, "rogue-adrenaline-2" => 25, _ => 30 })} 个百分点",
            "ApplyStatus" when effect.StatusCode == "rogue-poison" =>
                $"使{target}中毒，未来 {effect.DurationRounds} 回合每回合受到施放时攻击力 {effect.AttackPowerPercent:0.##}% 的伤害",
            "ApplyStatus" => $"对{target}施加{GetStatusName(effect.StatusCode)}，持续 {effect.DurationRounds} 回合" +
                (effect.AttackPowerPercent > 0 ? $"，每回合造成施放时攻击力 {effect.AttackPowerPercent:0.##}% 的伤害" :
                    effect.HealMaxHpPercent > 0 ? $"，每回合恢复目标最大生命值的 {effect.HealMaxHpPercent:0.##}%" : ""),
            _ => $"对{target}产生技能效果"
        };
    }

    private static string GetStatusName(string? code) => code switch
    {
        "armor-break" => "破甲",
        "attack-down" => "攻击降低",
        "attack-up" => "攻击提升",
        "defense-up" => "防御提升",
        "regen" => "持续恢复",
        "knight-holy-burn" => "圣焰",
        "knight-holy-renew" => "圣佑回春",
        "rogue-shadow-charge" => "影袭蓄势",
        "rogue-poison" => "淬毒",
        "rogue-adrenaline-1" or "rogue-adrenaline-2" or "rogue-adrenaline-3" => "肾上腺素",
        _ => "状态效果"
    };

    private bool HasApplicableSkillEffect(RoomSlotResponse character, RoomSkillSlotResponse skill)
    {
        if (_roomDetail is null) return false;
        if (SkillRules.RequiresInterruptibleTarget(skill.Effects.Select(effect => effect.Type)))
            return _roomDetail.MonsterIntent is { ActionType: "Skill", IsInterruptible: true, IsInterrupted: false };
        return skill.Effects.Any(effect => effect.Type switch
        {
            "Damage" => _roomDetail.MonsterHp > 0,
            "Heal" when effect.Target == "Self" => character.CharacterHp < character.CharacterMaxHp,
            "Heal" => _roomDetail.Slots.Any(slot => slot.IsAlive && slot.CharacterHp < slot.CharacterMaxHp),
            "Guard" => _roomDetail.Slots.Any(slot => slot.IsAlive),
            "Cleanse" when effect.Target == "Self" => character.StatusEffects.Any(status => !status.IsPositive && status.CanDispel),
            "Cleanse" => _roomDetail.Slots.Any(slot => slot.IsAlive && slot.StatusEffects.Any(status => !status.IsPositive && status.CanDispel)),
            "Dispel" => _roomDetail.MonsterEffects.Any(status => status.IsPositive && status.CanDispel),
            "Interrupt" => _roomDetail.MonsterIntent is { ActionType: "Skill", IsInterruptible: true, IsInterrupted: false },
            "ApplyStatus" => effect.Target != "Monster" || _roomDetail.MonsterHp > 0,
            _ => false
        });
    }

    private string GetUnavailableSkillReason(RoomSkillSlotResponse skill)
    {
        if (skill.Effects.Any(effect => effect.Type == "Cleanse")) return "没有可净化的负面状态";
        if (skill.Effects.Any(effect => effect.Type == "Dispel")) return "怪物没有可驱散的增益";
        if (skill.Effects.Any(effect => effect.Type == "Interrupt")) return "当前没有可打断的敌方技能";
        if (skill.Effects.Any(effect => effect.Type == "Heal")) return "没有受伤队友";
        return "当前没有有效目标";
    }

    private static string GetDangerLabel(string dangerLevel) => dangerLevel switch
    {
        "Dangerous" => "危险",
        "Deadly" => "致命",
        _ => "普通"
    };

    private async Task<bool> ToggleSkillAsync(RoomSlotResponse character, RoomSkillSlotResponse skill, int? targetCharacterId = null)
    {
        if (_isBusy || character.CharacterId is null || !CanQueueSkill(character, skill)) return false;
        _isBusy = true;
        _skillMessage = null;
        var succeeded = false;
        try
        {
            var (detail, error) = await ApiService.QueueSkillAsync(RoomId, character.CharacterId.Value,
                skill.SlotIndex, !IsSkillQueued(character, skill), targetCharacterId);
            if (detail is null)
            {
                _skillMessage = GetSkillError(error);
                _skillDialogMessage = _skillMessage;
                await RefreshRoomDetailAsync();
            }
            else
            {
                _roomDetail = detail;
                _serverTimeUtc = detail.ServerTimeUtc;
                _serverTimeReceivedAtUtc = DateTime.UtcNow;
                _alignMobileQuickActions = true;
                succeeded = true;
            }
        }
        catch { _skillDialogMessage = _skillMessage = "连接失败，请稍后重试。"; }
        finally { _isBusy = false; }
        return succeeded;
    }

