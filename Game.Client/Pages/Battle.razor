@page "/battle/{roomId:int}"
@using Game.Client.Services
@using Game.Shared.Dtos
@using Game.Shared.Dtos.Auth
@using Game.Shared.Dtos.Characters
@using Game.Shared
@inject ApiService ApiService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>房间</PageTitle>

<div class="battle-page" @onkeydown="HandleBattleLogKeyDown">
    <header class="battle-page__header">
        <button class="back-link" @onclick="GoToRooms">← 返回大厅</button>
        <span class="battle-page__room">ROOM · @RoomId</span>
    </header>

@if (_roomDetail is null)
{
    <div class="battle-loading">正在进入战场...</div>
}
else
{
    <section class="battle-stage" aria-label="战斗场景">
        <div class="battle-stage__header">
            <div>
                <span class="section-kicker">DUNGEON ENCOUNTER</span>
                <h1>@_roomDetail.DungeonName</h1>
            </div>
            <div class="battle-stage__meta">
                <span class="battle-mode">@(_roomDetail.IsRepeatBattle ? "循环讨伐" : "单次讨伐")</span>
                <span class="battle-status">@GetStatusText()</span>
            </div>
        </div>

        <button type="button" class="battle-feed" @onclick="OpenBattleLog" @ref="_logTrigger" aria-haspopup="dialog">
            <span class="battle-feed__live">● LIVE LOG</span>
            <span class="battle-feed__latest">@GetLatestLog()</span>
            <span class="battle-feed__open">详细战报 <span aria-hidden="true">↗</span></span>
        </button>

        <div class="battle-field">
            <div class="battle-field__party">
                <div class="battle-field__label"><span>YOUR PARTY</span><strong>@_roomDetail.Slots.Count(slot => slot.IsOccupied) / @_roomDetail.SlotCount</strong></div>
                <div class="fighter-line">
                    @foreach (var slot in _roomDetail.Slots.OrderBy(slot => slot.SlotIndex))
                    {
                        <div class="fighter @(slot.IsOccupied ? "fighter--occupied" : "fighter--empty") @(!slot.IsAlive && slot.IsOccupied ? "fighter--down" : "")" title="@(slot.IsOccupied ? $"{slot.CharacterName} · HP {slot.CharacterHp}/{slot.CharacterMaxHp}" : $"{slot.SlotIndex} 号空槽位")">
                            <div class="fighter__portrait">
                                @if (slot.IsOccupied)
                                {
                                    <img src="/art/knight.svg" alt="" />
                                }
                                else
                                {
                                    <span aria-hidden="true">＋</span>
                                }
                                <span class="fighter__number">@slot.SlotIndex</span>
                            </div>
                            <strong>@(slot.IsOccupied ? slot.CharacterName : "空位")</strong>
                            @if (slot.IsOccupied) { <small class="fighter__level">Lv @slot.CharacterLevel</small> }
                            @if (slot.IsOccupied)
                            {
                                <progress class="fighter__health" value="@slot.CharacterHp" max="@slot.CharacterMaxHp" aria-label="@slot.CharacterName 生命值"></progress>
                                <small>@slot.CharacterHp / @slot.CharacterMaxHp</small>
                            }
                            else
                            {
                                <small>待命</small>
                            }
                        </div>
                    }
                </div>
            </div>

            <span class="battle-field__versus" aria-hidden="true">VS</span>

            <div class="battle-field__enemy @(_roomDetail.MonsterHp <= 0 ? "battle-field__enemy--defeated" : "")">
                <div class="battle-field__enemy-art"><img src="@GetMonsterArtPath()" alt="@_roomDetail.MonsterName" /></div>
                <div class="enemy-vitals">
                    <span>ENEMY / @_roomDetail.MonsterName.ToUpperInvariant()</span>
                    <div class="enemy-vitals__name"><strong>@_roomDetail.MonsterName</strong><span>@_roomDetail.MonsterHp / @_roomDetail.MonsterMaxHp HP</span></div>
                    <progress class="enemy-vitals__health" value="@_roomDetail.MonsterHp" max="@_roomDetail.MonsterMaxHp" aria-label="怪物生命值"></progress>
                </div>
            </div>
        </div>
        <div class="battle-stage__footer"><span>行动顺序：槽位 1 → @_roomDetail.SlotCount</span><span>@(_roomDetail.IsPreparationTimeoutEnabled ? $"准备超时 {BattleRules.PreparationTimeoutSeconds} 秒 · 本回合临时 Auto" : "无准备超时")</span></div>
    </section>

    @if (_isLogOpen)
    {
        <div class="battle-log-overlay" @onclick="CloseBattleLog">
            <section class="battle-log-dialog" role="dialog" aria-modal="true" aria-labelledby="battle-log-title" @onclick:stopPropagation>
                <header class="battle-log-dialog__header">
                    <div><span class="section-kicker">BATTLE REPORT</span><h2 id="battle-log-title">战斗记录</h2><p>本次页面内的最近 @_logs.Count 条记录</p></div>
                    <button type="button" class="battle-log-dialog__close" @onclick="CloseBattleLog" @ref="_logCloseButton" aria-label="关闭战报">×</button>
                </header>
                <div class="battle-log-dialog__content">
                    @if (_logs.Count == 0)
                    {
                        <p>战场尚无记录。准备战斗后，行动过程会显示在这里。</p>
                    }
                    else
                    {
                        <ol>
                            @foreach (var log in _logs.AsEnumerable().Reverse())
                            {
                                <li>@log</li>
                            }
                        </ol>
                    }
                </div>
            </section>
        </div>
    }

    var autoSlot = _roomDetail.Slots.FirstOrDefault(slot => slot.IsCurrentUserCharacter && (slot.IsMainControl || !IsOwner));
    <section class="battle-controls" aria-label="行动控制">
        <div class="battle-controls__main">
            <div class="battle-controls__heading"><span class="section-kicker">COMMAND PHASE</span><h2>行动指令</h2><p>@GetActionHint()</p></div>
            <div class="battle-controls__action">
                @if (_roomDetail.IsAllAliveMembersAuto && _roomDetail.RoomStatus != Game.Shared.Enums.RoomStatus.BattleOver)
                {
                    <span class="auto-indicator"><span aria-hidden="true">✦</span> 自动战斗中</span>
                }
                else if (_roomDetail.CanPrepare)
                {
                    <button class="button button--primary battle-controls__primary" @onclick="StartPreparationAsync" disabled="@_isBusy">准备并结算 <span aria-hidden="true">→</span></button>
                }
                else if (_roomDetail.RoomStatus == Game.Shared.Enums.RoomStatus.Preparing)
                {
                    <span class="battle-controls__waiting">已准备 · 等待队友</span>
                }
                else
                {
                    <span class="battle-controls__waiting">@GetStatusText()</span>
                }
                @if (autoSlot is not null)
                {
                    <label class="battle-auto @(autoSlot.CanConfigureAuto ? "" : "battle-auto--locked")" title="@(autoSlot.IsAutoUnlockedForCurrentUser ? "自动准备开关" : "首次通关此副本后解锁 Auto")">
                        <span><input type="checkbox" checked="@autoSlot.IsAutoEnabled" @onchange="e => SetSlotAutoAsync(autoSlot.SlotIndex, (bool)e.Value!)" disabled="@(_isBusy || !autoSlot.CanConfigureAuto)" /> Auto 自动准备</span>
                        @if (!autoSlot.IsAutoUnlockedForCurrentUser) { <small>通关后解锁</small> }
                    </label>
                }
            </div>
        </div>
        <div class="battle-controls__tools">
            @if (_roomDetail.RoomStatus == Game.Shared.Enums.RoomStatus.BattleOver && _roomDetail.NextBattleStartAtUtc is null)
            {
                <button class="button button--secondary" @onclick="ResetBattleAsync" disabled="@_isBusy">重置战斗</button>
            }
            else if (_roomDetail.CanLeaveRoom)
            {
                <button class="button button--secondary" @onclick="LeaveRoomAsync" disabled="@_isBusy">离开房间</button>
            }
            <button class="button button--quiet" @onclick="HealAsync" disabled="@_isBusy">恢复主控 10 HP</button>
            @if (IsOwner)
            {
                <button class="button button--danger" @onclick="DismissRoomAsync" disabled="@_isBusy">解散房间</button>
            }
        </div>
        @{
            var countdown = GetActiveCountdown();
        }
        @if (countdown is not null)
        {
            var remainingSeconds = GetRemainingSeconds(countdown.DeadlineUtc);
            var progress = GetCountdownProgress(countdown);
            <div class="battle-countdown battle-countdown--@countdown.Kind">
                <div class="battle-countdown__heading"><span>@countdown.Label</span><strong>@FormatCountdown(remainingSeconds)</strong></div>
                <div class="battle-countdown__track" role="progressbar" aria-label="@countdown.Label" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progress"><span class="battle-countdown__fill" style="width: @(progress)%"></span></div>
            </div>
        }
    </section>

    <details class="formation-panel">
        <summary class="formation-panel__heading"><span><span class="section-kicker">FORMATION</span><strong>队伍编成与槽位管理</strong></span><span>@_roomDetail.Slots.Count(slot => slot.IsOccupied) / @_roomDetail.SlotCount 人 · 展开管理 <span aria-hidden="true">⌄</span></span></summary>
        <p class="formation-panel__progress-note">角色升级会获得天赋点；加点功能将在后续开放。</p>
        <div class="slot-grid">
            @foreach (var slot in _roomDetail.Slots.OrderBy(x => x.SlotIndex))
            {
                <article class="party-slot @(slot.IsOccupied ? "party-slot--occupied" : "party-slot--empty")">
                    <span class="party-slot__index">@slot.SlotIndex</span>
                    @if (slot.IsOccupied)
                    {
                        <div class="party-slot__identity"><h3>@slot.CharacterName</h3><span>@slot.PlayerName · Lv @slot.CharacterLevel</span></div>
                        <div class="party-slot__hp"><span>HP @slot.CharacterHp / @slot.CharacterMaxHp</span><span>@(slot.IsAlive ? "存活" : "已阵亡")</span></div>
                        <progress class="health-bar" value="@slot.CharacterHp" max="@slot.CharacterMaxHp"></progress>
                        <div class="party-slot__experience">
                            <div class="party-slot__experience-label"><span>EXP</span><strong>@(slot.ExperienceToNextLevel is int nextExperience ? $"{slot.CharacterExperience} / {nextExperience}" : "MAX")</strong></div>
                            <progress value="@(slot.ExperienceToNextLevel is null ? 1 : slot.CharacterExperience ?? 0)" max="@(slot.ExperienceToNextLevel ?? 1)" aria-label="@slot.CharacterName 经验值"></progress>
                            <small>未分配天赋点 @slot.TalentPoints</small>
                        </div>
                        <div class="party-slot__badges">@if (slot.IsMainControl) { <span class="status-badge status-badge--gold">主控</span> } @if (!slot.IsAlive) { <span class="status-badge status-badge--danger">已死亡</span> } else if (slot.IsTemporaryAuto) { <span class="status-badge">超时自动准备</span> } else if (slot.IsAutoEnabled) { <span class="status-badge status-badge--success">自动准备</span> } else if (slot.IsConfirmed) { <span class="status-badge status-badge--success">已准备</span> } else { <span class="status-badge">@(slot.IsCurrentUserCharacter ? "等待你准备" : "等待玩家准备")</span> }</div>
                    }
                    else
                    {
                        <div class="party-slot__identity"><h3>空槽位</h3><span>等待冒险者加入</span></div>
                        @if (!IsOwner && !_roomDetail.CanLeaveRoom && CanChangeFormation)
                        {
                            <button class="button button--secondary" @onclick="() => JoinRoomAsync(slot.SlotIndex)" disabled="@_isBusy">加入房间</button>
                        }
                    }

                    @if (IsOwner)
                    {
                        <div class="slot-management">
                            <select @bind="_selectedCharacterIds[slot.SlotIndex]" disabled="@(_isBusy || !CanChangeFormation)">
                                <option value="0">选择自有角色</option>
                                @foreach (var character in _characters)
                                {
                                    <option value="@character.CharacterId">@character.Name · Lv @character.Level (@character.Hp / @character.MaxHp)</option>
                                }
                            </select>
                            <button class="button button--quiet" @onclick="() => AssignSlotAsync(slot.SlotIndex)" disabled="@(_isBusy || !CanChangeFormation || _selectedCharacterIds[slot.SlotIndex] == 0)">@(slot.IsOccupied ? "替换" : "上阵")</button>
                            @if (slot.IsOccupied)
                            {
                                <button class="button button--quiet" @onclick="() => RemoveSlotAsync(slot.SlotIndex)" disabled="@(_isBusy || !CanChangeFormation || slot.IsMainControl)">移除</button>
                                <button class="button button--quiet" @onclick="() => SetMainControlAsync(slot.CharacterId!.Value)" disabled="@(_isBusy || !CanChangeFormation || slot.IsMainControl)">设为主控</button>
                            }
                        </div>
                    }
                </article>
            }
        </div>
    </details>
    @if (_message is not null) { <p class="notice-message">@_message</p> }
}
</div>

@code {
    [Parameter] public int RoomId { get; set; }
    private RoomDetailResponse? _roomDetail;
    private CurrentUserResponse? _currentUser;
    private List<CharacterSummaryResponse> _characters = new();
    private readonly List<string> _logs = new();
    private readonly CancellationTokenSource _refreshCancellation = new();
    private bool _isBusy;
    private string? _message;
    private readonly Dictionary<int, int> _selectedCharacterIds = new();
    private DateTime _serverTimeUtc;
    private DateTime _serverTimeReceivedAtUtc;
    private ElementReference _logTrigger;
    private ElementReference _logCloseButton;
    private bool _isLogOpen;
    private bool _focusLogCloseButton;
    private bool _focusLogTrigger;
    private sealed record BattleCountdown(string Label, DateTime DeadlineUtc, int DurationSeconds, string Kind);
    private bool IsOwner => _roomDetail is not null && _currentUser?.UserId == _roomDetail.OwnerUserId;
    private bool CanChangeFormation => _roomDetail?.RoomStatus is Game.Shared.Enums.RoomStatus.NotStarted or Game.Shared.Enums.RoomStatus.BattleOver;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await ApiService.GetCurrentUserAsync();
        if (_currentUser is null) { Navigation.NavigateTo("/login", replace: true); return; }
        _characters = await ApiService.GetCurrentCharactersAsync() ?? new();
        await RefreshRoomDetailAsync();
        _ = RefreshCooldownAsync(_refreshCancellation.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusLogCloseButton)
        {
            _focusLogCloseButton = false;
            await _logCloseButton.FocusAsync();
        }
        else if (_focusLogTrigger)
        {
            _focusLogTrigger = false;
            await _logTrigger.FocusAsync();
        }
    }

    private void OpenBattleLog()
    {
        _isLogOpen = true;
        _focusLogCloseButton = true;
    }

    private void CloseBattleLog()
    {
        _isLogOpen = false;
        _focusLogTrigger = true;
    }

    private void HandleBattleLogKeyDown(KeyboardEventArgs args)
    {
        if (_isLogOpen && args.Key == "Escape") CloseBattleLog();
    }

    private async Task AssignSlotAsync(int slotIndex)
    {
        _isBusy = true; _message = null;
        var (detail, error) = await ApiService.AssignRoomSlotAsync(RoomId, slotIndex, _selectedCharacterIds[slotIndex]);
        if (detail is null) _message = error ?? "上阵角色失败。"; else _roomDetail = detail;
        _isBusy = false;
    }

    private async Task RemoveSlotAsync(int slotIndex)
    {
        _isBusy = true; _message = null;
        var (detail, error) = await ApiService.RemoveRoomSlotAsync(RoomId, slotIndex);
        if (detail is null) _message = error ?? "移除角色失败。"; else _roomDetail = detail;
        _isBusy = false;
    }

    private async Task SetMainControlAsync(int characterId)
    {
        _isBusy = true; _message = null;
        var (detail, error) = await ApiService.SetMainControlAsync(RoomId, characterId);
        if (detail is null) _message = error ?? "切换主控失败。"; else _roomDetail = detail;
        _isBusy = false;
    }

    private async Task StartPreparationAsync()
    {
        _isBusy = true; _message = null;
        var (result, error) = await ApiService.StartPreparationAsync(RoomId);
        if (result is null) _message = error ?? "开始回合失败。";
        else { AppendBattleLogs(result.Logs); _message = error; }
        await RefreshRoomDetailAsync();
        _isBusy = false;
    }

    private async Task JoinRoomAsync(int slotIndex)
    {
        _isBusy = true;
        var (detail, error) = await ApiService.JoinRoomAsync(RoomId, slotIndex);
        if (detail is null) _message = error ?? "加入房间失败。"; else _roomDetail = detail;
        _isBusy = false;
    }

    private async Task LeaveRoomAsync()
    {
        _isBusy = true;
        var (detail, error) = await ApiService.LeaveRoomAsync(RoomId);
        if (detail is null) _message = error ?? "离开房间失败。"; else _roomDetail = detail;
        _isBusy = false;
    }

    private async Task SetSlotAutoAsync(int slotIndex, bool isAutoEnabled)
    {
        _isBusy = true;
        var (response, error) = await ApiService.SetSlotAutoAsync(RoomId, slotIndex, isAutoEnabled);
        if (response is null) _message = error ?? "配置 Auto 失败。";
        else
        {
            _roomDetail = response.Room;
            _serverTimeUtc = response.Room.ServerTimeUtc;
            _serverTimeReceivedAtUtc = DateTime.UtcNow;
            if (response.RoundResult is not null) AppendBattleLogs(response.RoundResult.Logs);
        }
        _isBusy = false;
    }

    private async Task ResetBattleAsync()
    {
        _isBusy = true; _message = null;
        var (detail, error) = await ApiService.ResetBattleAsync(RoomId);
        if (detail is null) _message = error ?? "重置战斗失败。"; else { _roomDetail = detail; _logs.Clear(); AppendBattleLogs(["战斗已重置。"]); }
        _isBusy = false;
    }

    private async Task HealAsync()
    {
        _isBusy = true; _message = null;
        var (detail, error) = await ApiService.HealAsync(RoomId);
        if (detail is null) _message = error ?? "恢复角色失败。"; else { _roomDetail = detail; AppendBattleLogs(["主控角色恢复了 10 HP。"]); }
        _isBusy = false;
    }

    private async Task DismissRoomAsync()
    {
        _isBusy = true;
        if (await ApiService.DeleteRoomAsync(RoomId)) Navigation.NavigateTo("/rooms"); else { _message = "解散房间失败。"; _isBusy = false; }
    }

    private async Task RefreshRoomDetailAsync()
    {
        _roomDetail = await ApiService.GetRoomDetailAsync(RoomId);
        if (_roomDetail is not null)
        {
            foreach (var slot in _roomDetail.Slots) _selectedCharacterIds.TryAdd(slot.SlotIndex, 0);
        }
        if (_roomDetail is not null) { _serverTimeUtc = _roomDetail.ServerTimeUtc; _serverTimeReceivedAtUtc = DateTime.UtcNow; }
    }

    private void GoToRooms() => Navigation.NavigateTo("/rooms");
    private DateTime GetEstimatedServerTimeUtc() => _serverTimeUtc + (DateTime.UtcNow - _serverTimeReceivedAtUtc);
    private int GetRemainingSeconds(DateTime deadlineUtc) => Math.Max(0, (int)Math.Ceiling((deadlineUtc - GetEstimatedServerTimeUtc()).TotalSeconds));
    private BattleCountdown? GetActiveCountdown()
    {
        if (_roomDetail?.NextBattleStartAtUtc is DateTime nextBattle)
            return new("副本重开", nextBattle, BattleRules.RepeatBattleDelaySeconds, "repeat");
        if (_roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.Cooldown && _roomDetail.NextRoundAvailableAtUtc is DateTime nextRound)
        {
            var duration = _roomDetail.RoundCooldownDurationSeconds ??
                (_roomDetail.IsAllAliveMembersAuto || GetRemainingSeconds(nextRound) > BattleRules.RoundCooldownSeconds
                    ? BattleRules.AutoRoundCooldownSeconds : BattleRules.RoundCooldownSeconds);
            return new("下一回合", nextRound, duration, "round");
        }
        if ((_roomDetail?.RoomStatus is Game.Shared.Enums.RoomStatus.NotStarted or Game.Shared.Enums.RoomStatus.Preparing) &&
            _roomDetail.PreparationExpiresAtUtc is DateTime preparationExpires && !_roomDetail.IsAllAliveMembersAuto)
            return new("准备超时", preparationExpires, _roomDetail.PreparationTimeoutSeconds, "prepare");
        return null;
    }
    private int GetCountdownProgress(BattleCountdown countdown) => (int)Math.Clamp(
        Math.Round(100 * (1 - (countdown.DeadlineUtc - GetEstimatedServerTimeUtc()).TotalSeconds / Math.Max(1, countdown.DurationSeconds))), 0, 100);
    private static string FormatCountdown(int remainingSeconds) => $"{remainingSeconds / 60:00}:{remainingSeconds % 60:00}";
    private string GetLatestLog() => _logs.Count == 0 ? "战斗尚未开始，行动记录会在这里出现。" : _logs[^1];
    private string GetMonsterArtPath() => _roomDetail?.MonsterName.ToLowerInvariant() switch
    {
        "slime" => "/art/slime.svg",
        "goblin" => "/art/goblin.svg",
        "wolf" => "/art/wolf.svg",
        _ => "/art/monster.svg"
    };
    private string GetActionHint()
    {
        if (_roomDetail?.NextBattleStartAtUtc is not null) return "胜利！即将重开副本，全队恢复至满 HP。";
        if (_roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.BattleOver) return _roomDetail.MonsterHp <= 0 ? "副本挑战完成。" : "队伍战败，可重置后再次挑战。";
        if (_roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.Cooldown) return "冷却中，结束后进入下一回合。";
        if (_roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.Preparing) return _roomDetail.IsPreparationTimeoutEnabled ? "等待全员准备，超时后自动开始。" : "等待全员准备，当前未启用超时。";
        if (_roomDetail?.IsAllAliveMembersAuto == true) return "队伍已开启 Auto，回合将自动推进。";
        return _roomDetail?.CanPrepare == true
            ? _roomDetail.IsPreparationTimeoutEnabled ? "可手动准备；倒计时结束后本回合自动结算。" : "确认准备后推进本回合。"
            : "在下方编成队伍，等待战斗开始。";
    }
    private void AppendBattleLogs(IEnumerable<string> logs)
    {
        _logs.AddRange(logs);
        if (_logs.Count > 80) _logs.RemoveRange(0, _logs.Count - 80);
    }
    private string GetStatusText() => _roomDetail?.RoomStatus switch
    {
        Game.Shared.Enums.RoomStatus.NotStarted => "未开始",
        Game.Shared.Enums.RoomStatus.Cooldown => "冷却中",
        Game.Shared.Enums.RoomStatus.Preparing => "准备中",
        Game.Shared.Enums.RoomStatus.BattleOver when _roomDetail.MonsterHp <= 0 => "战斗胜利",
        Game.Shared.Enums.RoomStatus.BattleOver => "队伍战败",
        _ => "未知"
    };

    private async Task RefreshCooldownAsync(CancellationToken cancellationToken)
    {
        try
        {
            var ticks = 0;
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(1), cancellationToken);
                ticks++;
                if (ticks % 2 == 0 && !_isBusy && (_roomDetail?.RoomStatus is Game.Shared.Enums.RoomStatus.Cooldown or Game.Shared.Enums.RoomStatus.Preparing ||
                    _roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.NotStarted && _roomDetail.IsPreparationTimeoutEnabled ||
                    _roomDetail?.IsAllAliveMembersAuto == true || _roomDetail?.NextBattleStartAtUtc is not null)
                )
                {
                    var (result, _) = await ApiService.SyncBattleAsync(RoomId);
                    if (result is not null) AppendBattleLogs(result.Logs);
                    await RefreshRoomDetailAsync();
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose() { _refreshCancellation.Cancel(); _refreshCancellation.Dispose(); }
}
