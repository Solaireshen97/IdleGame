                    "SoulImprintNotEquipped" => "魂印装备已变化，请刷新页面。",
                    "CharacterDead" => "角色已阵亡。",
                    "BattleOver" => "战斗已结束。",
                    "ConcurrencyConflict" => "战斗状态已变化，请重试。",
                    _ => "安排魂印失败，请稍后重试。"
