    private async Task<bool> RefreshRoomDetailAsync(int? expectedRoomId = null)
    {
        var requestRoomId = expectedRoomId ?? RoomId;
        var result = await ApiService.LoadRoomDetailAsync(requestRoomId, _refreshCancellation.Token);
        if (requestRoomId != RoomId || _refreshCancellation.IsCancellationRequested) return false;
        if (result.Status == RoomLoadStatus.Unavailable)
        {
            Navigation.NavigateTo("/rooms?notice=room-unavailable", replace: true);
            return false;
        }
        if (result.Status == RoomLoadStatus.Unauthorized)
        {
            ActiveCharacterState.Clear();
            Navigation.NavigateTo("/login", replace: true);
            return false;
        }
        if (result.Room is not { } latest)
        {
            _roomLoadError = "连接失败、超时或服务暂时不可用，请重试。";
            return false;
        }
        _roomLoadError = null;
        ApplyRoomDetail(latest);
        if (_roomDetail is not null)
        {
            foreach (var slot in _roomDetail.Slots) _selectedCharacterIds.TryAdd(slot.SlotIndex, 0);
            MergeRoomBattleLogs(_roomDetail.BattleLogs);
        }
        if (_roomDetail is not null) { _serverTimeUtc = _roomDetail.ServerTimeUtc; _serverTimeReceivedAtUtc = DateTime.UtcNow; }
        return true;
    }

    private void ApplyRoomDetail(RoomDetailResponse? detail, bool allowCombatFeedback = true)
    {
        var previous = _roomDetail;
        if (previous is not null && detail is not null)
        {
            var finished = detail.Operations.FirstOrDefault(operation => operation.Status != "Pending" &&
                previous.Operations.Any(old => old.Id == operation.Id && old.Status == "Pending"));
            if (finished is not null) _message = finished.Message;
        }
        if (_isMonsterStatusDialogOpen && (detail is null || previous is null || detail.ClosedAtUtc.HasValue ||
            detail.RunSequence != previous.RunSequence || detail.CurrentWaveNumber != previous.CurrentWaveNumber ||
            detail.CurrentEnemyNumber != previous.CurrentEnemyNumber ||
            !string.Equals(detail.MonsterName, previous.MonsterName, StringComparison.Ordinal)))
        {
            _isMonsterStatusDialogOpen = false;
            _focusMonsterStatusDialogCloseButton = false;
        }
        _roomDetail = detail;
        SyncMobileActionCharacter(previous, detail);
        if (!allowCombatFeedback || detail is null || IsBattlePanelOpen)
        {
            ClearCombatFeedback();
            return;
        }
        if (_activeCombatPlan is { } active && _combatScene is { } scene)
        {
            if (BattleFeedbackPlanner.CanFinishPlayback(scene, detail, active)) return;
            ClearCombatFeedback();
        }
        // Inspect the killing round before treating a changed enemy or a closed
        // room as navigation. Both can be part of that same server response.
        if (BattleFeedbackPlanner.Create(previous, detail) is { } plan)
        {
            _combatScene = previous;
            _activeCombatPlan = _pendingCombatPlan = plan;
        }
        else if (detail.ClosedAtUtc.HasValue || previous is not null &&
            (!BattleFeedbackPlanner.SameEncounter(previous, detail) || detail.RoundNumber != previous.RoundNumber))
            ClearCombatFeedback();
    }

    private void ClearCombatFeedback()
    {
        _cancelCombatPlayback = true;
        _activeCombatPlan = _pendingCombatPlan = _lastCombatPlan = null;
        _combatScene = null;
        _combatAnnouncement = string.Empty;
    }

    private void SyncMobileActionCharacter(RoomDetailResponse? previous, RoomDetailResponse? current)
    {
        if (current is null) return;

        var selected = current.Slots.FirstOrDefault(slot => slot.CharacterId == _mobileActionCharacterId &&
            slot.IsCurrentUserCharacter && slot.IsOccupied);
        if (selected is null)
        {
            SetMobileActionCharacter(current.Slots.FirstOrDefault(slot => slot.IsCurrentUserCharacter && slot.IsOccupied && slot.CharacterId == _accountCharacterId)?.CharacterId
                ?? current.Slots.FirstOrDefault(slot => slot.IsCurrentUserCharacter && slot.IsOccupied && slot.IsAlive)?.CharacterId
                ?? current.Slots.FirstOrDefault(slot => slot.IsCurrentUserCharacter && slot.IsOccupied)?.CharacterId);
            return;
        }

        var previouslyAlive = previous?.Slots.FirstOrDefault(slot => slot.CharacterId == selected.CharacterId)?.IsAlive == true;
        if (!previouslyAlive || selected.IsAlive) return;

        SetMobileActionCharacter(current.Slots.FirstOrDefault(slot => slot.IsCurrentUserCharacter && slot.IsOccupied && slot.IsAlive)?.CharacterId
            ?? selected.CharacterId);
    }

    private void SetMobileActionCharacter(int? characterId)
    {
        if (_mobileActionCharacterId == characterId) return;

        _mobileActionCharacterId = characterId;
        _scrollToMobileActionCharacter = true;
        _alignMobileQuickActions = true;
    }

    private void HandleAccountCharacterChanged()
    {
        var characterId = ActiveCharacterState.Current?.CharacterId;
        if (_accountCharacterId == characterId) return;
        _accountCharacterId = characterId;
        if (_roomDetail?.Slots.Any(slot => slot.IsCurrentUserCharacter && slot.IsOccupied && slot.CharacterId == characterId) == true)
            SetMobileActionCharacter(characterId);
        _ = InvokeAsync(StateHasChanged);
    }

    private static int HealthPercent(int? hp, int? maxHp) =>
        (int)Math.Clamp((hp ?? 0) * 100L / Math.Max(1, maxHp ?? 1), 0, 100);

    private string GetCombatHeadline() => _roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.BattleOver
        ? _roomDetail.MonsterHp <= 0 ? "讨伐完成" : "队伍战败"
        : _roomDetail?.MonsterHp <= 0 ? "目标击破"
        : _lastCombatPlan is not null ? "回合完成" : "等待出手";

    private async Task PlayCombatFeedbackAsync(BattleFeedbackPlan plan)
    {
        var assetsUnavailable = false;
        try
        {
            assetsUnavailable = await Js.InvokeAsync<string?>("battleCombat.play", _battleStage, plan) == "assets-unavailable";
        }
        catch (JSException) { /* Presentation must never prevent the authoritative room update. */ }
        catch (TaskCanceledException) { }
        finally
        {
            if (ReferenceEquals(_activeCombatPlan, plan) && !_refreshCancellation.IsCancellationRequested)
            {
                _lastCombatPlan = plan;
                _combatAnnouncement = $"第 {plan.Round} 回合，{plan.HitCount} 次命中，共造成 {plan.TotalDamage} 点伤害。" +
                    (plan.CriticalCount > 0 ? $"{plan.CriticalCount} 次暴击。" : "") + (plan.Defeated ? "目标已击破。" : "");
                if (assetsUnavailable) _combatAnnouncement += "部分战斗图片未能载入，已同步战斗结果。";
                _activeCombatPlan = null;
                _combatScene = null;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void GoToRooms() => Navigation.NavigateTo("/rooms");
    private DateTime GetEstimatedServerTimeUtc() => _serverTimeUtc + (DateTime.UtcNow - _serverTimeReceivedAtUtc);
    private int GetRemainingSeconds(DateTime deadlineUtc) => Math.Max(0, (int)Math.Ceiling((deadlineUtc - GetEstimatedServerTimeUtc()).TotalSeconds));
    private BattleCountdown? GetActiveCountdown()
    {
        if (_roomDetail?.NextBattleStartAtUtc is DateTime nextBattle)
            return new("副本重开", nextBattle, BattleRules.RepeatBattleDelaySeconds, "repeat");
        if (_roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.WaveTransition && _roomDetail.NextWaveStartAtUtc is DateTime nextWave)
            return new("下一名敌人", nextWave, BattleRules.WaveTransitionSeconds, "wave");
        if (_roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.Cooldown && _roomDetail.NextRoundAvailableAtUtc is DateTime nextRound)
        {
            var duration = _roomDetail.RoundCooldownDurationSeconds ??
                (_roomDetail.IsAllAliveMembersAuto || GetRemainingSeconds(nextRound) > BattleRules.RoundCooldownSeconds
                    ? BattleRules.AutoRoundCooldownSeconds : BattleRules.RoundCooldownSeconds);
            return new("下一回合", nextRound, duration, "round");
        }
        if ((_roomDetail?.RoomStatus is Game.Shared.Enums.RoomStatus.NotStarted or Game.Shared.Enums.RoomStatus.Preparing) &&
            _roomDetail.PreparationExpiresAtUtc is DateTime preparationExpires && !_roomDetail.IsAllAliveMembersAuto)
            return new("准备超时", preparationExpires, _roomDetail.PreparationTimeoutSeconds, "prepare");
        return null;
    }
    private int GetCountdownProgress(BattleCountdown countdown) => (int)Math.Clamp(
        Math.Round(100 * (1 - (countdown.DeadlineUtc - GetEstimatedServerTimeUtc()).TotalSeconds / Math.Max(1, countdown.DurationSeconds))), 0, 100);
    private static string FormatCountdown(int remainingSeconds) => $"{remainingSeconds / 60:00}:{remainingSeconds % 60:00}";
    private string GetLatestLog() => _logs.Count == 0 ? "战斗尚未开始，行动记录会在这里出现。" : _logs[^1].Text;
    private static string GetElementRelation(RoomSlotResponse slot) => slot.OutgoingElementModifierPercent switch
    {
        > 0 => "克制",
        < 0 => "被克制",
        _ => "均势"
    };

    private static string FormatElementModifier(int percent) => percent > 0 ? $"+{percent}%" : $"{percent}%";
    private bool IsMonsterIntentTarget(RoomSlotResponse slot) =>
        _roomDetail is { MonsterHp: > 0, NextBattleStartAtUtc: null } &&
        _roomDetail.RoomStatus != Game.Shared.Enums.RoomStatus.WaveTransition &&
        _roomDetail.MonsterIntent is { IsInterrupted: false, TargetCharacterId: int targetId } && slot.CharacterId == targetId;

    private string GetActionHint()
    {
        if (_roomDetail?.NextBattleStartAtUtc is not null) return "胜利！即将重开副本，全队恢复至满 HP。";
        if (_roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.WaveTransition) return "敌人已击败，下一名敌人即将进入战场。";
        if (_roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.BattleOver) return _roomDetail.MonsterHp <= 0 ? "副本挑战完成。" : IsOwner ? "队伍战败，可重置后再次挑战。" : "队伍战败，等待房主重置战斗。";
        if (_roomDetail?.CanCancelPreparation == true)
            return _roomDetail.RoomStatus == Game.Shared.Enums.RoomStatus.Cooldown
                ? "已准备；可取消并调整操作，原冷却倒计时不变。"
                : "已准备，等待队友；取消准备会保留已排队操作。";
        if (IsCurrentUserPrepared() && _roomDetail?.IsCurrentUserAutoEnabled == true)
            return "Auto 自动准备中；先关闭 Auto，才能取消准备。";
        if (_roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.Cooldown)
            return IsCurrentUserPrepared() ? "已准备，正在等待冷却结束。" : "冷却中，可提前准备下一回合操作。";
        if (_roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.Preparing) return _roomDetail.IsPreparationTimeoutEnabled ? "等待全员准备，超时后自动开始。" : "等待全员准备，当前未启用超时。";
        if (_roomDetail?.IsAllAliveMembersAuto == true) return "队伍已开启 Auto，回合将自动推进。";
        return _roomDetail?.CanPrepare == true
            ? _roomDetail.IsPreparationTimeoutEnabled ? "可手动准备；倒计时结束后本回合自动结算。" : "确认准备后推进本回合。"
            : "在下方编成队伍，等待战斗开始。";
    }
    private void AppendBattleLogs(IEnumerable<string> logs)
    {
        foreach (var log in logs) _logs.Add(new BattleLogEntry(--_nextLocalLogId, log));
        if (_logs.Count > 80) _logs.RemoveRange(0, _logs.Count - 80);
    }
    private bool IsCurrentUserPrepared()
    {
        var aliveOwnSlots = _roomDetail?.Slots.Where(slot => slot.IsCurrentUserCharacter && slot.IsOccupied && slot.IsAlive).ToList();
        return aliveOwnSlots is { Count: > 0 } && aliveOwnSlots.All(slot => slot.IsConfirmed);
    }
    private void MergeRoomBattleLogs(IEnumerable<BattleLogResponse> logs)
    {
        foreach (var log in logs.OrderBy(entry => entry.Id))
        {
            if (_seenServerLogIds.Add(log.Id)) _logs.Add(new BattleLogEntry(log.Id, log.Text));
        }
        if (_logs.Count > 80) _logs.RemoveRange(0, _logs.Count - 80);
    }
    private string GetStatusText() => _roomDetail?.RoomStatus switch
    {
        Game.Shared.Enums.RoomStatus.NotStarted when _roomDetail.RoundNumber > 0 => "等待操作",
        Game.Shared.Enums.RoomStatus.NotStarted => "等待开战",
        Game.Shared.Enums.RoomStatus.Cooldown => "冷却中",
        Game.Shared.Enums.RoomStatus.Preparing => "准备中",
        Game.Shared.Enums.RoomStatus.WaveTransition => "波次切换",
        Game.Shared.Enums.RoomStatus.BattleOver when _roomDetail.MonsterHp <= 0 => "战斗胜利",
        Game.Shared.Enums.RoomStatus.BattleOver => "队伍战败",
        _ => "未知"
    };

    private async Task RefreshCooldownAsync(CancellationToken cancellationToken)
    {
        try
        {
            var ticks = 0;
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(1), cancellationToken);
                ticks++;
                if (ticks % 2 == 0 && !_isBusy && _roomDetail?.ClosedAtUtc is null)
                {
                    try
                    {
                        if (_roomDetail?.Slots.Any(slot => slot.IsCurrentUserCharacter) == true)
                            await ApiService.SyncBattleAsync(RoomId);
                        await RefreshRoomDetailAsync();
                    }
                    catch (Exception) when (!cancellationToken.IsCancellationRequested)
                    {
                        // Keep the last good room state and retry on the next poll.
                    }
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    public async ValueTask DisposeAsync()
    {
        ActiveCharacterState.Changed -= HandleAccountCharacterChanged;
        _refreshCancellation.Cancel();
        _refreshCancellation.Dispose();
        try { await Js.InvokeVoidAsync("battleUi.releaseDialogState", _dialogOwner); }
        catch (JSException) { }
        catch (TaskCanceledException) { }
        try { await Js.InvokeVoidAsync("battleCombat.cancel", _battleStage); }
        catch (JSException) { }
        catch (TaskCanceledException) { }
    }
}
