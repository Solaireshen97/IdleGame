    private async Task RefreshRoomDetailAsync()
    {
        var latest = await ApiService.GetRoomDetailAsync(RoomId);
        if (latest is null) return;
        ApplyRoomDetail(latest);
        if (_roomDetail is not null)
        {
            foreach (var slot in _roomDetail.Slots) _selectedCharacterIds.TryAdd(slot.SlotIndex, 0);
            MergeRoomBattleLogs(_roomDetail.BattleLogs);
        }
        if (_roomDetail is not null) { _serverTimeUtc = _roomDetail.ServerTimeUtc; _serverTimeReceivedAtUtc = DateTime.UtcNow; }
    }

    private void ApplyRoomDetail(RoomDetailResponse? detail, bool allowCombatFeedback = true)
    {
        var previous = _roomDetail;
        if (_isMonsterStatusDialogOpen && (detail is null || previous is null || detail.ClosedAtUtc.HasValue ||
            detail.RunSequence != previous.RunSequence || detail.CurrentWaveNumber != previous.CurrentWaveNumber ||
            detail.CurrentEnemyNumber != previous.CurrentEnemyNumber ||
            !string.Equals(detail.MonsterName, previous.MonsterName, StringComparison.Ordinal)))
        {
            _isMonsterStatusDialogOpen = false;
            _focusMonsterStatusDialogCloseButton = false;
        }
        _roomDetail = detail;
        if (!allowCombatFeedback || previous is null || detail is null || detail.RoundNumber <= 0) return;

        var resolvedAnotherRound = detail.RunSequence > previous.RunSequence ||
            detail.RunSequence == previous.RunSequence && detail.RoundNumber > previous.RoundNumber;
        if (!resolvedAnotherRound) return;

        var sameEnemy = detail.RunSequence == previous.RunSequence &&
            detail.CurrentWaveNumber == previous.CurrentWaveNumber &&
            detail.CurrentEnemyNumber == previous.CurrentEnemyNumber &&
            string.Equals(detail.MonsterName, previous.MonsterName, StringComparison.Ordinal);
        var damage = sameEnemy
            ? Math.Max(0, previous.MonsterHp - detail.MonsterHp)
            : detail.RunSequence > previous.RunSequence
                ? Math.Max(0, detail.MonsterMaxHp - detail.MonsterHp)
                : Math.Max(0, previous.MonsterHp);
        var defeated = sameEnemy ? detail.MonsterHp <= 0 : detail.RunSequence == previous.RunSequence;
        ShowCombatFeedback(damage, defeated);
    }

    private void ShowCombatFeedback(int damage, bool defeated)
    {
        _combatFeedbackCancellation?.Cancel();
        _combatFeedbackCancellation?.Dispose();
        _combatFeedbackCancellation = new CancellationTokenSource();
        _combatFeedbackText = defeated
            ? damage > 0 ? $"击破 · -{damage}" : "击破"
            : damage > 0 ? $"-{damage}" : "命中";
        _isCombatFeedbackVisible = true;
        _ = HideCombatFeedbackAsync(_combatFeedbackCancellation.Token);
    }

    private async Task HideCombatFeedbackAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(900, cancellationToken);
            await InvokeAsync(() =>
            {
                _isCombatFeedbackVisible = false;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) { }
    }

    private void GoToRooms() => Navigation.NavigateTo("/rooms");
    private DateTime GetEstimatedServerTimeUtc() => _serverTimeUtc + (DateTime.UtcNow - _serverTimeReceivedAtUtc);
    private int GetRemainingSeconds(DateTime deadlineUtc) => Math.Max(0, (int)Math.Ceiling((deadlineUtc - GetEstimatedServerTimeUtc()).TotalSeconds));
    private BattleCountdown? GetActiveCountdown()
    {
        if (_roomDetail?.NextBattleStartAtUtc is DateTime nextBattle)
            return new("副本重开", nextBattle, BattleRules.RepeatBattleDelaySeconds, "repeat");
        if (_roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.WaveTransition && _roomDetail.NextWaveStartAtUtc is DateTime nextWave)
            return new("下一名敌人", nextWave, BattleRules.WaveTransitionSeconds, "wave");
        if (_roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.Cooldown && _roomDetail.NextRoundAvailableAtUtc is DateTime nextRound)
        {
            var duration = _roomDetail.RoundCooldownDurationSeconds ??
                (_roomDetail.IsAllAliveMembersAuto || GetRemainingSeconds(nextRound) > BattleRules.RoundCooldownSeconds
                    ? BattleRules.AutoRoundCooldownSeconds : BattleRules.RoundCooldownSeconds);
            return new("下一回合", nextRound, duration, "round");
        }
        if ((_roomDetail?.RoomStatus is Game.Shared.Enums.RoomStatus.NotStarted or Game.Shared.Enums.RoomStatus.Preparing) &&
            _roomDetail.PreparationExpiresAtUtc is DateTime preparationExpires && !_roomDetail.IsAllAliveMembersAuto)
            return new("准备超时", preparationExpires, _roomDetail.PreparationTimeoutSeconds, "prepare");
        return null;
    }
    private int GetCountdownProgress(BattleCountdown countdown) => (int)Math.Clamp(
        Math.Round(100 * (1 - (countdown.DeadlineUtc - GetEstimatedServerTimeUtc()).TotalSeconds / Math.Max(1, countdown.DurationSeconds))), 0, 100);
    private static string FormatCountdown(int remainingSeconds) => $"{remainingSeconds / 60:00}:{remainingSeconds % 60:00}";
    private string GetLatestLog() => _logs.Count == 0 ? "战斗尚未开始，行动记录会在这里出现。" : _logs[^1].Text;
    private static string GetElementRelation(RoomSlotResponse slot) => slot.OutgoingElementModifierPercent switch
    {
        > 0 => "克制",
        < 0 => "被克制",
        _ => "均势"
    };

    private static string FormatElementModifier(int percent) => percent > 0 ? $"+{percent}%" : $"{percent}%";

    private string GetMonsterArtPath()
    {
        var name = _roomDetail?.MonsterName.ToLowerInvariant() ?? "";
        if (name.Contains("slime") || name.Contains("史莱姆")) return "/art/slime.svg";
        if (name.Contains("goblin") || name.Contains("狗头人") || name.Contains("金牙")) return "/art/goblin.svg";
        if (name.Contains("wolf") || name.Contains("狼")) return "/art/wolf.svg";
        return "/art/monster.svg";
    }
    private string GetActionHint()
    {
        if (_roomDetail?.NextBattleStartAtUtc is not null) return "胜利！即将重开副本，全队恢复至满 HP。";
        if (_roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.WaveTransition) return "敌人已击败，下一名敌人即将进入战场。";
        if (_roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.BattleOver) return _roomDetail.MonsterHp <= 0 ? "副本挑战完成。" : IsOwner ? "队伍战败，可重置后再次挑战。" : "队伍战败，等待房主重置战斗。";
        if (_roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.Cooldown)
            return IsCurrentUserPrepared() ? "操作已锁定，冷却结束后自动结算。" : "冷却中，可提前准备下一回合操作。";
        if (_roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.Preparing) return _roomDetail.IsPreparationTimeoutEnabled ? "等待全员准备，超时后自动开始。" : "等待全员准备，当前未启用超时。";
        if (_roomDetail?.IsAllAliveMembersAuto == true) return "队伍已开启 Auto，回合将自动推进。";
        return _roomDetail?.CanPrepare == true
            ? _roomDetail.IsPreparationTimeoutEnabled ? "可手动准备；倒计时结束后本回合自动结算。" : "确认准备后推进本回合。"
            : "在下方编成队伍，等待战斗开始。";
    }
    private void AppendBattleLogs(IEnumerable<string> logs)
    {
        foreach (var log in logs) _logs.Add(new BattleLogEntry(--_nextLocalLogId, log));
        if (_logs.Count > 80) _logs.RemoveRange(0, _logs.Count - 80);
    }
    private bool IsCurrentUserPrepared()
    {
        var aliveOwnSlots = _roomDetail?.Slots.Where(slot => slot.IsCurrentUserCharacter && slot.IsOccupied && slot.IsAlive).ToList();
        return aliveOwnSlots is { Count: > 0 } && aliveOwnSlots.All(slot => slot.IsConfirmed);
    }
    private void MergeRoomBattleLogs(IEnumerable<BattleLogResponse> logs)
    {
        foreach (var log in logs.OrderBy(entry => entry.Id))
        {
            if (_seenServerLogIds.Add(log.Id)) _logs.Add(new BattleLogEntry(log.Id, log.Text));
        }
        if (_logs.Count > 80) _logs.RemoveRange(0, _logs.Count - 80);
    }
    private string GetStatusText() => _roomDetail?.RoomStatus switch
    {
        Game.Shared.Enums.RoomStatus.NotStarted when _roomDetail.RoundNumber > 0 => "等待操作",
        Game.Shared.Enums.RoomStatus.NotStarted => "等待开战",
        Game.Shared.Enums.RoomStatus.Cooldown => "冷却中",
        Game.Shared.Enums.RoomStatus.Preparing => "准备中",
        Game.Shared.Enums.RoomStatus.WaveTransition => "波次切换",
        Game.Shared.Enums.RoomStatus.BattleOver when _roomDetail.MonsterHp <= 0 => "战斗胜利",
        Game.Shared.Enums.RoomStatus.BattleOver => "队伍战败",
        _ => "未知"
    };

    private async Task RefreshCooldownAsync(CancellationToken cancellationToken)
    {
        try
        {
            var ticks = 0;
            while (!cancellationToken.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(1), cancellationToken);
                ticks++;
                if (ticks % 2 == 0 && !_isBusy && _roomDetail?.ClosedAtUtc is null)
                {
                    try
                    {
                        if (_roomDetail?.Slots.Any(slot => slot.IsCurrentUserCharacter) == true)
                            await ApiService.SyncBattleAsync(RoomId);
                        await RefreshRoomDetailAsync();
                    }
                    catch (Exception) when (!cancellationToken.IsCancellationRequested)
                    {
                        // Keep the last good room state and retry on the next poll.
                    }
                }
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose()
    {
        _refreshCancellation.Cancel();
        _refreshCancellation.Dispose();
        _combatFeedbackCancellation?.Cancel();
        _combatFeedbackCancellation?.Dispose();
    }
}
