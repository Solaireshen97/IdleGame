    protected override Task OnInitializedAsync() => InitializeBattleAsync();

    private async Task InitializeBattleAsync()
    {
        if (_isInitializing || _refreshCancellation.IsCancellationRequested) return;
        _isInitializing = true;
        _roomLoadError = null;
        try
        {
            _currentUser = await ApiService.GetCurrentUserAsync();
            if (_refreshCancellation.IsCancellationRequested) return;
            if (_currentUser is null)
            {
                if (await UserSession.IsLoggedIn())
                    _roomLoadError = "暂时无法确认登录状态，请稍后重试。";
                else
                    Navigation.NavigateTo("/login", replace: true);
                return;
            }
            if (!await RefreshRoomDetailAsync()) return;
            _characters = await ApiService.GetCurrentCharactersAsync() ?? new();
            await ActiveCharacterState.RefreshAsync();
            if (_refreshCancellation.IsCancellationRequested) return;
            _accountCharacterId = ActiveCharacterState.Current?.CharacterId;
            if (!_isCharacterSubscribed)
            {
                ActiveCharacterState.Changed += HandleAccountCharacterChanged;
                _isCharacterSubscribed = true;
            }
            if (_roomDetail is { ClosedAtUtc: null } && _roomDetail.Slots.Any(slot => slot.IsCurrentUserCharacter))
            {
                await ApiService.SyncBattleAsync(RoomId);
                if (!await RefreshRoomDetailAsync()) return;
            }
            if (!_hasStartedRoomRefresh && !_refreshCancellation.IsCancellationRequested)
            {
                _hasStartedRoomRefresh = true;
                _ = RefreshCooldownAsync(_refreshCancellation.Token);
            }
        }
        catch (Exception exception) when (exception is HttpRequestException or OperationCanceledException or System.Text.Json.JsonException)
        {
            if (!_refreshCancellation.IsCancellationRequested)
                _roomLoadError = "连接失败或超时，请稍后重试。";
        }
        finally
        {
            _isInitializing = false;
        }
    }

