    private static string GetStatusEffectGlyph(BattleStatusEffectResponse effect)
    {
        var label = $"{effect.Code} {effect.Name}";
        if (effect.Code.StartsWith("operation-potion:", StringComparison.OrdinalIgnoreCase)) return "✦";
        if (label.Contains("poison", StringComparison.OrdinalIgnoreCase) || label.Contains("毒", StringComparison.Ordinal)) return "☠";
        if (label.Contains("berserk", StringComparison.OrdinalIgnoreCase) || label.Contains("fury", StringComparison.OrdinalIgnoreCase) ||
            label.Contains("狂暴", StringComparison.Ordinal) || label.Contains("狂怒", StringComparison.Ordinal)) return "⚔";
        if (label.Contains("burn", StringComparison.OrdinalIgnoreCase) || label.Contains("灼烧", StringComparison.Ordinal)) return "♨";
        if (label.Contains("guard", StringComparison.OrdinalIgnoreCase) || label.Contains("shield", StringComparison.OrdinalIgnoreCase) || label.Contains("护盾", StringComparison.Ordinal)) return "◆";
        return effect.IsPositive ? "↑" : "↓";
    }

    private static string GetStatusEffectDuration(BattleStatusEffectResponse effect) =>
        effect.ExpiresWithRun ? "本场持续" : $"剩余 {effect.RemainingRounds} 回合";

    private IEnumerable<CharacterSummaryResponse> GetFormationCharacters(RoomSlotResponse target) =>
        _characters.Where(character => character.CharacterId != target.CharacterId &&
            (!target.IsOccupied || GetFormationCharacterSlot(character.CharacterId) is not null));

    private RoomSlotResponse? GetFormationCharacterSlot(int characterId) =>
        _roomDetail?.Slots.FirstOrDefault(slot => slot.IsCurrentUserCharacter && slot.CharacterId == characterId);

    private string GetFormationCharacterLabel(CharacterSummaryResponse character)
    {
        var position = GetFormationCharacterSlot(character.CharacterId) is { } slot ? $" · 当前 {slot.SlotIndex} 号位" : "";
        return $"{character.Name} · Lv {character.Level}{position}";
    }

    private string GetFormationActionLabel(RoomSlotResponse target) => (CanChangeFormation ? "" : "预约") +
        (target.IsOccupied ? "交换站位" : GetFormationCharacterSlot(_selectedCharacterIds[target.SlotIndex]) is not null ? "移动至此" : "上阵");

    private async Task AssignSlotAsync(int slotIndex)
    {
        if (await RunRoomOperationAsync(() => ApiService.AssignRoomSlotAsync(RoomId, slotIndex, _selectedCharacterIds[slotIndex]), "调整队伍失败。"))
            foreach (var index in _selectedCharacterIds.Keys.ToList()) _selectedCharacterIds[index] = 0;
