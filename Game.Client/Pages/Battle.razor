    };

    private bool CanQueueConsumable(RoomSlotResponse character, RoomConsumableSlotResponse supply) =>
        _roomDetail?.RoomStatus != Game.Shared.Enums.RoomStatus.BattleOver && character.IsAlive && supply.ItemCode is not null &&
        (character.PendingConsumableSlotIndex == supply.SlotIndex ||
            supply.Quantity > 0 && supply.CooldownRoundsRemaining == 0 &&
            (supply.Kind != "Healing" || character.CharacterHp < character.CharacterMaxHp) &&
            (supply.Kind != "CombatBuff" || !character.StatusEffects.Any(effect =>
                effect.Code == $"combat-consumable:{supply.ItemCode}")) &&
            supply.Description != "当前等级已无效果");

    private SkillDialogContext? GetSkillDialogContext()
    {
        if (!_isSkillDialogOpen || _roomDetail is null || _selectedSkillCharacterId is null || _selectedSkillSlotIndex is null)
            return null;
        var character = _roomDetail.Slots.FirstOrDefault(slot => slot.CharacterId == _selectedSkillCharacterId);
        var skill = character?.Skills.FirstOrDefault(item => item.SlotIndex == _selectedSkillSlotIndex && item.SkillCode is not null);
        return character is null || skill is null ? null : new SkillDialogContext(character, skill);
    }

    private async Task HandleSkillClickAsync(RoomSlotResponse character, RoomSkillSlotResponse skill)
    {
        if (_isBusy) return;
        if (IsSkillQueued(character, skill) || _isQuickSkillCastEnabled && CanQueueSkill(character, skill))
        {
            await ToggleSkillAsync(character, skill);
            return;
        }

        _selectedSkillCharacterId = character.CharacterId;
        _selectedSkillSlotIndex = skill.SlotIndex;
        _skillDialogMessage = null;
        _isSkillDialogOpen = true;
        _focusSkillDialogCloseButton = true;
    }

    private void CloseSkillDialog()
    {
        _isSkillDialogOpen = false;
        _selectedSkillCharacterId = null;
        _selectedSkillSlotIndex = null;
        _skillDialogMessage = null;
    }

    private async Task ConfirmSkillAsync(SkillDialogContext context)
    {
        if (await ToggleSkillAsync(context.Character, context.Skill)) CloseSkillDialog();
    }

    private async Task SetSkillAutoThresholdAsync(SkillDialogContext context, ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var threshold))
            await SetSkillAutoAsync(context, context.Skill.AutoUseEnabled, threshold);
    }

    private async Task SetSkillAutoAsync(SkillDialogContext context, bool enabled, int threshold)
    {
        if (_isSkillAutoSaving || context.Character.CharacterId is null) return;
        _isSkillAutoSaving = true;
        _skillDialogMessage = null;
        try
        {
            var (response, error) = await ApiService.SetSkillAutoAsync(context.Character.CharacterId.Value,
                context.Skill.SlotIndex, new SetSkillAutoRequest
                {
                    AutoUseEnabled = enabled,
                    AutoHpThresholdPercent = threshold
                });
            if (response is null)
                _skillDialogMessage = GetSkillAutoError(error);
            else
                await RefreshRoomDetailAsync();
        }
        catch
        {
            _skillDialogMessage = "连接失败，自动使用设置未保存。";
        }
        finally
        {
            _isSkillAutoSaving = false;
        }
    }

