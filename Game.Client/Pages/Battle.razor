    private async Task ToggleConsumableAsync(RoomSlotResponse character, RoomConsumableSlotResponse supply)
    {
        if (_isBusy || _roomDetail is null || character.CharacterId is null || !CanQueueConsumable(character, supply)) return;
        _isBusy = true;
        _consumableMessage = null;
        var cancel = IsConsumableQueued(character, supply);
        try
        {
            var (detail, error) = await ApiService.QueueConsumableAsync(RoomId, character.CharacterId.Value,
                supply.SlotIndex, !cancel, _roomDetail.RoundNumber, _roomDetail.RunSequence);
            if (detail is null)
            {
                _consumableMessage = GetConsumableError(error);
                await RefreshRoomDetailAsync();
            }
            else
            {
                _roomDetail = detail;
                _serverTimeUtc = detail.ServerTimeUtc;
                _serverTimeReceivedAtUtc = DateTime.UtcNow;
                _consumableMessage = null;
                _alignMobileQuickActions = true;
            }
        }
        catch
        {
            _consumableMessage = "连接失败，请稍后重试。";
        }
        finally
        {
            _isBusy = false;
        }
    }

