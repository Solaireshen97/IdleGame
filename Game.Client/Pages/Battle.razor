@page "/battle/{roomId:int}"
@using Game.Client.Services
@using Game.Shared.Dtos
@using Game.Shared.Dtos.Auth
@using Game.Shared.Dtos.Characters
@using Game.Shared
@inject ApiService ApiService
@inject ActiveCharacterState ActiveCharacterState
@inject UserSessionService UserSession
@inject NavigationManager Navigation
@inject IJSRuntime Js
@implements IAsyncDisposable

<PageTitle>战斗房间</PageTitle>

<div class="battle-page @(_roomDetail is { ClosedAtUtc: null } || _combatScene is not null ? "battle-page--focused" : null) @(IsBattlePanelOpen ? "battle-page--panel-open" : null)" @onkeydown="HandleBattleLogKeyDown">
    <header class="battle-page__header">
        <button class="back-link" @onclick="GoToRooms">← 返回大厅</button>
        <span class="battle-page__room">ROOM · @RoomId</span>
    </header>

    @if (_roomDetail is not null && !_isManagementOpen)
    {
        <RoomOperations Operations="_roomDetail.Operations" IsBusy="_isBusy" OnCancel="CancelRoomOperationAsync" />
    }

@if (_roomLoadError is not null)
{
    <GameStateCard Compact="true" Tone="error" Title="暂时无法读取战斗房间" Detail="@_roomLoadError">
        <Actions>
            <button type="button" class="button button--primary" @onclick="InitializeBattleAsync" disabled="@_isInitializing">重试</button>
            <button type="button" class="button button--secondary" @onclick="GoToRooms">返回大厅</button>
        </Actions>
    </GameStateCard>
}
@if (_roomDetail is null)
{
    @if (_roomLoadError is null)
    {
        <GameStateCard Compact="true" Title="正在进入战场" Detail="同步房间成员与敌方状态…" />
    }
}
else if (_roomDetail.ClosedAtUtc.HasValue && _combatScene is null)
{
    <section class="battle-rewards" aria-label="已结束的战斗任务">
        <div class="battle-rewards__heading">
            <div><span class="section-kicker">EXPEDITION COMPLETE</span><h1>@_roomDetail.DungeonName · 任务已结束</h1></div>
            <span>第 @_roomDetail.RunSequence 轮 · @(_roomDetail.RoundNumber == 0 ? "到期停止" : _roomDetail.MonsterHp <= 0 ? "通关后停止" : "战败后停止")</span>
        </div>
        <p>本次任务已停止，角色可以开始新的战斗或其他活动。继续讨伐请创建新房间。</p>
        @if (_roomDetail.SupportsDepths)
        {
            <DungeonMastery UnlockedDepth="_roomDetail.UnlockedDepth" MasteryLevel="_roomDetail.MasteryLevel" HighestDepth="_roomDetail.CharacterHighestDepth" />
            <p>本次挑战深层 LV@(_roomDetail.DepthLevel) · 新获得的精通从下轮生效。</p>
        }
        @if (_roomDetail.CumulativeRewards is { } cumulative)
        {
            <p>已结算 @cumulative.CompletedRuns 轮</p>
            <div class="battle-rewards__loot"><RoomRewards Rewards="cumulative" /></div>
        }
        @if (IsOwner)
        {
            <button class="button button--danger" @onclick="DismissRoomAsync" disabled="@_isBusy">删除记录</button>
        }
    </section>
}
else
{
    var autoSlot = _roomDetail.Slots.FirstOrDefault(slot => slot.IsCurrentUserCharacter && slot.CharacterId == _accountCharacterId)
        ?? _roomDetail.Slots.FirstOrDefault(slot => slot.IsCurrentUserCharacter && slot.IsOccupied);
    var canConfigureOwnAuto = _roomDetail.ClosedAtUtc is null &&
        (_roomDetail.IsCurrentUserAutoUnlocked || _roomDetail.IsCurrentUserAutoEnabled);
    var ownSlots = _roomDetail.Slots.Where(slot => slot.IsCurrentUserCharacter && slot.IsOccupied).ToList();
    var isCurrentUserPrepared = ownSlots.Any(slot => slot.IsAlive) && ownSlots.Where(slot => slot.IsAlive).All(slot => slot.IsConfirmed);
    var countdown = GetActiveCountdown();
    var scene = _combatScene ?? _roomDetail;
    var backgroundArt = BattleBackgroundArt.ForEncounter(scene.DungeonName);

    <section class="battle-stage" aria-label="战斗场景" @ref="_battleStage">
        <div class="battle-stage__header">
            <div>
                <span class="section-kicker">@scene.RegionName · DUNGEON ENCOUNTER</span>
                <h1>@scene.DungeonName</h1>
                @if (_roomDetail.SupportsDepths)
                {
                    <DungeonMastery UnlockedDepth="_roomDetail.UnlockedDepth" MasteryLevel="_roomDetail.MasteryLevel" HighestDepth="_roomDetail.CharacterHighestDepth" />
                    <small>深层 LV@(_roomDetail.DepthLevel) · @(_roomDetail.IsRepeatBattle ? "固定此层重复挑战" : "单次挑战") · 新精通从下轮生效</small>
                }
            </div>
            <div class="battle-stage__meta">
                <span class="battle-mode">第 @scene.CurrentWaveNumber / @scene.TotalWaveCount 波</span>
                <span class="battle-status">@(_activeCombatPlan is not null ? "交战中" : GetStatusText())</span>
            </div>
        </div>

        @if (scene.MonsterIntent is { } intent && scene.MonsterHp > 0 && scene.RoomStatus != Game.Shared.Enums.RoomStatus.WaveTransition && scene.NextBattleStartAtUtc is null)
        {
            <section class="monster-intent monster-intent--@intent.DangerLevel.ToLowerInvariant()" aria-label="敌方行动预告">
                <div class="monster-intent__icon" aria-hidden="true">!</div>
                <div class="monster-intent__body">
                    <span>ENEMY INTENT · 敌方行动预告 · @GetDangerLabel(intent.DangerLevel)</span>
                    <strong>@intent.ActionName</strong>
                    <small>@intent.Description</small>
                </div>
                <div class="monster-intent__target">
                    <span>目标</span><strong>@intent.TargetLabel</strong>
                    @if (intent.ActionType == "Skill")
                    {
                        <small class="@(intent.IsInterruptible ? "intent-rule--yes" : "intent-rule--no")">
                            @(intent.IsInterrupted ? "已打断" : intent.IsInterruptible ? "可打断" : "不可打断")
                        </small>
                    }
                </div>
            </section>
        }
        else
        {
            var encounterVictory = scene.RoomStatus == Game.Shared.Enums.RoomStatus.BattleOver && scene.MonsterHp <= 0;
            var intentTitle = encounterVictory
                ? "讨伐完成"
                : scene.NextBattleStartAtUtc is not null
                ? "讨伐已完成"
                : scene.RoomStatus == Game.Shared.Enums.RoomStatus.WaveTransition || scene.MonsterHp <= 0
                    ? "目标已击破"
                    : "等待敌方行动";
            var intentDetail = scene.NextBattleStartAtUtc is not null
                ? "等待副本重新开始"
                : encounterVictory ? "战利品已结算，下一场冒险随时开始"
                : scene.RoomStatus == Game.Shared.Enums.RoomStatus.WaveTransition || scene.MonsterHp <= 0
                    ? "等待下一名敌人进入战场"
                    : "行动预告将在准备后显示";
            var intentState = scene.NextBattleStartAtUtc is not null
                ? "即将重开"
                : encounterVictory ? "已通关"
                : scene.RoomStatus == Game.Shared.Enums.RoomStatus.WaveTransition || scene.MonsterHp <= 0
                    ? "切换中"
                    : "未锁定";
            <section class="monster-intent monster-intent--waiting @(encounterVictory ? "monster-intent--victory" : null)" aria-label="敌方行动预告状态" aria-live="polite">
                <div class="monster-intent__icon" aria-hidden="true">@(encounterVictory ? "✦" : "◇")</div>
                <div class="monster-intent__body">
                    <span>ENEMY INTENT · 敌方行动预告</span>
                    <strong>@intentTitle</strong>
                    <small>@intentDetail</small>
                </div>
                <div class="monster-intent__target"><span>状态</span><strong>@intentState</strong></div>
            </section>
        }

        <div class="combat-readout" aria-label="回合战斗反馈">
            <span class="combat-readout__round">ROUND <b>@((_activeCombatPlan?.Round ?? scene.RoundNumber).ToString("D2"))</b></span>
            <strong class="combat-readout__action"><span class="combat-readout__rest">@GetCombatHeadline()</span><span class="combat-readout__live" data-combat-action></span></strong>
            <span class="combat-readout__result combat-readout__rest"><b>@(_lastCombatPlan is { HitCount: > 0 } ? $"{_lastCombatPlan.HitCount} HIT" : "")</b><span>@(_lastCombatPlan is { TotalDamage: > 0 } ? $"{_lastCombatPlan.TotalDamage:N0} 伤害" : "")</span></span>
            <span class="combat-readout__result combat-readout__live"><b data-combat-hits></b><span data-combat-total></span></span>
        </div>
        <span class="combat-announcement" role="status">@_combatAnnouncement</span>
        <div class="battle-field @(backgroundArt is not null ? "battle-field--illustrated" : null) @(scene.Slots.Count(slot => slot.IsOccupied) >= 4 ? "battle-field--crowded" : "")">
            @if (backgroundArt is not null)
            {
                <div class="battle-field__backdrop" aria-hidden="true">
                    <img src="@backgroundArt" alt="" decoding="async" fetchpriority="high" />
                </div>
            }
            <div class="battle-field__party">
                <div class="battle-field__label"><span><small>YOUR PARTY</small>我方队伍</span><strong>@scene.Slots.Count(slot => slot.IsOccupied) / @scene.SlotCount 人</strong></div>
                <div class="fighter-line">
                    @foreach (var slot in scene.Slots.Where(slot => slot.IsOccupied).OrderByDescending(slot => slot.SlotIndex))
                    {
                        <button type="button" @key="slot.CharacterId" data-combat-unit="@slot.SlotIndex" data-combat-name="@slot.CharacterName" data-hp="@slot.CharacterHp" data-max-hp="@slot.CharacterMaxHp"
                                class="fighter fighter--occupied fighter--interactive @(!slot.IsAlive ? "fighter--down" : "") @(IsMonsterIntentTarget(slot) ? "fighter--targeted" : "")"
                                title="@($"{slot.CharacterName} · HP {slot.CharacterHp}/{slot.CharacterMaxHp} · 点击查看状态")"
                                aria-label="@($"{slot.SlotIndex} 号位 {slot.CharacterName}，生命值 {slot.CharacterHp}/{slot.CharacterMaxHp}{(IsMonsterIntentTarget(slot) ? "，敌人当前攻击目标" : "")}，点击查看详细状态")"
                                aria-haspopup="dialog"
                                @onclick="() => OpenStatusDialog(slot)">
                            <span class="fighter__vitals">
                                <strong>@slot.CharacterName</strong>
                                <span class="combat-health">
                                    <span class="combat-health__trail" style="width:@HealthPercent(slot.CharacterHp, slot.CharacterMaxHp)%" aria-hidden="true"></span>
                                    <progress class="fighter__health" value="@slot.CharacterHp" max="@slot.CharacterMaxHp" aria-label="@slot.CharacterName 生命值"></progress>
                                </span>
                                <small class="fighter__hp-text">@slot.CharacterHp / @slot.CharacterMaxHp</small>
                            </span>
                            <div class="fighter__portrait">
                                <img src="@ProfessionArt.ForName(slot.ProfessionName)" alt="" loading="eager" decoding="async" fetchpriority="high" />
                                <span class="fighter__number">@slot.SlotIndex</span>
                                @if (slot.StatusEffects.Count > 0)
                                {
                                    <span class="fighter__effect-icons" aria-label="@($"{slot.CharacterName} 有 {slot.StatusEffects.Count} 个状态效果")">
                                        @foreach (var effect in slot.StatusEffects.Take(3))
                                        {
                                            <span class="fighter__effect-icon @(effect.IsPositive ? "fighter__effect-icon--positive" : "fighter__effect-icon--negative")"
                                                  title="@($"{effect.Name} · {GetStatusEffectDuration(effect)}")"
                                                  aria-hidden="true">@GetStatusEffectGlyph(effect)</span>
                                        }
                                        @if (slot.StatusEffects.Count > 3)
                                        {
                                            <span class="fighter__effect-icon fighter__effect-icon--more" aria-hidden="true">+@(slot.StatusEffects.Count - 3)</span>
                                        }
                                    </span>
                                }
                                @if (IsMonsterIntentTarget(slot))
                                {
                                    <span class="fighter__target-marker" aria-hidden="true">▼</span>
                                }
                            </div>
                            <small class="fighter__level">Lv @slot.CharacterLevel</small>
                            @if (slot.CharacterElement is { } characterElement)
                            {
                                <small class="battle-element" title="攻击 @FormatElementModifier(slot.OutgoingElementModifierPercent) · 受击 @FormatElementModifier(slot.IncomingElementModifierPercent)">@WeaponRules.ElementName(characterElement)属性 · @GetElementRelation(slot)</small>
                            }
                        </button>
                    }
                </div>
            </div>

            <div class="battle-field__enemy @(scene.MonsterHp <= 0 ? "battle-field__enemy--defeated" : "") @(scene.RoomStatus == Game.Shared.Enums.RoomStatus.WaveTransition || scene.NextBattleStartAtUtc is not null ? "battle-field__enemy--pending" : "")"
                 data-combat-unit="enemy" data-combat-name="@scene.MonsterName" data-hp="@scene.MonsterHp" data-max-hp="@scene.MonsterMaxHp">
                @if (scene.RoomStatus == Game.Shared.Enums.RoomStatus.WaveTransition || scene.NextBattleStartAtUtc is not null)
                {
                    <div class="battle-field__enemy-pending" aria-live="polite">
                        <span aria-hidden="true">✦</span>
                        <strong>怪物即将出现</strong>
                        <small>等待回合冷却</small>
                    </div>
                }
                else
                {
                <button type="button" class="enemy-vitals" @onclick="OpenMonsterStatusDialog"
                        title="点击查看 @scene.MonsterName 的状态"
                        aria-label="查看 @scene.MonsterName 的生命值与状态效果" aria-haspopup="dialog">
                    <span class="enemy-vitals__name"><strong>@scene.MonsterName</strong><span>@scene.MonsterHp / @scene.MonsterMaxHp HP</span></span>
                    <span class="combat-health combat-health--enemy">
                        <span class="combat-health__trail" style="width:@HealthPercent(scene.MonsterHp, scene.MonsterMaxHp)%" aria-hidden="true"></span>
                        <progress class="enemy-vitals__health" value="@scene.MonsterHp" max="@scene.MonsterMaxHp" aria-label="怪物生命值"></progress>
                    </span>
                </button>
                <button type="button" class="battle-field__enemy-art" @onclick="OpenMonsterStatusDialog" @ref="_monsterTrigger"
                        title="点击查看 @scene.MonsterName 的状态"
                        aria-label="@scene.MonsterName，生命值 @scene.MonsterHp / @scene.MonsterMaxHp，@scene.MonsterEffects.Count 个状态效果，点击查看详细状态"
                        aria-haspopup="dialog">
                    <img src="@MonsterArt.ForName(scene.MonsterName)" alt="" loading="eager" decoding="async" fetchpriority="high" />
                    @if (scene.MonsterEffects.Count > 0)
                    {
                        <span class="enemy-effect-icons" aria-hidden="true">
                            @foreach (var effect in scene.MonsterEffects.Take(3))
                            {
                                <span class="fighter__effect-icon @(effect.IsPositive ? "fighter__effect-icon--positive" : "fighter__effect-icon--negative")"
                                      title="@($"{effect.Name} · {GetStatusEffectDuration(effect)}")">@GetStatusEffectGlyph(effect)</span>
                            }
                            @if (scene.MonsterEffects.Count > 3)
                            {
                                <span class="fighter__effect-icon fighter__effect-icon--more">+@(scene.MonsterEffects.Count - 3)</span>
                            }
                        </span>
                    }
                </button>
                }
            </div>
            <div class="combat-fx-layer" aria-hidden="true"></div>
        </div>
        <button type="button" class="battle-feed" @onclick="OpenBattleLog" @ref="_logTrigger" aria-haspopup="dialog">
            <span class="battle-feed__live">战报</span>
            <span class="battle-feed__latest">@GetLatestLog()</span>
            <span class="battle-feed__open">打开完整战报 <span aria-hidden="true">↗</span></span>
        </button>
        <div class="battle-stage__footer"><span><strong>进度</strong> 第 @scene.CurrentWaveNumber / @scene.TotalWaveCount 波 · 敌人 @scene.CurrentEnemyNumber / @scene.EnemiesInCurrentWave</span><span><strong>顺序</strong> 槽位 1 → @scene.SlotCount</span><span><strong>规则</strong> @(scene.IsPreparationTimeoutEnabled ? $"{BattleRules.PreparationTimeoutSeconds} 秒未准备则自动攻击" : "无准备超时")</span></div>
    </section>

    var mobileActionSlot = ownSlots.FirstOrDefault(slot => slot.CharacterId == _mobileActionCharacterId) ?? ownSlots.FirstOrDefault();

    <section class="battle-command" aria-label="本回合操作" @ref="_battleCommand">
        @if (mobileActionSlot is not null)
        {
            <div class="battle-mobile-quick-actions @(mobileActionSlot.IsAlive ? null : "battle-mobile-quick-actions--down") @(ownSlots.Count == 1 ? "battle-mobile-quick-actions--solo" : null)" aria-label="战斗技能与补给" @ref="_mobileQuickActions">
                <div class="battle-mobile-quick-actions__heading">
                    <div>
                        <strong>@mobileActionSlot.CharacterName <span class="battle-action-profession">· @mobileActionSlot.ProfessionName</span></strong>
                        <small class="battle-action-health">@(mobileActionSlot.IsAlive ? $"HP {mobileActionSlot.CharacterHp} / {mobileActionSlot.CharacterMaxHp}" : "已阵亡 · 请选择其他角色")</small>
                    </div>
                    @if (_mobileLoadoutView == "skills")
                    {
                        <div class="battle-mobile-quick-actions__tools">
                            <label class="quick-skill-toggle quick-skill-toggle--compact" title="开启后，点按可用技能直接安排；可指定队友的技能仍需选人">
                                <input type="checkbox" checked="@mobileActionSlot.IsQuickSkillCastEnabled" @onchange="e => SetQuickSkillCastAsync(mobileActionSlot.CharacterId, (bool)e.Value!)" disabled="@_isQuickSkillCastSaving" />
                                <strong>快速释放</strong>
                            </label>
                        </div>
                    }
                </div>
                <div class="battle-loadout-switch" role="group" aria-label="选择技能或补给">
                    <button type="button" class='@(_mobileLoadoutView == "skills" ? "active" : null)' aria-pressed='@(_mobileLoadoutView == "skills" ? "true" : "false")' aria-controls="mobile-action-rail" @onclick='() => SetMobileLoadoutView("skills")'>✦ 技能</button>
                    <button type="button" class='@(_mobileLoadoutView == "supplies" ? "active" : null)' aria-pressed='@(_mobileLoadoutView == "supplies" ? "true" : "false")' aria-controls="mobile-action-rail" @onclick='() => SetMobileLoadoutView("supplies")'>✚ 补给</button>
                </div>
                <div class="battle-mobile-quick-actions__characters" role="tablist" aria-label="选择操作角色，共 @ownSlots.Count 个" @ref="_mobileActionCharacters">
                    @foreach (var characterSlot in ownSlots)
                    {
                        <button type="button"
                                class="battle-mobile-character-tab @(characterSlot.CharacterId == mobileActionSlot.CharacterId ? "active" : null) @(characterSlot.IsAlive ? null : "battle-mobile-character-tab--down")"
                                role="tab"
                                aria-selected="@(characterSlot.CharacterId == mobileActionSlot.CharacterId ? "true" : "false")"
                                aria-label='@($"操作 {characterSlot.CharacterName}，槽位 {characterSlot.SlotIndex}，{(characterSlot.IsAlive ? "存活" : "已阵亡")}")'
                                aria-controls="mobile-action-rail"
                                @onclick="() => SelectMobileActionCharacter(characterSlot.CharacterId)">
                            <span>@characterSlot.SlotIndex</span>
                            <strong>@characterSlot.CharacterName</strong>
                            <small>@(characterSlot.IsAlive ? $"HP {Math.Round(100d * (characterSlot.CharacterHp ?? 0) / Math.Max(1, characterSlot.CharacterMaxHp ?? 1))}%" : "已阵亡")</small>
                        </button>
                    }
                </div>
                @if (_mobileLoadoutView == "skills")
                {
                    <div id="mobile-action-rail" class="battle-mobile-skill-rail" role="tabpanel" aria-label="当前角色技能">
                        @if (mobileActionSlot.SoulImprint is { } mobileSoulImprint)
                        {
                            var soulSelected = mobileActionSlot.IsSoulImprintQueued;
                            <button type="button"
                                    class="battle-mobile-skill battle-mobile-skill--soul @(soulSelected ? "battle-mobile-skill--selected" : null)"
                                    disabled="@(_isBusy || !CanQueueSoulImprint(mobileActionSlot, mobileSoulImprint))"
                                    aria-pressed="@(soulSelected ? "true" : "false")"
                                    title="@GetSoulImprintHint(mobileActionSlot, mobileSoulImprint)"
                                    @onclick="() => ToggleSoulImprintAsync(mobileActionSlot, mobileSoulImprint)">
                                <span class="battle-mobile-skill__icon" aria-hidden="true">@if (ItemArt.ForCode(mobileSoulImprint.Code) is { } soulArt) { <img src="@soulArt" alt="" /> } else { <text>✦</text> }</span>
                                <strong>魂印</strong>
                                <small>@(soulSelected ? "已安排" : mobileSoulImprint.CooldownRoundsRemaining > 0 ? $"蓄力 {mobileSoulImprint.CooldownRoundsRemaining}" : "释放")</small>
                            </button>
                        }
                        @foreach (var skill in mobileActionSlot.Skills.Where(skill => skill.SkillCode is not null).OrderBy(skill => skill.SlotIndex))
                        {
                            var selected = IsSkillQueued(mobileActionSlot, skill);
                            var available = CanQueueSkill(mobileActionSlot, skill);
                            <button type="button"
                                    class="battle-skill-card battle-mobile-skill battle-skill-card--@GetSkillTone(skill) @(selected ? "battle-skill-card--selected" : "") @(!available ? "battle-skill-card--unavailable" : "")"
                                    disabled="@_isBusy"
                                    title="@GetSkillHint(mobileActionSlot, skill)"
                                    aria-pressed="@(selected ? "true" : "false")"
                                    aria-haspopup="dialog"
                                    @onclick="() => HandleSkillClickAsync(mobileActionSlot, skill)">
                                <span class="battle-skill-card__icon battle-skill-card__icon--@GetSkillTone(skill)" aria-hidden="true">
                                    <span class="battle-skill-card__flare"></span>
                                    <img class="battle-skill-card__art" src="@SkillArt.ForCode(skill.SkillCode)" alt="" />
                                    <span class="battle-skill-card__slot">@skill.SlotIndex</span>
                                    @if (skill.CooldownRoundsRemaining > 0) { <span class="battle-skill-card__cooldown">@skill.CooldownRoundsRemaining</span> }
                                    @if (selected) { <span class="battle-skill-card__check">✓</span> }
                                </span>
                                <strong class="battle-skill-card__name">@skill.SkillName</strong>
                                <small class="battle-skill-card__status">@(selected ? "已安排" : !mobileActionSlot.IsAlive ? "已阵亡" : skill.CooldownRoundsRemaining > 0 ? $"冷却 {skill.CooldownRoundsRemaining} 回合" : available ? "就绪" : "无有效目标")</small>
                                @if (skill.AutoUseEnabled) { <span class="battle-skill-card__auto">AUTO</span> }
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div id="mobile-action-rail" class="battle-supplies-panel" role="tabpanel" aria-label="当前角色战斗补给">
                        <BattleConsumablesPanel Character="mobileActionSlot" IsBusy="_isBusy"
                                                IsBattleOver="@(_roomDetail.RoomStatus == Game.Shared.Enums.RoomStatus.BattleOver || _roomDetail.ClosedAtUtc is not null)"
                                                CanQueue="@(supply => CanQueueConsumable(mobileActionSlot, supply))"
                                                OnToggle="@(supply => ToggleConsumableAsync(mobileActionSlot, supply))" />
                    </div>
                }
                @if (_mobileLoadoutView == "skills" || _consumableMessage is not null)
                {
                    <div class="battle-mobile-quick-actions__hint @(_skillMessage is not null || _consumableMessage is not null ? "battle-mobile-quick-actions__hint--feedback" : null)" aria-live="polite">
                        <span>@GetMobileActionFooterHint(mobileActionSlot)</span>
                    </div>
                }
            </div>
        }
        @if (countdown is not null)
        {
            var remainingSeconds = GetRemainingSeconds(countdown.DeadlineUtc);
            var progress = GetCountdownProgress(countdown);
            <div class="battle-countdown battle-countdown--@countdown.Kind">
                <div class="battle-countdown__heading"><span>@countdown.Label</span><strong>@FormatCountdown(remainingSeconds)</strong></div>
                <div class="battle-countdown__track" role="progressbar" aria-label="@countdown.Label" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progress"><span class="battle-countdown__fill" style="width: @(progress)%"></span></div>
            </div>
        }
        <div class="battle-command__action">
            @if (_roomDetail.CanCancelPreparation)
            {
                <button class="button button--primary battle-controls__primary" @onclick="CancelPreparationAsync" disabled="@_isBusy" title="撤回自己手动角色的准备，保留已排队操作和倒计时">
                    <span class="battle-controls__primary-label">取消准备</span><span aria-hidden="true">↶</span>
                </button>
            }
            else if (_roomDetail.IsAllAliveMembersAuto && _roomDetail.RoomStatus != Game.Shared.Enums.RoomStatus.BattleOver)
            {
                <span class="auto-indicator"><span aria-hidden="true">✦</span> 自动战斗中</span>
            }
            else if (_roomDetail.CanPrepare)
            {
                <button class="button button--primary battle-controls__primary" @onclick="StartPreparationAsync" disabled="@_isBusy">
                    <span class="battle-controls__primary-label">@(_roomDetail.RoomStatus == Game.Shared.Enums.RoomStatus.Cooldown ? "提前准备" : "准备并结算")</span><span aria-hidden="true">→</span>
                </button>
            }
            else if (isCurrentUserPrepared && _roomDetail.RoomStatus is Game.Shared.Enums.RoomStatus.Cooldown or Game.Shared.Enums.RoomStatus.Preparing or Game.Shared.Enums.RoomStatus.NotStarted)
            {
                <span class="battle-controls__waiting"><span class="status-dot" aria-hidden="true"></span>@(_roomDetail.RoomStatus == Game.Shared.Enums.RoomStatus.Cooldown ? "已准备 · 等待冷却" : "已准备 · 等待队友")</span>
            }
            else if (_roomDetail.RoomStatus == Game.Shared.Enums.RoomStatus.Preparing)
            {
                <span class="battle-controls__waiting"><span class="status-dot" aria-hidden="true"></span>等待队友准备</span>
            }
            else
            {
                <span class="battle-controls__waiting">@GetStatusText()</span>
            }
            @if (autoSlot is not null)
            {
                <label class="battle-auto @(canConfigureOwnAuto ? "" : "battle-auto--locked")" title="控制我的全部角色；未通关角色仍需手动准备">
                    <span>
                        <input type="checkbox" checked="@_roomDetail.IsCurrentUserAutoEnabled" @onchange="e => SetSlotAutoAsync(autoSlot.SlotIndex, (bool)e.Value!)" disabled="@(_isBusy || !canConfigureOwnAuto)" />
                        <span class="battle-auto__label-full">Auto 自动准备</span>
                        <span class="battle-auto__label-mobile">Auto</span>
                    </span>
                    @if (!_roomDetail.IsCurrentUserAutoUnlocked && !_roomDetail.IsCurrentUserAutoEnabled) { <small>存活角色通关后解锁</small> }
                </label>
            }
        </div>
        <div class="battle-command__shortcuts" aria-label="战斗管理">
            <button type="button" class="battle-shortcut" title="队伍编成与房间管理" @onclick="OpenManagement" @ref="_managementTrigger" aria-haspopup="dialog">
                <span aria-hidden="true">☷</span> 队伍 <span class="battle-shortcut__count">@_roomDetail.Slots.Count(slot => slot.IsOccupied)/@_roomDetail.SlotCount</span>
            </button>
            @if (_roomDetail.CumulativeRewards is not null)
            {
                <button type="button"
                        class="battle-shortcut"
                        @onclick="OpenRewards"
                        @ref="_rewardsTrigger"
                        aria-haspopup="dialog">
                    <span aria-hidden="true">✦</span> 战利品
                </button>
            }
        </div>
        @if (_message is not null) { <p class="battle-command__message" role="alert">@_message</p> }
    </section>

    @if (_isLogOpen)
    {
        <div class="battle-log-overlay" @onclick="CloseBattleLog">
            <section class="battle-log-dialog" role="dialog" aria-modal="true" aria-labelledby="battle-log-title" @onclick:stopPropagation>
                <header class="battle-log-dialog__header">
                    <div><span class="section-kicker">BATTLE REPORT</span><h2 id="battle-log-title">战斗记录</h2><p>当前房间最近 @_logs.Count 条记录</p></div>
                    <button type="button" class="battle-log-dialog__close" @onclick="CloseBattleLog" @ref="_logCloseButton" aria-label="关闭战报">×</button>
                </header>
                <div class="battle-log-dialog__content">
                    @if (_logs.Count == 0)
                    {
                        <p>战场尚无记录。准备战斗后，行动过程会显示在这里。</p>
                    }
                    else
                    {
                        <ol>
                            @foreach (var log in _logs.AsEnumerable().Reverse())
                            {
                                <li @key="log.Id">@log.Text</li>
                            }
                        </ol>
                    }
                </div>
            </section>
        </div>
    }

    @if (_isRewardsOpen && _roomDetail.CumulativeRewards is { } dialogRewards)
    {
        <div class="battle-log-overlay battle-reward-overlay" @onclick="CloseRewards">
            <section class="battle-log-dialog battle-reward-dialog" role="dialog" aria-modal="true" aria-labelledby="battle-reward-title" @onclick:stopPropagation>
                <header class="battle-log-dialog__header">
                    <div>
                        <span class="section-kicker">ROOM LOOT</span>
                        <h2 id="battle-reward-title">房间累计战利品</h2>
                        <p>已结算 @dialogRewards.CompletedRuns 轮 · 当前第 @_roomDetail.RunSequence 轮</p>
                    </div>
                    <button type="button" class="battle-log-dialog__close" @onclick="CloseRewards" @ref="_rewardsCloseButton" aria-label="关闭战利品">×</button>
                </header>
                <div class="battle-log-dialog__content battle-reward-dialog__content">
                    <RoomRewards Rewards="dialogRewards" />
                </div>
            </section>
        </div>
    }

    @if (GetStatusDialogCharacter() is { } statusCharacter)
    {
        var positiveEffects = statusCharacter.StatusEffects.Where(effect => effect.IsPositive).ToList();
        var negativeEffects = statusCharacter.StatusEffects.Where(effect => !effect.IsPositive).ToList();
        <div class="status-dialog-overlay" @onclick="CloseStatusDialog">
            <section class="status-dialog" role="dialog" aria-modal="true" aria-labelledby="status-dialog-title" aria-describedby="status-dialog-description" @onclick:stopPropagation>
                <header class="status-dialog__header">
                    <div class="status-dialog__identity">
                        <span class="status-dialog__portrait" aria-hidden="true"><img src="@ProfessionArt.ForName(statusCharacter.ProfessionName)" alt="" /></span>
                        <div>
                            <span class="section-kicker">CHARACTER STATUS · @statusCharacter.SlotIndex 号位</span>
                            <h2 id="status-dialog-title">@statusCharacter.CharacterName</h2>
                            <p id="status-dialog-description">@statusCharacter.ProfessionName · Lv @statusCharacter.CharacterLevel</p>
                        </div>
                    </div>
                    <button type="button" class="status-dialog__close" @onclick="CloseStatusDialog" @ref="_statusDialogCloseButton" aria-label="关闭角色状态详情">×</button>
                </header>
                <div class="status-dialog__content">
                    <div class="status-dialog__vitals">
                        <div><span>生命值</span><strong>@statusCharacter.CharacterHp / @statusCharacter.CharacterMaxHp</strong></div>
                        <progress value="@statusCharacter.CharacterHp" max="@statusCharacter.CharacterMaxHp" aria-label="@statusCharacter.CharacterName 生命值"></progress>
                        @if (statusCharacter.CharacterElement is { } statusElement)
                        {
                            <small>@WeaponRules.ElementName(statusElement)属性 · @GetElementRelation(statusCharacter)</small>
                        }
                    </div>

                    @if (statusCharacter.StatusEffects.Count == 0)
                    {
                        <div class="status-dialog__empty"><span aria-hidden="true">◇</span><strong>当前没有状态效果</strong><small>获得强化或负面状态后会显示在这里。</small></div>
                    }
                    else
                    {
                        @if (positiveEffects.Count > 0)
                        {
                            <section class="status-dialog__group" aria-labelledby="positive-status-title">
                                <h3 id="positive-status-title">强化效果 <span>@positiveEffects.Count</span></h3>
                                <ul>
                                    @foreach (var effect in positiveEffects)
                                    {
                                        <li class="status-detail status-detail--positive">
                                            <span class="status-detail__icon" aria-hidden="true">@GetStatusEffectGlyph(effect)</span>
                                            <div><strong>@effect.Name@(effect.Stacks > 1 ? $" ×{effect.Stacks}" : "")</strong><p>@effect.Description</p><small>@GetStatusEffectDuration(effect) · @(effect.CanDispel ? "可移除" : "不可移除")</small></div>
                                        </li>
                                    }
                                </ul>
                            </section>
                        }
                        @if (negativeEffects.Count > 0)
                        {
                            <section class="status-dialog__group" aria-labelledby="negative-status-title">
                                <h3 id="negative-status-title">负面状态 <span>@negativeEffects.Count</span></h3>
                                <ul>
                                    @foreach (var effect in negativeEffects)
                                    {
                                        <li class="status-detail status-detail--negative">
                                            <span class="status-detail__icon" aria-hidden="true">@GetStatusEffectGlyph(effect)</span>
                                            <div><strong>@effect.Name@(effect.Stacks > 1 ? $" ×{effect.Stacks}" : "")</strong><p>@effect.Description</p><small>@GetStatusEffectDuration(effect) · @(effect.CanDispel ? "可移除" : "不可移除")</small></div>
                                        </li>
                                    }
                                </ul>
                            </section>
                        }
                    }
                </div>
            </section>
        </div>
    }

    @if (_isMonsterStatusDialogOpen && _roomDetail is { } monsterStatus)
    {
        var positiveMonsterEffects = monsterStatus.MonsterEffects.Where(effect => effect.IsPositive).ToList();
        var negativeMonsterEffects = monsterStatus.MonsterEffects.Where(effect => !effect.IsPositive).ToList();
        <div class="status-dialog-overlay" @onclick="CloseMonsterStatusDialog">
            <section class="status-dialog status-dialog--enemy" role="dialog" aria-modal="true" aria-labelledby="monster-status-dialog-title" aria-describedby="monster-status-dialog-description" @onclick:stopPropagation>
                <header class="status-dialog__header">
                    <div class="status-dialog__identity">
                        <span class="status-dialog__portrait status-dialog__portrait--enemy" aria-hidden="true"><img src="@MonsterArt.ForName(monsterStatus.MonsterName)" alt="" /></span>
                        <div>
                            <span class="section-kicker">ENEMY STATUS · 第 @monsterStatus.CurrentWaveNumber 波</span>
                            <h2 id="monster-status-dialog-title">@monsterStatus.MonsterName</h2>
                            <p id="monster-status-dialog-description">@WeaponRules.ElementName(monsterStatus.MonsterElement)属性 · 第 @monsterStatus.CurrentEnemyNumber / @monsterStatus.EnemiesInCurrentWave 位</p>
                        </div>
                    </div>
                    <button type="button" class="status-dialog__close" @onclick="CloseMonsterStatusDialog" @ref="_monsterStatusDialogCloseButton" aria-label="关闭怪物状态详情">×</button>
                </header>
                <div class="status-dialog__content">
                    <div class="status-dialog__vitals">
                        <div><span>生命值</span><strong>@monsterStatus.MonsterHp / @monsterStatus.MonsterMaxHp</strong></div>
                        <progress value="@monsterStatus.MonsterHp" max="@monsterStatus.MonsterMaxHp" aria-label="@monsterStatus.MonsterName 生命值"></progress>
                        <small>当前 @monsterStatus.MonsterEffects.Count 个状态效果</small>
                        @if (monsterStatus.IsPartyHpScaled)
                        {
                            <small>本场按 @monsterStatus.ScalingPartySize 人计算 · 生命 @monsterStatus.MonsterHpPercent% · 单人生命 @monsterStatus.MonsterBaseMaxHp</small>
                            <small>中途加入保留剩余血量比例；阵亡、离线不会降低本场生命，下一场重新计算。</small>
                        }
                        else
                        {
                            <small>固定难度 · 生命不随队伍人数变化</small>
                        }
                    </div>
                    @if (monsterStatus.MonsterEffects.Count == 0)
                    {
                        <div class="status-dialog__empty"><span aria-hidden="true">◇</span><strong>当前没有状态效果</strong><small>怪物获得强化或负面状态后会显示在这里。</small></div>
                    }
                    else
                    {
                        @if (positiveMonsterEffects.Count > 0)
                        {
                            <section class="status-dialog__group" aria-labelledby="monster-positive-status-title">
                                <h3 id="monster-positive-status-title">强化效果 <span>@positiveMonsterEffects.Count</span></h3>
                                <ul>
                                    @foreach (var effect in positiveMonsterEffects)
                                    {
                                        <li class="status-detail status-detail--positive">
                                            <span class="status-detail__icon" aria-hidden="true">@GetStatusEffectGlyph(effect)</span>
                                            <div><strong>@effect.Name@(effect.Stacks > 1 ? $" ×{effect.Stacks}" : "")</strong><p>@effect.Description</p><small>@GetStatusEffectDuration(effect) · @(effect.CanDispel ? "可移除" : "不可移除")</small></div>
                                        </li>
                                    }
                                </ul>
                            </section>
                        }
                        @if (negativeMonsterEffects.Count > 0)
                        {
                            <section class="status-dialog__group" aria-labelledby="monster-negative-status-title">
                                <h3 id="monster-negative-status-title">负面状态 <span>@negativeMonsterEffects.Count</span></h3>
                                <ul>
                                    @foreach (var effect in negativeMonsterEffects)
                                    {
                                        <li class="status-detail status-detail--negative">
                                            <span class="status-detail__icon" aria-hidden="true">@GetStatusEffectGlyph(effect)</span>
                                            <div><strong>@effect.Name@(effect.Stacks > 1 ? $" ×{effect.Stacks}" : "")</strong><p>@effect.Description</p><small>@GetStatusEffectDuration(effect) · @(effect.CanDispel ? "可移除" : "不可移除")</small></div>
                                        </li>
                                    }
                                </ul>
                            </section>
                        }
                    }
                </div>
            </section>
        </div>
    }

    @if (GetSkillDialogContext() is { } skillDialog)
    {
        var dialogSelected = IsSkillQueued(skillDialog.Character, skillDialog.Skill);
        var needsTarget = CanChooseSkillTarget(skillDialog.Skill);
        var chosenTarget = _roomDetail.Slots.FirstOrDefault(slot => slot.CharacterId == _selectedSkillTargetId);
        var dialogCanUse = CanQueueSkill(skillDialog.Character, skillDialog.Skill) &&
            (dialogSelected || !needsTarget || chosenTarget is not null && CanSelectSkillTarget(skillDialog.Skill, chosenTarget));
        var confirmLabel = dialogSelected ? "取消本回合施放" : !CanQueueSkill(skillDialog.Character, skillDialog.Skill)
            ? GetSkillHint(skillDialog.Character, skillDialog.Skill) : needsTarget && !dialogCanUse
                ? "请选择有效目标" : needsTarget ? $"对 {chosenTarget!.CharacterName} 使用" : "本回合使用";
        <div class="skill-dialog-overlay" @onclick="CloseSkillDialog">
            <section class="skill-dialog" role="dialog" aria-modal="true" aria-labelledby="skill-dialog-title" aria-describedby="skill-dialog-description" @onclick:stopPropagation>
                <header class="skill-dialog__header">
                    <div class="skill-dialog__skill">
                        <span class="battle-skill-card__icon battle-skill-card__icon--@GetSkillTone(skillDialog.Skill)" aria-hidden="true">
                            <span class="battle-skill-card__flare"></span>
                            <img class="battle-skill-card__art" src="@SkillArt.ForCode(skillDialog.Skill.SkillCode)" alt="" />
                        </span>
                        <div><span class="section-kicker">SKILL @skillDialog.Skill.SlotIndex</span><h2 id="skill-dialog-title">@skillDialog.Skill.SkillName</h2><p>@skillDialog.Character.CharacterName · @skillDialog.Character.ProfessionName</p></div>
                    </div>
                    <button type="button" class="skill-dialog__close" @onclick="CloseSkillDialog" @ref="_skillDialogCloseButton" aria-label="关闭技能详情">×</button>
                </header>
                <div class="skill-dialog__content">
                    <p id="skill-dialog-description" class="skill-dialog__description">@(string.IsNullOrWhiteSpace(skillDialog.Skill.Description) ? "该技能暂无详细说明。" : skillDialog.Skill.Description)</p>
                    @if (needsTarget && !dialogSelected)
                    {
                        <section class="skill-target-picker" aria-labelledby="skill-target-heading">
                            <div><strong id="skill-target-heading">本次施放目标</strong><p>手动施放以本次点选的队友为准；Auto 继续按技能规则智能选择。</p></div>
                            <div class="skill-target-picker__list" role="group" aria-label="选择技能目标">
                                @foreach (var target in _roomDetail.Slots.Where(slot => slot.IsOccupied).OrderBy(slot => slot.SlotIndex))
                                {
                                    var canSelect = CanSelectSkillTarget(skillDialog.Skill, target);
                                    <button type="button" class="skill-target-picker__target @(target.CharacterId == _selectedSkillTargetId ? "selected" : null)"
                                            aria-pressed="@(target.CharacterId == _selectedSkillTargetId ? "true" : "false")"
                                            disabled="@(_isBusy || !canSelect)" @onclick="() => _selectedSkillTargetId = target.CharacterId">
                                        <strong>@target.SlotIndex 号位 · @target.CharacterName@(target.CharacterId == skillDialog.Character.CharacterId ? "（自己）" : "")</strong>
                                        <span>@(target.IsAlive ? $"生命 {target.CharacterHp} / {target.CharacterMaxHp}" : "已阵亡")</span>
                                        @if (target.IsAlive && !canSelect) { <small>@(skillDialog.Skill.Effects.Any(effect => effect.Type == "Heal") ? "无需治疗" : "没有可净化减益")</small> }
                                    </button>
                                }
                            </div>
                            @if (_selectedSkillTargetId.HasValue && (chosenTarget is null || !CanSelectSkillTarget(skillDialog.Skill, chosenTarget)))
                            {
                                <p role="status">目标状态已变化，请重新选择。</p>
                            }
                        </section>
                    }
                    <div class="skill-dialog__facts">
                        @foreach (var effect in skillDialog.Skill.Effects)
                        {
                            <span><i aria-hidden="true">✦</i>@GetSkillEffectText(effect, needsTarget)</span>
                        }
                        <span><i aria-hidden="true">⌛</i>@(skillDialog.Skill.CooldownRoundsRemaining > 0 ? $"剩余冷却 {skillDialog.Skill.CooldownRoundsRemaining} 回合" : "技能已就绪")</span>
                    </div>
                    <section class="skill-dialog__automation" aria-label="技能自动使用设置">
                        <div class="skill-dialog__automation-heading">
                            <div><strong>自动使用</strong><small>@GetSkillAutoConditionText(skillDialog.Skill)</small></div>
                            <label class="switch-control">
                                <input type="checkbox" aria-label="@($"自动使用 {skillDialog.Skill.SkillName}")" checked="@skillDialog.Skill.AutoUseEnabled" @onchange="e => SetSkillAutoAsync(skillDialog, (bool)e.Value!, skillDialog.Skill.AutoHpThresholdPercent, skillDialog.Skill.AutoConditionOverride)" disabled="@(_isBusy || _isSkillAutoSaving)" />
                                <span aria-hidden="true"></span>
                            </label>
                        </div>
                        <SkillAutoConditionPicker ConditionOverride="@skillDialog.Skill.AutoConditionOverride"
                            DefaultCondition="@skillDialog.Skill.AutoCondition" Threshold="@skillDialog.Skill.AutoHpThresholdPercent"
                            Disabled="@(_isBusy || _isSkillAutoSaving)"
                            OnConditionChanged="condition => SetSkillAutoAsync(skillDialog, skillDialog.Skill.AutoUseEnabled, skillDialog.Skill.AutoHpThresholdPercent, condition)"
                            OnThresholdChanged="threshold => SetSkillAutoAsync(skillDialog, skillDialog.Skill.AutoUseEnabled, threshold, skillDialog.Skill.AutoConditionOverride)" />
                        @if (_skillDialogMessage is not null)
                        {
                            <p class="skill-dialog__message" role="alert">@_skillDialogMessage</p>
                        }
                    </section>
                </div>
                <footer class="skill-dialog__footer">
                    <button type="button" class="button button--quiet" @onclick="CloseSkillDialog">返回</button>
                    <button type="button" class="button button--primary" @onclick="() => ConfirmSkillAsync(skillDialog)" disabled="@(_isBusy || !dialogCanUse)">
                        @confirmLabel
                    </button>
                </footer>
            </section>
        </div>
    }

    @if (_isManagementOpen)
    {
        <div class="battle-management-overlay" @onclick="CloseManagement">
            <section class="battle-management-dialog" role="dialog" aria-modal="true" aria-labelledby="battle-management-title" @onclick:stopPropagation @ref="_managementDialog">
                <header class="battle-management-dialog__header">
                    <div><span class="section-kicker">PARTY & ROOM</span><h2 id="battle-management-title">队伍与房间 <small>@_roomDetail.Slots.Count(slot => slot.IsOccupied) / @_roomDetail.SlotCount 人</small></h2></div>
                    <button type="button" class="battle-log-dialog__close" @onclick="CloseManagement" aria-label="关闭队伍与房间" @ref="_managementCloseButton">×</button>
                </header>
                <div class="battle-management-dialog__content">
                    <RoomOperations Operations="_roomDetail.Operations" IsBusy="_isBusy" ShowLatest="true" OnCancel="CancelRoomOperationAsync" />
                    <div class="battle-management-summary">
                        <strong>@_roomDetail.DungeonName <span>· 第 @_roomDetail.RunSequence 轮</span></strong>
                        <span>@(_roomDetail.IsPublic ? "公开房间 · 允许其他玩家加入" : "私人房间 · 不接受新玩家加入")</span>
                        <span>@(_roomDetail.IsRepeatBattle ? "循环讨伐" : "单次讨伐") · 第 @_roomDetail.CurrentWaveNumber / @_roomDetail.TotalWaveCount 波 · 敌人 @_roomDetail.CurrentEnemyNumber / @_roomDetail.EnemiesInCurrentWave</span>
                        @if (_roomDetail.IsPartyHpScaled)
                        {
                            <span>怪物生命随上阵人数增加；中途加入保留剩余血量比例，下一场按实际人数重新计算。</span>
                        }
                        else
                        {
                            <span>固定难度 · 怪物生命不随上阵人数变化</span>
                        }
                        @if (_roomDetail.ExpiresAtUtc is DateTime expiresAt)
                        {
                            <span>任务截止 @DateTime.SpecifyKind(expiresAt, DateTimeKind.Utc).ToLocalTime().ToString("MM-dd HH:mm")</span>
                        }
                        <span>@(_roomDetail.IsPreparationTimeoutEnabled ? $"{BattleRules.PreparationTimeoutSeconds} 秒未准备则自动攻击（不自动施放技能）" : "无准备超时") · 按槽位 1 → @_roomDetail.SlotCount 行动</span>
                    </div>
                    <p class="formation-panel__progress-note">当前职业获得战斗经验，技能随职业等级自动解锁和升级；可在职业与技能页配置技能栏。</p>
                    @if (IsOwner)
                    {
                        <p class="formation-panel__progress-note">在空位选择已上阵角色可直接移入；在已占用位置选择其他自有队员可交换站位。可直接点击自己任意队员的技能进行操作。</p>
                        @if (!CanChangeFormation && _roomDetail.ClosedAtUtc is null)
                        {
                            <p class="formation-panel__progress-note">战斗中也可预约调整，本场战斗结束后自动执行；预约可随时取消。</p>
                        }
                    }
                    <div class="slot-grid">
                        @foreach (var slot in _roomDetail.Slots.OrderBy(x => x.SlotIndex))
                        {
                            <article class="party-slot @(slot.IsOccupied ? "party-slot--occupied" : "party-slot--empty")">
                                <span class="party-slot__index">@slot.SlotIndex</span>
                                @if (slot.IsOccupied)
                                {
                                    <div class="party-slot__identity"><h3>@slot.CharacterName</h3><span>@slot.PlayerName · Lv @slot.CharacterLevel</span></div>
                                    <div class="party-slot__hp"><span>HP @slot.CharacterHp / @slot.CharacterMaxHp</span><span>@(slot.IsAlive ? "存活" : "已阵亡")</span></div>
                                    <progress class="health-bar" value="@slot.CharacterHp" max="@slot.CharacterMaxHp"></progress>
                                    <div class="party-slot__experience">
                                        <div class="party-slot__experience-label"><span>EXP</span><strong>@(slot.ExperienceToNextLevel is int nextExperience ? $"{slot.CharacterExperience} / {nextExperience}" : "MAX")</strong></div>
                                        <progress value="@(slot.ExperienceToNextLevel is null ? 1 : slot.CharacterExperience ?? 0)" max="@(slot.ExperienceToNextLevel ?? 1)" aria-label="@slot.CharacterName 经验值"></progress>
                                    </div>
                                    <div class="party-slot__badges">@if (!slot.IsAlive) { <span class="status-badge status-badge--danger">已死亡</span> } else if (slot.IsOfflineAuto) { <span class="status-badge">离线自动准备</span> } else if (slot.IsOffline) { <span class="status-badge">@(_roomDetail.IsPreparationTimeoutEnabled ? "离线 · 等待准备超时" : "离线 · 等待准备")</span> } else if (slot.IsTemporaryAuto) { <span class="status-badge">超时自动攻击</span> } else if (slot.IsAutoEnabled) { <span class="status-badge status-badge--success">自动准备</span> } else if (slot.IsConfirmed) { <span class="status-badge status-badge--success">已准备</span> } else { <span class="status-badge">@(slot.IsCurrentUserCharacter ? "等待你准备" : "等待玩家准备")</span> }</div>
                                }
                                else
                                {
                                    <div class="party-slot__identity"><h3>空槽位</h3><span>等待冒险者加入</span></div>
                                    @if (!IsOwner && !_roomDetail.Slots.Any(member => member.IsCurrentUserCharacter) && CanJoinRoom)
                                    {
                                        <button class="button button--secondary" @onclick="() => JoinRoomAsync(slot.SlotIndex)" disabled="@_isBusy">加入房间</button>
                                    }
                                }

                                @if (IsOwner && (!slot.IsOccupied || slot.IsCurrentUserCharacter))
                                {
                                    <div class="slot-management">
                                        <select @bind="_selectedCharacterIds[slot.SlotIndex]" disabled="@(_isBusy || _roomDetail.ClosedAtUtc.HasValue)" aria-label="@($"选择放到 {slot.SlotIndex} 号位的角色")">
                                            <option value="0">@(slot.IsOccupied ? "选择队员交换站位" : "选择自有角色")</option>
                                            @foreach (var character in GetFormationCharacters(slot))
                                            {
                                                <option value="@character.CharacterId">@GetFormationCharacterLabel(character)</option>
                                            }
                                        </select>
                                        <button class="button button--quiet" @onclick="() => AssignSlotAsync(slot.SlotIndex)" disabled="@(_isBusy || _roomDetail.ClosedAtUtc.HasValue || _selectedCharacterIds[slot.SlotIndex] == 0)">@GetFormationActionLabel(slot)</button>
                                        @if (slot.IsOccupied)
                                        {
                                            <button class="button button--quiet" @onclick="() => RemoveSlotAsync(slot.SlotIndex)" disabled="@(_isBusy || _roomDetail.ClosedAtUtc.HasValue)">@(CanChangeFormation ? "移除" : "预约移除")</button>
                                        }
                                    </div>
                                }
                            </article>
                        }
                    </div>

                    @if (_message is not null) { <p class="notice-message" role="alert">@_message</p> }
                </div>
                <footer class="battle-management-dialog__footer">
                    @if (IsOwner)
                    {
                        <div class="room-visibility-control">
                            <div><strong>开放房间</strong><small>@(_roomDetail.IsPublic ? "允许其他玩家从大厅加入" : "已关闭加入，现有队员不受影响")</small></div>
                            <button type="button" class="room-visibility-switch @(_roomDetail.IsPublic ? "is-public" : null)" role="switch"
                                    aria-label="开放房间" aria-checked="@(_roomDetail.IsPublic ? "true" : "false")"
                                    disabled="@(_isBusy || _roomDetail.ClosedAtUtc.HasValue)" @onclick="() => SetRoomVisibilityAsync(!_roomDetail.IsPublic)">
                                <span>@(_isUpdatingVisibility ? "保存中…" : _roomDetail.IsPublic ? "已开放" : "已关闭")</span><i aria-hidden="true"></i>
                            </button>
                        </div>
                        @if (_visibilityError is not null) { <p class="room-visibility-error" role="alert">@_visibilityError</p> }
                    }
                    @if (IsOwner || CanRequestLeave)
                    {
                    <section class="battle-controls battle-controls--room-actions" aria-label="房间操作">
                        <div class="battle-controls__tools">
                            @if (IsOwner && _roomDetail.RoomStatus == Game.Shared.Enums.RoomStatus.BattleOver && _roomDetail.NextBattleStartAtUtc is null)
                            {
                                <button class="button button--secondary" @onclick="ResetBattleAsync" disabled="@_isBusy">重置战斗</button>
                            }
                            else if (CanRequestLeave)
                            {
                                <button class="button button--secondary" @onclick="LeaveRoomAsync" disabled="@_isBusy">@(_roomDetail.CanLeaveRoom ? "离开房间" : "预约退出")</button>
                            }
                            @if (IsOwner)
                            {
                                <button class="button button--danger" @onclick="DismissRoomAsync" disabled="@_isBusy">解散房间</button>
                            }
                        </div>
                    </section>
                    }
                </footer>
            </section>
        </div>
    }
}
</div>

