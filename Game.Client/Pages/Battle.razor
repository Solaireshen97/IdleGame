    private async Task ResetBattleAsync()
    {
        _isBusy = true; _message = null;
        var (detail, error) = await ApiService.ResetBattleAsync(RoomId);
        if (detail is null) _message = error ?? "重置战斗失败。"; else { ApplyRoomDetail(detail, false); _logs.Clear(); _seenServerLogIds.Clear(); AppendBattleLogs(["战斗已重置。"]); }
