    {
        "SkillCooldown" => "技能仍在冷却中。",
        "InvalidSkillTarget" => "所选目标已离队、阵亡或不适用于此技能，请重新选择。",
        "NoInjuredTarget" or "NoValidSkillTarget" => "当前没有符合技能条件的目标。",
        "SkillNotEquipped" => "技能栏已变化，请刷新页面。",
        "CharacterDead" => "角色已阵亡。",
