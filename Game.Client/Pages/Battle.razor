@page "/battle/{roomId:int}"
@using Game.Client.Services
@using Game.Shared.Dtos
@using Game.Shared.Dtos.Auth
@using Game.Shared.Dtos.Characters
@inject ApiService ApiService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>房间</PageTitle>

<div class="battle-page">
    <header class="battle-page__header">
        <button class="back-link" @onclick="GoToRooms">← 返回大厅</button>
        <span class="battle-page__room">ROOM · @RoomId</span>
    </header>

@if (_roomDetail is null)
{
    <div class="battle-loading">正在进入战场...</div>
}
else
{
    <section class="battle-stage">
        <div class="enemy-panel">
            <span class="section-kicker">DUNGEON ENCOUNTER</span>
            <p class="enemy-panel__dungeon">@_roomDetail.DungeonName</p>
            <h1>@_roomDetail.MonsterName</h1>
            <div class="battle-hp"><span>ENEMY HP</span><strong>@_roomDetail.MonsterHp <small>/ @_roomDetail.MonsterMaxHp</small></strong></div>
            <progress class="health-bar health-bar--enemy" value="@_roomDetail.MonsterHp" max="@_roomDetail.MonsterMaxHp"></progress>
            <div class="battle-state"><span class="status-badge">@GetStatusText()</span><span>@(_roomDetail.IsRepeatBattle ? "重复战斗" : "单次战斗")</span><span>@(_roomDetail.IsMixedTeam ? "混合队伍 · 30 秒超时" : _roomDetail.IsPreparationTimeoutEnabled ? "队伍准备超时已启用" : "队伍准备超时已关闭")</span></div>
        </div>
        <section class="battle-controls">
            <div class="battle-controls__heading"><span class="section-kicker">COMMAND CENTER</span><h2>行动控制</h2></div>
            @if (GetRemainingCooldownSeconds() > 0)
            {
                <p class="combat-tip">下一回合将在 <strong>@GetRemainingCooldownSeconds()</strong> 秒后可准备</p>
            }
            @if (_roomDetail.NextBattleStartAtUtc is not null)
            {
                <p class="combat-tip">下一场副本将在 <strong>@GetRemainingRepeatSeconds()</strong> 秒后重开；角色生命值将恢复至满。</p>
            }
            @if (_roomDetail.RoomStatus == Game.Shared.Enums.RoomStatus.Preparing)
            {
                <p class="combat-tip">@(_roomDetail.IsPreparationTimeoutEnabled ? $"准备阶段剩余 {GetRemainingPreparationSeconds()} 秒" : "纯自建队已关闭准备超时")</p>
            }
            @if (_roomDetail.CanConfigurePreparationTimeout)
            {
                <label class="toggle-option"><input type="checkbox" checked="@_roomDetail.IsPreparationTimeoutEnabled" @onchange="e => SetPreparationTimeoutAsync((bool)e.Value!)" disabled="@_isBusy" /> 启用准备超时</label>
            }
            @if (_roomDetail.IsAllAliveMembersAuto)
            {
                <p class="combat-tip combat-tip--active">自动战斗中</p>
            }
            else if (_roomDetail.CanPrepare)
            {
                <button class="button button--primary" @onclick="StartPreparationAsync" disabled="@_isBusy">准备并结算</button>
            }
            else if (_roomDetail.RoomStatus == Game.Shared.Enums.RoomStatus.Preparing) { <p class="combat-tip">已准备，等待其他玩家。</p> }
            @if (_roomDetail.RoomStatus == Game.Shared.Enums.RoomStatus.BattleOver && _roomDetail.NextBattleStartAtUtc is null)
            {
                <button class="button button--secondary" @onclick="ResetBattleAsync" disabled="@_isBusy">重置战斗</button>
            }
            else if (_roomDetail.CanLeaveRoom)
            {
                <button class="button button--secondary" @onclick="LeaveRoomAsync" disabled="@_isBusy">离开房间</button>
            }
            <button class="button button--quiet" @onclick="HealAsync" disabled="@_isBusy">恢复主控 10 HP</button>
            @if (IsOwner)
            {
                <button class="button button--danger" @onclick="DismissRoomAsync" disabled="@_isBusy">解散房间</button>
            }
        </section>
    </section>
    <section class="formation-panel">
        <div class="formation-panel__heading"><div><span class="section-kicker">FORMATION</span><h2>队伍阵列</h2></div><span>行动顺序 1 → 5</span></div>
        <div class="slot-grid">
            @foreach (var slot in _roomDetail.Slots.OrderBy(x => x.SlotIndex))
            {
                <article class="party-slot @(slot.IsOccupied ? "party-slot--occupied" : "party-slot--empty")">
                    <span class="party-slot__index">@slot.SlotIndex</span>
                    @if (slot.IsOccupied)
                    {
                        <div class="party-slot__identity"><h3>@slot.CharacterName</h3><span>@slot.PlayerName</span></div>
                        <div class="party-slot__hp"><span>HP @slot.CharacterHp / @slot.CharacterMaxHp</span><span>@(slot.IsAlive ? "存活" : "已阵亡")</span></div>
                        <progress class="health-bar" value="@slot.CharacterHp" max="@slot.CharacterMaxHp"></progress>
                        <div class="party-slot__badges">@if (slot.IsMainControl) { <span class="status-badge status-badge--gold">主控</span> } @if (!slot.IsAlive) { <span class="status-badge status-badge--danger">已死亡</span> } else if (slot.IsTemporaryAuto) { <span class="status-badge">超时自动准备</span> } else if (slot.IsAutoEnabled) { <span class="status-badge status-badge--success">自动准备</span> } else if (slot.IsConfirmed) { <span class="status-badge status-badge--success">已准备</span> } else { <span class="status-badge">@(slot.IsCurrentUserCharacter ? "等待你准备" : "等待玩家准备")</span> }</div>
                        @if (slot.IsCurrentUserCharacter && !slot.IsAutoUnlockedForCurrentUser)
                        {
                            <span class="party-slot__hint">首次通关此副本后解锁 Auto</span>
                        }
                        @if (slot.CanConfigureAuto)
                        {
                            <label class="toggle-option"><input type="checkbox" checked="@slot.IsAutoEnabled" @onchange="e => SetSlotAutoAsync(slot.SlotIndex, (bool)e.Value!)" disabled="@_isBusy" /> Auto</label>
                        }
                    }
                    else
                    {
                        <div class="party-slot__identity"><h3>空槽位</h3><span>等待冒险者加入</span></div>
                        @if (!IsOwner && !_roomDetail.CanLeaveRoom && CanChangeFormation)
                        {
                            <button class="button button--secondary" @onclick="() => JoinRoomAsync(slot.SlotIndex)" disabled="@_isBusy">加入房间</button>
                        }
                    }

                    @if (IsOwner)
                    {
                        <div class="slot-management">
                            <select @bind="_selectedCharacterIds[slot.SlotIndex]" disabled="@(_isBusy || !CanChangeFormation)">
                                <option value="0">选择自有角色</option>
                                @foreach (var character in _characters)
                                {
                                    <option value="@character.CharacterId">@character.Name (@character.Hp / @character.MaxHp)</option>
                                }
                            </select>
                            <button class="button button--quiet" @onclick="() => AssignSlotAsync(slot.SlotIndex)" disabled="@(_isBusy || !CanChangeFormation || _selectedCharacterIds[slot.SlotIndex] == 0)">@(slot.IsOccupied ? "替换" : "上阵")</button>
                            @if (slot.IsOccupied)
                            {
                                <button class="button button--quiet" @onclick="() => RemoveSlotAsync(slot.SlotIndex)" disabled="@(_isBusy || !CanChangeFormation || slot.IsMainControl)">移除</button>
                                <button class="button button--quiet" @onclick="() => SetMainControlAsync(slot.CharacterId!.Value)" disabled="@(_isBusy || !CanChangeFormation || slot.IsMainControl)">设为主控</button>
                            }
                        </div>
                    }
                </article>
            }
        </div>
    </section>

    <section class="combat-log"><div class="combat-log__heading"><span class="section-kicker">BATTLE REPORT</span><h2>战斗日志</h2></div>@if (_logs.Count == 0) { <p>战场尚无新的记录。</p> } else { <ul>@foreach (var log in _logs) { <li>@log</li> }</ul> }</section>
    @if (_message is not null) { <p class="notice-message">@_message</p> }
}
</div>

@code {
    [Parameter] public int RoomId { get; set; }
    private RoomDetailResponse? _roomDetail;
    private CurrentUserResponse? _currentUser;
    private List<CharacterSummaryResponse> _characters = new();
    private readonly List<string> _logs = new();
    private readonly CancellationTokenSource _refreshCancellation = new();
    private bool _isBusy;
    private string? _message;
    private readonly Dictionary<int, int> _selectedCharacterIds = new();
    private DateTime _serverTimeUtc;
    private DateTime _serverTimeReceivedAtUtc;
    private bool IsOwner => _roomDetail is not null && _currentUser?.UserId == _roomDetail.OwnerUserId;
    private bool CanChangeFormation => _roomDetail?.RoomStatus is Game.Shared.Enums.RoomStatus.NotStarted or Game.Shared.Enums.RoomStatus.BattleOver;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await ApiService.GetCurrentUserAsync();
        if (_currentUser is null) { Navigation.NavigateTo("/login", replace: true); return; }
        _characters = await ApiService.GetCurrentCharactersAsync() ?? new();
        await RefreshRoomDetailAsync();
        _ = RefreshCooldownAsync(_refreshCancellation.Token);
    }

    private async Task AssignSlotAsync(int slotIndex)
    {
        _isBusy = true; _message = null;
        var (detail, error) = await ApiService.AssignRoomSlotAsync(RoomId, slotIndex, _selectedCharacterIds[slotIndex]);
        if (detail is null) _message = error ?? "上阵角色失败。"; else _roomDetail = detail;
        _isBusy = false;
    }

    private async Task SetPreparationTimeoutAsync(bool isEnabled)
    {
        _isBusy = true;
        var (detail, error) = await ApiService.SetPreparationTimeoutAsync(RoomId, isEnabled);
        if (detail is null) _message = error ?? "配置准备超时失败。"; else _roomDetail = detail;
        _isBusy = false;
    }

    private async Task RemoveSlotAsync(int slotIndex)
    {
        _isBusy = true; _message = null;
        var (detail, error) = await ApiService.RemoveRoomSlotAsync(RoomId, slotIndex);
        if (detail is null) _message = error ?? "移除角色失败。"; else _roomDetail = detail;
        _isBusy = false;
    }

    private async Task SetMainControlAsync(int characterId)
    {
        _isBusy = true; _message = null;
        var (detail, error) = await ApiService.SetMainControlAsync(RoomId, characterId);
        if (detail is null) _message = error ?? "切换主控失败。"; else _roomDetail = detail;
        _isBusy = false;
    }

    private async Task StartPreparationAsync()
    {
        _isBusy = true; _message = null; _logs.Clear();
        var (result, error) = await ApiService.StartPreparationAsync(RoomId);
        if (result is null) _message = error ?? "开始回合失败。";
        else { _logs.AddRange(result.Logs); _message = error; }
        await RefreshRoomDetailAsync();
        _isBusy = false;
    }

    private async Task JoinRoomAsync(int slotIndex)
    {
        _isBusy = true;
        var (detail, error) = await ApiService.JoinRoomAsync(RoomId, slotIndex);
        if (detail is null) _message = error ?? "加入房间失败。"; else _roomDetail = detail;
        _isBusy = false;
    }

    private async Task LeaveRoomAsync()
    {
        _isBusy = true;
        var (detail, error) = await ApiService.LeaveRoomAsync(RoomId);
        if (detail is null) _message = error ?? "离开房间失败。"; else _roomDetail = detail;
        _isBusy = false;
    }

    private async Task SetSlotAutoAsync(int slotIndex, bool isAutoEnabled)
    {
        _isBusy = true;
        var (response, error) = await ApiService.SetSlotAutoAsync(RoomId, slotIndex, isAutoEnabled);
        if (response is null) _message = error ?? "配置 Auto 失败。";
        else
        {
            _roomDetail = response.Room;
            if (response.RoundResult is not null) _logs.AddRange(response.RoundResult.Logs);
        }
        _isBusy = false;
    }

    private async Task ResetBattleAsync()
    {
        _isBusy = true; _message = null; _logs.Clear();
        var (detail, error) = await ApiService.ResetBattleAsync(RoomId);
        if (detail is null) _message = error ?? "重置战斗失败。"; else { _roomDetail = detail; _logs.Add("战斗已重置。"); }
        _isBusy = false;
    }

    private async Task HealAsync()
    {
        _isBusy = true; _message = null; _logs.Clear();
        var (detail, error) = await ApiService.HealAsync(RoomId);
        if (detail is null) _message = error ?? "恢复角色失败。"; else { _roomDetail = detail; _logs.Add("主控角色恢复了 10 HP。"); }
        _isBusy = false;
    }

    private async Task DismissRoomAsync()
    {
        _isBusy = true;
        if (await ApiService.DeleteRoomAsync(RoomId)) Navigation.NavigateTo("/rooms"); else { _message = "解散房间失败。"; _isBusy = false; }
    }

    private async Task RefreshRoomDetailAsync()
    {
        _roomDetail = await ApiService.GetRoomDetailAsync(RoomId);
        if (_roomDetail is not null)
        {
            foreach (var slot in _roomDetail.Slots) _selectedCharacterIds.TryAdd(slot.SlotIndex, 0);
        }
        if (_roomDetail is not null) { _serverTimeUtc = _roomDetail.ServerTimeUtc; _serverTimeReceivedAtUtc = DateTime.UtcNow; }
    }

    private void GoToRooms() => Navigation.NavigateTo("/rooms");
    private int GetRemainingCooldownSeconds() => _roomDetail?.NextRoundAvailableAtUtc is not DateTime next ? 0 : Math.Max(0, (int)Math.Ceiling((next - (_serverTimeUtc + (DateTime.UtcNow - _serverTimeReceivedAtUtc))).TotalSeconds));
    private int GetRemainingPreparationSeconds() => _roomDetail?.PreparationExpiresAtUtc is not DateTime next ? 0 : Math.Max(0, (int)Math.Ceiling((next - (_serverTimeUtc + (DateTime.UtcNow - _serverTimeReceivedAtUtc))).TotalSeconds));
    private int GetRemainingRepeatSeconds() => _roomDetail?.NextBattleStartAtUtc is not DateTime next ? 0 : Math.Max(0, (int)Math.Ceiling((next - (_serverTimeUtc + (DateTime.UtcNow - _serverTimeReceivedAtUtc))).TotalSeconds));
    private string GetStatusText() => _roomDetail?.RoomStatus switch
    {
        Game.Shared.Enums.RoomStatus.NotStarted => "未开始",
        Game.Shared.Enums.RoomStatus.Cooldown => "冷却中",
        Game.Shared.Enums.RoomStatus.Preparing => "准备中",
        Game.Shared.Enums.RoomStatus.BattleOver when _roomDetail.MonsterHp <= 0 => "战斗胜利",
        Game.Shared.Enums.RoomStatus.BattleOver => "队伍战败",
        _ => "未知"
    };

    private async Task RefreshCooldownAsync(CancellationToken cancellationToken)
    {
        try { while (!cancellationToken.IsCancellationRequested) { await Task.Delay(TimeSpan.FromSeconds(2), cancellationToken); if (_roomDetail?.RoomStatus is Game.Shared.Enums.RoomStatus.Cooldown or Game.Shared.Enums.RoomStatus.Preparing || _roomDetail?.IsAllAliveMembersAuto == true || _roomDetail?.NextBattleStartAtUtc is not null) { var (result, _) = await ApiService.SyncBattleAsync(RoomId); if (result is not null) _logs.AddRange(result.Logs); await RefreshRoomDetailAsync(); } await InvokeAsync(StateHasChanged); } }
        catch (OperationCanceledException) { }
    }

    public void Dispose() { _refreshCancellation.Cancel(); _refreshCancellation.Dispose(); }
}
