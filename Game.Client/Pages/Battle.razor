@page "/battle/{roomId:int}"
@using Game.Client.Services
@using Game.Shared.Dtos
@using Game.Shared.Dtos.Auth
@using Game.Shared.Dtos.Characters
@using Game.Shared
@inject ApiService ApiService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>战斗房间</PageTitle>

<div class="battle-page" @onkeydown="HandleBattleLogKeyDown">
    <header class="battle-page__header">
        <button class="back-link" @onclick="GoToRooms">← 返回大厅</button>
        <span class="battle-page__room">ROOM · @RoomId</span>
    </header>

@if (_roomDetail is null)
{
    <GameStateCard Compact="true" Title="正在进入战场" Detail="同步房间成员与敌方状态…" />
}
else if (_roomDetail.ClosedAtUtc.HasValue)
{
    <section class="battle-rewards" aria-label="已结束的战斗任务">
        <div class="battle-rewards__heading">
            <div><span class="section-kicker">EXPEDITION COMPLETE</span><h1>@_roomDetail.DungeonName · 任务已结束</h1></div>
            <span>第 @_roomDetail.RunSequence 轮 · @(_roomDetail.RoundNumber == 0 ? "到期停止" : _roomDetail.MonsterHp <= 0 ? "通关后停止" : "战败后停止")</span>
        </div>
        <p>本次任务已停止，角色可以开始新的战斗或其他活动。继续讨伐请创建新房间。</p>
        @if (_roomDetail.CumulativeRewards is { } cumulative)
        {
            <p>已结算 @cumulative.CompletedRuns 轮</p>
            <div class="battle-rewards__totals"><strong>累计金币 +@cumulative.Gold</strong><strong>累计经验 +@cumulative.Experience</strong></div>
            @if (cumulative.Items.Count > 0)
            {
                <ul>
                    @foreach (var item in cumulative.Items)
                    {
                        <li><span>@item.CharacterName</span><strong>@item.Name × @item.Quantity</strong></li>
                    }
                </ul>
            }
        }
        @if (IsOwner)
        {
            <button class="button button--danger" @onclick="DismissRoomAsync" disabled="@_isBusy">删除记录</button>
        }
    </section>
}
else
{
    var autoSlot = _roomDetail.Slots.FirstOrDefault(slot => slot.IsCurrentUserCharacter && (slot.IsMainControl || !IsOwner));
    var ownSlots = _roomDetail.Slots.Where(slot => slot.IsCurrentUserCharacter && slot.IsOccupied).ToList();
    var isCurrentUserPrepared = ownSlots.Any(slot => slot.IsAlive) && ownSlots.Where(slot => slot.IsAlive).All(slot => slot.IsConfirmed);
    var countdown = GetActiveCountdown();

    <section class="battle-stage" aria-label="战斗场景">
        <div class="battle-stage__header">
            <div>
                <span class="section-kicker">@_roomDetail.RegionName · DUNGEON ENCOUNTER</span>
                <h1>@_roomDetail.DungeonName</h1>
            </div>
            <div class="battle-stage__meta">
                <span class="battle-mode">第 @_roomDetail.CurrentWaveNumber / @_roomDetail.TotalWaveCount 波</span>
                <span class="battle-mode">@(_roomDetail.IsRepeatBattle ? "循环讨伐" : "单次讨伐")</span>
                @if (_roomDetail.ExpiresAtUtc is DateTime expiresAt)
                {
                    <span class="battle-mode">任务截止：@DateTime.SpecifyKind(expiresAt, DateTimeKind.Utc).ToLocalTime().ToString("MM-dd HH:mm")</span>
                }
                <span class="battle-status">@GetStatusText()</span>
            </div>
        </div>

        <button type="button" class="battle-feed" @onclick="OpenBattleLog" @ref="_logTrigger" aria-haspopup="dialog">
            <span class="battle-feed__live">● LIVE LOG</span>
            <span class="battle-feed__latest">@GetLatestLog()</span>
            <span class="battle-feed__open">打开完整战报 <span aria-hidden="true">↗</span></span>
        </button>

        @if (_roomDetail.MonsterIntent is { } intent)
        {
            <section class="monster-intent monster-intent--@intent.DangerLevel.ToLowerInvariant()" aria-label="敌方行动预告">
                <div class="monster-intent__icon" aria-hidden="true">!</div>
                <div class="monster-intent__body">
                    <span>ENEMY INTENT · 敌方行动预告 · @GetDangerLabel(intent.DangerLevel)</span>
                    <strong>@intent.ActionName</strong>
                    <small>@intent.Description</small>
                </div>
                <div class="monster-intent__target">
                    <span>目标</span><strong>@intent.TargetLabel</strong>
                    @if (intent.ActionType == "Skill")
                    {
                        <small class="@(intent.IsInterruptible ? "intent-rule--yes" : "intent-rule--no")">
                            @(intent.IsInterrupted ? "已打断" : intent.IsInterruptible ? "可打断" : "不可打断")
                        </small>
                    }
                </div>
            </section>
        }

        <div class="battle-field @(_isCombatFeedbackVisible ? "battle-field--player-attack" : "")">
            <div class="battle-field__party">
                <div class="battle-field__label"><span><small>YOUR PARTY</small>我方队伍</span><strong>@_roomDetail.Slots.Count(slot => slot.IsOccupied) / @_roomDetail.SlotCount 人</strong></div>
                <div class="fighter-line">
                    @foreach (var slot in _roomDetail.Slots.OrderBy(slot => slot.SlotIndex))
                    {
                        <button type="button"
                                class="fighter @(slot.IsOccupied ? "fighter--occupied fighter--interactive" : "fighter--empty") @(!slot.IsAlive && slot.IsOccupied ? "fighter--down" : "")"
                                disabled="@(!slot.IsOccupied)"
                                title="@(slot.IsOccupied ? $"{slot.CharacterName} · HP {slot.CharacterHp}/{slot.CharacterMaxHp} · 点击查看状态" : $"{slot.SlotIndex} 号空槽位")"
                                aria-label="@(slot.IsOccupied ? $"{slot.SlotIndex} 号位 {slot.CharacterName}，生命值 {slot.CharacterHp}/{slot.CharacterMaxHp}，点击查看详细状态" : $"{slot.SlotIndex} 号空槽位")"
                                aria-haspopup="@(slot.IsOccupied ? "dialog" : null)"
                                @onclick="() => OpenStatusDialog(slot)">
                            <div class="fighter__portrait">
                                @if (slot.IsOccupied)
                                {
                                    <img src="/art/knight.svg" alt="" />
                                }
                                else
                                {
                                    <span aria-hidden="true">＋</span>
                                }
                                <span class="fighter__number">@slot.SlotIndex</span>
                                @if (slot.StatusEffects.Count > 0)
                                {
                                    <span class="fighter__effect-icons" aria-label="@($"{slot.CharacterName} 有 {slot.StatusEffects.Count} 个状态效果")">
                                        @foreach (var effect in slot.StatusEffects.Take(3))
                                        {
                                            <span class="fighter__effect-icon @(effect.IsPositive ? "fighter__effect-icon--positive" : "fighter__effect-icon--negative")"
                                                  title="@($"{effect.Name} · {GetStatusEffectDuration(effect)}")"
                                                  aria-hidden="true">@GetStatusEffectGlyph(effect)</span>
                                        }
                                        @if (slot.StatusEffects.Count > 3)
                                        {
                                            <span class="fighter__effect-icon fighter__effect-icon--more" aria-hidden="true">+@(slot.StatusEffects.Count - 3)</span>
                                        }
                                    </span>
                                }
                            </div>
                            <strong>@(slot.IsOccupied ? slot.CharacterName : "空位")</strong>
                            @if (slot.IsOccupied) { <small class="fighter__level">Lv @slot.CharacterLevel</small> }
                            @if (slot.CharacterElement is { } characterElement)
                            {
                                <small class="battle-element" title="攻击 @FormatElementModifier(slot.OutgoingElementModifierPercent) · 受击 @FormatElementModifier(slot.IncomingElementModifierPercent)">@WeaponRules.ElementName(characterElement)属性 · @GetElementRelation(slot)</small>
                            }
                            @if (slot.IsOccupied)
                            {
                                <progress class="fighter__health" value="@slot.CharacterHp" max="@slot.CharacterMaxHp" aria-label="@slot.CharacterName 生命值"></progress>
                                <small class="fighter__hp-text">HP @slot.CharacterHp / @slot.CharacterMaxHp</small>
                            }
                            else
                            {
                                <small>待命</small>
                            }
                        </button>
                    }
                </div>
            </div>

            <span class="battle-field__versus" aria-hidden="true">VS</span>

            <div class="battle-field__enemy @(_roomDetail.MonsterHp <= 0 ? "battle-field__enemy--defeated" : "") @(_isCombatFeedbackVisible ? "battle-field__enemy--hit" : "")">
                <button type="button" class="battle-field__enemy-art" @onclick="OpenMonsterStatusDialog" @ref="_monsterTrigger"
                        title="点击查看 @_roomDetail.MonsterName 的状态"
                        aria-label="@_roomDetail.MonsterName，生命值 @_roomDetail.MonsterHp / @_roomDetail.MonsterMaxHp，@_roomDetail.MonsterEffects.Count 个状态效果，点击查看详细状态"
                        aria-haspopup="dialog">
                    <img src="@GetMonsterArtPath()" alt="" />
                    @if (_roomDetail.MonsterEffects.Count > 0)
                    {
                        <span class="enemy-effect-icons" aria-hidden="true">
                            @foreach (var effect in _roomDetail.MonsterEffects.Take(3))
                            {
                                <span class="fighter__effect-icon @(effect.IsPositive ? "fighter__effect-icon--positive" : "fighter__effect-icon--negative")"
                                      title="@($"{effect.Name} · {effect.RemainingRounds} 回合")">@GetStatusEffectGlyph(effect)</span>
                            }
                            @if (_roomDetail.MonsterEffects.Count > 3)
                            {
                                <span class="fighter__effect-icon fighter__effect-icon--more">+@(_roomDetail.MonsterEffects.Count - 3)</span>
                            }
                        </span>
                    }
                    @if (_isCombatFeedbackVisible)
                    {
                        <span class="battle-hit-slash" aria-hidden="true"></span>
                        <strong class="battle-damage-popup" aria-live="polite">@_combatFeedbackText</strong>
                    }
                </button>
                <button type="button" class="enemy-vitals" @onclick="OpenMonsterStatusDialog"
                        title="点击查看 @_roomDetail.MonsterName 的状态"
                        aria-label="查看 @_roomDetail.MonsterName 的生命值与状态效果" aria-haspopup="dialog">
                    <span class="enemy-vitals__eyebrow">当前敌人 · 第 @_roomDetail.CurrentWaveNumber / @_roomDetail.TotalWaveCount 波 · @_roomDetail.CurrentEnemyNumber / @_roomDetail.EnemiesInCurrentWave</span>
                    <span class="enemy-vitals__name"><strong>@_roomDetail.MonsterName</strong><span>@_roomDetail.MonsterHp / @_roomDetail.MonsterMaxHp HP <b aria-hidden="true">›</b></span></span>
                    <progress class="enemy-vitals__health" value="@_roomDetail.MonsterHp" max="@_roomDetail.MonsterMaxHp" aria-label="怪物生命值"></progress>
                </button>
            </div>
        </div>
        <div class="battle-stage__footer"><span><strong>进度</strong> 第 @_roomDetail.CurrentWaveNumber / @_roomDetail.TotalWaveCount 波 · 敌人 @_roomDetail.CurrentEnemyNumber / @_roomDetail.EnemiesInCurrentWave</span><span><strong>顺序</strong> 槽位 1 → @_roomDetail.SlotCount</span><span><strong>规则</strong> @(_roomDetail.IsPreparationTimeoutEnabled ? $"{BattleRules.PreparationTimeoutSeconds} 秒未准备则临时 Auto" : "无准备超时")</span></div>
    </section>

    <section class="battle-command" aria-label="本回合操作">
        <div class="battle-command__heading">
            <span class="section-kicker">YOUR TURN</span>
            <div>
                <h2>本回合操作</h2>
                <p>@GetActionHint()</p>
            </div>
        </div>
        <div class="battle-command__state" aria-live="polite">
            <span>当前状态</span>
            <strong>@GetStatusText()</strong>
        </div>
        <div class="battle-command__action">
            @if (_roomDetail.IsAllAliveMembersAuto && _roomDetail.RoomStatus != Game.Shared.Enums.RoomStatus.BattleOver)
            {
                <span class="auto-indicator"><span aria-hidden="true">✦</span> 自动战斗中</span>
            }
            else if (_roomDetail.CanPrepare)
            {
                <button class="button button--primary battle-controls__primary" @onclick="StartPreparationAsync" disabled="@_isBusy">
                    <span class="battle-controls__primary-label">@(_roomDetail.RoomStatus == Game.Shared.Enums.RoomStatus.Cooldown ? "提前准备" : "准备并结算")</span><span aria-hidden="true">→</span>
                </button>
            }
            else if (isCurrentUserPrepared && _roomDetail.RoomStatus is Game.Shared.Enums.RoomStatus.Cooldown or Game.Shared.Enums.RoomStatus.Preparing or Game.Shared.Enums.RoomStatus.NotStarted)
            {
                <span class="battle-controls__waiting"><span class="status-dot" aria-hidden="true"></span>@(_roomDetail.RoomStatus == Game.Shared.Enums.RoomStatus.Cooldown ? "已准备 · 等待冷却" : "已准备 · 等待队友")</span>
            }
            else if (_roomDetail.RoomStatus == Game.Shared.Enums.RoomStatus.Preparing)
            {
                <span class="battle-controls__waiting"><span class="status-dot" aria-hidden="true"></span>等待队友准备</span>
            }
            else
            {
                <span class="battle-controls__waiting">@GetStatusText()</span>
            }
            @if (autoSlot is not null)
            {
                <label class="battle-auto @(autoSlot.CanConfigureAuto ? "" : "battle-auto--locked")" title="@(autoSlot.IsAutoUnlockedForCurrentUser ? "自动准备开关" : "首次通关此副本后解锁 Auto")">
                    <span><input type="checkbox" checked="@autoSlot.IsAutoEnabled" @onchange="e => SetSlotAutoAsync(autoSlot.SlotIndex, (bool)e.Value!)" disabled="@(_isBusy || !autoSlot.CanConfigureAuto)" /> Auto 自动准备</span>
                    @if (!autoSlot.IsAutoUnlockedForCurrentUser) { <small>通关后解锁</small> }
                </label>
            }
        </div>
        <div class="battle-command__shortcuts" aria-label="快捷操作">
            <button type="button" class="battle-shortcut" @onclick="OpenBattleLog" aria-haspopup="dialog"><span aria-hidden="true">☷</span> 战报</button>
            @if (ownSlots.Count > 0)
            {
                <a class="battle-shortcut" href="@($"/battle/{RoomId}#battle-loadout")"><span aria-hidden="true">✦</span> 技能与补给</a>
            }
        </div>
        @if (countdown is not null)
        {
            var remainingSeconds = GetRemainingSeconds(countdown.DeadlineUtc);
            var progress = GetCountdownProgress(countdown);
            <div class="battle-countdown battle-countdown--@countdown.Kind">
                <div class="battle-countdown__heading"><span>@countdown.Label</span><strong>@FormatCountdown(remainingSeconds)</strong></div>
                <div class="battle-countdown__track" role="progressbar" aria-label="@countdown.Label" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@progress"><span class="battle-countdown__fill" style="width: @(progress)%"></span></div>
            </div>
        }
    </section>

    @if (_isLogOpen)
    {
        <div class="battle-log-overlay" @onclick="CloseBattleLog">
            <section class="battle-log-dialog" role="dialog" aria-modal="true" aria-labelledby="battle-log-title" @onclick:stopPropagation>
                <header class="battle-log-dialog__header">
                    <div><span class="section-kicker">BATTLE REPORT</span><h2 id="battle-log-title">战斗记录</h2><p>当前房间最近 @_logs.Count 条记录</p></div>
                    <button type="button" class="battle-log-dialog__close" @onclick="CloseBattleLog" @ref="_logCloseButton" aria-label="关闭战报">×</button>
                </header>
                <div class="battle-log-dialog__content">
                    @if (_logs.Count == 0)
                    {
                        <p>战场尚无记录。准备战斗后，行动过程会显示在这里。</p>
                    }
                    else
                    {
                        <ol>
                            @foreach (var log in _logs.AsEnumerable().Reverse())
                            {
                                <li @key="log.Id">@log.Text</li>
                            }
                        </ol>
                    }
                </div>
            </section>
        </div>
    }

    @if (GetStatusDialogCharacter() is { } statusCharacter)
    {
        var positiveEffects = statusCharacter.StatusEffects.Where(effect => effect.IsPositive).ToList();
        var negativeEffects = statusCharacter.StatusEffects.Where(effect => !effect.IsPositive).ToList();
        <div class="status-dialog-overlay" @onclick="CloseStatusDialog">
            <section class="status-dialog" role="dialog" aria-modal="true" aria-labelledby="status-dialog-title" @onclick:stopPropagation>
                <header class="status-dialog__header">
                    <div class="status-dialog__identity">
                        <span class="status-dialog__portrait" aria-hidden="true"><img src="/art/knight.svg" alt="" /></span>
                        <div>
                            <span class="section-kicker">CHARACTER STATUS · @statusCharacter.SlotIndex 号位</span>
                            <h2 id="status-dialog-title">@statusCharacter.CharacterName</h2>
                            <p>@statusCharacter.ProfessionName · Lv @statusCharacter.CharacterLevel</p>
                        </div>
                    </div>
                    <button type="button" class="status-dialog__close" @onclick="CloseStatusDialog" @ref="_statusDialogCloseButton" aria-label="关闭角色状态详情">×</button>
                </header>
                <div class="status-dialog__content">
                    <div class="status-dialog__vitals">
                        <div><span>生命值</span><strong>@statusCharacter.CharacterHp / @statusCharacter.CharacterMaxHp</strong></div>
                        <progress value="@statusCharacter.CharacterHp" max="@statusCharacter.CharacterMaxHp" aria-label="@statusCharacter.CharacterName 生命值"></progress>
                        @if (statusCharacter.CharacterElement is { } statusElement)
                        {
                            <small>@WeaponRules.ElementName(statusElement)属性 · @GetElementRelation(statusCharacter)</small>
                        }
                    </div>

                    @if (statusCharacter.StatusEffects.Count == 0)
                    {
                        <div class="status-dialog__empty"><span aria-hidden="true">◇</span><strong>当前没有状态效果</strong><small>获得强化或负面状态后会显示在这里。</small></div>
                    }
                    else
                    {
                        @if (positiveEffects.Count > 0)
                        {
                            <section class="status-dialog__group" aria-labelledby="positive-status-title">
                                <h3 id="positive-status-title">强化效果 <span>@positiveEffects.Count</span></h3>
                                <ul>
                                    @foreach (var effect in positiveEffects)
                                    {
                                        <li class="status-detail status-detail--positive">
                                            <span class="status-detail__icon" aria-hidden="true">@GetStatusEffectGlyph(effect)</span>
                                            <div><strong>@effect.Name@(effect.Stacks > 1 ? $" ×{effect.Stacks}" : "")</strong><p>@effect.Description</p><small>@GetStatusEffectDuration(effect) · @(effect.CanDispel ? "可移除" : "不可移除")</small></div>
                                        </li>
                                    }
                                </ul>
                            </section>
                        }
                        @if (negativeEffects.Count > 0)
                        {
                            <section class="status-dialog__group" aria-labelledby="negative-status-title">
                                <h3 id="negative-status-title">负面状态 <span>@negativeEffects.Count</span></h3>
                                <ul>
                                    @foreach (var effect in negativeEffects)
                                    {
                                        <li class="status-detail status-detail--negative">
                                            <span class="status-detail__icon" aria-hidden="true">@GetStatusEffectGlyph(effect)</span>
                                            <div><strong>@effect.Name@(effect.Stacks > 1 ? $" ×{effect.Stacks}" : "")</strong><p>@effect.Description</p><small>剩余 @effect.RemainingRounds 回合 · @(effect.CanDispel ? "可移除" : "不可移除")</small></div>
                                        </li>
                                    }
                                </ul>
                            </section>
                        }
                    }
                </div>
            </section>
        </div>
    }

    @if (_isMonsterStatusDialogOpen && _roomDetail is { } monsterStatus)
    {
        var positiveMonsterEffects = monsterStatus.MonsterEffects.Where(effect => effect.IsPositive).ToList();
        var negativeMonsterEffects = monsterStatus.MonsterEffects.Where(effect => !effect.IsPositive).ToList();
        <div class="status-dialog-overlay" @onclick="CloseMonsterStatusDialog">
            <section class="status-dialog status-dialog--enemy" role="dialog" aria-modal="true" aria-labelledby="monster-status-dialog-title" @onclick:stopPropagation>
                <header class="status-dialog__header">
                    <div class="status-dialog__identity">
                        <span class="status-dialog__portrait status-dialog__portrait--enemy" aria-hidden="true"><img src="@GetMonsterArtPath()" alt="" /></span>
                        <div>
                            <span class="section-kicker">ENEMY STATUS · 第 @monsterStatus.CurrentWaveNumber 波</span>
                            <h2 id="monster-status-dialog-title">@monsterStatus.MonsterName</h2>
                            <p>@WeaponRules.ElementName(monsterStatus.MonsterElement)属性 · 第 @monsterStatus.CurrentEnemyNumber / @monsterStatus.EnemiesInCurrentWave 位</p>
                        </div>
                    </div>
                    <button type="button" class="status-dialog__close" @onclick="CloseMonsterStatusDialog" @ref="_monsterStatusDialogCloseButton" aria-label="关闭怪物状态详情">×</button>
                </header>
                <div class="status-dialog__content">
                    <div class="status-dialog__vitals">
                        <div><span>生命值</span><strong>@monsterStatus.MonsterHp / @monsterStatus.MonsterMaxHp</strong></div>
                        <progress value="@monsterStatus.MonsterHp" max="@monsterStatus.MonsterMaxHp" aria-label="@monsterStatus.MonsterName 生命值"></progress>
                        <small>当前 @monsterStatus.MonsterEffects.Count 个状态效果</small>
                    </div>
                    @if (monsterStatus.MonsterEffects.Count == 0)
                    {
                        <div class="status-dialog__empty"><span aria-hidden="true">◇</span><strong>当前没有状态效果</strong><small>怪物获得强化或负面状态后会显示在这里。</small></div>
                    }
                    else
                    {
                        @if (positiveMonsterEffects.Count > 0)
                        {
                            <section class="status-dialog__group" aria-labelledby="monster-positive-status-title">
                                <h3 id="monster-positive-status-title">强化效果 <span>@positiveMonsterEffects.Count</span></h3>
                                <ul>
                                    @foreach (var effect in positiveMonsterEffects)
                                    {
                                        <li class="status-detail status-detail--positive">
                                            <span class="status-detail__icon" aria-hidden="true">@GetStatusEffectGlyph(effect)</span>
                                            <div><strong>@effect.Name@(effect.Stacks > 1 ? $" ×{effect.Stacks}" : "")</strong><p>@effect.Description</p><small>剩余 @effect.RemainingRounds 回合 · @(effect.CanDispel ? "可移除" : "不可移除")</small></div>
                                        </li>
                                    }
                                </ul>
                            </section>
                        }
                        @if (negativeMonsterEffects.Count > 0)
                        {
                            <section class="status-dialog__group" aria-labelledby="monster-negative-status-title">
                                <h3 id="monster-negative-status-title">负面状态 <span>@negativeMonsterEffects.Count</span></h3>
                                <ul>
                                    @foreach (var effect in negativeMonsterEffects)
                                    {
                                        <li class="status-detail status-detail--negative">
                                            <span class="status-detail__icon" aria-hidden="true">@GetStatusEffectGlyph(effect)</span>
                                            <div><strong>@effect.Name@(effect.Stacks > 1 ? $" ×{effect.Stacks}" : "")</strong><p>@effect.Description</p><small>剩余 @effect.RemainingRounds 回合 · @(effect.CanDispel ? "可移除" : "不可移除")</small></div>
                                        </li>
                                    }
                                </ul>
                            </section>
                        }
                    }
                </div>
            </section>
        </div>
    }

    @if (GetSkillDialogContext() is { } skillDialog)
    {
        var dialogSelected = IsSkillQueued(skillDialog.Character, skillDialog.Skill);
        var dialogCanUse = CanQueueSkill(skillDialog.Character, skillDialog.Skill);
        <div class="skill-dialog-overlay" @onclick="CloseSkillDialog">
            <section class="skill-dialog" role="dialog" aria-modal="true" aria-labelledby="skill-dialog-title" @onclick:stopPropagation>
                <header class="skill-dialog__header">
                    <div class="skill-dialog__skill">
                        <span class="battle-skill-card__icon battle-skill-card__icon--@GetSkillTone(skillDialog.Skill)" aria-hidden="true">
                            <span class="battle-skill-card__flare"></span>
                            <span class="battle-skill-card__glyph">@GetSkillGlyph(skillDialog.Skill)</span>
                        </span>
                        <div><span class="section-kicker">SKILL @skillDialog.Skill.SlotIndex</span><h2 id="skill-dialog-title">@skillDialog.Skill.SkillName</h2><p>@skillDialog.Character.CharacterName · @skillDialog.Character.ProfessionName</p></div>
                    </div>
                    <button type="button" class="skill-dialog__close" @onclick="CloseSkillDialog" @ref="_skillDialogCloseButton" aria-label="关闭技能详情">×</button>
                </header>
                <div class="skill-dialog__content">
                    <p class="skill-dialog__description">@(string.IsNullOrWhiteSpace(skillDialog.Skill.Description) ? "该技能暂无详细说明。" : skillDialog.Skill.Description)</p>
                    <div class="skill-dialog__facts">
                        @foreach (var effect in skillDialog.Skill.Effects)
                        {
                            <span><i aria-hidden="true">✦</i>@GetSkillEffectText(effect)</span>
                        }
                        <span><i aria-hidden="true">⌛</i>@(skillDialog.Skill.CooldownRoundsRemaining > 0 ? $"剩余冷却 {skillDialog.Skill.CooldownRoundsRemaining} 回合" : "技能已就绪")</span>
                    </div>
                    <section class="skill-dialog__automation" aria-label="技能自动使用设置">
                        <div class="skill-dialog__automation-heading">
                            <div><strong>自动使用</strong><small>@GetSkillAutoConditionText(skillDialog.Skill)</small></div>
                            <label class="switch-control">
                                <input type="checkbox" aria-label="@($"自动使用 {skillDialog.Skill.SkillName}")" checked="@skillDialog.Skill.AutoUseEnabled" @onchange="e => SetSkillAutoAsync(skillDialog, (bool)e.Value!, skillDialog.Skill.AutoHpThresholdPercent)" disabled="@(_isBusy || _isSkillAutoSaving)" />
                                <span aria-hidden="true"></span>
                            </label>
                        </div>
                        @if (skillDialog.Skill.AutoCondition == "LowestHpBelowThreshold")
                        {
                            <label class="skill-threshold">
                                <span>生命值阈值 <strong>@skillDialog.Skill.AutoHpThresholdPercent%</strong></span>
                                <input type="range" min="1" max="100" step="1" value="@skillDialog.Skill.AutoHpThresholdPercent" @onchange="e => SetSkillAutoThresholdAsync(skillDialog, e)" disabled="@(_isBusy || _isSkillAutoSaving)" />
                            </label>
                        }
                        @if (_skillDialogMessage is not null)
                        {
                            <p class="skill-dialog__message" role="alert">@_skillDialogMessage</p>
                        }
                    </section>
                </div>
                <footer class="skill-dialog__footer">
                    <button type="button" class="button button--quiet" @onclick="CloseSkillDialog">返回</button>
                    <button type="button" class="button button--primary" @onclick="() => ConfirmSkillAsync(skillDialog)" disabled="@(_isBusy || !dialogCanUse)">
                        @(dialogSelected ? "取消本回合施放" : dialogCanUse ? "本回合使用" : GetSkillHint(skillDialog.Character, skillDialog.Skill))
                    </button>
                </footer>
            </section>
        </div>
    }

    @if (ownSlots.Count > 0 || IsOwner || _roomDetail.CanLeaveRoom)
    {
    <section id="battle-loadout" class="battle-controls battle-controls--loadout" aria-label="技能与战斗补给">
        @if (ownSlots.Count > 0)
        {
            <nav class="battle-loadout__tabs" aria-label="战斗操作分类">
                <button type="button" class="@(_mobileLoadoutView == "skills" ? "active" : null)" aria-pressed="@(_mobileLoadoutView == "skills" ? "true" : "false")" @onclick='() => _mobileLoadoutView = "skills"'>
                    <span aria-hidden="true">✦</span><strong>职业技能</strong><small>@ownSlots.Sum(slot => slot.Skills.Count(skill => skill.SkillCode is not null))</small>
                </button>
                <button type="button" class="@(_mobileLoadoutView == "supplies" ? "active" : null)" aria-pressed="@(_mobileLoadoutView == "supplies" ? "true" : "false")" @onclick='() => _mobileLoadoutView = "supplies"'>
                    <span aria-hidden="true">✚</span><strong>战斗补给</strong><small>@ownSlots.Sum(slot => slot.Consumables.Count(supply => supply.ItemCode is not null))</small>
                </button>
            </nav>

            <div class="battle-loadout__panel @(_mobileLoadoutView == "skills" ? "battle-loadout__panel--selected" : null)">
            <div class="battle-skills" aria-label="职业技能">
                <div class="battle-supplies__header">
                    <div><span class="section-kicker">CLASS SKILLS</span><h3>职业技能</h3></div>
                    <div class="battle-skills__tools">
                        <label class="quick-skill-toggle" title="开启后，点击可用技能会直接安排到本回合">
                            <input type="checkbox" @bind="_isQuickSkillCastEnabled" />
                            <span><strong>快速施放</strong><small>@(_isQuickSkillCastEnabled ? "点击技能立即安排" : "点击技能先查看详情")</small></span>
                        </label>
                        <a href="/talents">调整技能 ↗</a>
                    </div>
                </div>
                @foreach (var characterSlot in ownSlots)
                {
                    <div class="battle-skills__character" @key="characterSlot.CharacterId">
                        <div class="battle-supplies__identity"><strong>@characterSlot.CharacterName · @characterSlot.ProfessionName</strong><span>自动技能按 1 → 5 号位依次判定</span></div>
                        <div class="battle-skill-grid">
                            @foreach (var skill in characterSlot.Skills.Where(skill => skill.SkillCode is not null).OrderBy(skill => skill.SlotIndex))
                            {
                                var selected = IsSkillQueued(characterSlot, skill);
                                var available = CanQueueSkill(characterSlot, skill);
                                <button type="button"
                                        class="battle-skill-card battle-skill-card--@GetSkillTone(skill) @(selected ? "battle-skill-card--selected" : "") @(!available ? "battle-skill-card--unavailable" : "")"
                                        disabled="@_isBusy"
                                        title="@GetSkillHint(characterSlot, skill)"
                                        aria-pressed="@(selected ? "true" : "false")"
                                        aria-haspopup="dialog"
                                        @onclick="() => HandleSkillClickAsync(characterSlot, skill)">
                                    <span class="battle-skill-card__icon battle-skill-card__icon--@GetSkillTone(skill)" aria-hidden="true">
                                        <span class="battle-skill-card__flare"></span>
                                        <span class="battle-skill-card__glyph">@GetSkillGlyph(skill)</span>
                                        <span class="battle-skill-card__slot">@skill.SlotIndex</span>
                                        @if (skill.CooldownRoundsRemaining > 0) { <span class="battle-skill-card__cooldown">@skill.CooldownRoundsRemaining</span> }
                                        @if (selected) { <span class="battle-skill-card__check">✓</span> }
                                    </span>
                                    <strong class="battle-skill-card__name">@skill.SkillName</strong>
                                    <small class="battle-skill-card__status">@GetSkillStatus(skill, selected)</small>
                                    @if (skill.AutoUseEnabled) { <span class="battle-skill-card__auto">AUTO</span> }
                                </button>
                            }
                        </div>
                    </div>
                }
                <p>可手动安排多个技能；关闭“快速施放”时，点击图标可查看效果、确认使用并设置该技能的自动策略。</p>
                @if (_skillMessage is not null) { <p class="battle-supplies__message" role="alert">@_skillMessage</p> }
            </div>
            </div>
        }
        @if (ownSlots.Count > 0)
        {
            <div class="battle-loadout__panel @(_mobileLoadoutView == "supplies" ? "battle-loadout__panel--selected" : null)">
            <div class="battle-supplies" aria-label="战斗补给">
                <div class="battle-supplies__header">
                    <div><span class="section-kicker">COMBAT SUPPLIES</span><h3>战斗补给</h3></div>
                    <a href="/supplies">管理补给槽 ↗</a>
                </div>
                <div class="battle-supplies__characters">
                    @foreach (var characterSlot in ownSlots)
                    {
                        <div class="battle-supplies__character" @key="characterSlot.CharacterId">
                            <div class="battle-supplies__identity"><strong>@characterSlot.CharacterName</strong><span>HP @characterSlot.CharacterHp / @characterSlot.CharacterMaxHp</span></div>
                            <div class="battle-supplies__slots">
                                @if (characterSlot.OperationPotion is { } operationPotion)
                                {
                                    <div class="battle-supply battle-supply--operation" title="作战药剂在本场首次结算时自动使用">
                                        <span class="battle-supply__icon" aria-hidden="true">✦</span>
                                        <span class="battle-supply__body"><strong>@(operationPotion.ItemName ?? "空作战药剂槽")</strong><small>@(operationPotion.ItemCode is null ? "前往补给页装备" : $"库存 {operationPotion.Quantity} · {operationPotion.Description}")</small></span>
                                        <span class="battle-supply__action">药剂</span>
                                    </div>
                                }
                                @foreach (var supply in characterSlot.Consumables.OrderBy(supply => supply.SlotIndex))
                                {
                                    var selected = characterSlot.PendingConsumableSlotIndex == supply.SlotIndex;
                                    <button type="button"
                                            class="battle-supply @(selected ? "battle-supply--selected" : "")"
                                            disabled="@(_isBusy || !CanQueueConsumable(characterSlot, supply))"
                                            title="@GetConsumableHint(characterSlot, supply)"
                                            aria-pressed="@(selected ? "true" : "false")"
                                            @onclick="() => ToggleConsumableAsync(characterSlot, supply)">
                                        <span class="battle-supply__icon" aria-hidden="true">✚</span>
                                        <span class="battle-supply__body"><strong>@(supply.ItemName ?? $"空槽位 {supply.SlotIndex}")</strong><small>@GetConsumableStatus(supply, selected)</small></span>
                                        <span class="battle-supply__action">@(selected ? "取消" : "使用")</span>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
                <p>普通消耗品可手动排队至下一次结算，不占用攻击；作战药剂在本场首次结算时自动使用。</p>
                @if (_consumableMessage is not null) { <p class="battle-supplies__message" role="alert">@_consumableMessage</p> }
            </div>
            </div>
        }
        <div class="battle-controls__tools">
            @if (IsOwner && _roomDetail.RoomStatus == Game.Shared.Enums.RoomStatus.BattleOver && _roomDetail.NextBattleStartAtUtc is null)
            {
                <button class="button button--secondary" @onclick="ResetBattleAsync" disabled="@_isBusy">重置战斗</button>
            }
            else if (_roomDetail.CanLeaveRoom)
            {
                <button class="button button--secondary" @onclick="LeaveRoomAsync" disabled="@_isBusy">离开房间</button>
            }
            @if (IsOwner)
            {
                <button class="button button--danger" @onclick="DismissRoomAsync" disabled="@_isBusy">解散房间</button>
            }
        </div>
    </section>
    }

    @if (_roomDetail.Rewards is { } rewards)
    {
        <section class="battle-rewards" aria-label="本轮奖励">
            <div class="battle-rewards__heading">
                <div><span class="section-kicker">REWARD POOL</span><h2>@(rewards.IsCurrentRun ? "本轮奖励" : "上一轮奖励")</h2></div>
                <span>@(rewards.Status == "Pending" ? "待结算" : rewards.Status == "Victory" ? "通关已结算" : "战败已结算") · 第 @rewards.RunSequence 轮</span>
            </div>
            <div class="battle-rewards__totals"><strong>金币 +@rewards.Gold</strong><strong>经验 +@rewards.Experience</strong></div>
            @if (rewards.Items.Count > 0)
            {
                <ul>
                    @foreach (var item in rewards.Items)
                    {
                        <li><span>@item.CharacterName · @item.Source</span><strong>@item.Name × @item.Quantity</strong></li>
                    }
                </ul>
            }
            else
            {
                <p>@(rewards.Status == "Defeat" ? "本轮没有可结算的击杀奖励。" : "本轮暂无物品奖励。")</p>
            }
        </section>
    }

    <details class="formation-panel">
        <summary class="formation-panel__heading"><span><span class="section-kicker">FORMATION</span><strong>队伍编成与槽位管理</strong></span><span>@_roomDetail.Slots.Count(slot => slot.IsOccupied) / @_roomDetail.SlotCount 人 · 展开管理 <span aria-hidden="true">⌄</span></span></summary>
        <p class="formation-panel__progress-note">角色升级会获得天赋点；可在职业天赋页分配点数并配置技能。</p>
        <div class="slot-grid">
            @foreach (var slot in _roomDetail.Slots.OrderBy(x => x.SlotIndex))
            {
                <article class="party-slot @(slot.IsOccupied ? "party-slot--occupied" : "party-slot--empty")">
                    <span class="party-slot__index">@slot.SlotIndex</span>
                    @if (slot.IsOccupied)
                    {
                        <div class="party-slot__identity"><h3>@slot.CharacterName</h3><span>@slot.PlayerName · Lv @slot.CharacterLevel</span></div>
                        <div class="party-slot__hp"><span>HP @slot.CharacterHp / @slot.CharacterMaxHp</span><span>@(slot.IsAlive ? "存活" : "已阵亡")</span></div>
                        <progress class="health-bar" value="@slot.CharacterHp" max="@slot.CharacterMaxHp"></progress>
                        <div class="party-slot__experience">
                            <div class="party-slot__experience-label"><span>EXP</span><strong>@(slot.ExperienceToNextLevel is int nextExperience ? $"{slot.CharacterExperience} / {nextExperience}" : "MAX")</strong></div>
                            <progress value="@(slot.ExperienceToNextLevel is null ? 1 : slot.CharacterExperience ?? 0)" max="@(slot.ExperienceToNextLevel ?? 1)" aria-label="@slot.CharacterName 经验值"></progress>
                            <small>未分配天赋点 @slot.TalentPoints</small>
                        </div>
                        <div class="party-slot__badges">@if (slot.IsMainControl) { <span class="status-badge status-badge--gold">主控</span> } @if (!slot.IsAlive) { <span class="status-badge status-badge--danger">已死亡</span> } else if (slot.IsOfflineAuto) { <span class="status-badge">离线自动准备</span> } else if (slot.IsTemporaryAuto) { <span class="status-badge">超时自动准备</span> } else if (slot.IsAutoEnabled) { <span class="status-badge status-badge--success">自动准备</span> } else if (slot.IsConfirmed) { <span class="status-badge status-badge--success">已准备</span> } else { <span class="status-badge">@(slot.IsCurrentUserCharacter ? "等待你准备" : "等待玩家准备")</span> }</div>
                    }
                    else
                    {
                        <div class="party-slot__identity"><h3>空槽位</h3><span>等待冒险者加入</span></div>
                        @if (!IsOwner && !_roomDetail.Slots.Any(member => member.IsCurrentUserCharacter) && CanJoinRoom)
                        {
                            <button class="button button--secondary" @onclick="() => JoinRoomAsync(slot.SlotIndex)" disabled="@_isBusy">加入房间</button>
                        }
                    }

                    @if (IsOwner)
                    {
                        <div class="slot-management">
                            <select @bind="_selectedCharacterIds[slot.SlotIndex]" disabled="@(_isBusy || !CanChangeFormation)">
                                <option value="0">选择自有角色</option>
                                @foreach (var character in _characters)
                                {
                                    <option value="@character.CharacterId">@character.Name · Lv @character.Level (@character.Hp / @character.MaxHp)</option>
                                }
                            </select>
                            <button class="button button--quiet" @onclick="() => AssignSlotAsync(slot.SlotIndex)" disabled="@(_isBusy || !CanChangeFormation || _selectedCharacterIds[slot.SlotIndex] == 0)">@(slot.IsOccupied ? "替换" : "上阵")</button>
                            @if (slot.IsOccupied)
                            {
                                <button class="button button--quiet" @onclick="() => RemoveSlotAsync(slot.SlotIndex)" disabled="@(_isBusy || !CanChangeFormation || slot.IsMainControl)">移除</button>
                                <button class="button button--quiet" @onclick="() => SetMainControlAsync(slot.CharacterId!.Value)" disabled="@(_isBusy || !CanChangeFormation || slot.IsMainControl)">设为主控</button>
                            }
                        </div>
                    }
                </article>
            }
        </div>
    </details>
    @if (_message is not null) { <p class="notice-message">@_message</p> }
}
</div>

@code {
    [Parameter] public int RoomId { get; set; }
    private RoomDetailResponse? _roomDetail;
    private CurrentUserResponse? _currentUser;
    private List<CharacterSummaryResponse> _characters = new();
    private readonly List<BattleLogEntry> _logs = new();
    private long _nextLocalLogId;
    private readonly HashSet<long> _seenServerLogIds = [];
    private readonly CancellationTokenSource _refreshCancellation = new();
    private bool _isBusy;
    private string? _message;
    private string? _consumableMessage;
    private string? _skillMessage;
    private readonly Dictionary<int, int> _selectedCharacterIds = new();
    private DateTime _serverTimeUtc;
    private DateTime _serverTimeReceivedAtUtc;
    private ElementReference _logTrigger;
    private ElementReference _logCloseButton;
    private ElementReference _skillDialogCloseButton;
    private ElementReference _statusDialogCloseButton;
    private ElementReference _monsterTrigger;
    private ElementReference _monsterStatusDialogCloseButton;
    private bool _isLogOpen;
    private bool _focusLogCloseButton;
    private bool _focusLogTrigger;
    private bool _isQuickSkillCastEnabled;
    private string _mobileLoadoutView = "skills";
    private bool _isSkillDialogOpen;
    private bool _focusSkillDialogCloseButton;
    private bool _isSkillAutoSaving;
    private int? _selectedSkillCharacterId;
    private int? _selectedSkillSlotIndex;
    private string? _skillDialogMessage;
    private int? _selectedStatusCharacterId;
    private bool _focusStatusDialogCloseButton;
    private bool _isMonsterStatusDialogOpen;
    private bool _focusMonsterStatusDialogCloseButton;
    private bool _focusMonsterTrigger;
    private CancellationTokenSource? _combatFeedbackCancellation;
    private bool _isCombatFeedbackVisible;
    private string _combatFeedbackText = string.Empty;
    private sealed record BattleCountdown(string Label, DateTime DeadlineUtc, int DurationSeconds, string Kind);
    private sealed record BattleLogEntry(long Id, string Text);
    private sealed record SkillDialogContext(RoomSlotResponse Character, RoomSkillSlotResponse Skill);
    private bool IsOwner => _roomDetail is not null && _currentUser?.UserId == _roomDetail.OwnerUserId;
    private bool CanChangeFormation => _roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.BattleOver ||
        _roomDetail?.RoomStatus == Game.Shared.Enums.RoomStatus.NotStarted && _roomDetail.RoundNumber == 0;
    private bool CanJoinRoom => _roomDetail?.ClosedAtUtc is null &&
        (_roomDetail?.RoomStatus is Game.Shared.Enums.RoomStatus.NotStarted or Game.Shared.Enums.RoomStatus.Preparing or
            Game.Shared.Enums.RoomStatus.Cooldown or Game.Shared.Enums.RoomStatus.WaveTransition ||
         _roomDetail?.NextBattleStartAtUtc is not null);

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await ApiService.GetCurrentUserAsync();
        if (_currentUser is null) { Navigation.NavigateTo("/login", replace: true); return; }
        _characters = await ApiService.GetCurrentCharactersAsync() ?? new();
        await RefreshRoomDetailAsync();
        if (_roomDetail?.Slots.Any(slot => slot.IsCurrentUserCharacter) == true)
        {
            await ApiService.SyncBattleAsync(RoomId);
            await RefreshRoomDetailAsync();
        }
        _ = RefreshCooldownAsync(_refreshCancellation.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusSkillDialogCloseButton)
        {
            _focusSkillDialogCloseButton = false;
            await _skillDialogCloseButton.FocusAsync();
        }
        else if (_focusStatusDialogCloseButton)
        {
            _focusStatusDialogCloseButton = false;
            await _statusDialogCloseButton.FocusAsync();
        }
        else if (_focusMonsterStatusDialogCloseButton)
        {
            _focusMonsterStatusDialogCloseButton = false;
            await _monsterStatusDialogCloseButton.FocusAsync();
        }
        else if (_focusMonsterTrigger)
        {
            _focusMonsterTrigger = false;
            await _monsterTrigger.FocusAsync();
        }
        else if (_focusLogCloseButton)
        {
            _focusLogCloseButton = false;
            await _logCloseButton.FocusAsync();
        }
        else if (_focusLogTrigger)
        {
            _focusLogTrigger = false;
            await _logTrigger.FocusAsync();
        }
    }

    private void OpenBattleLog()
    {
        _isLogOpen = true;
        _focusLogCloseButton = true;
    }

    private void CloseBattleLog()
    {
        _isLogOpen = false;
        _focusLogTrigger = true;
    }

    private void HandleBattleLogKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Escape") return;
        if (_isSkillDialogOpen) CloseSkillDialog();
        else if (_selectedStatusCharacterId.HasValue) CloseStatusDialog();
        else if (_isMonsterStatusDialogOpen) CloseMonsterStatusDialog();
        else if (_isLogOpen) CloseBattleLog();
    }

    private void OpenStatusDialog(RoomSlotResponse slot)
    {
        if (!slot.IsOccupied || slot.CharacterId is null) return;
        _selectedStatusCharacterId = slot.CharacterId;
        _focusStatusDialogCloseButton = true;
    }

    private void CloseStatusDialog()
    {
        _selectedStatusCharacterId = null;
    }

    private void OpenMonsterStatusDialog()
    {
        if (_roomDetail is null) return;
        _isMonsterStatusDialogOpen = true;
        _focusMonsterStatusDialogCloseButton = true;
    }

    private void CloseMonsterStatusDialog()
    {
        _isMonsterStatusDialogOpen = false;
        _focusMonsterStatusDialogCloseButton = false;
        _focusMonsterTrigger = _roomDetail?.ClosedAtUtc is null;
    }

    private RoomSlotResponse? GetStatusDialogCharacter() => _selectedStatusCharacterId is int characterId
        ? _roomDetail?.Slots.FirstOrDefault(slot => slot.CharacterId == characterId)
        : null;

    private static string GetStatusEffectGlyph(BattleStatusEffectResponse effect)
    {
        var label = $"{effect.Code} {effect.Name}";
        if (effect.Code.StartsWith("operation-potion:", StringComparison.OrdinalIgnoreCase)) return "✦";
        if (label.Contains("poison", StringComparison.OrdinalIgnoreCase) || label.Contains("毒", StringComparison.Ordinal)) return "☠";
        if (label.Contains("berserk", StringComparison.OrdinalIgnoreCase) || label.Contains("fury", StringComparison.OrdinalIgnoreCase) ||
            label.Contains("狂暴", StringComparison.Ordinal) || label.Contains("狂怒", StringComparison.Ordinal)) return "⚔";
        if (label.Contains("burn", StringComparison.OrdinalIgnoreCase) || label.Contains("灼烧", StringComparison.Ordinal)) return "♨";
        if (label.Contains("guard", StringComparison.OrdinalIgnoreCase) || label.Contains("shield", StringComparison.OrdinalIgnoreCase) || label.Contains("护盾", StringComparison.Ordinal)) return "◆";
        return effect.IsPositive ? "↑" : "↓";
    }

    private static string GetStatusEffectDuration(BattleStatusEffectResponse effect) =>
        effect.ExpiresWithRun ? "本场持续" : $"剩余 {effect.RemainingRounds} 回合";

    private async Task AssignSlotAsync(int slotIndex)
    {
        _isBusy = true; _message = null;
        var (detail, error) = await ApiService.AssignRoomSlotAsync(RoomId, slotIndex, _selectedCharacterIds[slotIndex]);
        if (detail is null) _message = GetRoomOperationError(error, "上阵角色失败。"); else _roomDetail = detail;
        _isBusy = false;
    }

    private async Task RemoveSlotAsync(int slotIndex)
    {
        _isBusy = true; _message = null;
        var (detail, error) = await ApiService.RemoveRoomSlotAsync(RoomId, slotIndex);
        if (detail is null) _message = error ?? "移除角色失败。"; else _roomDetail = detail;
        _isBusy = false;
    }

    private async Task SetMainControlAsync(int characterId)
    {
        _isBusy = true; _message = null;
        var (detail, error) = await ApiService.SetMainControlAsync(RoomId, characterId);
        if (detail is null) _message = error ?? "切换主控失败。"; else _roomDetail = detail;
        _isBusy = false;
    }

    private async Task StartPreparationAsync()
    {
        _isBusy = true; _message = null;
        var (result, error) = await ApiService.StartPreparationAsync(RoomId, _roomDetail?.RoundNumber ?? 0);
        if (result is null) _message = error ?? "开始回合失败。";
        else if (error is not null) { AppendBattleLogs(result.Logs); _message = error; }
        await RefreshRoomDetailAsync();
        _isBusy = false;
