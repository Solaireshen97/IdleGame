        (character.PendingSkillSlotMask & SkillRules.SlotMask(skill.SlotIndex)) != 0;

    private bool CanQueueSkill(RoomSlotResponse character, RoomSkillSlotResponse skill) =>
        _roomDetail?.RoomStatus != Game.Shared.Enums.RoomStatus.BattleOver && character.IsAlive && skill.SkillCode is not null &&
        (IsSkillQueued(character, skill) || skill.CooldownRoundsRemaining == 0 && HasApplicableSkillEffect(character, skill));

