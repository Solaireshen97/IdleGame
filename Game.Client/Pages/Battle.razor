        "Deadly" => "致命",
        _ => "普通"
    };

    private async Task<bool> ToggleSkillAsync(RoomSlotResponse character, RoomSkillSlotResponse skill)
    {
        if (_isBusy || character.CharacterId is null || !CanQueueSkill(character, skill)) return false;
        _isBusy = true;
        _skillMessage = null;
        var succeeded = false;
        try
        {
            var (detail, error) = await ApiService.QueueSkillAsync(RoomId, character.CharacterId.Value,
                skill.SlotIndex, !IsSkillQueued(character, skill));
            if (detail is null)
            {
                _skillMessage = GetSkillError(error);
                await RefreshRoomDetailAsync();
            }
            else
            {
                _roomDetail = detail;
                _serverTimeUtc = detail.ServerTimeUtc;
                _serverTimeReceivedAtUtc = DateTime.UtcNow;
                succeeded = true;
            }
        }
        catch { _skillMessage = "连接失败，请稍后重试。"; }
        finally { _isBusy = false; }
        return succeeded;
    }

