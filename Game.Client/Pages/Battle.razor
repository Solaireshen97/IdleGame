        var panelOpen = IsBattlePanelOpen;
        if (_dialogScrollOpen != panelOpen)
        {
            _dialogScrollOpen = panelOpen;
            await Js.InvokeVoidAsync("battleUi.setDialogState", _dialogOwner, panelOpen);
        }
        if (_roomDetail is { ClosedAtUtc: null } || _combatScene is not null)
            await Js.InvokeVoidAsync("battleCombat.preload", _battleStage);
        if (_cancelCombatPlayback)
        {
            _cancelCombatPlayback = false;
            await Js.InvokeVoidAsync("battleCombat.cancel", _battleStage);
        }
        if (_pendingCombatPlan is { } plan)
        {
            _pendingCombatPlan = null;
            await PlayCombatFeedbackAsync(plan);
            if (_refreshCancellation.IsCancellationRequested) return;
        }

        if (!_hasRevealedShortViewport &&
            _roomDetail?.Slots.Any(slot => slot.IsCurrentUserCharacter && slot.IsOccupied) == true)
        {
            _hasRevealedShortViewport = true;
            await Js.InvokeVoidAsync("battleUi.revealQuickActionsOnShortViewport", _mobileQuickActions);
        }

        if (_scrollToMobileActionCharacter)
        {
            _scrollToMobileActionCharacter = false;
            await Js.InvokeVoidAsync("battleUi.revealSelectedMobileCharacter", _mobileActionCharacters);
        }

        if (_alignMobileQuickActions)
        {
            _alignMobileQuickActions = false;
            await Js.InvokeVoidAsync("battleUi.revealQuickActionsOnShortViewport", _mobileQuickActions);
        }

        if (_focusManagementClose)
        {
            _focusManagementClose = false;
            await _managementCloseButton.FocusAsync(preventScroll: true);
            await Js.InvokeVoidAsync("battleUi.trapDialogFocus", _managementDialog);
        }
        else if (_focusManagementTrigger)
        {
            _focusManagementTrigger = false;
            await _managementTrigger.FocusAsync(preventScroll: true);
