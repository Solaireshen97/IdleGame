    private static int GetMobileQueuedActionCount(RoomSlotResponse slot)
    {
        var queuedCount = slot.Skills.Count(skill => skill.SkillCode is not null && IsSkillQueued(slot, skill));
        if (slot.IsSoulImprintQueued) queuedCount++;
        queuedCount += slot.Consumables.Count(supply => IsConsumableQueued(slot, supply));
        return queuedCount;
    }

