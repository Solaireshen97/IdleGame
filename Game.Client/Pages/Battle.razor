    };

    private bool HasApplicableSkillEffect(RoomSlotResponse character, RoomSkillSlotResponse skill)
    {
        if (_roomDetail is null) return false;
        return skill.Effects.Any(effect => effect.Type switch
        {
            "Damage" => _roomDetail.MonsterHp > 0,
            "Heal" when effect.Target == "Self" => character.CharacterHp < character.CharacterMaxHp,
            "Heal" => _roomDetail.Slots.Any(slot => slot.IsAlive && slot.CharacterHp < slot.CharacterMaxHp),
            "Guard" => _roomDetail.Slots.Any(slot => slot.IsAlive),
            "Cleanse" when effect.Target == "Self" => character.StatusEffects.Any(status => !status.IsPositive && status.CanDispel),
            "Cleanse" => _roomDetail.Slots.Any(slot => slot.IsAlive && slot.StatusEffects.Any(status => !status.IsPositive && status.CanDispel)),
            "Dispel" => _roomDetail.MonsterEffects.Any(status => status.IsPositive && status.CanDispel),
            "Interrupt" => _roomDetail.MonsterIntent is { ActionType: "Skill", IsInterruptible: true, IsInterrupted: false },
            "ApplyStatus" => effect.Target != "Monster" || _roomDetail.MonsterHp > 0,
            _ => false
        });
    }

    private string GetUnavailableSkillReason(RoomSkillSlotResponse skill)
    {
        if (skill.Effects.Any(effect => effect.Type == "Cleanse")) return "没有可净化的负面状态";
        if (skill.Effects.Any(effect => effect.Type == "Dispel")) return "怪物没有可驱散的增益";
        if (skill.Effects.Any(effect => effect.Type == "Interrupt")) return "当前没有可打断的敌方技能";
        if (skill.Effects.Any(effect => effect.Type == "Heal")) return "没有受伤队友";
        return "当前没有有效目标";
    }

