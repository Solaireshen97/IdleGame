    {
        "InvalidHpThreshold" => "生命值阈值需要设置在 1% 到 100% 之间。",
        "SkillNotEquipped" or "SkillNotLearned" => "技能配置已变化，请刷新页面。",
        "ConcurrencyConflict" => "技能设置刚刚发生变化，请重试。",
