@page "/warehouse"
@using Game.Client.Services
@using Game.Shared.Dtos.Warehouse
@using Microsoft.AspNetCore.Components.Web
@inject ApiService ApiService
@inject ActiveCharacterState ActiveCharacters
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>营地仓库</PageTitle>

<div class="warehouse-page">
    <header class="warehouse-page__intro">
        <a href="/rooms">← 返回大厅</a>
        <div>
            <span class="warehouse-page__eyebrow">CAMP STORAGE</span>
            <h1>营地仓库</h1>
            <p>角色背包各自独立；可流通的材料与补给可以存入这里，供同账号的其他角色取用。</p>
        </div>
    </header>

    @if (_isLoading)
    {
        <GameStateCard Compact="true" Title="正在清点营地物资" Detail="读取当前角色背包与共享仓库…" />
    }
    else if (_warehouse is null)
    {
        <GameStateCard Compact="true" Tone="error" Icon="!" Title="仓库读取失败" Detail="请检查登录状态后重试。" />
        <button class="warehouse-page__refresh" @onclick="LoadAsync">重新读取</button>
    }
    else
    {
        <section class="warehouse-shell" aria-label="物品仓库">
            <div class="warehouse-shell__heading">
                <div><small>当前角色</small><strong>@_warehouse.CharacterName</strong><span>可共享物品 · @_warehouse.Items.Count 种</span></div>
                <button type="button" class="warehouse-page__refresh" @onclick="LoadAsync" disabled="@_isBusy">↻ 刷新</button>
            </div>

            <nav class="warehouse-tabs" aria-label="物品所在位置">
                <button type="button" class="@(_selectedSource == "bag" ? "active" : null)" aria-pressed="@(_selectedSource == "bag")"
                        @onclick='() => SelectSource("bag")'>
                    <span aria-hidden="true">▦</span><strong>@_warehouse.CharacterName 的背包</strong><small>@_warehouse.Items.Count(item => item.CharacterQuantity > 0) 种</small>
                </button>
                <button type="button" class="@(_selectedSource == "warehouse" ? "active" : null)" aria-pressed="@(_selectedSource == "warehouse")"
                        @onclick='() => SelectSource("warehouse")'>
                    <span aria-hidden="true">◇</span><strong>营地仓库</strong><small>@_warehouse.Items.Count(item => item.WarehouseQuantity > 0) 种</small>
                </button>
            </nav>

            <div class="warehouse-filters" role="group" aria-label="按物品类别筛选">
                <button type="button" class="@(_kindFilter == "All" ? "active" : null)" aria-pressed="@(_kindFilter == "All")" @onclick='() => SelectKind("All")'>全部</button>
                <button type="button" class="@(_kindFilter == "Consumable" ? "active" : null)" aria-pressed="@(_kindFilter == "Consumable")" @onclick='() => SelectKind("Consumable")'>补给</button>
                <button type="button" class="@(_kindFilter == "Material" ? "active" : null)" aria-pressed="@(_kindFilter == "Material")" @onclick='() => SelectKind("Material")'>材料</button>
                <small>显示 @VisibleItems.Count 种</small>
            </div>

            @if (_message is not null && SelectedItem is null)
            {
                <p class="warehouse-page__message" role="status">@_message</p>
            }

            @if (VisibleItems.Count == 0)
            {
                <p class="warehouse-page__empty">当前栏位没有这类物品。可切换背包、仓库或类别查看。</p>
            }
            else
            {
                <section class="warehouse-items" aria-label="@(_selectedSource == "bag" ? "角色背包物品" : "营地仓库物品")">
                    @foreach (var item in VisibleItems)
                    {
                        <button type="button" class="warehouse-item @(item.Kind == "Consumable" ? "warehouse-item--consumable" : "warehouse-item--material")"
                                @key="item.Code" @onclick="() => OpenItem(item)" disabled="@_isBusy"
                                aria-haspopup="dialog" aria-label="查看 @item.Name，当前栏位持有 @SourceQuantity(item) 个">
                            <span class="warehouse-item__kind">@(item.Kind == "Consumable" ? "补给" : "材料")</span>
                            <span class="warehouse-item__icon" aria-hidden="true">@(item.Kind == "Consumable" ? "✚" : "✦")</span>
                            <strong>@item.Name</strong>
                            <span class="warehouse-item__quantity">× @SourceQuantity(item)</span>
                        </button>
                    }
                </section>
            }
        </section>

        @if (SelectedItem is { } selected)
        {
            <div class="warehouse-dialog-overlay" @onclick="CloseItem" @onkeydown="HandleDialogKeyDown" @onkeydown:stopPropagation>
                <section class="warehouse-dialog" role="dialog" aria-modal="true" aria-labelledby="warehouse-dialog-title" @onclick:stopPropagation>
                    <header class="warehouse-dialog__header">
                        <span class="warehouse-dialog__icon @(selected.Kind == "Consumable" ? "warehouse-dialog__icon--consumable" : "warehouse-dialog__icon--material")" aria-hidden="true">@(selected.Kind == "Consumable" ? "✚" : "✦")</span>
                        <div><small>@(selected.Kind == "Consumable" ? "补给" : "材料") · 可共享</small><h2 id="warehouse-dialog-title">@selected.Name</h2></div>
                        <button type="button" class="warehouse-dialog__close" @onclick="CloseItem" @ref="_dialogCloseButton" aria-label="关闭物品详情">×</button>
                    </header>
                    <div class="warehouse-dialog__body">
                        <p class="warehouse-dialog__description">@selected.Description</p>
                        <div class="warehouse-dialog__balances">
                            <div><span>@_warehouse.CharacterName 的背包</span><strong>@selected.CharacterQuantity</strong></div>
                            <div><span>营地仓库</span><strong>@selected.WarehouseQuantity</strong></div>
                        </div>
                        <div class="warehouse-dialog__quantity">
                            <label for="warehouse-quantity">转移数量</label>
                            <div class="warehouse-dialog__stepper">
                                <button type="button" @onclick="() => AdjustQuantity(-1)" disabled="@(_isBusy || _quantity <= 1)" aria-label="减少数量">−</button>
                                <input id="warehouse-quantity" type="number" min="1" step="1" inputmode="numeric" @bind="_quantity" disabled="@_isBusy" />
                                <button type="button" @onclick="() => AdjustQuantity(1)" disabled="@(_isBusy || _quantity >= MaximumQuantity)" aria-label="增加数量">+</button>
                                <button type="button" class="warehouse-dialog__max" @onclick="SetMaxQuantity" disabled="@(_isBusy || SourceQuantity(selected) == 0)">本栏全部</button>
                            </div>
                        </div>
                        @if (_message is not null)
                        {
                            <p class="warehouse-page__message" role="status">@_message</p>
                        }
                    </div>
                    <footer class="warehouse-dialog__footer">
                        <div class="warehouse-dialog__actions">
                            <button type="button" class="warehouse-dialog__deposit" @onclick='() => TransferAsync(selected, "Deposit")'
                                    disabled="@(_isBusy || _quantity < 1 || selected.CharacterQuantity < _quantity)">存入仓库 →</button>
                            <button type="button" class="warehouse-dialog__withdraw" @onclick='() => TransferAsync(selected, "Withdraw")'
                                    disabled="@(_isBusy || _quantity < 1 || selected.WarehouseQuantity < _quantity)">← 取回背包</button>
                        </div>
                        <button type="button" class="warehouse-dialog__back" @onclick="CloseItem">返回物品列表</button>
                    </footer>
                </section>
            </div>
        }
    }
</div>

@code {
    private WarehouseResponse? _warehouse;
    private bool _isLoading = true;
    private bool _isBusy;
    private int _quantity = 1;
    private string _selectedSource = "bag";
    private string _kindFilter = "All";
    private string? _selectedItemCode;
    private bool _focusDialog;
    private ElementReference _dialogCloseButton;
    private string? _message;
    private PendingTransfer? _pendingTransfer;

    private WarehouseItemResponse? SelectedItem => _warehouse?.Items.FirstOrDefault(item => item.Code == _selectedItemCode);
    private List<WarehouseItemResponse> VisibleItems => _warehouse?.Items
        .Where(item => item.CanTransfer && SourceQuantity(item) > 0 && (_kindFilter == "All" || item.Kind == _kindFilter))
        .ToList() ?? [];

    private int SourceQuantity(WarehouseItemResponse item) => _selectedSource == "bag"
        ? item.CharacterQuantity : item.WarehouseQuantity;
    private int MaximumQuantity => SelectedItem is { } item
        ? Math.Max(1, Math.Max(item.CharacterQuantity, item.WarehouseQuantity)) : 1;

    protected override async Task OnInitializedAsync()
    {
        await ActiveCharacters.RefreshAsync();
        ActiveCharacters.Changed += OnActiveCharacterChanged;
        if (ActiveCharacters.Current is null)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusDialog) return;
        _focusDialog = false;
        await _dialogCloseButton.FocusAsync();
    }

    private void SelectSource(string source)
    {
        _selectedSource = source;
        _selectedItemCode = null;
        _message = null;
    }

    private void SelectKind(string kind) => _kindFilter = kind;

    private void OpenItem(WarehouseItemResponse item)
    {
        _selectedItemCode = item.Code;
        _quantity = 1;
        _message = null;
        _focusDialog = true;
    }

    private void CloseItem() => _selectedItemCode = null;

    private void HandleDialogKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseItem();
    }

    private void AdjustQuantity(int change)
    {
        _quantity = (int)Math.Clamp((long)_quantity + change, 1, MaximumQuantity);
    }

    private void SetMaxQuantity()
    {
        if (SelectedItem is { } item) _quantity = Math.Max(1, SourceQuantity(item));
    }

    private async Task LoadAsync()
    {
        var expectedCharacterId = ActiveCharacters.Current?.CharacterId;
        _isLoading = true;
        try
        {
            var response = await ApiService.GetWarehouseAsync();
            if (expectedCharacterId == ActiveCharacters.Current?.CharacterId)
            {
                _warehouse = response is not null && response.CharacterId == expectedCharacterId ? response : null;
                if (_warehouse is null || !_warehouse.Items.Any(item => item.Code == _selectedItemCode))
                    _selectedItemCode = null;
                _message = null;
            }
        }
        catch
        {
            _warehouse = null;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task TransferAsync(WarehouseItemResponse item, string direction)
    {
        if (_isBusy || _warehouse is null || _quantity < 1 || !item.CanTransfer) return;
        var characterId = _warehouse.CharacterId;
        _pendingTransfer = _pendingTransfer is { } previous &&
            previous.CharacterId == characterId && previous.ItemCode == item.Code &&
            previous.Direction == direction && previous.Quantity == _quantity
            ? previous : new PendingTransfer(characterId, item.Code, direction, _quantity, Guid.NewGuid());
        _isBusy = true;
        _message = null;
        try
        {
            var (response, error) = await ApiService.TransferWarehouseAsync(characterId, item.Code,
                direction, _quantity, _pendingTransfer.RequestId);
            if (error is not null)
            {
                _pendingTransfer = null;
                try
                {
                    var refreshed = await ApiService.GetWarehouseAsync();
                    if (ActiveCharacters.Current?.CharacterId == characterId && refreshed?.CharacterId == characterId)
                        _warehouse = refreshed;
                }
                catch { /* Keep the last snapshot when the follow-up read is unavailable. */ }
                _message = error;
            }
            else if (response is not null)
            {
                _pendingTransfer = null;
                if (ActiveCharacters.Current?.CharacterId == response.CharacterId)
                    _warehouse = response;
                _message = direction == "Deposit"
                    ? $"已将 {item.Name} × {_quantity} 存入仓库。"
                    : $"已将 {item.Name} × {_quantity} 取回背包。";
            }
        }
        catch
        {
            _message = "连接中断；若要重试这次转移，请保持物品和数量不变后再次点击。";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void OnActiveCharacterChanged() => _ = InvokeAsync(async () =>
    {
        _pendingTransfer = null;
        _selectedItemCode = null;
        _selectedSource = "bag";
        _kindFilter = "All";
        _quantity = 1;
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => ActiveCharacters.Changed -= OnActiveCharacterChanged;

    private sealed record PendingTransfer(int CharacterId, string ItemCode, string Direction,
        int Quantity, Guid RequestId);
}
