@page "/login"
@using Game.Client.Services
@using Game.Shared.Dtos.Auth
@inject ApiService ApiService
@inject NavigationManager Navigation
@inject UserSessionService Session

<PageTitle>登录</PageTitle>

<AuthShell Kicker=""
           Title="欢迎回来"
           Description=""
           SubmitLabel="进入冒险"
           SubmittingLabel="正在进入…"
           AlternatePrompt="没有账号？"
           AlternateLabel="注册账号"
           AlternateHref="/register"
           IsChecking="@_isCheckingLoginState"
           IsSubmitting="@_isSubmitting"
           ErrorMessage="@_errorMessage"
           RecoveryError="@_recoveryError"
           OnRetry="CheckLoginAsync"
           OnSubmit="LoginAsync">
    <label class="auth-field" for="login-user-name">
        <span>用户名</span>
        <span class="auth-field__control">
            <span class="auth-field__icon" aria-hidden="true">◆</span>
            <input id="login-user-name"
                   name="username"
                   autocomplete="username"
                   enterkeyhint="next"
                   autocapitalize="none"
                   spellcheck="false"
                   placeholder="输入用户名"
                   @bind="_request.UserName"
                   @bind:event="oninput" />
        </span>
    </label>

    <label class="auth-field" for="login-password">
        <span>密码</span>
        <span class="auth-field__control">
            <span class="auth-field__icon" aria-hidden="true">✦</span>
            <input id="login-password"
                   name="password"
                   type="@(_showPassword ? "text" : "password")"
                   autocomplete="current-password"
                   enterkeyhint="done"
                   placeholder="输入密码"
                   @bind="_request.Password"
                   @bind:event="oninput" />
            <button type="button" class="auth-field__reveal"
                    aria-label="@(_showPassword ? "隐藏密码" : "显示密码")"
                    aria-pressed="@(_showPassword ? "true" : "false")"
                    @onclick:stopPropagation="true"
                    @onclick="() => _showPassword = !_showPassword">@(_showPassword ? "隐藏" : "显示")</button>
        </span>
    </label>
</AuthShell>

@code {
    private readonly LoginRequest _request = new();
    private bool _isCheckingLoginState = true;
    private bool _isSubmitting;
    private bool _showPassword;
    private string? _errorMessage;
    private string? _recoveryError;
    private bool _checking;
    [SupplyParameterFromQuery(Name = "notice")] public string? Notice { get; set; }

    protected override Task OnInitializedAsync() => CheckLoginAsync();

    private async Task CheckLoginAsync()
    {
        if (_checking) return;
        _checking = true;
        _isCheckingLoginState = true;
        _recoveryError = null;
        try
        {
            var hadToken = await Session.IsLoggedIn();
            var currentUser = await ApiService.GetCurrentUserAsync(forceRefresh: true);
            if (currentUser is not null)
            {
                Navigation.NavigateTo(currentUser.CharacterCount == 0 ? "/characters/create" : "/rooms", replace: true);
                return;
            }
            if (await Session.IsLoggedIn()) _recoveryError = "暂时无法确认登录状态。请检查网络后重试，无需重新输入账号。";
            else if (hadToken || Notice == "session-expired") _errorMessage = "登录已过期，请重新登录。";
        }
        finally { _isCheckingLoginState = false; _checking = false; }
    }

    private async Task LoginAsync()
    {
        if (_isSubmitting) return;
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var (_, errorMessage) = await ApiService.LoginAsync(_request);
            if (errorMessage is not null)
            {
                _errorMessage = errorMessage;
                return;
            }

            Navigation.NavigateTo("/rooms", replace: true);
        }
        catch (HttpRequestException)
        {
            _errorMessage = "暂时无法连接到游戏服务，请稍后重试。";
        }
        catch (TaskCanceledException)
        {
            _errorMessage = "连接超时，请检查网络后重试。";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
