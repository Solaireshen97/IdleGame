@page "/login"
@using Game.Client.Services
@using Game.Shared.Dtos.Auth
@inject ApiService ApiService
@inject NavigationManager Navigation

<PageTitle>登录</PageTitle>

<AuthShell Kicker="RETURN TO ADVENTURE"
           Title="欢迎回来"
           Description="继续你的远征、养成与离线收益。"
           SubmitLabel="进入冒险"
           SubmittingLabel="正在进入…"
           AlternatePrompt="第一次来到这里？"
           AlternateLabel="创建冒险者账号"
           AlternateHref="/register"
           IsChecking="@_isCheckingLoginState"
           IsSubmitting="@_isSubmitting"
           ErrorMessage="@_errorMessage"
           OnSubmit="LoginAsync">
    <label class="auth-field" for="login-user-name">
        <span>用户名</span>
        <span class="auth-field__control">
            <span class="auth-field__icon" aria-hidden="true">◆</span>
            <input id="login-user-name"
                   name="username"
                   autocomplete="username"
                   autocapitalize="none"
                   spellcheck="false"
                   placeholder="输入用户名"
                   @bind="_request.UserName"
                   @bind:event="oninput" />
        </span>
    </label>

    <label class="auth-field" for="login-password">
        <span>密码</span>
        <span class="auth-field__control">
            <span class="auth-field__icon" aria-hidden="true">✦</span>
            <input id="login-password"
                   name="password"
                   type="@(_showPassword ? "text" : "password")"
                   autocomplete="current-password"
                   placeholder="输入密码"
                   @bind="_request.Password"
                   @bind:event="oninput" />
            <button type="button" class="auth-field__reveal"
                    aria-label="@(_showPassword ? "隐藏密码" : "显示密码")"
                    aria-pressed="@(_showPassword ? "true" : "false")"
                    @onclick:stopPropagation="true"
                    @onclick="() => _showPassword = !_showPassword">@(_showPassword ? "隐藏" : "显示")</button>
        </span>
    </label>
</AuthShell>

@code {
    private readonly LoginRequest _request = new();
    private bool _isCheckingLoginState = true;
    private bool _isSubmitting;
    private bool _showPassword;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var currentUser = await ApiService.GetCurrentUserAsync();
        if (currentUser is not null)
        {
            Navigation.NavigateTo("/rooms", replace: true);
            return;
        }

        _isCheckingLoginState = false;
    }

    private async Task LoginAsync()
    {
        _isSubmitting = true;
        _errorMessage = null;

        try
        {
            var (_, errorMessage) = await ApiService.LoginAsync(_request);
            if (errorMessage is not null)
            {
                _errorMessage = errorMessage;
                return;
            }

            Navigation.NavigateTo("/rooms", replace: true);
        }
        catch (HttpRequestException)
        {
            _errorMessage = "暂时无法连接到游戏服务，请稍后重试。";
        }
        catch (TaskCanceledException)
        {
            _errorMessage = "连接超时，请检查网络后重试。";
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
