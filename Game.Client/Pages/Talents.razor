@page "/talents"
@page "/talents/{CharacterId:int}"
@using Game.Client.Services
@inject ActiveCharacterState ActiveCharacters
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>职业天赋</PageTitle>
<div class="talents-page">
    @if (_isLoading)
    {
        <GameStateCard Compact="true" Title="正在读取当前角色" Detail="准备载入职业成长路线。" />
    }
    else if (ActiveCharacters.Current is { } character)
    {
        <nav class="talents-page__tabs" aria-label="天赋与技能">
            <button type="button" class="@(_section == "battle" ? "active" : null)" aria-pressed="@(_section == "battle" ? "true" : "false")" @onclick='() => _section = "battle"'>战斗</button>
            <button type="button" class="@(_section == "skills" ? "active" : null)" aria-pressed="@(_section == "skills" ? "true" : "false")" @onclick='() => _section = "skills"'>技能</button>
            <button type="button" class="@(_section == "soul" ? "active" : null)" aria-pressed="@(_section == "soul" ? "true" : "false")" @onclick='() => _section = "soul"'>魂印</button>
        </nav>
        <div class="talents-page__workspace @(_section is "skills" or "soul" ? "talents-page__workspace--library" : null)">
            @if (_section == "battle")
            {
                <CharacterTalentBoard @key='("base", character.CharacterId)' CharacterId="@character.CharacterId" OnChanged="RefreshCurrentAsync" />
            }
            else if (_section == "skills")
            {
                <CharacterSkillBoard @key='("skills", character.CharacterId, _talentRevision)' CharacterId="@character.CharacterId" />
            }
            else
            {
                <CharacterSoulImprintBoard @key='("soul", character.CharacterId)' CharacterId="@character.CharacterId" />
            }
        </div>
    }
    else
    {
        <GameStateCard Compact="true" Tone="error" Icon="!" Title="角色读取失败" Detail="请返回大厅后重新选择角色。" />
    }
</div>

@code {
    [Parameter] public int? CharacterId { get; set; }
    private bool _isLoading = true;
    private int _talentRevision;
    private string _section = "battle";

    protected override async Task OnInitializedAsync()
    {
        ActiveCharacters.Changed += OnActiveCharacterChanged;
        await ActiveCharacters.RefreshAsync();
        _isLoading = false;
        if (ActiveCharacters.Current is null) Navigation.NavigateTo("/login", replace: true);
    }

    protected override void OnParametersSet()
    {
        if (CharacterId is not null) Navigation.NavigateTo("/talents", replace: true);
    }

    private async Task RefreshCurrentAsync()
    {
        await ActiveCharacters.RefreshAsync();
        _talentRevision++;
    }

    private void OnActiveCharacterChanged() => _ = InvokeAsync(() =>
    {
        _talentRevision++;
        StateHasChanged();
    });

    public void Dispose() => ActiveCharacters.Changed -= OnActiveCharacterChanged;
}
