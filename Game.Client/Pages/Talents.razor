@page "/talents"
@page "/talents/{CharacterId:int}"
<PageTitle>编队职业与技能</PageTitle>
<LegacyLoadoutRoute Section="@(RequestedSoulId is not null || RequestedSoulImprintId is not null ? "soul" : RequestedSection is "skills" or "soul" ? RequestedSection : "profession")" InstanceKind="soul" InstanceId="@(RequestedSoulId ?? RequestedSoulImprintId)" />
@code {
    [Parameter] public int? CharacterId { get; set; }
    [SupplyParameterFromQuery(Name = "instanceId")] public int? RequestedSoulId { get; set; }
    [SupplyParameterFromQuery(Name = "soulImprintId")] public int? RequestedSoulImprintId { get; set; }
    [SupplyParameterFromQuery(Name = "section")] public string? RequestedSection { get; set; }
}
