@page "/talents"
@page "/talents/{CharacterId:int}"
@using Game.Client.Services
@inject ActiveCharacterState ActiveCharacters
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>职业天赋</PageTitle>

<div class="talents-page">
    <div class="talents-page__intro">
        <a class="talents-page__back" href="/">← 返回大厅</a>
        <p>为当前角色分配天赋，规划后续职业成长。</p>
    </div>

    @if (_isLoading)
    {
        <p class="talents-page__notice">正在读取当前角色...</p>
    }
    else if (ActiveCharacters.Current is { } character)
    {
        <div class="talents-page__layout">
            <aside class="talents-page__aside">
                <section class="talents-page__identity" aria-label="当前操作角色">
                    <span class="talents-page__eyebrow">ACTIVE CHARACTER</span>
                    <h2>@character.Name</h2><small>@character.ProfessionName</small>
                    <div class="talents-page__level"><strong>Lv @character.Level</strong><span>@(character.ExperienceToNextLevel is int required ? $"EXP {character.Experience} / {required}" : "MAX")</span></div>
                    <progress value="@(character.ExperienceToNextLevel is null ? 1 : character.Experience)" max="@(character.ExperienceToNextLevel ?? 1)" aria-label="角色经验值"></progress>
                    <dl>
                        <div><dt>HP</dt><dd>@character.Hp / @character.MaxHp</dd></div>
                        <div><dt>攻击</dt><dd>@character.Attack</dd></div>
                        <div><dt>防御</dt><dd>@character.Defense</dd></div>
                        <div><dt>可用天赋点</dt><dd>@character.TalentPoints</dd></div>
                    </dl>
                    <p>可从顶栏切换当前操作角色。</p>
                </section>
                <section class="talents-page__roadmap">
                    <span class="talents-page__eyebrow">CAREER PATH</span>
                    <h2>职业路线</h2>
                    <p>点亮前置节点，沿职业路线学习新技能。后续可在这里扩展转职条件与专属路线。</p>
                </section>
            </aside>

            <div class="talents-page__main">
                <CharacterTalentBoard @key='("base", character.CharacterId, _talentRevision)'
                                      CharacterId="@character.CharacterId"
                                      OnChanged="RefreshCurrentAsync" />
                <CharacterSkillBoard @key='("skills", character.CharacterId, _talentRevision)'
                                     CharacterId="@character.CharacterId" OnChanged="RefreshCurrentAsync" />
                <section class="talents-page__next">
                    <span class="talents-page__next-icon" aria-hidden="true">✦</span>
                    <div>
                        <span class="talents-page__eyebrow">FUTURE PATH</span>
                        <h2>职业进阶</h2>
                        <p>职业路线将继续扩展专精、转职与更高等级的技能节点。</p>
                    </div>
                </section>
            </div>
        </div>
    }
    else
    {
        <p class="talents-page__notice" role="alert">暂时无法读取当前角色。</p>
    }
</div>

@code {
    [Parameter]
    public int? CharacterId { get; set; }

    private bool _isLoading = true;
    private int _talentRevision;

    protected override async Task OnInitializedAsync()
    {
        ActiveCharacters.Changed += OnActiveCharacterChanged;
        await ActiveCharacters.RefreshAsync();
        _isLoading = false;
        if (ActiveCharacters.Current is null) Navigation.NavigateTo("/login", replace: true);
    }

    protected override void OnParametersSet()
    {
        if (CharacterId is not null) Navigation.NavigateTo("/talents", replace: true);
    }

    private async Task RefreshCurrentAsync()
    {
        await ActiveCharacters.RefreshAsync();
        _talentRevision++;
    }
    private void OnActiveCharacterChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => ActiveCharacters.Changed -= OnActiveCharacterChanged;
}
