@page "/talents"
@page "/talents/{CharacterId:int}"
@using Game.Client.Services
@using Game.Shared.Dtos.Professions
@inject ApiService ApiService
@inject ActiveCharacterState ActiveCharacters
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>职业天赋</PageTitle>
<div class="talents-page">
    @if (_isLoading)
    {
        <GameStateCard Compact="true" Title="正在读取当前角色" Detail="准备载入职业成长路线。" />
    }
    else if (ActiveCharacters.Current is { } character)
    {
        <nav class="talents-page__tabs" aria-label="天赋与技能">
            <button type="button" class="@(_section == "battle" ? "active" : null)" aria-pressed="@(_section == "battle" ? "true" : "false")" @onclick='() => SelectTalentTreeAsync("battle")'>战斗</button>
            <button type="button" class="@(_section == "Gathering" ? "active" : null)" aria-pressed="@(_section == "Gathering" ? "true" : "false")" @onclick='() => SelectTalentTreeAsync("Gathering")'>采集</button>
            <button type="button" class="@(_section == "Alchemy" ? "active" : null)" aria-pressed="@(_section == "Alchemy" ? "true" : "false")" @onclick='() => SelectTalentTreeAsync("Alchemy")'>炼金</button>
            <button type="button" class="@(_section == "skills" ? "active" : null)" aria-pressed="@(_section == "skills" ? "true" : "false")" @onclick='() => _section = "skills"'>技能</button>
            <button type="button" class="@(_section == "soul" ? "active" : null)" aria-pressed="@(_section == "soul" ? "true" : "false")" @onclick='() => _section = "soul"'>魂印</button>
        </nav>
        <div class="talents-page__workspace @(_section is "skills" or "soul" ? "talents-page__workspace--library" : null)">
            @if (_section == "battle")
            {
                <CharacterTalentBoard @key='("base", character.CharacterId)' CharacterId="@character.CharacterId" OnChanged="RefreshCurrentAsync" />
            }
            else if (_section == "skills")
            {
                <CharacterSkillBoard @key='("skills", character.CharacterId, _talentRevision)' CharacterId="@character.CharacterId" />
            }
            else if (_section == "soul")
            {
                <CharacterSoulImprintBoard @key='("soul", character.CharacterId)' CharacterId="@character.CharacterId" />
            }
            else if (_isProfessionLoading)
            {
                <GameStateCard Compact="true" Title="正在读取专业天赋" Detail="同步专业等级、点数与任务状态…" />
            }
            else if (_professionProgress is null)
            {
                <GameStateCard Compact="true" Tone="error" Icon="!" Title="专业天赋读取失败" Detail="@(_professionNotice ?? "请刷新后重试。")">
                    <Actions><button type="button" class="talents-page__refresh" @onclick="LoadProfessionAsync">重新读取</button></Actions>
                </GameStateCard>
            }
            else
            {
                <div class="talents-page__profession-tools"><span role="status">@(_professionNotice ?? "工作升级获得专业点数")</span><button type="button" @onclick="LoadProfessionAsync" disabled="@_isProfessionBusy">刷新</button></div>
                <ProfessionTalentBoard @key='(character.CharacterId, _activeTalentTree)' Progress="_professionProgress" OnSpend="SpendProfessionTalentAsync" OnReset="ResetProfessionTalentsAsync" IsBusy="_isProfessionBusy" Notice="@_professionNotice" />
            }
        </div>
    }
    else
    {
        <GameStateCard Compact="true" Tone="error" Icon="!" Title="角色读取失败" Detail="请返回大厅后重新选择角色。" />
    }
</div>

@code {
    [Parameter]
    public int? CharacterId { get; set; }
    [SupplyParameterFromQuery(Name = "tree")]
    public string? Tree { get; set; }

    private bool _isLoading = true;
    private int _talentRevision;
    private string _section = "battle";
    private string _activeTalentTree = "battle";
    private ProfessionProgressResponse? _professionProgress;
    private string? _professionNotice;
    private bool _isProfessionLoading;
    private bool _isProfessionBusy;
    private int _professionLoadSequence;

    protected override async Task OnInitializedAsync()
    {
        ActiveCharacters.Changed += OnActiveCharacterChanged;
        await ActiveCharacters.RefreshAsync();
        _isLoading = false;
        if (ActiveCharacters.Current is null) Navigation.NavigateTo("/login", replace: true);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (CharacterId is not null)
        {
            Navigation.NavigateTo("/talents", replace: true);
            return;
        }
        if (ActiveCharacters.Current is not null && (Tree is "Gathering" or "Alchemy"))
            await SelectTalentTreeAsync(Tree);
    }

    private async Task RefreshCurrentAsync()
    {
        await ActiveCharacters.RefreshAsync();
        _talentRevision++;
    }
    private async Task SelectTalentTreeAsync(string tree)
    {
        _section = tree;
        if (_activeTalentTree == tree) return;
        _activeTalentTree = tree;
        _professionLoadSequence++;
        _isProfessionLoading = false;
        _professionProgress = null;
        _professionNotice = null;
        if (tree != "battle") await LoadProfessionAsync();
    }

    private async Task LoadProfessionAsync()
    {
        if (_activeTalentTree == "battle" || _isProfessionBusy) return;
        _isProfessionLoading = true;
        var requestSequence = ++_professionLoadSequence;
        var expectedCharacterId = ActiveCharacters.Current?.CharacterId;
        var expectedTree = _activeTalentTree;
        try
        {
            var response = await ApiService.GetProfessionProgressAsync(expectedTree);
            if (requestSequence == _professionLoadSequence &&
                expectedCharacterId == ActiveCharacters.Current?.CharacterId && expectedTree == _activeTalentTree)
            {
                _professionProgress = response;
                _professionNotice = response is null ? "专业状态读取失败。" : null;
            }
        }
        catch
        {
            if (requestSequence == _professionLoadSequence)
            {
                _professionProgress = null;
                _professionNotice = "连接中断，请重试。";
            }
        }
        finally { if (requestSequence == _professionLoadSequence) _isProfessionLoading = false; }
    }

    private Task SpendProfessionTalentAsync(string nodeCode) => ChangeProfessionTalentsAsync(nodeCode);
    private Task ResetProfessionTalentsAsync() => ChangeProfessionTalentsAsync(null);

    private async Task ChangeProfessionTalentsAsync(string? nodeCode)
    {
        if (_isProfessionBusy || _professionProgress is null || _activeTalentTree == "battle") return;
        _isProfessionBusy = true;
        _professionNotice = null;
        var expectedCharacterId = ActiveCharacters.Current?.CharacterId;
        var expectedTree = _activeTalentTree;
        var shouldReload = false;
        try
        {
            var (progress, error) = nodeCode is null
                ? await ApiService.ResetProfessionTalentsAsync(expectedTree)
                : await ApiService.SpendProfessionTalentAsync(expectedTree, nodeCode);
            if (expectedCharacterId == ActiveCharacters.Current?.CharacterId && expectedTree == _activeTalentTree)
            {
                if (error is not null)
                {
                    _professionNotice = error;
                    shouldReload = true;
                }
                else if (progress is not null)
                {
                    _professionProgress = progress;
                    _professionNotice = nodeCode is null ? "天赋已重置，点数已返还。" : "天赋已升级。";
                }
            }
        }
        catch { _professionNotice = "连接中断，请刷新后确认天赋状态。"; shouldReload = true; }
        finally { _isProfessionBusy = false; }
        if (_activeTalentTree != "battle" && expectedTree != _activeTalentTree)
            await LoadProfessionAsync();
        else if (shouldReload && _activeTalentTree != "battle" &&
            expectedCharacterId == ActiveCharacters.Current?.CharacterId)
        {
            var notice = _professionNotice;
            await LoadProfessionAsync();
            _professionNotice = notice;
        }
    }

    private void OnActiveCharacterChanged() => _ = InvokeAsync(async () =>
    {
        _professionProgress = null;
        _professionNotice = null;
        _professionLoadSequence++;
        _talentRevision++;
        if (_activeTalentTree != "battle") await LoadProfessionAsync();
        StateHasChanged();
    });

    public void Dispose() => ActiveCharacters.Changed -= OnActiveCharacterChanged;
}
