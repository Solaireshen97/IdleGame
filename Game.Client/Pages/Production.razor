@page "/production"
@using Game.Client.Services
@using Game.Shared.Dtos.Production
@using Microsoft.AspNetCore.Components.Web
@inject ApiService ApiService
@inject ActiveCharacterState ActiveCharacters
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>炼金生产</PageTitle>

<div class="activity-page activity-page--production">
    <header class="activity-intro">
        <div><span>CAMP ALCHEMY</span><h1>炼金生产</h1></div>
        <p>选择配方查看材料与产出；原料和成品属于当前角色。</p>
    </header>

    @if (_isLoading)
    {
        <GameStateCard Compact="true" Title="正在查看炼金配方" Detail="读取角色配方和生产任务…" />
    }
    else if (_overview is null)
    {
        <GameStateCard Compact="true" Tone="error" Icon="!" Title="炼金信息读取失败" Detail="请检查登录状态后重试。" />
        <button class="activity-refresh" @onclick="LoadAsync">重新读取</button>
    }
    else
    {
        <div class="activity-summary">
            <div><small>当前角色</small><strong>@_overview.CharacterName · 炼金 Lv.@_overview.AlchemyLevel</strong></div>
            <span>已解锁 @_overview.Recipes.Count(recipe => recipe.IsUnlocked) / @_overview.Recipes.Count 种</span>
            <a href="/talents?tree=Alchemy">炼金天赋 ↗</a>
        </div>

        @if (_notice is not null)
        {
            <p class="activity-notice" role="status">@_notice</p>
        }

        @if (_overview.ActiveTask is { } task)
        {
            <section class="activity-active" aria-label="当前生产任务">
                <div class="activity-active__heading"><span>炼金中</span><strong>剩余 @FormatDuration(task.EndsAtUtc - ServerNow)</strong></div>
                <div class="activity-active__main"><div><h2>@task.RecipeName</h2><p>已完成 @task.CompletedCycles 轮 · 产出 @task.TotalQuantity 瓶@(task.ExtraYieldQuantity > 0 ? $" · 额外 {task.ExtraYieldQuantity}" : "")</p></div><button type="button" class="activity-stop" @onclick="() => StopAsync(task.Id)" disabled="@_isBusy">停止并结算</button></div>
                <div class="activity-active__timer"><span>下一轮</span><strong>@FormatDuration(task.NextCycleAtUtc - ServerNow)</strong></div>
                <div class="activity-progress" role="progressbar" aria-label="下一轮生产进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@CycleProgress(task)">
                    <span @key="task.NextCycleAtUtc" style="width: @(CycleProgress(task))%"></span>
                </div>
                <details class="activity-active__more"><summary>查看生产规则与节省原料</summary><p>每 @task.CycleSeconds 秒制作一轮，结算时才扣当前角色背包材料。关闭网页后服务器仍会继续生产。@(task.SavedIngredientQuantity > 0 ? $"累计节省首种原料 {task.SavedIngredientQuantity} 份。" : "")</p></details>
            </section>
        }

        <section class="activity-options" aria-label="炼金配方">
            <div class="activity-section-title"><div><span>RECIPES</span><h2>炼金配方</h2></div><small>点击配方查看材料</small></div>
            <div class="activity-option-grid">
                @foreach (var recipe in OrderedRecipes())
                {
                    <button type="button" class="activity-option @(!recipe.IsUnlocked ? "activity-option--locked" : null)" @key="recipe.Code"
                            @onclick="() => OpenRecipe(recipe.Code)" aria-haspopup="dialog" aria-label="查看 @recipe.Name 的炼金配方">
                        <span class="activity-option__top"><span>炼金 Lv.@recipe.MinimumAlchemyLevel · @recipe.CycleSeconds 秒</span><b>@(recipe.IsUnlocked ? IngredientsReady(recipe) ? "可生产" : "缺材料" : "未解锁")</b></span>
                        <span class="activity-option__item"><img src="@ItemArt.ForCode(recipe.OutputCode)" alt="" loading="lazy" /><span><strong>@recipe.Name</strong><span class="activity-option__output">@recipe.OutputName × @recipe.OutputQuantity <small>/ 轮</small></span></span></span>
                        <span class="activity-option__foot">可做 @AvailableCycles(recipe) 轮 <span aria-hidden="true">详情 ›</span></span>
                    </button>
                }
            </div>
        </section>

        @if (_overview.RecentTasks.Count > 0)
        {
            <details class="activity-history"><summary>最近生产 <small>@_overview.RecentTasks.Count 条记录</small></summary>
                @foreach (var completed in _overview.RecentTasks)
                {
                    <div class="activity-history__row"><span>@completed.RecipeName <small>@StatusName(completed.Status)</small></span><strong>@completed.OutputName × @completed.TotalQuantity@(completed.ExtraYieldQuantity > 0 ? $"（额外 {completed.ExtraYieldQuantity}）" : "")@(completed.SavedIngredientQuantity > 0 ? $" · 节省原料 {completed.SavedIngredientQuantity}" : "")</strong></div>
                }
            </details>
        }

        @if (SelectedRecipe is { } selected)
        {
            <div class="activity-dialog-overlay" @onclick="CloseRecipe" @onkeydown="HandleDialogKeyDown" @onkeydown:stopPropagation>
                <section class="activity-dialog" role="dialog" aria-modal="true" aria-labelledby="production-dialog-title" @onclick:stopPropagation>
                    <header class="activity-dialog__header"><span class="activity-dialog__icon" aria-hidden="true"><img src="@ItemArt.ForCode(selected.OutputCode)" alt="" /></span><div><small>炼金配方 · 每 @selected.CycleSeconds 秒</small><h2 id="production-dialog-title">@selected.Name</h2></div><button type="button" class="activity-dialog__close" @onclick="CloseRecipe" @ref="_dialogCloseButton" aria-label="关闭配方详情">×</button></header>
                    <div class="activity-dialog__body">
                        <section class="activity-dialog__product" aria-label="炼金产出">
                            <span class="activity-dialog__product-icon" aria-hidden="true"><img src="@ItemArt.ForCode(selected.OutputCode)" alt="" /></span>
                            <div><small>每轮产出 × @selected.OutputQuantity</small><strong>@selected.OutputName</strong><p>@selected.OutputDescription</p></div>
                        </section>
                        <div class="activity-dialog__stats"><div><span>当前材料可做</span><strong>@AvailableCycles(selected) 轮</strong></div><div><span>预计产出</span><strong>@((long)AvailableCycles(selected) * selected.OutputQuantity) 件</strong></div><div><span>背包成品</span><strong>@selected.CharacterQuantity</strong></div></div>
                        <div class="activity-dialog__ingredients"><strong>每轮消耗</strong>@foreach (var ingredient in selected.Ingredients) { <div><span class="activity-dialog__ingredient-name">@if (ItemArt.ForCode(ingredient.Code) is { } ingredientArt) { <img src="@ingredientArt" alt="" loading="lazy" /> }@ingredient.Name × @ingredient.Quantity</span><b class="@(ingredient.CharacterQuantity < ingredient.Quantity ? "activity-dialog__short" : null)">背包 @ingredient.CharacterQuantity</b></div> }</div>
                        <div class="activity-dialog__requirements"><strong>@(selected.IsUnlocked ? "已满足战斗条件" : "尚未解锁")</strong><span>@selected.UnlockDescription · @selected.UnlockProgress / @selected.UnlockRequired</span>@if (ActiveCharacters.Current?.Level < selected.MinimumCharacterLevel) { <span>需要角色 Lv.@selected.MinimumCharacterLevel</span> }@if (_overview.AlchemyLevel < selected.MinimumAlchemyLevel) { <span>需要炼金 Lv.@selected.MinimumAlchemyLevel</span> }</div>
                        @if (_notice is not null) { <p class="activity-notice" role="status">@_notice</p> }
                    </div>
                    <footer class="activity-dialog__footer"><button type="button" class="activity-dialog__primary" @onclick="() => StartAsync(selected)" disabled="@(_isBusy || !CanStart(selected))">@StartLabel(selected)</button><button type="button" class="activity-dialog__back" @onclick="CloseRecipe">返回炼金配方</button></footer>
                </section>
            </div>
        }
    }
</div>

@code {
    private ProductionOverviewResponse? _overview;
    private readonly CancellationTokenSource _refreshCancellation = new();
    private bool _isLoading = true;
    private bool _isRefreshing;
    private bool _isBusy;
    private string? _notice;
    private string? _selectedRecipeCode;
    private bool _focusDialog;
    private ElementReference _dialogCloseButton;
    private TimeSpan _serverOffset;
    private DateTime ServerNow => DateTime.UtcNow + _serverOffset;
    private ProductionRecipeResponse? SelectedRecipe => _overview?.Recipes.FirstOrDefault(recipe => recipe.Code == _selectedRecipeCode);
    private IEnumerable<ProductionRecipeResponse> OrderedRecipes() => (_overview?.Recipes ?? [])
        .OrderByDescending(recipe => recipe.IsUnlocked)
        .ThenBy(recipe => recipe.MinimumAlchemyLevel)
        .ThenBy(recipe => recipe.MinimumCharacterLevel)
        .ThenBy(recipe => recipe.Name, StringComparer.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        await ActiveCharacters.RefreshAsync();
        ActiveCharacters.Changed += OnActiveCharacterChanged;
        if (ActiveCharacters.Current is null)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }
        await LoadAsync();
        _ = RefreshLoopAsync(_refreshCancellation.Token);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusDialog) return;
        _focusDialog = false;
        await _dialogCloseButton.FocusAsync();
    }

    private void OpenRecipe(string code) { _selectedRecipeCode = code; _focusDialog = true; _notice = null; }
    private void CloseRecipe() => _selectedRecipeCode = null;
    private void HandleDialogKeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") CloseRecipe(); }

    private static bool IngredientsReady(ProductionRecipeResponse recipe) => recipe.Ingredients.Count > 0 &&
        recipe.Ingredients.All(item => item.Quantity > 0 && item.CharacterQuantity >= item.Quantity);

    private static int AvailableCycles(ProductionRecipeResponse recipe) => recipe.Ingredients.Count == 0 ||
        recipe.Ingredients.Any(item => item.Quantity <= 0) ? 0 :
        recipe.Ingredients.Min(item => item.CharacterQuantity / item.Quantity);

    private bool CanStart(ProductionRecipeResponse recipe) => _overview is not null && recipe.IsUnlocked &&
        ActiveCharacters.Current?.Level >= recipe.MinimumCharacterLevel &&
        _overview.AlchemyLevel >= recipe.MinimumAlchemyLevel && _overview.ActiveTask is null && IngredientsReady(recipe);

    private string StartLabel(ProductionRecipeResponse recipe) => !recipe.IsUnlocked ? "完成战斗后解锁"
        : ActiveCharacters.Current?.Level < recipe.MinimumCharacterLevel || _overview?.AlchemyLevel < recipe.MinimumAlchemyLevel ? "等级不足"
        : _overview?.ActiveTask is not null ? "已有进行中的任务"
        : !IngredientsReady(recipe) ? "背包材料不足" : "开始生产";

    private async Task RefreshLoopAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        var ticks = 0;
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(async () =>
                {
                    if (++ticks % 2 == 0)
                        await LoadAsync();
                    if (!token.IsCancellationRequested)
                        StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
    }

    private async Task LoadAsync()
    {
        if (_isRefreshing || _isBusy) return;
        _isRefreshing = true;
        var expectedCharacterId = ActiveCharacters.Current?.CharacterId;
        try
        {
            var response = await ApiService.GetProductionAsync();
            if (expectedCharacterId == ActiveCharacters.Current?.CharacterId)
            {
                _overview = response is not null && response.CharacterId == expectedCharacterId ? response : null;
                if (response is not null) _serverOffset = response.ServerTimeUtc - DateTime.UtcNow;
            }
        }
        catch { _overview = null; }
        finally
        {
            _isLoading = false;
            _isRefreshing = false;
        }
    }

    private async Task StartAsync(ProductionRecipeResponse recipe)
    {
        if (_isBusy || _overview is null) return;
        _isBusy = true;
        _notice = null;
        try
        {
            var (response, error) = await ApiService.StartProductionAsync(_overview.CharacterId, recipe.Code);
            if (error is not null) _notice = error;
            else if (response is not null && response.CharacterId == ActiveCharacters.Current?.CharacterId)
            {
                _overview = response;
                _selectedRecipeCode = null;
                _serverOffset = response.ServerTimeUtc - DateTime.UtcNow;
                _notice = $"{recipe.Name} 已开始生产，每轮结算时消耗材料。";
            }
        }
        catch { _notice = "连接中断，请刷新后确认任务状态。"; }
        finally { _isBusy = false; }
    }

    private async Task StopAsync(int taskId)
    {
        if (_isBusy) return;
        _isBusy = true;
        _notice = null;
        try
        {
            var (response, error) = await ApiService.StopProductionAsync(taskId);
            if (error is not null) _notice = error;
            else if (response is not null && response.CharacterId == ActiveCharacters.Current?.CharacterId)
            {
                _overview = response;
                _serverOffset = response.ServerTimeUtc - DateTime.UtcNow;
                _notice = "生产已停止，已完成的小轮成品保留在当前角色背包。";
            }
        }
        catch { _notice = "连接中断，请刷新后确认任务状态。"; }
        finally { _isBusy = false; }
    }

    private int CycleProgress(ProductionTaskResponse task)
    {
        if (task.CycleSeconds <= 0) return 0;
        var remaining = Math.Clamp((task.NextCycleAtUtc - ServerNow).TotalSeconds, 0, task.CycleSeconds);
        return (int)Math.Clamp(Math.Round(100 * (1 - remaining / task.CycleSeconds)), 0, 100);
    }

    private static string FormatDuration(TimeSpan span)
    {
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;
        return span.TotalHours >= 1 ? $"{(int)span.TotalHours:D2}:{span.Minutes:D2}:{span.Seconds:D2}"
            : $"{span.Minutes:D2}:{span.Seconds:D2}";
    }

    private static string StatusName(string status) => status switch
    {
        "Completed" => "到期完成",
        "Stopped" => "手动停止",
        "MaterialShortage" => "材料耗尽",
        "InventoryFull" => "背包已满",
        _ => status
    };

    private void OnActiveCharacterChanged() => _ = InvokeAsync(async () =>
    {
        _notice = null;
        _selectedRecipeCode = null;
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        _refreshCancellation.Cancel();
        _refreshCancellation.Dispose();
        ActiveCharacters.Changed -= OnActiveCharacterChanged;
    }
}
