@page "/shop"
@using Game.Client.Services
@using Game.Shared
@using Game.Shared.Dtos.Shop
@inject ApiService ApiService
@inject ActiveCharacterState ActiveCharacters
@inject AccountBalanceState AccountBalance
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>商店</PageTitle>

<div class="shop-page">
    <header class="shop-page__intro">
        <a href="/rooms">← 返回大厅</a>
        <span class="section-kicker">ADVENTURER'S SHOP</span>
        <h1>商店</h1>
        <p>使用金币购买补给，或将副本徽记兑换成当前角色的专属装备。</p>
    </header>

    @if (_loading)
    {
        <GameStateCard Compact="true" Title="正在整理商品" Detail="同步金币、库存与副本兑换内容…" />
    }
    else if (_shop is null)
    {
        <GameStateCard Compact="true" Tone="error" Icon="!" Title="商店读取失败" Detail="@(_message ?? "暂时无法读取商店。")">
            <Actions><button type="button" @onclick="LoadAsync">重试</button></Actions>
        </GameStateCard>
    }
    else
    {
        <section class="shop-summary" aria-label="购买账户">
            <div><small>CHARACTER GOLD</small><strong>◆ @_shop.Gold</strong><span>金币归当前角色</span></div>
            <div><small>DELIVERY TO</small><strong>@_shop.CharacterName</strong><span>商品进入此角色的背包</span></div>
        </section>

        <div class="shop-tabs" role="tablist" aria-label="商品分类">
            <button id="shop-consumables-tab" type="button" role="tab" aria-controls="shop-consumables-panel"
                    class="@(_kind == "Consumable" ? "shop-tabs__active" : "")" aria-selected="@(_kind == "Consumable" ? "true" : "false")" @onclick="ShowConsumables"><span aria-hidden="true">✚</span><strong>战斗补给</strong><small>@_shop.Items.Count(item => item.Kind == "Consumable")</small></button>
            <button id="shop-weapons-tab" type="button" role="tab" aria-controls="shop-weapons-panel"
                    class="@(_kind == "Weapon" ? "shop-tabs__active" : "")" aria-selected="@(_kind == "Weapon" ? "true" : "false")" @onclick="ShowWeapons"><span aria-hidden="true">⚔</span><strong>武器</strong><small>@_shop.Items.Count(item => item.Kind == "Weapon")</small></button>
            <button id="shop-exchange-tab" type="button" role="tab" aria-controls="shop-exchange-panel"
                    class="@(_kind == "Exchange" ? "shop-tabs__active" : "")" aria-selected="@(_kind == "Exchange" ? "true" : "false")" @onclick="ShowExchange"><span aria-hidden="true">◆</span><strong>副本兑换</strong><small>@_shop.DungeonExchangeOffers.Count</small></button>
            <button id="shop-character-slots-tab" type="button" role="tab" aria-controls="shop-character-slots-panel"
                    class="@(_kind == "CharacterSlot" ? "shop-tabs__active" : "")" aria-selected="@(_kind == "CharacterSlot" ? "true" : "false")" @onclick="ShowCharacterSlots"><span aria-hidden="true">♟</span><strong>角色栏位</strong><small>@_shop.CharacterSlotLimit/@_shop.MaximumCharacterSlots</small></button>
        </div>

        @if (_kind == "CharacterSlot")
        {
            <section id="shop-character-slots-panel" class="character-slot-shop" role="tabpanel" aria-labelledby="shop-character-slots-tab">
                <div class="character-slot-shop__header">
                    <div>
                        <span class="section-kicker">CAMP ROSTER</span>
                        <h2>扩充角色栏位</h2>
                        <p>更多角色可以分别参加战斗、采集和生产。一个账号最多拥有 @_shop.MaximumCharacterSlots 个角色。</p>
                    </div>
                    <strong>@_shop.CharacterCount / @_shop.CharacterSlotLimit</strong>
                </div>
                <div class="character-slot-shop__track" aria-label="角色栏位解锁进度">
                    @for (var slot = 1; slot <= _shop.MaximumCharacterSlots; slot++)
                    {
                        <span class="@(slot <= _shop.CharacterSlotLimit ? "character-slot-shop__slot--unlocked" : null)">
                            <b>@slot</b><small>@(slot <= _shop.CharacterSlotLimit ? "已解锁" : "未解锁")</small>
                        </span>
                    }
                </div>
                @if (_shop.NextCharacterSlotCost is int nextSlotCost)
                {
                    <div class="character-slot-shop__purchase">
                        <div><small>下一个栏位</small><strong>第 @(_shop.CharacterSlotLimit + 1) 个角色</strong><span>解锁永久保留，删除角色不会退还或减少栏位。</span></div>
                        <button type="button" @onclick="PurchaseCharacterSlotAsync" disabled="@(_busy || _shop.Gold < nextSlotCost)">◆ @nextSlotCost · 解锁</button>
                    </div>
                }
                else
                {
                    <p class="character-slot-shop__complete">已解锁全部角色栏位。</p>
                }
            </section>
        }
        else if (_kind == "Exchange")
        {
            <div id="shop-exchange-panel" class="shop-panel" role="tabpanel" aria-labelledby="shop-exchange-tab">
            @if (_shop.Materials.Count > 0)
            {
                <section class="material-wallet" aria-label="角色材料">
                    @foreach (var material in _shop.Materials)
                    {
                        <div><span aria-hidden="true">◆</span><strong>@material.Name × @material.Quantity</strong><small>@material.Description</small></div>
                    }
                </section>
            }
            <label class="exchange-filter">选择副本兑换所
                <select @bind="_exchangeDungeonCode">
                    @foreach (var dungeon in _shop.DungeonExchangeOffers.GroupBy(offer => new { offer.DungeonCode, offer.DungeonName }))
                    { <option value="@dungeon.Key.DungeonCode">@dungeon.Key.DungeonName</option> }
                </select>
            </label>
            @foreach (var dungeon in _shop.DungeonExchangeOffers.Where(offer => offer.DungeonCode == _exchangeDungeonCode).GroupBy(offer => new { offer.DungeonCode, offer.DungeonName }))
            {
                var firstOffer = dungeon.First();
                var balance = GetMaterialQuantity(firstOffer.CurrencyCode);
                <section class="exchange-section">
                    <header><div><span class="section-kicker">DUNGEON EXCHANGE</span><h2>@dungeon.Key.DungeonName</h2></div><strong>◆ @firstOffer.CurrencyName × @balance</strong></header>
                    <p>兑换武器的属性与配置固定，获得时仍会按照正常规则生成品质。</p>
                    <div class="shop-grid">
                    @foreach (var offer in dungeon)
                    {
                        <article class="shop-item exchange-item" @key="offer.Code">
                            <div class="shop-item__top"><span class="shop-item__symbol" aria-hidden="true"><img src="@WeaponArt.ForCode(offer.WeaponCode)" alt="" loading="lazy" /></span><span class="shop-item__kind">@WeaponRules.ElementName(offer.Element) · EXCHANGE</span></div>
                            <h2>@offer.WeaponName</h2>
                            <p>@WeaponRules.ElementName(offer.Element)属性 · 攻击 +@offer.Attack · HP +@offer.MaxHp</p>
                            <div class="shop-item__skills">
                                @foreach (var skill in offer.WeaponSkills)
                                { <span title="@skill.Description">@skill.Name Lv @skill.Level · @skill.Description</span> }
                            </div>
                            <div class="shop-item__foot"><span class="shop-item__owned">持有 <b>@offer.OwnedQuantity</b></span><div class="shop-item__buy"><button type="button" @onclick="() => ExchangeAsync(offer)" disabled="@(_busy || balance < offer.Cost)">◆ @offer.Cost · 兑换</button></div></div>
                        </article>
                    }
                    </div>
                </section>
            }
            </div>
        }
        else
        {
            var panelId = _kind == "Weapon" ? "shop-weapons-panel" : "shop-consumables-panel";
            var tabId = _kind == "Weapon" ? "shop-weapons-tab" : "shop-consumables-tab";
            <div id="@panelId" class="shop-panel shop-grid" role="tabpanel" aria-labelledby="@tabId">
                @foreach (var item in _shop.Items.Where(item => item.Kind == _kind))
                {
                    var quantity = GetQuantity(item);
                    var total = item.Price * quantity;
                    <article class="shop-item" @key="item.Code">
                        <div class="shop-item__top">
                            <span class="shop-item__symbol" aria-hidden="true">@if (item.Kind == "Weapon") { <img src="@WeaponArt.ForCode(item.Code)" alt="" loading="lazy" /> } else { @(item.AttackPercent.HasValue ? "✦" : "✚") }</span>
                            <span class="shop-item__kind">@(item.Kind == "Weapon" ? "WEAPON" : item.AttackPercent.HasValue ? "OPERATION POTION" : "CONSUMABLE")</span>
                        </div>
                        <h2>@item.Name</h2>
                        @if (item.Kind == "Consumable")
                        { <p>@(item.AttackPercent.HasValue ? $"作战药剂 · 整场攻击 +{item.AttackPercent}% · 每场消耗 1 瓶" : $"恢复 {item.HealAmount} HP · 冷却 {item.CooldownRounds} 回合")</p> }
                        else
                        {
                            <p>@(item.Element is { } element ? WeaponRules.ElementName(element) : "无")属性 · 攻击 +@item.Attack · HP +@item.MaxHp</p>
                            <div class="shop-item__skills">
                                @foreach (var skill in item.WeaponSkills)
                                { <span title="@skill.Description">@skill.Name Lv @skill.Level · @skill.Description</span> }
                            </div>
                        }
                        <div class="shop-item__foot">
                            <span class="shop-item__owned">持有 <b>@item.OwnedQuantity</b></span>
                            <div class="shop-item__buy">
                                @if (item.Kind == "Consumable")
                                {
                                    <label>数量<select value="@quantity" @onchange="e => SetQuantity(item.Code, e.Value?.ToString())" disabled="@_busy"><option value="1">1</option><option value="5">5</option><option value="10">10</option></select></label>
                                }
                                <button type="button" @onclick="() => PurchaseAsync(item)" disabled="@(_busy || _shop.Gold < total)">◆ @total · 购买</button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }

        @if (_message is not null)
        {
            <div class="shop-page__message" role="status"><span>@_message</span><button type="button" aria-label="关闭提示" @onclick="() => _message = null">×</button></div>
        }
        <div class="shop-page__links"><a href="/supplies">管理战斗补给 →</a><a href="/weapons">前往武器编成 →</a></div>
    }
</div>

@code {
    private ShopResponse? _shop;
    private readonly Dictionary<string, int> _quantities = new(StringComparer.OrdinalIgnoreCase);
    private string _kind = "Consumable";
    private string _exchangeDungeonCode = "";
    private string? _message;
    private bool _loading = true;
    private bool _busy;

    private void ShowConsumables() => _kind = "Consumable";
    private void ShowWeapons() => _kind = "Weapon";
    private void ShowExchange() => _kind = "Exchange";
    private void ShowCharacterSlots() => _kind = "CharacterSlot";

    protected override async Task OnInitializedAsync()
    {
        await ActiveCharacters.RefreshAsync();
        ActiveCharacters.Changed += OnActiveCharacterChanged;
        if (ActiveCharacters.Current is null)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _message = null;
        var characterId = ActiveCharacters.Current?.CharacterId;
        try
        {
            var response = await ApiService.GetShopAsync();
            if (characterId == ActiveCharacters.Current?.CharacterId)
            {
                _shop = response?.CharacterId == characterId ? response : null;
                if (_shop is not null && !_shop.DungeonExchangeOffers.Any(offer => offer.DungeonCode == _exchangeDungeonCode))
                    _exchangeDungeonCode = _shop.DungeonExchangeOffers.FirstOrDefault()?.DungeonCode ?? "";
                if (_shop is null) _message = "商店读取失败，请重试。";
            }
        }
        catch
        {
            _shop = null;
            _message = "暂时无法连接商店，请重试。";
        }
        finally { _loading = false; }
    }

    private void OnActiveCharacterChanged() => _ = InvokeAsync(async () =>
    {
        if (_shop?.CharacterId != ActiveCharacters.Current?.CharacterId) await LoadAsync();
        StateHasChanged();
    });

    private int GetQuantity(ShopItemResponse item) => item.Kind == "Weapon" ? 1 :
        _quantities.GetValueOrDefault(item.Code, 1);

    private void SetQuantity(string code, string? raw)
    {
        if (int.TryParse(raw, out var quantity) && quantity is 1 or 5 or 10)
            _quantities[code] = quantity;
    }

    private int GetMaterialQuantity(string code) =>
        _shop?.Materials.FirstOrDefault(material => material.Code == code)?.Quantity ?? 0;

    private async Task PurchaseAsync(ShopItemResponse item)
    {
        if (_busy || _shop is null) return;
        _busy = true;
        _message = null;
        try
        {
            var quantity = GetQuantity(item);
            var (response, error) = await ApiService.PurchaseShopItemAsync(_shop.CharacterId, item.Code, quantity);
            if (response is null)
            {
                _message = error ?? "购买失败。";
                if (error is "当前角色已切换，请刷新商店。" or "余额或背包刚刚发生变化，请重试。")
                {
                    await LoadAsync();
                    _message = error;
                }
                return;
            }
            _shop = response;
            _message = $"已为 {response.CharacterName} 购入 {item.Name} × {quantity}。";
            AccountBalance.NotifyChanged();
        }
        catch { _message = "购买请求未能完成，请刷新商店核对余额和背包。"; }
        finally { _busy = false; }
    }

    private async Task ExchangeAsync(DungeonExchangeOfferResponse offer)
    {
        if (_busy || _shop is null) return;
        _busy = true;
        _message = null;
        try
        {
            var (response, error) = await ApiService.ExchangeDungeonWeaponAsync(_shop.CharacterId, offer.Code);
            if (response is null)
            {
                _message = error ?? "兑换失败。";
                if (error is "当前角色已切换，请刷新兑换所。" or "材料或背包刚刚发生变化，请重试。")
                {
                    await LoadAsync();
                    _message = error;
                }
                return;
            }
            _shop = response.Shop;
            _message = $"已为 {_shop.CharacterName} 兑换 {response.WeaponDisplayName}。";
        }
        catch { _message = "兑换请求未能完成，请刷新页面核对材料和背包。"; }
        finally { _busy = false; }
    }

    private async Task PurchaseCharacterSlotAsync()
    {
        if (_busy || _shop?.NextCharacterSlotCost is not int cost) return;
        _busy = true;
        _message = null;
        try
        {
            var (response, error) = await ApiService.PurchaseCharacterSlotAsync();
            if (response is null)
            {
                _message = error ?? "角色栏位解锁失败。";
                if (error is "金币或角色栏位刚刚发生变化，请重试。" or "角色栏位已达到上限。")
                {
                    await LoadAsync();
                    _message = error;
                }
                return;
            }

            _shop = response;
            _message = $"已花费 {cost} 金币，解锁第 {response.CharacterSlotLimit} 个角色栏位。";
            AccountBalance.NotifyChanged();
        }
        catch { _message = "解锁请求未能完成，请刷新商店核对金币和角色栏位。"; }
        finally { _busy = false; }
    }

    public void Dispose() => ActiveCharacters.Changed -= OnActiveCharacterChanged;
}
