@page "/weapons"
<PageTitle>编队武器盘</PageTitle>
<LegacyLoadoutRoute Section="weapons" InstanceKind="weapon" InstanceId="@(RequestedInstanceId ?? RequestedWeaponId)" />
@code {
    [SupplyParameterFromQuery(Name = "instanceId")] public int? RequestedInstanceId { get; set; }
    [SupplyParameterFromQuery(Name = "weaponId")] public int? RequestedWeaponId { get; set; }
}
