@page "/"
@page "/rooms"
@using Game.Client.Services
@using Game.Shared.Dtos
@using Game.Shared
@inject ApiService ApiService
@inject NavigationManager Navigation

<PageTitle>副本大厅</PageTitle>

<div class="rooms-page">
@if (_isCheckingLoginState)
{
    <p>检查登录状态中...</p>
}
else
{
    <section class="dungeon-launcher">
        <div class="dungeon-launcher__heading">
            <span class="section-kicker">SELECT MISSION</span>
            <h2>选择挑战副本</h2>
        </div>
        <div class="dungeon-launcher__controls">
            <label for="dungeonSelect">目标副本</label>
            <select id="dungeonSelect" @bind="_selectedDungeonId">
            @foreach (var dungeon in _dungeons)
            {
                <option value="@dungeon.DungeonId">@dungeon.Name — @dungeon.MonsterName（HP @dungeon.MonsterMaxHp / 攻击 @dungeon.MonsterAttack / 防御 @dungeon.MonsterDefense）</option>
            }
            </select>
            <button class="button button--primary" @onclick="CreateRoomAsync" disabled="@_isLoading">开启房间</button>
        </div>
        <div class="dungeon-launcher__options">
            <label class="dungeon-launcher__mode"><span><input type="checkbox" @bind="_isRepeatBattle" /> 重复战斗</span><small>胜利后 @BattleRules.RepeatBattleDelaySeconds 秒重开副本</small></label>
            <label class="dungeon-launcher__mode"><span><input type="checkbox" @bind="_isPreparationTimeoutEnabled" /> 准备超时</span><small>@BattleRules.PreparationTimeoutSeconds 秒内未准备的角色仅本回合临时 Auto，不会永久开启 Auto</small></label>
        </div>
        @if (_selectedDungeon is not null)
        {
            <div class="dungeon-launcher__details">
                <span class="status-badge @(_selectedDungeon.AutoUnlocked ? "status-badge--success" : "status-badge--warning")">@(_selectedDungeon.AutoUnlocked ? "已通关 · Auto 已解锁" : "首次挑战 · 手动战斗")</span>
                <span>创建后，当前激活角色将自动进入 1 号位并成为主控。</span>
            </div>
        }
    </section>

    @if (_isLoading)
    {
        <div class="empty-state">正在搜索可用房间...</div>
    }
    else if (_rooms is null || _rooms.Count == 0)
    {
        <div class="empty-state"><strong>大厅暂时无人驻守</strong><span>选择副本并开启房间，成为第一个出发的冒险者。</span></div>
    }
    else
    {
        <section class="room-list">
            <div class="room-list__heading"><span class="section-kicker">ACTIVE EXPEDITIONS</span><h2>进行中的远征</h2></div>
            <div class="room-grid">
                @foreach (var room in _rooms)
                {
                    <article class="room-card">
                        <div class="room-card__topline"><span>ROOM · @room.RoomId · @(room.IsRepeatBattle ? "重复战斗" : "单次战斗")</span><span class="status-badge">@room.RoomStatus</span></div>
                        <h3>@room.MonsterName</h3>
                        <div class="room-card__rules"><span>@(room.IsRepeatBattle ? "循环讨伐" : "单次讨伐")</span><span>@(room.IsPreparationTimeoutEnabled ? "30 秒准备超时" : "无准备超时")</span></div>
                        <div class="hp-readout"><span>敌方生命</span><strong>@room.MonsterHp <small>/ @room.MonsterMaxHp</small></strong></div>
                        <progress class="health-bar health-bar--enemy" value="@room.MonsterHp" max="@room.MonsterMaxHp"></progress>
                        <button class="button button--secondary room-card__enter" @onclick="() => EnterRoom(room.RoomId)">进入战场 <span>→</span></button>
                    </article>
                }
            </div>
        </section>
    }
}

@if (_message is not null)
{
    <p class="notice-message">@_message</p>
}
</div>

@code {
    private List<RoomSummaryResponse>? _rooms;
    private bool _isCheckingLoginState = true;
    private bool _isLoading;
    private string? _message;
    private List<DungeonSummaryResponse> _dungeons = new();
    private int _selectedDungeonId;
    private bool _isRepeatBattle;
    private bool _isPreparationTimeoutEnabled = true;
    private DungeonSummaryResponse? _selectedDungeon => _dungeons.SingleOrDefault(dungeon => dungeon.DungeonId == _selectedDungeonId);

    protected override async Task OnInitializedAsync()
    {
        if (await ApiService.GetCurrentUserAsync() is null)
        {
            Navigation.NavigateTo("/login", replace: true);
            return;
        }

        _isCheckingLoginState = false;
        _dungeons = await ApiService.GetDungeonsAsync() ?? new();
        _selectedDungeonId = _dungeons.FirstOrDefault()?.DungeonId ?? 0;
        await LoadRoomsAsync();
    }

    private async Task LoadRoomsAsync()
    {
        _isLoading = true;
        _rooms = await ApiService.GetRoomsAsync();
        _isLoading = false;
    }

    private async Task CreateRoomAsync()
    {
        _isLoading = true;
        _message = null;
        if (_selectedDungeonId == 0) { _message = "暂无可用副本。"; _isLoading = false; return; }
        var (roomDetail, errorMessage) = await ApiService.CreateRoomAsync(_selectedDungeonId, _isRepeatBattle, _isPreparationTimeoutEnabled);
        if (roomDetail is null)
        {
            _message = errorMessage switch
            {
                "Current character is already in another room." => "当前角色已在其他房间中，不能再创建新房间。",
                _ => errorMessage ?? "创建房间失败。"
            };
            _isLoading = false;
        }
        else
        {
            Navigation.NavigateTo($"/battle/{roomDetail.RoomId}");
        }
    }

    private void EnterRoom(int roomId)
    {
        Navigation.NavigateTo($"/battle/{roomId}");
    }

}
