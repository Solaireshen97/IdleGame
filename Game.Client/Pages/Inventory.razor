    private CancellationTokenSource? _searchCancellation;
    private DotNetObjectReference<Inventory>? _reference;
    private int _visibilityRegistration;
    private ElementReference _detailElement, _modalElement;
    private ElementReference _categoryStrip;
    private ElementReference _listHeading;
    private string? _revealedCategory;
    private bool HasConfirmation => _preview is not null || _managementConfirm is not null || _chooseMaterial;
    private bool HasSyncError => _error is not null || Store.ErrorMessage is not null || Store.IsStale || !_charactersLoaded;
    private bool HasCurrentCategory => Store.LoadedCategory == _query.Category;
    private string ViewedName => Store.Overview?.CharacterId == _characterId ? Store.Overview.CharacterName : _characters.FirstOrDefault(character => character.CharacterId == _characterId)?.Name ?? "角色";
    private int PageCount => Math.Max(1, ((Store.Overview?.FilteredRowCount ?? 0) + _query.PageSize - 1) / _query.PageSize);
    private bool HasFilter => !string.IsNullOrWhiteSpace(_query.Search) || _query.Element is not null || _query.Tier is not null || _query.QualityRank is not null || _query.State != "all";
    private string FilterSummary
    {
        get
        {
            var filters = new List<string>();
            if (_query.Element is { } element) filters.Add(WeaponRules.ElementName(element));
            if (_query.Tier is { } tier) filters.Add($"T{tier}");
            if (_query.QualityRank is { } quality) filters.Add(WeaponRules.QualityName(quality));
            filters.Add(_query.State switch
            {
                "equipped" => "已装备", "unequipped" => "未装备", "locked" => "已锁定",
                "referenced" => "编队引用", "protected" => "受保护", "available" => "可整理", _ => "全部状态"
            });
            filters.Add(_query.Sort switch { "quantity" => "数量优先", "level" => "等级优先", "quality" => "品质优先", _ => "名称排序" });
            return string.Join(" · ", filters);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += StoreChanged;
        Api.ContextChanged += ContextChanged;
        _session = Api.SessionRevision;
        await LoadCharactersAsync();
    }
    private async Task LoadCharactersAsync(bool force = false)
    {
        var session = _session;
        _loadingCharacters = true;
        try
        {
            await Characters.EnsureLoadedAsync();
            var characters = await Api.GetCurrentCharactersAsync(force);
            if (_disposed || session != _session) return;
            _charactersLoaded = characters is not null;
            if (characters is null) { _error = "角色列表暂时无法读取，请重试。"; return; }
            _characters = characters;
            if (_characters.Count == 0) { _characterId = 0; return; }
            _characterId = RequestedCharacterId ?? Characters.Current?.CharacterId ?? _characters[0].CharacterId;
            if (!_characters.Any(character => character.CharacterId == _characterId)) _characterId = _characters[0].CharacterId;
            ApplyRoute();
            await LoadAsync(force);
            if (!_pollingStarted && !_disposed) { _pollingStarted = true; _ = PollAsync(); }
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch
        {
            if (!_disposed && session == _session)
            {
                _charactersLoaded = false;
                _error = "角色列表暂时无法读取，请重试。";
            }
        }
        finally
        {
            if (!_disposed && session == _session) { _initialized = true; _loadingCharacters = false; }
        }
    }
    protected override async Task OnParametersSetAsync()
    {
        if (!_initialized || _disposed || _lastRoute == Navigation.Uri || _busy) return;
        ApplyRoute();
        await LoadAsync();
    }
    private void ApplyRoute()
    {
        var nextId = RequestedCharacterId ?? _characterId;
        if (_characters.Any(character => character.CharacterId == nextId) && nextId != _characterId) { _characterId = nextId; ClearSelection(); }
        _query = new() { Category = RequestedCategory is not null && InventoryCategories.Values.Contains(RequestedCategory) ? RequestedCategory : RequestedItem?.StartsWith("soul:") == true ? InventoryCategories.SoulImprints : InventoryCategories.Weapons, Search = RequestedSearch, Element = Enum.TryParse<ElementType>(RequestedElement, out var element) ? element : null, State = RequestedState ?? "all", Sort = RequestedSort ?? "name", Tier = RequestedTier, QualityRank = RequestedQuality, Page = Math.Max(1, RequestedPage ?? 1) };
        _lastRoute = Navigation.Uri;
        ClearSelection();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_connected)
        {
            _reference = DotNetObjectReference.Create(this);
            try { _visibilityRegistration = await Js.InvokeAsync<int>("inventoryUi.connect", _reference); _connected = true; } catch (JSException) { }
        }
        if (_focusModal) { _focusModal = false; await Js.InvokeVoidAsync("inventoryUi.focusDialog", _modalElement, true); }
        if (_refocusModal) { _refocusModal = false; if (HasConfirmation && !_busy) await Js.InvokeVoidAsync("inventoryUi.refocusDialog", _modalElement); }
        if (_focusDetail) { _focusDetail = false; await Js.InvokeVoidAsync("inventoryUi.focusDialog", _detailElement, false, _selectedKey); }
        if (_restoreFocus) { _restoreFocus = false; await Js.InvokeVoidAsync("inventoryUi.restoreFocus"); }
        if (_revealList) { _revealList = false; await Js.InvokeVoidAsync("inventoryUi.revealList", _listHeading); }
        if (Store.Overview?.CharacterId == _characterId && _revealedCategory != _query.Category)
        {
            _revealedCategory = _query.Category;
            await Js.InvokeVoidAsync("inventoryUi.revealCategory", _categoryStrip);
        }
    }
    private void StoreChanged() => _ = InvokeAsync(async () => { if (_disposed) return; Reconcile(); StateHasChanged(); if (Store.IsStale && Store.ErrorMessage is null && !Store.IsLoading && !_busy && !HasConfirmation && await IsVisibleAsync()) await LoadAsync(true); });
    private void ContextChanged()
    {
        if (_session == Api.SessionRevision) return;
        _session = Api.SessionRevision; _generation++; _detailGeneration++; _characterId = 0; _characters.Clear(); ClearSelection(); _initialized = false; _charactersLoaded = false; _ = InvokeAsync(StateHasChanged);
    }
    private async Task<bool> IsVisibleAsync() { try { return await Js.InvokeAsync<bool>("inventoryUi.isVisible"); } catch (JSException) { return true; } }
    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try { while (await timer.WaitForNextTickAsync(_lifetime.Token)) await InvokeAsync(async () => { if (!_disposed && !_busy && !HasConfirmation && !Store.IsLoading && await IsVisibleAsync()) await LoadAsync(true); }); } catch (OperationCanceledException) { }
    }
    [JSInvokable] public Task OnVisibleAsync() => InvokeAsync(async () => { if (!_disposed && _initialized && !_busy && !HasConfirmation && !Store.IsLoading) await LoadAsync(true); });
    private async Task LoadAsync(bool force = false)
    {
        if (_disposed || _characterId <= 0) return;
        var generation = _generation;
        var characterId = _characterId;
        await Store.LoadAsync(characterId, _query, force, _lifetime.Token);
        if (_disposed || generation != _generation || characterId != _characterId) return;
        Reconcile();
        if (_selectedKey is not null && _detail is not null && !HasConfirmation) await LoadDetailAsync(_selectedKey, _detail.Entry.AssetKind, force);
        else if (RequestedItem is not null && _detail is null && _selectedKey is null)
        {
            var kind = RequestedItem.Split(':', 2)[0];
            if (kind is InventoryKinds.Weapon or InventoryKinds.SoulImprint or InventoryKinds.Stack) { _selectedKey = RequestedItem; _focusDetail = true; await LoadDetailAsync(RequestedItem, kind, true); }
        }
    }
    private void Reconcile()
    {
        if (Store.Overview?.CharacterId != _characterId || !HasCurrentCategory) return;
        var items = Store.Overview.Items;
        var removed = _selected.RemoveWhere(key => !items.Any(item => item.Key == key && Allowed(item, _batchAction)));
        if (removed > 0) _notice = $"{removed} 件已选物品状态发生变化，已从本次整理中移除。";
    }
    private async Task RefreshAsync()
    {
        if (_loadingCharacters) return;
        _error = null;
        if (!_charactersLoaded || _characters.Count == 0) await LoadCharactersAsync(true);
        else await LoadAsync(true);
    }
    private async Task ChangeCharacterAsync(ChangeEventArgs args)
    {
        if (_busy || HasConfirmation || !int.TryParse(args.Value?.ToString(), out var id) || !_characters.Any(character => character.CharacterId == id)) return;
        _characterId = id; _generation++; ClearSelection(); _notice = null; _error = null; _query.Page = 1; UpdateRoute(); await LoadAsync(true);
    }
    private void ClearSelection() { _selected.Clear(); ClearDetail(); _preview = null; _managementConfirm = null; _managementAction = null; _chooseMaterial = false; }
    private async Task QueryChangedAsync() { _generation++; ClearSelection(); _query.Page = 1; UpdateRoute(); await LoadAsync(); }
    private async Task SetCategoryAsync(string category) { _query.Category = category; _query.Element = null; _query.Tier = null; _query.QualityRank = null; await QueryChangedAsync(); }
    private async Task ElementChangedAsync(ChangeEventArgs args) { _query.Element = Enum.TryParse<ElementType>(args.Value?.ToString(), out var element) ? element : null; await QueryChangedAsync(); }
    private async Task TierChangedAsync(ChangeEventArgs args) { _query.Tier = int.TryParse(args.Value?.ToString(), out var value) ? value : null; await QueryChangedAsync(); }
    private async Task QualityChangedAsync(ChangeEventArgs args) { _query.QualityRank = int.TryParse(args.Value?.ToString(), out var value) ? value : null; await QueryChangedAsync(); }
    private async Task StateChangedAsync(ChangeEventArgs args) { _query.State = args.Value?.ToString() ?? "all"; await QueryChangedAsync(); }
    private async Task SortChangedAsync(ChangeEventArgs args) { _query.Sort = args.Value?.ToString() ?? "name"; await QueryChangedAsync(); }
    private async Task ResetFiltersAsync() { var category = _query.Category; _query = new() { Category = category }; await QueryChangedAsync(); }
    private void SearchChanged(ChangeEventArgs args)
    {
        _query.Search = args.Value?.ToString(); _searchCancellation?.Cancel(); _searchCancellation?.Dispose(); _searchCancellation = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token); _ = SearchAsync(_searchCancellation.Token);
    }
    private async Task SearchAsync(CancellationToken token) { try { await Task.Delay(300, token); await InvokeAsync(QueryChangedAsync); } catch (OperationCanceledException) { } }
    private async Task GoPageAsync(int page)
    {
        if (_busy || HasConfirmation || Store.IsLoading) return;
        _query.Page = Math.Clamp(page, 1, PageCount);
        var requestedPage = _query.Page;
        var generation = ++_generation;
        ClearSelection(); UpdateRoute();
        await LoadAsync();
        _revealList = !_disposed && generation == _generation && Store.ErrorMessage is null
            && Store.Overview?.CharacterId == _characterId && Store.Overview.Page == requestedPage;
    }
    private void UpdateRoute()
    {
        var values = new Dictionary<string, object?> { ["characterId"] = _characterId, ["category"] = _query.Category, ["search"] = _query.Search, ["element"] = _query.Element?.ToString(), ["state"] = _query.State == "all" ? null : _query.State, ["sort"] = _query.Sort == "name" ? null : _query.Sort, ["tier"] = _query.Tier, ["quality"] = _query.QualityRank, ["page"] = _query.Page == 1 ? null : _query.Page, ["item"] = _selectedKey };
        var uri = Navigation.GetUriWithQueryParameters(values); _lastRoute = uri; Navigation.NavigateTo(uri, replace: true);
    }
    private Task ActivateItemAsync(InventoryEntryDto item)
    {
        if (!_batchMode) return OpenDetailAsync(item);
        ToggleSelection(item);
        return Task.CompletedTask;
    }
    private async Task OpenDetailAsync(InventoryEntryDto item) { if (_selectedKey != item.Key) _detail = null; _selectedKey = item.Key; _focusDetail = true; UpdateRoute(); await LoadDetailAsync(item.Key, item.AssetKind, true); }
    private async Task LoadDetailAsync(string key, string kind, bool force)
    {
        var generation = ++_detailGeneration; var viewGeneration = _generation; var characterId = _characterId; _detailLoading = _detail is null;
        try
        {
            var (response, error) = await Api.GetInventoryDetailAsync(characterId, kind, key, force, _lifetime.Token);
            if (_disposed || generation != _detailGeneration || viewGeneration != _generation || _selectedKey != key || characterId != _characterId) return;
            if (response is not null && response.CharacterId == characterId)
            {
                _detail = response;
                // Item links can arrive without a category, including stackable materials.
                if (_query.Category != response.Entry.Category && InventoryCategories.Values.Contains(response.Entry.Category))
                {
                    _query.Category = response.Entry.Category;
                    _query.Element = null; _query.Tier = null; _query.QualityRank = null; _query.Page = 1;
                    _selected.Clear(); UpdateRoute();
                    await Store.LoadAsync(characterId, _query, false, _lifetime.Token);
                }
            }
            else
            {
                _error = error ?? "详情读取失败，请刷新仓库。";
                if (error == "物品已不在该角色仓库中，请刷新后重新选择。") { ClearDetail(); UpdateRoute(); }
                else if (_detail is null) _selectedKey = null;
            }
        }
        catch (OperationCanceledException) { }
        catch { if (!_disposed && generation == _detailGeneration) _error = "详情连接中断，请重新同步。"; }
        finally { if (generation == _detailGeneration) _detailLoading = false; }
    }
    private void ClearDetail() { _restoreFocus |= _detail is not null || _detailLoading || _chooseMaterial; _detailGeneration++; _detail = null; _selectedKey = null; _detailLoading = false; _chooseMaterial = false; _focusDetail = false; }
    private void CloseDetail() { if (_busy) return; ClearDetail(); UpdateRoute(); }
    private void DetailKeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") CloseDetail(); }
    private void ToggleBatch() { _batchMode = !_batchMode; _selected.Clear(); }
    private void BatchActionChanged(ChangeEventArgs args) { _batchAction = args.Value?.ToString() ?? "dismantle"; _selected.Clear(); }
    private bool CanSelect(InventoryEntryDto item) => item.InstanceId is not null && Allowed(item, _batchAction) && (_selected.Count == 0 || _selected.Contains(item.Key) || Store.Overview?.Items.FirstOrDefault(candidate => _selected.Contains(candidate.Key))?.AssetKind == item.AssetKind) && (_selected.Count < 100 || _selected.Contains(item.Key));
    private void ToggleSelection(InventoryEntryDto item) { if (_selected.Contains(item.Key)) _selected.Remove(item.Key); else if (CanSelect(item)) _selected.Add(item.Key); }
    private void SelectPage() { if (!HasCurrentCategory) return; foreach (var item in Store.Overview?.Items ?? []) if (CanSelect(item)) _selected.Add(item.Key); }
    private Task PreviewSelectedAsync() => PreviewAsync((Store.Overview?.Items ?? []).Where(item => _selected.Contains(item.Key)).ToList(), _batchAction);
    private async Task PreviewAsync(List<InventoryEntryDto> items, string action)
    {
        if (_busy || items.Count == 0) return;
        _busy = true; _error = null; var generation = _generation; var characterId = _characterId;
        try { var (preview, error) = await Api.PreviewInventoryActionAsync(characterId, new() { AssetKind = items[0].AssetKind, Action = action, InstanceIds = items.Select(item => item.InstanceId!.Value).ToList() }, _lifetime.Token); if (_disposed || generation != _generation || characterId != _characterId) return; if (preview is not null && preview.CharacterId == characterId) { _preview = preview; _focusModal = true; } else _error = error ?? "预览未能完成，请重新同步。"; } catch { if (!_disposed && generation == _generation) _error = "预览连接中断，请重试。"; } finally { _busy = false; }
    }
    private async Task ExecuteAsync()
    {
        if (_busy || _preview is not { Allowed: true } preview) return;
        _busy = true; _error = null; var characterId = _characterId;
        try { var (success, error) = await Api.ExecuteInventoryActionAsync(characterId, preview, _lifetime.Token); if (_disposed || characterId != _characterId) return; if (success) { _preview = null; _selected.Clear(); _notice = $"已{ActionName(preview.Action)} {preview.Items.Count} 件物品，收益已存入 {ViewedName} 的仓库。"; CloseAfterAction(); } else _error = error ?? "操作未完成，请重新核对。"; } catch { if (!_disposed) _error = "连接中断，请使用同一确认重试，或关闭后刷新核对库存。"; } finally { _busy = false; if (!_disposed) { if (_preview is not null) _refocusModal = true; await LoadAsync(true); } }
    }
    private void CloseAfterAction() { ClearDetail(); UpdateRoute(); }
    private async Task DetailActionAsync(string action)
    {
        if (_detail is null || _busy) return;
        if (action is "sell" or "dismantle") { await PreviewAsync([_detail.Entry], action); return; }
        var item = _detail.Entry;
        if (item.AssetKind == InventoryKinds.Weapon) await RunWeaponAsync(() => Api.SetWeaponLockAsync(_characterId, item.InstanceId!.Value, action == "lock"), action == "lock" ? "武器已锁定。" : "武器已解锁。");
        else if (item.AssetKind == InventoryKinds.SoulImprint) await RunSoulAsync(() => Api.SetSoulImprintLockAsync(_characterId, item.InstanceId!.Value, action == "lock"), action == "lock" ? "魂印已锁定。" : "魂印已解锁。");
    }
    private Task EnhanceAsync(int slot) => _detail?.Weapon is { } weapon ? RunWeaponAsync(() => Api.EnhanceWeaponSkillAsync(_characterId, weapon.Id, slot), "武器技能已强化。") : Task.CompletedTask;
    private Task CraftAsync(int tier) => RunWeaponAsync(() => Api.CraftWeaponBreakthroughStoneAsync(_characterId, tier), "已合成 1 枚通用突破石。");
    private Task ChooseMaterialAsync() { if (_busy) return Task.CompletedTask; _chooseMaterial = true; _focusModal = true; return Task.CompletedTask; }
    private void CloseMaterial() => CancelConfirmation();
    private Task UpgradeAsync(int materialId)
    {
        if (_detail?.Weapon is not { } weapon || _busy) return Task.CompletedTask;
        var candidate = _detail.QualityMaterials.FirstOrDefault(item => item.Id == materialId);
        if (materialId != 0 && candidate is null) return Task.CompletedTask;
        _chooseMaterial = false;
        _managementConfirm = materialId == 0 ? $"消耗 1 枚对应阶段通用突破石，为「{weapon.Name}」突破至 {WeaponRules.QualityName(weapon.QualityRank + 1)}。" : $"消耗「{candidate!.Name}」实例 #{candidate.Id}（{candidate.QualityName}），为「{weapon.Name}」突破至 {WeaponRules.QualityName(weapon.QualityRank + 1)}。素材的强化投入不会额外返还。";
        _managementAction = () => RunWeaponAsync(() => Api.UpgradeWeaponQualityAsync(_characterId, weapon.Id, materialId, materialId == 0), "武器品质已突破。"); _focusModal = true; return Task.CompletedTask;
    }
    private async Task ConfirmManagementAsync()
    {
        if (_busy || _managementAction is null) return;
        var action = _managementAction;
        await action();
        if (_disposed) return;
        if (_error is null) { _managementConfirm = null; _managementAction = null; _restoreFocus = true; await LoadAsync(true); }
        else _refocusModal = true;
    }
    private async Task RunWeaponAsync(Func<Task<(CharacterWeaponsResponse? Response, string? ErrorMessage)>> action, string notice) => await RunManagementAsync(async () => { var result = await action(); return (result.Response is not null, result.ErrorMessage); }, notice);
    private async Task RunSoulAsync(Func<Task<(CharacterSoulImprintsResponse? Response, string? ErrorMessage)>> action, string notice) => await RunManagementAsync(async () => { var result = await action(); return (result.Response is not null, result.ErrorMessage); }, notice);
    private async Task RunManagementAsync(Func<Task<(bool Success, string? Error)>> action, string notice)
    {
        if (_busy) return; _busy = true; _error = null; var generation = _generation; var characterId = _characterId;
        try { var result = await action(); if (_disposed || generation != _generation || characterId != _characterId) return; if (result.Success) { _notice = notice; if (Characters.Current?.CharacterId == characterId) await Characters.RefreshAsync(); } else _error = result.Error ?? "操作未完成，请重新同步。"; } catch { if (!_disposed) _error = "连接中断，请刷新后核对物品状态。"; } finally { _busy = false; if (!_disposed) await LoadAsync(true); }
    }
    private void CancelConfirmation() { if (_busy) return; _preview = null; _managementConfirm = null; _managementAction = null; _chooseMaterial = false; _ = InvokeAsync(async () => { await Js.InvokeVoidAsync("inventoryUi.restoreFocus"); await LoadAsync(true); }); }
    private void ModalKeyDown(KeyboardEventArgs args) { if (args.Key == "Escape") CancelConfirmation(); }
    private string NavigationLabel(string label) => Characters.Current?.CharacterId == _characterId ? label : $"切换为 {ViewedName} 并{label}";
    private string UsageLabel(InventoryUsageDto usage) => IsWarehouseRoute(usage.Route) ? usage.Label : NavigationLabel(usage.Label);
    private static bool IsWarehouseRoute(string route) => route.Split('?', '#')[0].Trim('/') == "inventory";
    private string UsageRoute(string route, InventoryEntryDto entry) => route + (route.Contains('?') ? "&" : "?") + (IsWarehouseRoute(route) ? "characterId=" + _characterId : "item=" + Uri.EscapeDataString(entry.Code) + (entry.InstanceId is int id ? "&instanceId=" + id : ""));
    private async Task NavigateForCharacterAsync(string route)
    {
        if (_busy) return; _busy = true; _error = null; var targetId = _characterId;
        if (IsWarehouseRoute(route)) { _busy = false; Navigation.NavigateTo(route); return; }
        try { if (Characters.Current?.CharacterId != targetId) { var (character, error) = await Api.SelectCurrentCharacterAsync(targetId); if (character is null) { _error = error ?? "切换角色失败。"; return; } await Characters.RefreshAsync(); if (Characters.Current?.CharacterId != targetId) { _error = "角色信息尚未同步，请重试。"; return; } } Navigation.NavigateTo(route); } catch { _error = "角色切换未完成，请重试。"; } finally { _busy = false; }
    }
    private static bool Allowed(InventoryEntryDto item, string action) => item.Actions.Any(candidate => candidate.Action == action && candidate.Allowed);
    private static string? Art(InventoryEntryDto item) => item.AssetKind == InventoryKinds.Weapon ? WeaponArt.ForCode(item.Code) : ItemArt.ForCode(item.Code);
    private static string CompactQuantity(int quantity) => quantity >= 100_000_000 ? $"{quantity / 100_000_000d:0.#}亿" : quantity >= 10_000 ? $"{quantity / 10_000d:0.#}万" : quantity.ToString("N0");
    private static string ItemSubtitle(InventoryEntryDto item) => string.Join(" · ", new[] { item.Element is { } element ? WeaponRules.ElementName(element) : null, item.ItemLevel is int level ? $"装等 {level}" : item.Tier is int tier ? $"T{tier}" : null, item.AssetKind == InventoryKinds.Stack ? InventoryCategories.Name(item.Category) : item.InstanceId is int id ? $"#{id}" : null }.Where(value => value is not null));
    private static string CategorySymbol(string category) => category switch { InventoryCategories.Weapons => "⚔", InventoryCategories.SoulImprints => "◇", InventoryCategories.Supplies => "✚", InventoryCategories.Planting => "♣", InventoryCategories.Upgrade => "✦", InventoryCategories.Exchange => "◆", _ => "▦" };
    private static string StorageName(InventoryEntryDto entry) => !entry.IsEquipped ? "未装备" : entry.AssetKind switch
    {
        InventoryKinds.Weapon => entry.EquippedSlotIndex is int slot ? slot == WeaponRules.MainSlotIndex ? "主武器" : $"副武器 {slot:00}" : "武器槽",
        InventoryKinds.SoulImprint => "魂印槽",
        InventoryKinds.Stack => entry.EquippedSlotIndex is int slot ? $"{ConsumableRules.SlotName(slot)}槽" : "补给槽",
        _ => "已装备 / 已配置"
    };
    private static string ActionName(string action) => action switch { "lock" => "锁定", "unlock" => "解锁", "sell" => "出售", "dismantle" => "分解", "enhance" => "强化", "upgrade" => "突破", _ => action };
    private static string ReasonName(string reason) => reason switch
    {
        "WeaponLocked" or "SoulImprintLocked" => "物品已锁定",
        "WeaponEquipped" or "SoulImprintEquipped" => "请先卸下物品",
        "FormationItemReferenced" => "物品被编队引用",
        "LoadoutLocked" => "角色已入场，请先离场",
        "WeaponCannotBeDismantled" => "没有可返还碎片",
        "UnknownItemDefinition" or "DefinitionMissing" or "UnknownSoulImprint" => "物品定义暂不可用",
        "WeaponQualityMaxed" or "WeaponQualityAtMaximum" => "品质已满",
        "WeaponSkillAtMaximum" => "技能已达到强化上限",
        "UnknownWeaponSkill" => "武器技能定义暂不可用，无法强化",
        "WeaponNotSellable" => "该武器不可出售",
        "StarterWeaponCannotBeConsumed" => "初始赠品不能作为突破素材",
