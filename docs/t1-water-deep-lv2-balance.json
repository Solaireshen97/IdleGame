  "Rules": {
    "Trigger": "首次降至70%生命，下一完整角色行动回合触发一次；过线所在回合不占用窗口。",
    "Window": "四个完整角色行动回合。初始三层，每层AttackPercent-5个百分点，LV2不累加层数、不冻结、不循环。",
    "Fire": "每名存活角色每回合首次有效火属性直接伤害，为全队存活角色各移除一层；普攻/技能/反击可计次，多段/二连击不额外计次，周期伤害/反射/衍生追击不计次。",
    "Cleanse": "移除单人全部深寒，由真实净化效果触发个人成功；净化其他状态不计入。",
    "Success": "个人主动清零后，下一完整回合起直接伤害最终倍率+15%，持续完整三回合，并免疫首领基础寒冷。每人仅一次。",
    "OrdinaryCold": "阶段触发时清除原有基础寒冷；四回合阶段内基础技能继续造成伤害，暂停施加基础寒冷。奖励期间保持个人基础寒冷免疫。",
    "NaturalExpiry": "剩余深寒自然消散，未主动清零者不获得余温，不追加惩罚；已取得奖励继续生效。",
    "Healing": "深寒只改变攻击加成，现有固定值/目标最大生命治疗不因其降低；余温不提高治疗或独立周期伤害。",
    "AttackFormula": "-15与装备攻击加成相加，不是将最终伤害再乘0.85；余温+15%是最终直接伤害倍率。",
    "ElementMatchup": "保持土打水+25%、火打水-25%规则。火属性是热机制解法，跨队伍总用时受装备与属性克制影响，不能只凭总时长比较处理收益。",
    "Persistence": "利用既有怪物阶段记录及绑定Boss的状态记录，不增加数据库表；窗口、角色计次及下一回合奖励跨服务重建保存，重复副本清空。"
  },
